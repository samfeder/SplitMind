+describe("the sweep never leaves items without a cursor (patch 0016, #125 decision 4)", () => {
+  const NOW = Date.UTC(2026, 10, 13, 0, 5, 0);
+  const stamp = (ms: number) => new Date(ms).toISOString();
+  const recent = stamp(NOW - HOUR);
+
+  class ItemsPurgeFailure extends Error {
+    override name = "ItemsPurgeFailure";
+  }
+  const secret = "Quarterly numbers for pat@example.com, code 482913";
+
+  function open() {
+    const sqlite = new SqliteD1Database();
+    databases.push(sqlite);
+    return { sqlite, log: createLogCapture() };
+  }
+
+  async function seedConnections(sqlite: SqliteD1Database, names: readonly string[]) {
+    for (const name of names) {
+      await insertCursor(sqlite, { connection_name: name, history_id: "1", last_run_at: recent });
+      await insertItem(sqlite, itemRow({ id: `${name}#p`, connection_name: name, created_at: recent, received_at: recent }));
+    }
+  }
+
+  const names = async (sqlite: SqliteD1Database, table: "email_watch_items" | "email_watch_cursors") =>
+    [...new Set((await selectAll<{ connection_name: string }>(sqlite, `select connection_name from ${table}`)).map((row) => row.connection_name))].sort();
+
+  /** The purge reads of email_watch_items (`select distinct` for a watched list, an unfiltered delete for none). */
+  const isItemsPurge = (query: string) =>
+    /select\s+distinct\s+connection_name\s+from\s+email_watch_items/i.test(query) || /^\s*delete\s+from\s+email_watch_items\s*$/i.test(query);
+
+  /** Throws when the statement matches, either as it is prepared or when it runs. `nth` counts matches, from 1. */
+  function failing(inner: SqliteD1Database, when: (query: string) => boolean, at: "prepare" | "run", nth = 1): D1DatabaseBinding {
+    let seen = 0;
+    return {
+      batch: (statements) => inner.batch(statements),
+      prepare(query: string) {
+        if (!when(query)) return inner.prepare(query);
+        seen += 1;
+        if (seen !== nth) return inner.prepare(query);
+        if (at === "prepare") throw new ItemsPurgeFailure(secret);
+        const statement = inner.prepare(query);
+        const rejecting = () => Promise.reject(new ItemsPurgeFailure(secret));
+        const wrapped: any = {
+          bind: (...values: unknown[]) => {
+            statement.bind(...values);
+            return wrapped;
+          },
+          first: rejecting,
+          all: rejecting,
+          run: rejecting,
+        };
+        return wrapped;
+      },
+    };
+  }
+
+  describe.each(["prepare", "run"] as const)("when the failure happens at %s", (at) => {
+    it("watched list: the cursor purge is skipped, the cursors stay, one error is logged by name only, and every item still has its cursor", async () => {
+      const { sqlite, log } = open();
+      await seedConnections(sqlite, ["a", "gone"]);
+      await sweepEmailWatchRetention(failing(sqlite, isItemsPurge, at), ["a"], log.logger, NOW);
+      expect(await names(sqlite, "email_watch_cursors")).toEqual(["a", "gone"]);
+      expect(await names(sqlite, "email_watch_items")).toEqual(["a", "gone"]);
+      expect(log.entries).toHaveLength(1);
+      expect(log.entries[0]!.level).toBe("error");
+      expect(log.text()).toContain("ItemsPurgeFailure");
+      for (const part of ["Quarterly numbers", "pat@example.com", "482913"]) expect(log.text(), part).not.toContain(part);
+    });
+
+    it("empty watched list: the cursors of every name stay", async () => {
+      const { sqlite, log } = open();
+      await seedConnections(sqlite, ["a", "gone"]);
+      await sweepEmailWatchRetention(failing(sqlite, isItemsPurge, at), [], log.logger, NOW);
+      expect(await names(sqlite, "email_watch_cursors")).toEqual(["a", "gone"]);
+      expect(log.entries).toHaveLength(1);
+    });
+
+    it("the expiry deletes still ran, and only the cursors of unwatched names were held back", async () => {
+      const { sqlite, log } = open();
+      await seedConnections(sqlite, ["a", "gone"]);
+      await insertItem(sqlite, itemRow({ id: "a#expired", connection_name: "a", created_at: stamp(NOW - 20 * DAY), received_at: stamp(NOW - 20 * DAY) }));
+      await sweepEmailWatchRetention(failing(sqlite, isItemsPurge, at), ["a"], log.logger, NOW);
+      expect((await selectAll<{ id: string }>(sqlite, "select id from email_watch_items order by id")).map((row) => row.id)).toEqual(["a#p", "gone#p"]);
+      expect(await names(sqlite, "email_watch_cursors")).toEqual(["a", "gone"]);
+    });
+
+    it("the next sweep, when the items purge works again, purges items and then cursors", async () => {
+      const { sqlite, log } = open();
+      await seedConnections(sqlite, ["a", "gone"]);
+      await sweepEmailWatchRetention(failing(sqlite, isItemsPurge, at), ["a"], log.logger, NOW);
+      await sweepEmailWatchRetention(sqlite, ["a"], log.logger, NOW);
+      expect(await names(sqlite, "email_watch_items")).toEqual(["a"]);
+      expect(await names(sqlite, "email_watch_cursors")).toEqual(["a"]);
+      expect(log.entries).toHaveLength(1);
+    });
+
+    it("a failure on the second chunk of unwatched names holds back every cursor, including those whose items were already purged", async () => {
+      const { sqlite, log } = open();
+      const many = Array.from({ length: 120 }, (_, index) => `n${String(index).padStart(3, "0")}`);
+      await seedConnections(sqlite, ["a", ...many]);
+      const secondChunk = (query: string) => /^\s*delete\s+from\s+email_watch_items\s+where\s+connection_name\s+in\b/i.test(query);
+      await sweepEmailWatchRetention(new BindLimitedD1(failing(sqlite, secondChunk, at, 2)), ["a"], log.logger, NOW);
+      expect(await names(sqlite, "email_watch_cursors")).toHaveLength(121);
+      expect((await names(sqlite, "email_watch_items")).length).toBeLessThan(121);
+      expect(log.entries).toHaveLength(1);
+      // Every name that still has items still has its cursor.
+      const cursors = new Set(await names(sqlite, "email_watch_cursors"));
+      for (const name of await names(sqlite, "email_watch_items")) expect(cursors.has(name), name).toBe(true);
+    });
+  });
+
+  it("a missing items table does not hold back the cursor purge, and nothing is logged", async () => {
+    const { sqlite, log } = open();
+    await seedConnections(sqlite, ["a", "gone"]);
+    sqlite.exec("drop table email_watch_items");
+    await sweepEmailWatchRetention(sqlite, ["a"], log.logger, NOW);
+    expect(await names(sqlite, "email_watch_cursors")).toEqual(["a"]);
+    expect(log.entries).toEqual([]);
+  });
+
+  it("a missing items table with an empty watched list purges every cursor", async () => {
+    const { sqlite, log } = open();
+    await seedConnections(sqlite, ["a", "gone"]);
+    sqlite.exec("drop table email_watch_items");
+    await sweepEmailWatchRetention(sqlite, [], log.logger, NOW);
+    expect(await names(sqlite, "email_watch_cursors")).toEqual([]);
+    expect(log.entries).toEqual([]);
+  });
+
+  it("a failing expiry delete alone does not hold back the cursor purge (only the items purge does)", async () => {
+    const { sqlite, log } = open();
+    await seedConnections(sqlite, ["a", "gone"]);
+    const pendingExpiry = (query: string) => /^\s*delete\s+from\s+email_watch_items\b/i.test(query) && /created_at/.test(query);
+    await sweepEmailWatchRetention(failing(sqlite, pendingExpiry, "prepare"), ["a"], log.logger, NOW);
+    expect(await names(sqlite, "email_watch_cursors")).toEqual(["a"]);
+    expect(await names(sqlite, "email_watch_items")).toEqual(["a"]);
+    expect(log.entries).toHaveLength(1);
+  });
+
+  it("a failing cursor purge after a working items purge still logs once and purges the items", async () => {
+    const { sqlite, log } = open();
+    await seedConnections(sqlite, ["a", "gone"]);
+    const cursorPurge = (query: string) => /email_watch_cursors/i.test(query);
+    await sweepEmailWatchRetention(failing(sqlite, cursorPurge, "prepare"), ["a"], log.logger, NOW);
+    expect(await names(sqlite, "email_watch_items")).toEqual(["a"]);
+    expect(log.entries).toHaveLength(1);
+  });
+});
+
