+describe("a stale invocation's purge changes nothing and says nothing (patch 0016, #125 decision 5)", () => {
+  const OTHER = "e".repeat(64);
+  const quote = (value: string | null) => (value === null ? "null" : `'${value.replace(/'/g, "''")}'`);
+  const nameOnly = (r: Rig, name: string) =>
+    r.log.entries.filter((entry) => entry.level === "warn" && JSON.stringify(entry.fields) === JSON.stringify({ connectionName: name }));
+
+  /** A database that runs `act` the first time a per-name delete on the watch tables is prepared. */
+  function onFirstPurge(inner: SqliteD1Database, act: () => void): D1DatabaseBinding {
+    let fired = false;
+    return {
+      batch: (statements) => inner.batch(statements),
+      prepare(query: string) {
+        if (!fired && /delete\s+from\s+email_watch_(items|cursors)\b[^;]*connection_name/i.test(query)) {
+          fired = true;
+          act();
+        }
+        return inner.prepare(query);
+      },
+    };
+  }
+
+  function staleWatcher(r: Rig, act: () => void): EmailWatcher {
+    return new EmailWatcher({
+      database: onFirstPurge(r.db, act),
+      runner: r.runner,
+      policy,
+      connections: r.connections,
+      logger: r.log.logger,
+      now: () => r.clock.now,
+    });
+  }
+
+  /** What another invocation did meanwhile: purged `work`, started it fresh under OTHER, stored a new item. */
+  function otherInvocationRestarted(r: Rig) {
+    return () => {
+      r.db.exec("delete from email_watch_items where connection_name = 'work'");
+      r.db.exec("delete from email_watch_cursors where connection_name = 'work'");
+      r.db.exec(
+        `insert into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up, last_success_at, failing_notice_at, connection_id)
+         values ('work', '7777', null, ${quote(iso(r.clock.now))}, 0, ${quote(iso(r.clock.now))}, null, ${quote(OTHER)})`,
+      );
+      const row = itemRow({ id: "fresh-1", connection_name: "work", gmail_message_id: "g-fresh-1", subject: "Deployment failed for fresh-app", dedup_key: "k-fresh-1" });
+      const columns = Object.keys(row);
+      r.db.exec(
+        `insert into email_watch_items (${columns.join(", ")}) values (${Object.values(row).map((value) => (typeof value === "number" ? String(value) : quote(value as string | null))).join(", ")})`,
+      );
+    };
+  }
+
+  it("a guard that matches nothing logs no warn, makes no get_profile call and leaves the other invocation's cursor and items alone", async () => {
+    const r = rig();
+    await seed(r);
+    await insertItem(r.db, itemRow({ id: "old-work", connection_name: "work", subject: "Deployment failed for old-app", dedup_key: "k-old" }));
+    r.runner.resolved.work = OTHER; // the name points at OTHER now: this invocation decides to purge the old fingerprint
+    const callsBefore = r.runner.calls.length;
+    r.clock.now = T0 + 10 * 60_000;
+    await staleWatcher(r, otherInvocationRestarted(r)).run();
+
+    expect(nameOnly(r, "work")).toEqual([]);
+    expect(r.log.entries.filter((entry) => entry.level !== "info")).toEqual([]);
+    expect(r.runner.calls.length).toBe(callsBefore);
+    expect(await cursorOf(r)).toMatchObject({ connection_id: OTHER, history_id: "7777" });
+    expect((await itemsOf(r)).map((row) => row.id)).toEqual(["fresh-1"]);
+  });
+
+  it("a guard that matches a stub cursor (no items) changed a row, so it warns once and restarts the name", async () => {
+    const r = rig();
+    r.mailboxes.work!.failWith("profile", 500);
+    await r.run();
+    expect((await cursorOf(r))!.history_id, "precondition: the stub exists").toBe("");
+    r.mailboxes.work!.clearFailures();
+    r.runner.resolved.work = OTHER;
+    const callsBefore = r.runner.calls.length;
+    r.clock.now = T0 + 10 * 60_000;
+    await r.run();
+    expect(nameOnly(r, "work")).toHaveLength(1);
+    expect(r.runner.calls.slice(callsBefore).map((call) => call.actionId)).toEqual(["gmail.get_profile"]);
+    expect(await cursorOf(r)).toMatchObject({ connection_id: OTHER, history_id: "1000" });
+  });
+});
