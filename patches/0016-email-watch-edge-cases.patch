+// Patch 0016, #125: 0023 adds the nullable text column created_at to email_watch_cursors and backfills it with
+// coalesce(last_success_at, last_run_at). Postgres has the same file name in its own directory.
+describe("0023_email_watch_cursor_created_at migration (patch 0016, #125)", () => {
+  const NAME = "0023_email_watch_cursor_created_at.sql";
+  const PREVIOUS = "0022_email_watch_cursor_state.sql";
+
+  const sqlOf = (dialect: "sqlite" | "postgresql") =>
+    defaultMigrationSource.readMigrations(dialect).find((migration) => migration.name === NAME)?.sql;
+  const through = (name: string) => defaultMigrationSource.readMigrations("sqlite").filter((entry) => entry.name <= name);
+
+  it("comes right after 0022, in both the D1/SQLite and the Postgres directory", () => {
+    for (const dialect of ["sqlite", "postgresql"] as const) {
+      const names = defaultMigrationSource.readMigrations(dialect).map((migration) => migration.name);
+      expect(names, dialect).toContain(NAME);
+      expect(names.indexOf(NAME), dialect).toBe(names.indexOf(PREVIOUS) + 1);
+    }
+  });
+
+  it("adds one nullable text column created_at without a default, and keeps the eight that were there", async () => {
+    const found = await columns(open(), "email_watch_cursors");
+    const byName = Object.fromEntries(found.map((column) => [column.name, column]));
+    expect(byName.created_at?.type.toLowerCase()).toBe("text");
+    expect(byName.created_at).toMatchObject({ notnull: 0, dflt_value: null, pk: 0 });
+    expect(byName.connection_name).toMatchObject({ pk: 1 });
+    expect(byName.history_id).toMatchObject({ notnull: 1 });
+    expect(found).toHaveLength(9);
+  });
+
+  it("backfills created_at with coalesce(last_success_at, last_run_at) on rows that exist before 0023", () => {
+    const connection = new DatabaseSync(":memory:");
+    try {
+      for (const migration of through(PREVIOUS)) connection.exec(migration.sql);
+      connection.exec(`
+        insert into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up, last_success_at, failing_notice_at, connection_id)
+          values ('succeeded', '1', null, '2026-11-11T12:00:00.000Z', 0, '2026-11-10T00:00:00.000Z', null, 'c1');
+        insert into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up, last_success_at, failing_notice_at, connection_id)
+          values ('never-succeeded', '7', 'p20', '2026-11-09T08:30:00.000Z', 1, null, null, null);
+      `);
+      connection.exec(sqlOf("sqlite")!);
+      expect(
+        connection
+          .prepare("select connection_name, history_id, page_token, last_run_at, catch_up, last_success_at, connection_id, created_at from email_watch_cursors order by connection_name")
+          .all(),
+      ).toEqual([
+        {
+          connection_name: "never-succeeded",
+          history_id: "7",
+          page_token: "p20",
+          last_run_at: "2026-11-09T08:30:00.000Z",
+          catch_up: 1,
+          last_success_at: null,
+          connection_id: null,
+          created_at: "2026-11-09T08:30:00.000Z",
+        },
+        {
+          connection_name: "succeeded",
+          history_id: "1",
+          page_token: null,
+          last_run_at: "2026-11-11T12:00:00.000Z",
+          catch_up: 0,
+          last_success_at: "2026-11-10T00:00:00.000Z",
+          connection_id: "c1",
+          created_at: "2026-11-10T00:00:00.000Z",
+        },
+      ]);
+    } finally {
+      connection.close();
+    }
+  });
+
+  it("a row that predates 0022 gets last_success_at from 0022 and created_at from that: both are its last_run_at", () => {
+    const connection = new DatabaseSync(":memory:");
+    try {
+      for (const migration of through("0021_email_watch_drop_connection_index.sql")) connection.exec(migration.sql);
+      connection.exec("insert into email_watch_cursors values ('old', '1', null, '2026-11-05T01:02:03.000Z', 0)");
+      for (const migration of through(NAME).filter((entry) => entry.name > "0021_email_watch_drop_connection_index.sql")) connection.exec(migration.sql);
+      expect(connection.prepare("select last_run_at, last_success_at, created_at from email_watch_cursors").all()).toEqual([
+        { last_run_at: "2026-11-05T01:02:03.000Z", last_success_at: "2026-11-05T01:02:03.000Z", created_at: "2026-11-05T01:02:03.000Z" },
+      ]);
+    } finally {
+      connection.close();
+    }
+  });
+
+  it("applies on a database with no cursor rows; a row inserted afterwards has a null created_at unless it gives one", async () => {
+    const db = open();
+    await insertCursor(db, { connection_name: "work", history_id: "1", last_run_at: "2026-11-11T12:00:00.000Z" });
+    await insertCursor(db, { connection_name: "stub", history_id: "", last_run_at: "2026-11-11T12:00:00.000Z", created_at: "2026-11-11T11:00:00.000Z" });
+    expect(await selectAll(db, "select connection_name, history_id, created_at from email_watch_cursors order by connection_name")).toEqual([
+      { connection_name: "stub", history_id: "", created_at: "2026-11-11T11:00:00.000Z" },
+      { connection_name: "work", history_id: "1", created_at: null },
+    ]);
+  });
+
+  it("does not touch the items table, its indexes or its rows", () => {
+    const connection = new DatabaseSync(":memory:");
+    try {
+      for (const migration of through(PREVIOUS)) connection.exec(migration.sql);
+      connection.exec(`
+        insert into email_watch_items (id, connection_name, gmail_message_id, gmail_thread_id, sender_domain, subject, category, rule_id, received_at, created_at, status, acknowledged_at, dedup_key)
+          values ('p', 'work', 'g1', 't1', 'vercel.com', 's', 'deploy_failed', 'r', 'x', '2026-11-11T12:00:00.000Z', 'pending', null, 'k1');
