+// ---------------------------------------------------------------------------------------------------------------
+// Patch 0016, #125: a name that never started (a stub cursor, history_id '') through the real Worker, the connection
+// service and the list and acknowledge actions; and the sweep that must not leave items without a cursor.
+// ---------------------------------------------------------------------------------------------------------------
+describe("a name that never started, through the Worker (patch 0016, #125)", () => {
+  const ctx = { waitUntil() {}, passThroughOnException() {} };
+  const NEW_EMAIL = "new-owner@example.org";
+  const TRYING_SINCE = "Email watch could not start reading this account (trying since";
+  const fingerprint = (id: string, accountId: string) => createHash("sha256").update(`${id}|${accountId}`).digest("hex");
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  /** Watches `work` whose first profile call fails; the clock is faked so a day can pass between ticks. */
+  async function stubbed() {
+    vi.spyOn(console, "info").mockImplementation(() => {});
+    const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(at(M0));
+    const s = await setup({ names: ["work"], vars: { [CONNECTIONS]: "gmail:work" } });
+    s.mailboxes.work!.failWith("profile", 500);
+    await s.tick(M0);
+    return { s, warn };
+  }
+
+  async function advanceAndTick(s: Setup, minutes: number) {
+    vi.setSystemTime(at(M0 + minutes));
+    await s.tick(M0 + minutes);
+  }
+
+  async function action(s: Setup, name: string, input: unknown): Promise<string> {
+    const response = await worker.fetch(
+      new Request(`${s.env.OOMOL_CONNECT_ORIGIN}/v1/actions/mail_watch.${name}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ input }),
+      }),
+      s.env,
+      ctx,
+    );
+    return JSON.stringify(await response.json());
+  }
+
+  async function connectionStore(s: Setup) {
+    return new D1RuntimeDatabase(s.db, { secretCodec: await createWorkerSecretCodec(s.env.OOMOL_CONNECT_ENCRYPTION_KEY!) }).connectionStore;
+  }
+
+  it("the first failed profile call leaves a stub whose connection_id is the real account fingerprint", async () => {
+    const { s } = await stubbed();
+    const store = await connectionStore(s);
+    const id = (await store.get("gmail", "work"))!.id;
+    const rows = await s.watchRows<Record<string, any>>("email_watch_cursors");
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      connection_name: "work",
+      history_id: "",
+      page_token: null,
+      catch_up: 0,
+      last_success_at: null,
+      failing_notice_at: null,
+      connection_id: fingerprint(id, s.mailboxes.work!.email),
+    });
+    expect(rows[0]!.created_at).toBe(new Date(at(M0)).toISOString());
+  });
+
+  it("after 24 hours the 'could not start reading' item is listed, can be acknowledged, and is not hidden by the stub", async () => {
+    const { s } = await stubbed();
+    await advanceAndTick(s, 24 * 60 - 1);
+    expect(await s.watchRows("email_watch_items")).toEqual([]);
+    await advanceAndTick(s, 24 * 60 + 10);
+    const items = await s.watchRows<{ id: string; subject: string; rule_id: string }>("email_watch_items");
+    expect(items.map((item) => item.rule_id)).toEqual(["watch-failing"]);
+    expect(items[0]!.subject).toContain(TRYING_SINCE);
+
+    expect(await action(s, "list_pending_mail", {})).toContain(TRYING_SINCE);
+    expect(await action(s, "acknowledge_mail", { ids: [items[0]!.id] })).toContain('"acknowledged":1');
+    expect((await s.watchRows<{ status: string }>("email_watch_items"))[0]!.status).toBe("acknowledged");
+  });
+
+  it("when the name is saved over in place for another account, the list hides the item and acknowledge leaves it, before any poll", async () => {
+    const { s } = await stubbed();
+    await advanceAndTick(s, 24 * 60 + 10);
+    const id = (await s.watchRows<{ id: string }>("email_watch_items"))[0]!.id;
+    expect(await action(s, "list_pending_mail", {})).toContain(TRYING_SINCE);
+
+    s.mailboxes.work = new FakeMailbox({ prefix: "z", email: NEW_EMAIL, startHistoryId: 5000 });
+    await (await connectionStore(s)).set("gmail", "work", {
+      authType: "oauth2",
+      accessToken: "token-work",
+      tokenType: "Bearer",
+      metadata: {},
+      profile: { accountId: NEW_EMAIL, displayName: NEW_EMAIL, grantedScopes: [] },
+    });
+    expect(await action(s, "list_pending_mail", {})).not.toContain(TRYING_SINCE);
+    expect(await action(s, "acknowledge_mail", { ids: [id] })).toContain('"acknowledged":0');
+    expect((await s.watchRows<{ status: string }>("email_watch_items"))[0]!.status).toBe("pending");
+  });
+
+  it("the next poll after that switch purges the stub and its item and starts the new account from its own profile", async () => {
+    const { s, warn } = await stubbed();
+    await advanceAndTick(s, 24 * 60 + 10);
+    expect(await s.watchRows("email_watch_items")).toHaveLength(1);
+    s.mailboxes.work = new FakeMailbox({ prefix: "z", email: NEW_EMAIL, startHistoryId: 5000 });
+    const store = await connectionStore(s);
+    const id = (await store.set("gmail", "work", {
+      authType: "oauth2",
+      accessToken: "token-work",
+      tokenType: "Bearer",
+      metadata: {},
+      profile: { accountId: NEW_EMAIL, displayName: NEW_EMAIL, grantedScopes: [] },
+    })).id;
+    await advanceAndTick(s, 24 * 60 + 20);
+    expect(await s.watchRows("email_watch_items")).toEqual([]);
+    expect(await s.watchRows("email_watch_cursors")).toMatchObject([{ connection_name: "work", history_id: "5000", connection_id: fingerprint(id, NEW_EMAIL) }]);
+    expect(warn.mock.calls.filter((call) => JSON.stringify(call[1]) === JSON.stringify({ connectionName: "work" }))).toHaveLength(1);
+  });
+
+  it("when Gmail recovers the stub becomes a real cursor and mail is stored", async () => {
+    const { s } = await stubbed();
+    s.mailboxes.work!.clearFailures();
+    await advanceAndTick(s, 10);
+    expect(await s.watchRows("email_watch_cursors")).toMatchObject([{ connection_name: "work", history_id: "1000" }]);
+    s.mailboxes.work!.deliver(vercelFailure("Deployment failed for after-the-start"));
+    await advanceAndTick(s, 20);
+    expect((await s.watchRows<{ subject: string }>("email_watch_items")).map((item) => item.subject)).toEqual(["Deployment failed for after-the-start"]);
+    expect(await action(s, "list_pending_mail", {})).toContain("after-the-start");
+  });
+});
+
+describe("the retention sweep through the Worker leaves no items without a cursor (patch 0016, #125)", () => {
+  const iso = (ms: number) => new Date(ms).toISOString();
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  async function twoNames(): Promise<Setup> {
+    vi.spyOn(console, "info").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(at(M0));
+    const s = await setup({ names: ["a", "b"], vars: { [CONNECTIONS]: "gmail:a" } });
+    for (const name of ["a", "b"]) {
+      await insertCursor(s.db, { connection_name: name, history_id: "1000", last_run_at: iso(at(M0) - HOUR) });
+      await insertItem(s.db, itemRow({ id: `${name}-pending`, connection_name: name, created_at: iso(at(M0) - HOUR), received_at: iso(at(M0) - HOUR) }));
+    }
+    return s;
+  }
+  const cursorNames = async (s: Setup) => (await s.watchRows<{ connection_name: string }>("email_watch_cursors")).map((row) => row.connection_name).sort();
+  const itemIds = async (s: Setup) => (await s.watchRows<{ id: string }>("email_watch_items")).map((row) => row.id).sort();
+
+  it("an items purge that fails (not a missing table) leaves b's cursor with b's items, and logs once", async () => {
+    const s = await twoNames();
+    const error = vi.spyOn(console, "error").mockImplementation(() => {});
+    s.db.failWhen = (query) => {
+      if (/select\s+distinct\s+connection_name\s+from\s+email_watch_items/i.test(query)) throw new Error("fixture D1 failure");
+      return false;
+    };
+    await s.tick(M0);
+    expect(await cursorNames(s)).toEqual(["a", "b"]);
+    expect(await itemIds(s)).toEqual(["a-pending", "b-pending"]);
+    expect(error).toHaveBeenCalledTimes(1);
+  });
+
+  it("the next due invocation, with the items table working again, purges b's items and then b's cursor", async () => {
+    const s = await twoNames();
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    s.db.failWhen = (query) => {
+      if (/select\s+distinct\s+connection_name\s+from\s+email_watch_items/i.test(query)) throw new Error("fixture D1 failure");
+      return false;
+    };
+    await s.tick(M0);
+    s.db.failWhen = undefined;
+    vi.setSystemTime(at(M0 + 10));
+    await s.tick(M0 + 10);
+    expect(await cursorNames(s)).toEqual(["a"]);
+    expect(await itemIds(s)).toEqual(["a-pending"]);
+  });
+});
