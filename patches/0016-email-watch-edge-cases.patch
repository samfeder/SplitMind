diff --git a/migrations/0023_email_watch_cursor_created_at.sql b/migrations/0023_email_watch_cursor_created_at.sql
new file mode 100644
index 00000000..f489c21c
--- /dev/null
+++ b/migrations/0023_email_watch_cursor_created_at.sql
@@ -0,0 +1,5 @@
+-- Email watch (patch 0016). created_at: when the cursor row was first written (ISO-8601 UTC text). A stub cursor
+-- (history_id '', a name whose first get_profile failed) measures its 24 hours from it. Rows older than this
+-- migration get the last successful read, or the last run when there never was one.
+alter table email_watch_cursors add column created_at text;
+update email_watch_cursors set created_at = coalesce(last_success_at, last_run_at);
