+    expect(result.ok, JSON.stringify(result)).toBe(true);
+    return { policy: result.data.capability.policy, markdown: result.data.markdown };
+  };
+  type Policy = { allowed: boolean; code?: string; message?: string; checks: { source: string; rule?: string }[] };
+
+  const agentMd = async (site: Site, actionId: string, connectionName?: string) => {
