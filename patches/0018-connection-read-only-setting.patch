+    expect(result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect(String((result.error as { message: string }).message)).toContain('"notion:a"');
+    expect(String((result.error as { message: string }).message)).toContain("read-only");
+    expect(providerCalls).toEqual([]);
+  });
+
+  it("refuses a destructive action on a read-only connection and makes no provider call", async () => {
