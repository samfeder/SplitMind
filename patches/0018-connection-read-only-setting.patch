+// How each surface takes a connection: `get_action_guide` has `connectionName`; `agent.md` takes `?connectionName=`
+// (admin console route `/api/actions/:id/agent.md`; the runtime API has no agent.md route); `search_actions` has no
+// connection argument at all, so it can only describe the connection it would default to, `notion:default`.
+describe("read-only connections: guidance agrees with enforcement (#94)", () => {
+  const READ_ACTION = "notion.retrieve_page";
+  const WRITE_ACTION = "notion.append_block";
+  const DESTRUCTIVE_ACTION = "notion.delete_block";
+  const UNLABELLED_ACTION = "notion.create_comment"; // the catalog entry loses its operationType in these tests
+  const UNLABELLED_INPUT = {
+    parent: { type: "page_id", page_id: "page-1" },
