diff --git a/src/server/read-only-post-resolve.test.ts b/src/server/read-only-post-resolve.test.ts
new file mode 100644
index 00000000..5d0f5731
--- /dev/null
+++ b/src/server/read-only-post-resolve.test.ts
@@ -0,0 +1,271 @@
+import type { IConnectionStore } from "../connection-service.ts";
+import type {
+  ActionDefinition,
+  ActionExecutor,
+  ProviderDefinition,
+  ProviderProxyExecutor,
+  ResolvedCredential,
+} from "../core/types.ts";
+import type { IProviderLoader } from "../providers/provider-loader.ts";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createCatalogStore } from "../catalog-store.ts";
+import { ConnectionService } from "../connection-service.ts";
+import { ActionPolicyService } from "../core/action-policy.ts";
+import { parseReadOnlyConnections } from "../core/read-only-connections.ts";
+import { provider as github } from "../providers/github/definition.ts";
+import { ProviderLoader } from "../providers/provider-loader.ts";
+import { TriggerRunner } from "../triggers/trigger-runner.ts";
+import { ActionRunner } from "./actions/action-runner.ts";
+import { ProxyRunner } from "./proxy/proxy-runner.ts";
+import { RuntimeTokenService } from "./storage/runtime-token-service.ts";
+import { SqliteRuntimeDatabase } from "./storage/sqlite/runtime-store.ts";
+
+/**
+ * Post-resolve (TOCTOU) read-only checks. Each runner asks the connection service twice: a first lookup
+ * (`getConnectionSummary`) for the early checks, then `resolveForExecution` for the connection it will use. The
+ * operator's read-only list must be applied to the connection resolved for execution too, because the two lookups
+ * can disagree (a rename, a reconnect or a swap between them).
+ *
+ * The seam is the connection store under a real ConnectionService: the store answers the first `get` with a
+ * writable connection ("w") and every later `get` with the read-only one ("a", listed as read-only). The runners
+ * are real; nothing else is stubbed except the provider's own call, which is counted. Removing only the
+ * post-resolve check lets the provider call happen, which is what these tests observe.
+ */
+
+const READ_ONLY = parseReadOnlyConnections("example:a, github:a");
+const openPolicy = new ActionPolicyService().createSnapshot();
+
+const writeAction: ActionDefinition = {
+  id: "example.write_thing",
+  service: "example",
+  name: "write_thing",
+  description: "Writes a thing.",
+  operationType: "write",
+  requiredScopes: [],
+  providerPermissions: [],
+  inputSchema: { type: "object" },
+  outputSchema: { type: "object" },
+};
+const example: ProviderDefinition = {
+  service: "example",
+  displayName: "Example",
+  categories: ["Developer Tools"],
+  authTypes: ["api_key"],
+  auth: [{ type: "api_key" }],
+  actions: [writeAction],
+};
+
+function apiKey(key: string): ResolvedCredential {
+  return {
+    authType: "api_key",
+    apiKey: key,
+    values: { apiKey: key },
+    profile: { accountId: `acct-${key}`, displayName: key, grantedScopes: [] },
+    metadata: { providerAccountVerified: true },
+  };
+}
+
+let database: SqliteRuntimeDatabase;
+afterEach(() => {
+  database.close();
+  vi.restoreAllMocks();
+});
+beforeEach(() => {
+  database = new SqliteRuntimeDatabase(":memory:");
+});
+
+/** The first `get` returns connection "w"; every later `get` returns connection "a" (the read-only one). */
+async function swappingStore(service: string): Promise<{ store: IConnectionStore; gets: () => number }> {
+  const inner = database.connectionStore;
+  await inner.set(service, "w", apiKey("w"));
+  await inner.set(service, "a", apiKey("a"));
+  let gets = 0;
+  const store: IConnectionStore = {
+    get: async (svc, _name) => {
+      gets += 1;
+      return inner.get(svc, gets === 1 ? "w" : "a");
+    },
+    getRetirementGeneration: inner.getRetirementGeneration.bind(inner),
+    setIfCurrentGeneration: inner.setIfCurrentGeneration.bind(inner),
+    set: inner.set.bind(inner),
+    updateCredential: inner.updateCredential.bind(inner),
+    delete: inner.delete.bind(inner),
+    list: inner.list.bind(inner),
+  };
+  return { store, gets: () => gets };
+}
+
+describe("read-only check on the connection resolved for execution", () => {
+  it("ActionRunner refuses a write when the resolved connection is read-only, and never calls the provider", async () => {
+    const providerCalls = vi.fn();
+    const executor: ActionExecutor = async () => {
+      providerCalls();
+      return { ok: true, output: {} };
+    };
+    const loader: IProviderLoader = {
+      loadActionExecutor: async () => executor,
+      loadProxyExecutor: async () => undefined,
+      loadCredentialValidators: async () => undefined,
+    };
+    const catalog = createCatalogStore([example], { executableActionIds: [writeAction.id] });
+    const { store, gets } = await swappingStore("example");
+    const runner = new ActionRunner({
+      catalog,
+      providerLoader: loader,
+      connections: new ConnectionService({
+        catalog,
+        providerLoader: loader,
+        store,
+        readOnlyConnections: READ_ONLY,
+      }),
+      runs: database.runLogStore,
+    });
+
+    const run = await runner.run({
+      actionId: writeAction.id,
+      input: {},
+      caller: "http",
+      connectionName: "w",
+      policy: openPolicy,
+    });
+
+    expect(gets()).toBeGreaterThanOrEqual(2);
+    expect(run?.result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect((run!.result.error as { message: string }).message).toContain('"example:a"');
+    expect(providerCalls).not.toHaveBeenCalled();
+  });
+
+  it("ProxyRunner refuses a request when the resolved connection is read-only, and never calls the provider", async () => {
+    const providerCalls = vi.fn();
+    const proxy: ProviderProxyExecutor = async () => {
+      providerCalls();
+      return { ok: true, response: { status: 200, headers: {}, data: {} } };
+    };
+    const loader: IProviderLoader = {
+      loadActionExecutor: async () => undefined,
+      loadProxyExecutor: async () => proxy,
+      loadCredentialValidators: async () => undefined,
+    };
+    const catalog = createCatalogStore([example]);
+    const { store, gets } = await swappingStore("example");
+    const runner = new ProxyRunner({
+      catalog,
+      providerLoader: loader,
+      connections: new ConnectionService({
+        catalog,
+        providerLoader: loader,
+        store,
+        readOnlyConnections: READ_ONLY,
+      }),
+    });
+
+    const result = await runner.run({
+      service: "example",
+      input: { endpoint: "/things", method: "GET", connectionName: "w" },
+      connectionName: "w",
+      policy: openPolicy,
+    });
+
+    expect(gets()).toBeGreaterThanOrEqual(2);
+    expect(result).toMatchObject({ ok: false, status: 403, errorCode: "action_blocked" });
+    expect((result as { message: string }).message).toContain('"example:a"');
+    expect(providerCalls).not.toHaveBeenCalled();
+  });
+
+  it("TriggerRunner refuses a webhook write when the resolved connection is read-only, and never calls the provider", async () => {
+    const providerCalls = vi.fn();
+    const loader = new ProviderLoader({
+      github: async () => {
+        const native = await import("../providers/github/executors.ts");
+        const proxy: ProviderProxyExecutor = async () => {
+          providerCalls();
+          return { ok: true, response: { status: 200, headers: {}, data: {} } };
+        };
+        return { ...native, proxy };
+      },
+    });
+    const catalog = createCatalogStore([github]);
+    const { store, gets } = await swappingStore("github");
+    const created = await new RuntimeTokenService(database.runtimeTokenStore).createToken("Flow", {
+      allowedActions: [],
+      blockedActions: ["*"],
+      allowedProxies: [],
+      allowedTriggers: ["github.on_repo_event"],
+    });
+    const runner = new TriggerRunner({
+      catalog,
+      providerLoader: loader,
+      connections: new ConnectionService({
+        catalog,
+        providerLoader: loader,
+        store,
+        readOnlyConnections: READ_ONLY,
+      }),
+      store: database.triggerStore,
+    });
+
+    await expect(
+      runner.run({
+        service: "github",
+        triggerId: "github.on_repo_event",
+        connectionName: "w",
+        policy: openPolicy,
+        grant: {
+          tokenId: created.record.id,
+          allowedActions: [],
+          blockedActions: [],
+          allowedProxies: [],
+          allowedTriggers: ["github.on_repo_event"],
+        },
+        request: {
+          operation: "reconcile",
+          config: { owner: "octocat", repo: "repository", events: ["issues"] },
+          endpointUrl: "https://flow.example/events/hook",
+          active: true,
+          requestKey: "toctou",
+        },
+        signal: new AbortController().signal,
+      }),
+    ).rejects.toMatchObject({ code: "action_blocked", status: 403 });
+    expect(gets()).toBeGreaterThanOrEqual(2);
+    expect(providerCalls).not.toHaveBeenCalled();
+  });
+
+  it("control: the same runners let a write through when neither lookup is read-only", async () => {
+    const providerCalls = vi.fn();
+    const executor: ActionExecutor = async () => {
+      providerCalls();
+      return { ok: true, output: {} };
+    };
+    const loader: IProviderLoader = {
+      loadActionExecutor: async () => executor,
+      loadProxyExecutor: async () => undefined,
+      loadCredentialValidators: async () => undefined,
+    };
+    const catalog = createCatalogStore([example], { executableActionIds: [writeAction.id] });
+    await database.connectionStore.set("example", "w", apiKey("w"));
+    const runner = new ActionRunner({
+      catalog,
+      providerLoader: loader,
+      connections: new ConnectionService({
+        catalog,
+        providerLoader: loader,
+        store: database.connectionStore,
+        readOnlyConnections: READ_ONLY,
+      }),
+      runs: database.runLogStore,
+    });
+
+    const run = await runner.run({
+      actionId: writeAction.id,
+      input: {},
+      caller: "http",
+      connectionName: "w",
+      policy: openPolicy,
+    });
+
+    expect(run?.result).toMatchObject({ ok: true });
+    expect(providerCalls).toHaveBeenCalledTimes(1);
+  });
+});
