+    expect(String((write.error as { message: string }).message)).toContain('"notion:default"');
+    expect(providerCalls).toEqual([]);
+
+    expect((await site.mcpExecute({ ...NOTION_READ })).ok).toBe(true);
+    expect((await site.mcpExecute({ ...NOTION_WRITE, connectionName: "b" })).ok).toBe(true);
+  });
+});
