@@ -0,0 +1,208 @@
+import type { ActionDefinition, ActionExecutor, ProviderDefinition, ResolvedCredential } from "./core/types.ts";
+import type { IProviderLoader } from "./providers/provider-loader.ts";
+
+import { Client } from "@modelcontextprotocol/client";
+import { InMemoryTransport } from "@modelcontextprotocol/client";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createCatalogStore } from "./catalog-store.ts";
+import { ConnectionService } from "./connection-service.ts";
+import { ActionPolicyService, emptyPolicyRules } from "./core/action-policy.ts";
+import { parseReadOnlyConnections } from "./core/read-only-connections.ts";
+import { createMcpServer } from "./mcp.ts";
+import { ActionRunner } from "./server/actions/action-runner.ts";
+import { SqliteRuntimeDatabase } from "./server/storage/sqlite/runtime-store.ts";
+
+/**
+ * The read-only rule applies only when the caller's grant allows the connection (#31 round 2, item 1).
+ * The deployment marks `example_auth:default` read-only; the caller's MCP OAuth grant or runtime token
+ * (`allowedConnections`) covers only `example_auth:other`. A caller that is not granted the default connection must
+ * get the same "not granted" answer from every MCP tool that `execute_action` gives, and must never be told
+ * "is read-only" about a connection it cannot see.
+ */
+
+const action = (id: string, operationType: ActionDefinition["operationType"]): ActionDefinition => ({
+  id,
+  service: "example_auth",
+  name: id.split(".")[1]!,
+  description: `${id} description.`,
+  operationType,
+  requiredScopes: [],
+  providerPermissions: [],
+  inputSchema: { type: "object" },
+  outputSchema: { type: "object" },
+});
+const WRITE = action("example_auth.save_record", "write");
+const READ = action("example_auth.get_record", "read");
+const provider: ProviderDefinition = {
+  service: "example_auth",
+  displayName: "Authenticated Example",
+  categories: ["Developer Tools"],
+  authTypes: ["api_key"],
+  auth: [{ type: "api_key" }],
+  actions: [READ, WRITE],
+};
+const credential = (name: string): ResolvedCredential => ({
+  authType: "api_key",
+  apiKey: `key-${name}`,
+  values: { apiKey: `key-${name}` },
+  profile: { accountId: `account-${name}`, displayName: `Account ${name}`, grantedScopes: [] },
+  metadata: {},
+});
+
+class OkLoader implements IProviderLoader {
+  async loadActionExecutor(): Promise<ActionExecutor> {
+    return async () => ({ ok: true, output: { done: true } });
+  }
+  async loadProxyExecutor(): Promise<undefined> {
+    return undefined;
+  }
+  async loadCredentialValidators(): Promise<undefined> {
+    return undefined;
+  }
+}
+
+let database: SqliteRuntimeDatabase;
+beforeEach(() => {
+  database = new SqliteRuntimeDatabase(":memory:");
+});
+afterEach(() => database.close());
+
+/** `granted`: which connections the caller's grant covers; undefined means an ungranted-by-default token (all). */
+async function withClient(
+  options: { readOnly: string; granted: "other" | "default" | "all" },
+  run: (client: Client) => Promise<void>,
+): Promise<void> {
+  const catalog = createCatalogStore([provider], { executableActionIds: [READ.id, WRITE.id] });
+  const loader = new OkLoader();
+  const defaultConnection = await database.connectionStore.set("example_auth", "default", credential("default"));
+  const other = await database.connectionStore.set("example_auth", "other", credential("other"));
+  const connections = new ConnectionService({
+    catalog,
+    providerLoader: loader,
+    store: database.connectionStore,
+    readOnlyConnections: parseReadOnlyConnections(options.readOnly),
+  });
+  const grant = {
+    tokenId: "token-1",
+    allowedActions: [],
+    blockedActions: [],
+    allowedProxies: [],
+    allowedConnections:
+      options.granted === "other" ? [other.id] : options.granted === "default" ? [defaultConnection.id] : [],
+  };
+  const policy = new ActionPolicyService().createSnapshot(emptyPolicyRules(), grant);
+  const server = createMcpServer({
+    catalog,
+    connections,
+    actions: new ActionRunner({ catalog, providerLoader: loader, connections, runs: database.runLogStore }),
+    runtimeGrant: grant,
+    getPolicySnapshot: async () => policy,
+  });
+  const client = new Client({ name: "grant-test", version: "0.0.0" });
+  const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+  await server.connect(serverTransport);
+  await client.connect(clientTransport);
+  try {
+    await run(client);
+  } finally {
+    await client.close();
+  }
+}
+
+type Payload = Record<string, any>;
+const call = async (client: Client, name: string, args: Record<string, unknown>): Promise<Payload> =>
+  (await client.callTool({ name, arguments: args })).structuredContent as Payload;
+
+async function searchPolicy(client: Client, actionId: string) {
+  const found = await call(client, "search_actions", { service: "example_auth" });
+  expect(found.ok, JSON.stringify(found)).toBe(true);
+  return (found.data as Payload[]).find((entry) => entry.id === actionId)!.capability as Payload;
+}
+
+describe("read-only default connection, caller granted only other connections", () => {
+  const setup = { readOnly: "example_auth:default", granted: "other" as const };
+
+  it("execute_action gives a not-granted refusal, not a read-only one (the reference answer)", async () => {
+    await withClient(setup, async (client) => {
+      const executed = await call(client, "execute_action", { actionId: WRITE.id, input: {} });
+
+      expect(executed).toMatchObject({ ok: false, error: { code: "connection_not_allowed" } });
+      expect(executed.error.message).not.toContain("read-only");
+    });
+  });
+
+  it("search_actions never says the connection is read-only, and never leaks the connection", async () => {
+    await withClient(setup, async (client) => {
+      const executed = await call(client, "execute_action", { actionId: WRITE.id, input: {} });
+      const capability = await searchPolicy(client, WRITE.id);
+
+      expect(JSON.stringify(capability)).not.toContain("read-only");
+      expect(JSON.stringify(capability)).not.toContain("read-only-connection");
+      expect(capability.policy.checks.map((check: Payload) => check.source)).not.toContain("deployment");
+      expect(capability.connection).toBeUndefined();
+      expect(JSON.stringify(capability)).not.toContain("account-default");
+      // If search denies, it denies with execute_action's code and message, not a different reason.
+      if (capability.policy.allowed === false) {
+        expect(capability.policy).toMatchObject({
+          code: executed.error.code,
+          message: executed.error.message,
+        });
+      }
+    });
+  });
+
+  it("search_actions gives the write and the read action the same answer: the read-only rule plays no part", async () => {
+    await withClient(setup, async (client) => {
+      const write = await searchPolicy(client, WRITE.id);
+      const read = await searchPolicy(client, READ.id);
+
+      expect(write.policy).toEqual(read.policy);
+    });
+  });
+
+  it("control: get_action_guide gives the not-granted error for the default and for a named default", async () => {
+    await withClient(setup, async (client) => {
+      const executed = await call(client, "execute_action", { actionId: WRITE.id, input: {} });
+      const omitted = await call(client, "get_action_guide", { actionId: WRITE.id });
+      const named = await call(client, "get_action_guide", { actionId: WRITE.id, connectionName: "default" });
+
+      expect(omitted).toMatchObject({ ok: false, error: { code: "connection_not_allowed" } });
+      expect(omitted.error.message).toBe(executed.error.message);
+      expect(omitted.error.message).not.toContain("read-only");
+      expect(named).toEqual(omitted);
+    });
+  });
+});
+
+describe("read-only default connection, caller granted that connection (the rule still applies)", () => {
+  it.each([["default"], ["all"]] as const)("search_actions reports the write as read-only with grant %s", async (granted) => {
+    await withClient({ readOnly: "example_auth:default", granted }, async (client) => {
+      const executed = await call(client, "execute_action", { actionId: WRITE.id, input: {} });
+      const write = await searchPolicy(client, WRITE.id);
+      const read = await searchPolicy(client, READ.id);
+
+      expect(executed).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+      expect(write.policy).toMatchObject({ allowed: false, code: "action_blocked", message: executed.error.message });
+      expect(write.policy.message).toContain("read-only");
+      expect(read.policy.allowed).toBe(true);
+    });
+  });
+
+  it("get_action_guide reports the write as read-only with the default granted", async () => {
+    await withClient({ readOnly: "example_auth:default", granted: "default" }, async (client) => {
+      const guide = await call(client, "get_action_guide", { actionId: WRITE.id });
+
+      expect(guide.data.capability.policy).toMatchObject({ allowed: false, code: "action_blocked" });
+    });
+  });
+});
+
+describe("default connection is not read-only", () => {
+  it("search_actions is the same for a caller granted only other connections", async () => {
+    await withClient({ readOnly: "example_auth:other", granted: "other" }, async (client) => {
+      const write = await searchPolicy(client, WRITE.id);
+
+      expect(JSON.stringify(write)).not.toContain("read-only");
+    });
+  });
+});
