diff --git a/src/server/email-watch/watch-runner-read-only.test.ts b/src/server/email-watch/watch-runner-read-only.test.ts
new file mode 100644
index 00000000..35d62fcd
--- /dev/null
+++ b/src/server/email-watch/watch-runner-read-only.test.ts
@@ -0,0 +1,105 @@
+import type { AssetsBinding } from "../cloudflare/cloudflare-bindings.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ActionPolicyService } from "../../core/action-policy.ts";
+import { parseReadOnlyConnections } from "../../core/read-only-connections.ts";
+import { ProviderLoader } from "../../providers/provider-loader.ts";
+import { executorModules } from "../../providers/registry.cloudflare.generated.ts";
+import { provider as gmail } from "../../providers/gmail/definition.ts";
+import { loadCatalogFromAssets } from "../cloudflare/catalog-assets.ts";
+import { createWorkerSecretCodec } from "../secrets/worker-secret-codec.ts";
+import { D1RuntimeDatabase } from "../storage/d1/runtime-store.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import { FakeMailbox, fakeGmailFetch } from "./test-support.ts";
+import { createWatchActionRunner } from "./watch-runner.ts";
+
+/**
+ * The watcher's own ConnectionService (createWatchActionRunner) must honour OOMOL_CONNECT_READ_ONLY_CONNECTIONS
+ * like every other path (#31 round 2, item 2). Chosen level: behaviour. The runner is built the way the Worker's
+ * cron builds it, over a real D1-shaped SQLite database, the real Gmail executors and a fake Gmail REST API behind
+ * `fetch`; the read-only list is passed as the `readOnlyConnections` option, the same object every other runner
+ * receives. (The watch itself only issues reads, so the refusal of a non-read action is observed by calling the
+ * runner it returns, which is exactly the seam the cron hands to the watcher.)
+ */
+
+const catalog = {
+  "/catalog/index.json": { version: 1, providerCount: 1, chunks: ["apps-0000.json"] },
+  "/catalog/apps-0000.json": [JSON.parse(JSON.stringify(gmail))],
+};
+const assets: AssetsBinding = {
+  async fetch(request) {
+    const pathname = new URL(request.url).pathname;
+    return pathname in catalog
+      ? Response.json(catalog[pathname as keyof typeof catalog])
+      : new Response("not found", { status: 404 });
+  },
+};
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+async function build(readOnly: string | undefined) {
+  const database = new SqliteD1Database();
+  const runtime = new D1RuntimeDatabase(database, { secretCodec: await createWorkerSecretCodec("watch-ro-key") });
+  const mailboxes = { work: new FakeMailbox({ prefix: "w0" }), other: new FakeMailbox({ prefix: "w1" }) };
+  for (const [name, mailbox] of Object.entries(mailboxes)) {
+    await runtime.connectionStore.set("gmail", name, {
+      authType: "oauth2",
+      accessToken: `token-${name}`,
+      tokenType: "Bearer",
+      metadata: {},
+      profile: { accountId: mailbox.email, displayName: mailbox.email, grantedScopes: [] },
+    });
+  }
+  vi.stubGlobal("fetch", vi.fn(fakeGmailFetch(mailboxes)));
+  const runner = createWatchActionRunner({
+    catalog: await loadCatalogFromAssets(assets, { executableServices: Object.keys(executorModules) }),
+    providerLoader: new ProviderLoader({ gmail: executorModules.gmail! }),
+    runtimeDatabase: runtime,
+    publicOrigin: "https://watch-ro.example.com",
+    logger: { info() {}, warn() {}, error() {}, debug() {} } as never,
+    ...(readOnly === undefined ? {} : { readOnlyConnections: parseReadOnlyConnections(readOnly) }),
+  } as Parameters<typeof createWatchActionRunner>[0]);
+  const policy = new ActionPolicyService({}).createSnapshot();
+  const run = (actionId: string, input: unknown, connectionName: string) =>
+    runner.run({ actionId, input, connectionName, caller: "cron", audit: "failures", policy });
+  return { run, mailboxes };
+}
+
+describe("email watch runner with a read-only gmail connection", () => {
+  it("still reads Gmail through a read-only connection", async () => {
+    const { run, mailboxes } = await build("gmail:work");
+    const result = await run("gmail.get_profile", {}, "work");
+
+    expect(result?.result.ok, JSON.stringify(result?.result)).toBe(true);
+    expect(mailboxes.work.requests.length).toBeGreaterThan(0);
+  });
+
+  it.each([
+    ["write", "gmail.send_email", { recipientEmail: "a@example.com", subject: "s", body: "b" }],
+    ["destructive", "gmail.move_to_trash", { messageId: "m1" }],
+  ])("refuses a %s action on the read-only connection, with no Gmail request", async (_label, actionId, input) => {
+    const { run, mailboxes } = await build("gmail:work");
+    const result = await run(actionId, input, "work");
+
+    expect(result?.result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect((result!.result.error as { message: string }).message).toContain('"gmail:work"');
+    expect(mailboxes.work.requests).toEqual([]);
+  });
+
+  it("does not refuse the same non-read action on a gmail connection that is not read-only", async () => {
+    const { run } = await build("gmail:work");
+    const result = await run("gmail.move_to_trash", { messageId: "m1" }, "other");
+
+    expect(result?.result.error?.code).not.toBe("action_blocked");
+  });
+
+  it("refuses nothing when no read-only list is configured", async () => {
+    const { run } = await build(undefined);
+    const result = await run("gmail.move_to_trash", { messageId: "m1" }, "work");
+
+    expect(result?.result.error?.code).not.toBe("action_blocked");
+  });
+});
