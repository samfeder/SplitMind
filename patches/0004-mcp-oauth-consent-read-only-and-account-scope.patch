@@ -0,0 +1,90 @@
+import type { CloudflareEnv } from "./cloudflare-env.ts";
+
+/** What the consent form asked for: read-only or every action, and which accounts. */
+export interface McpGrantRequest {
+  /** "read" grants only actions whose operationType is read; "all" grants every action the deployment allows. */
+  access: "read" | "all";
+  /** Connection nicknames, as typed: "alias" (any service) or "service:alias". Empty grants every connection. */
+  accounts: readonly string[];
+}
+
+export interface McpGrantScope {
+  allowedActions: string[];
+  allowedConnections: string[];
+}
+
+type RuntimeHandler = (request: Request, env: CloudflareEnv) => Promise<Response>;
+
+/** Thrown for a request the operator can fix on the consent page, such as a nickname that matches no account. */
+export class McpGrantScopeError extends Error {}
+
+/** Read the access and accounts fields of a consent form. Missing access means read-only. */
+export function readMcpGrantRequest(form: URLSearchParams): McpGrantRequest {
+  const access = form.get("access") === "all" ? "all" : "read";
+  const accounts = (form.get("accounts") ?? "")
+    .split(/[\s,]+/)
+    .map((name) => name.trim())
+    .filter(Boolean);
+  return { access, accounts };
+}
+
+/**
+ * Turn the consent form's choice into the backing runtime token's grant. Runs only after the administrator token
+ * was checked, and asks the runtime with that token, so the consent page never lists accounts to an anonymous
+ * visitor.
+ */
+export async function resolveMcpGrantScope(
+  grant: McpGrantRequest,
+  origin: string,
+  env: CloudflareEnv,
+  runtime: RuntimeHandler,
+): Promise<McpGrantScope> {
+  const adminRequest = (path: string) =>
+    runtime(
+      new Request(`${origin}${path}`, {
+        headers: {
+          authorization: `Bearer ${env.OOMOL_CONNECT_ADMIN_TOKEN?.trim()}`,
+        },
+      }),
+      env,
+    );
+
+  let allowedActions = ["*"];
+  if (grant.access === "read") {
+    const response = await adminRequest("/api/actions");
+    if (!response.ok) throw new Error(`Unable to read the action catalog (${response.status}).`);
+    const actions = (await response.json()) as {
+      id: string;
+      operationType?: string;
+    }[];
+    allowedActions = actions.filter((action) => action.operationType === "read").map((action) => action.id);
+    // An empty list would mean "every action" to the policy, the opposite of read-only.
+    if (allowedActions.length === 0) throw new McpGrantScopeError("This gateway has no read-only actions to grant.");
+  }
+
+  let allowedConnections: string[] = [];
+  if (grant.accounts.length > 0) {
+    const response = await adminRequest("/v1/connections");
+    if (!response.ok) throw new Error(`Unable to read the connections (${response.status}).`);
+    const connections =
+      (
+        (await response.json()) as {
+          data?: { id: string; service: string; alias: string }[];
+        }
+      ).data ?? [];
+    const unknown: string[] = [];
+    const ids = new Set<string>();
+    for (const name of grant.accounts) {
+      const [service, alias] = name.includes(":") ? name.split(":", 2) : [undefined, name];
+      const matches = connections.filter(
+        (connection) => connection.alias === alias && (!service || connection.service === service),
+      );
+      if (matches.length === 0) unknown.push(name);
+      for (const match of matches) ids.add(match.id);
+    }
+    if (unknown.length > 0) throw new McpGrantScopeError(`No connected account is named ${unknown.join(", ")}.`);
+    allowedConnections = [...ids];
+  }
+
+  return { allowedActions, allowedConnections };
+}
