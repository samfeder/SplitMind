+import type { CloudflareEnv } from "./cloudflare-env.ts";
+
+import { describe, expect, it } from "vitest";
+import { McpGrantScopeError, readMcpGrantRequest, resolveMcpGrantScope } from "./mcp-grant-scope.ts";
+
+const origin = "https://connect.example.com";
+const env = { OOMOL_CONNECT_ADMIN_TOKEN: "test-admin-token" } as CloudflareEnv;
+
+const actions = [
+  { id: "gmail.search_messages", operationType: "read" },
+  { id: "gmail.send_message", operationType: "write" },
+  { id: "notion.search", operationType: "read" },
+  { id: "notion.delete_block", operationType: "destructive" },
+];
+const connections = [
+  { id: "c1", service: "gmail", alias: "work" },
+  { id: "c2", service: "slack", alias: "work" },
+  { id: "c3", service: "slack", alias: "team" },
+];
+
+// Stands in for the Worker's runtime, answering only an administrator.
+function runtime(seen: string[] = []) {
+  return async (request: Request) => {
+    seen.push(new URL(request.url).pathname);
+    if (request.headers.get("authorization") !== "Bearer test-admin-token") return new Response(null, { status: 401 });
+    const path = new URL(request.url).pathname;
+    if (path === "/api/actions") return Response.json(actions);
+    if (path === "/v1/connections") return Response.json({ success: true, data: connections });
+    return new Response(null, { status: 404 });
+  };
+}
+
+describe("MCP grant scope", () => {
+  it("reads an empty consent form as read-only for every account", () => {
+    expect(readMcpGrantRequest(new URLSearchParams())).toEqual({
+      access: "read",
+      accounts: [],
+    });
+    expect(readMcpGrantRequest(new URLSearchParams({ access: "all", accounts: " work,  slack:team " }))).toEqual({
+      access: "all",
+      accounts: ["work", "slack:team"],
+    });
+  });
+
+  it("grants only read actions for read-only access", async () => {
+    const scope = await resolveMcpGrantScope({ access: "read", accounts: [] }, origin, env, runtime());
+    expect(scope).toEqual({
+      allowedActions: ["gmail.search_messages", "notion.search"],
+      allowedConnections: [],
+    });
+  });
+
+  it("grants every action without reading the catalog for full access", async () => {
+    const seen: string[] = [];
+    const scope = await resolveMcpGrantScope({ access: "all", accounts: [] }, origin, env, runtime(seen));
+    expect(scope).toEqual({ allowedActions: ["*"], allowedConnections: [] });
+    expect(seen).toEqual([]);
+  });
+
+  it("matches a bare nickname on every service and a service:nickname on one", async () => {
+    const scope = await resolveMcpGrantScope(
+      { access: "all", accounts: ["work", "slack:team"] },
+      origin,
+      env,
+      runtime(),
+    );
+    expect(scope.allowedConnections.sort()).toEqual(["c1", "c2", "c3"]);
+    const one = await resolveMcpGrantScope({ access: "all", accounts: ["gmail:work"] }, origin, env, runtime());
+    expect(one.allowedConnections).toEqual(["c1"]);
+  });
+
+  it("names every nickname that matches no account", async () => {
+    const pending = resolveMcpGrantScope(
+      { access: "all", accounts: ["work", "home", "gmail:team"] },
+      origin,
+      env,
+      runtime(),
+    );
+    await expect(pending).rejects.toThrow(new McpGrantScopeError("No connected account is named home, gmail:team."));
+  });
+
+  it("refuses read-only access when no action is read-only, rather than granting everything", async () => {
+    const writesOnly = async (request: Request) =>
+      new URL(request.url).pathname === "/api/actions"
+        ? Response.json([{ id: "gmail.send_message", operationType: "write" }])
+        : new Response(null, { status: 404 });
+    await expect(resolveMcpGrantScope({ access: "read", accounts: [] }, origin, env, writesOnly)).rejects.toThrow(
+      McpGrantScopeError,
+    );
+  });
+});
