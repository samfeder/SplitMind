+describe("0021_email_watch_drop_connection_index migration (patch 0014, #114)", () => {
+  const NAME = "0021_email_watch_drop_connection_index.sql";
+  const PREVIOUS = "0020_email_watch_indexes.sql";
+
+  interface IndexRow {
+    name: string;
+    unique: number;
+    origin: string;
+  }
+  interface Index {
+    name: string;
+    columns: string[];
+    unique: boolean;
+    origin: string;
+  }
+
+  function indexesOf(connection: { prepare(sql: string): { all(): unknown[] } }, table: string): Index[] {
+    return (connection.prepare(`pragma index_list(${table})`).all() as IndexRow[]).map((row) => ({
+      name: row.name,
+      columns: (connection.prepare(`pragma index_xinfo("${row.name}")`).all() as { seqno: number; name: string | null; key: number }[])
+        .filter((column) => column.key === 1)
+        .sort((a, b) => a.seqno - b.seqno)
+        .map((column) => String(column.name)),
+      unique: row.unique === 1,
+      origin: row.origin,
+    }));
+  }
+
+  const find = (indexes: Index[], columns: string[], unique = false) =>
+    indexes.filter((index) => index.unique === unique && index.columns.join(",") === columns.join(","));
+
+  const migrationsUpTo = (name: string) => defaultMigrationSource.readMigrations("sqlite").filter((entry) => entry.name <= name);
