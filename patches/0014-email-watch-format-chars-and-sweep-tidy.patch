+    expect(sql).toMatch(/create index email_watch_items_status_created on email_watch_items \(status, created_at\)/);
+    expect(sql).toMatch(/create index email_watch_items_status_acknowledged on email_watch_items \(status, acknowledged_at\)/);
+    expect(sql).toMatch(/create index email_watch_items_connection on email_watch_items \(connection_name\)/);
+    const postgres = defaultMigrationSource.readMigrations("postgresql").find((entry) => entry.name === PREVIOUS)!.sql;
