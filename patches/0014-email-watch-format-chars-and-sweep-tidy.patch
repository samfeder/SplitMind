+
+// Patch 0014, #114 (cost claim): the purge reads the distinct connection names of email_watch_items. With
+// (connection_name) alone dropped, the unique (connection_name, gmail_message_id) index must still answer that read,
+// so the plan must name an index and never be a bare table scan. The SQL is the purge's statement in watcher.ts; the
+// watcher.test.ts counterpart captures the statement the sweep actually runs.
+describe("the purge's distinct connection_name read uses an index (patch 0014, #114)", () => {
+  const DISTINCT_READ = "select distinct connection_name from email_watch_items";
+
+  function plan(migrationNames: (name: string) => boolean): string[] {
+    const connection = new DatabaseSync(":memory:");
+    try {
+      for (const migration of defaultMigrationSource.readMigrations("sqlite").filter((entry) => migrationNames(entry.name))) {
+        connection.exec(migration.sql);
+      }
+      return (connection.prepare(`EXPLAIN QUERY PLAN ${DISTINCT_READ}`).all() as { detail: string }[]).map((row) => row.detail);
+    } finally {
+      connection.close();
+    }
+  }
+
+  const usesAnIndex = (lines: string[]) => {
+    const scans = lines.filter((line) => line.includes("email_watch_items"));
+    return scans.length > 0 && scans.every((line) => /USING (COVERING )?INDEX/.test(line));
+  };
+
+  it("with every migration applied (0021 included), the plan reads an index and not the bare table", () => {
+    const lines = plan(() => true);
+    expect(usesAnIndex(lines), lines.join("\n")).toBe(true);
+  });
+
+  it("with the migrations through 0020 (both connection indexes present), the plan reads an index too", () => {
+    const lines = plan((name) => name <= "0020_email_watch_indexes.sql");
+    expect(usesAnIndex(lines), lines.join("\n")).toBe(true);
+  });
+});
