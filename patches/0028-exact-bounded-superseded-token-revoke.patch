+
+// ---------------------------------------------------------------------------------------------------------------
+// Patch 0028 (#143, #145): an exact and bounded superseded-token revoke.
+//
+// The handler no longer lists grants after completeAuthorization. It `get`s each candidate's key (a candidate is one
+// of this client's grants from the before-step) and revokes the backing token only when that get returns null.
+// The before-step's reads of keys without metadata are capped at 50 per approve.
+//
+// How T1 is built: the OAuth library replaces an earlier grant only when it has the same client, and the same resource
+// (and, for a CIMD client, the same redirect URI). This Worker has exactly one resource, so "another resource" cannot
+// be set up through it; a CIMD client approved with two different redirect URIs can, and is a real library path
+// (completeAuthorization's `isCimdClient && grant.redirectUri === request.redirectUri`). The CIMD document is served
+// through the global fetch, as in mcp-oauth.test.ts.
+// ---------------------------------------------------------------------------------------------------------------
+
+const cimdClientUrl = "https://cimd.example.net/client.json";
+const callbackA = claudeCallback;
+const callbackB = "https://claude.com/api/mcp/auth_callback";
+
+/** Serves the CIMD document for `cimdClientUrl` (two redirect URIs) through the global fetch, and turns CIMD on. */
+function stubCimdTwoRedirects(): void {
+  vi.stubGlobal("Cloudflare", { compatibilityFlags: { global_fetch_strictly_public: true } });
+  vi.stubGlobal("fetch", async (input: string | URL | Request) => {
+    const url = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
+    return url === cimdClientUrl
+      ? Response.json({
+          client_id: cimdClientUrl,
+          client_name: "CIMD client",
+          redirect_uris: [callbackA, callbackB],
+          grant_types: ["authorization_code", "refresh_token"],
+          response_types: ["code"],
+          token_endpoint_auth_method: "none",
+        })
+      : new Response("not found", { status: 404 });
+  });
+}
+
+/** Keys of the administrator grants a client holds for one redirect URI, read from the stored records. */
+async function grantKeysFor(kv: MemoryKV, clientId: string, redirectUri: string): Promise<string[]> {
+  const keys: string[] = [];
+  for (const key of (await kv.list({ prefix: grantPrefix })).keys) {
+    if (key.name.slice(grantPrefix.length).includes(":")) continue;
+    const grant = await kv.get(key.name, { type: "json" });
+    if (grant?.clientId === clientId && grant.redirectUri === redirectUri) keys.push(key.name);
+  }
+  return keys;
+}
+
+interface TwoRedirectState {
+  keyA: string;
+  keyB: string;
+  tokenA: string;
+  tokenB: string;
+}
+
+/** A CIMD client approved once with redirect URI A and once with redirect URI B: two live grants, two live tokens. */
+async function approveCimdOnAThenB(kv: MemoryKV, e: CloudflareEnv): Promise<TwoRedirectState> {
+  codeOf(await consent(e, cimdClientUrl, { redirectUri: callbackA }));
+  codeOf(await consent(e, cimdClientUrl, { redirectUri: callbackB }));
+  const [keyA] = await grantKeysFor(kv, cimdClientUrl, callbackA);
+  const [keyB] = await grantKeysFor(kv, cimdClientUrl, callbackB);
+  expect(keyA).toBeTruthy();
+  expect(keyB).toBeTruthy();
+  const state = {
+    keyA: keyA!,
+    keyB: keyB!,
+    tokenA: await tokenOfGrant(kv, keyA!),
+    tokenB: await tokenOfGrant(kv, keyB!),
+  };
+  expect(state.tokenA).not.toBe(state.tokenB);
+  const live = await liveIds(e);
+  expect(live.has(state.tokenA)).toBe(true);
+  expect(live.has(state.tokenB)).toBe(true);
+  return state;
+}
+
+describe("patch 0028: the superseded-token revoke confirms with a get and is bounded (#143, #145)", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("T1: re-approving a CIMD client with redirect URI A keeps its grant for redirect URI B, and that grant's token stays live", async () => {
+    stubCimdTwoRedirects();
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const first = await approveCimdOnAThenB(kv, e);
+
+    codeOf(await consent(e, cimdClientUrl, { redirectUri: callbackA }));
+
+    // The library really did keep B's grant and replace A's: this is the case the revoke must not get wrong.
+    expect(await grantKeysFor(kv, cimdClientUrl, callbackB)).toEqual([first.keyB]);
+    const keysA = await grantKeysFor(kv, cimdClientUrl, callbackA);
+    expect(keysA).toHaveLength(1);
+    expect(keysA).not.toContain(first.keyA);
+    const live = await liveIds(e);
+    expect(live.has(first.tokenB)).toBe(true);
+    expect(live.has(first.tokenA)).toBe(false);
+    expect(live.size).toBe(2);
+    expect(difference(live, await grantBackedIds(e))).toEqual([]);
+  });
+
