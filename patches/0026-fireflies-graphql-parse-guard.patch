+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { firefliesActions } from "./actions.ts";
+import { provider } from "./definition.ts";
+import { firefliesActionHandlers } from "./runtime.ts";
+
+/**
+ * fireflies.execute_graphql_query forwards a caller-supplied document, so it only accepts documents whose
+ * operations are all queries. Expected outcomes below are literals chosen from the GraphQL grammar, not derived
+ * from the code under test.
+ */
+
+const rejectionMessage = "execute_graphql_query only allows read-only query operations";
+
+interface Sent {
+  url: string;
+  body: Record<string, unknown>;
+}
+
+let sent: Sent[];
+let globalFetch: ReturnType<typeof vi.spyOn>;
+
+const fetcher: typeof fetch = async (url, init) => {
+  sent.push({ url: String(url), body: JSON.parse(String(init?.body)) as Record<string, unknown> });
+  return Response.json({ data: { ok: true } });
+};
+
+function run(input: Record<string, unknown>) {
+  return firefliesActionHandlers.execute_graphql_query(input, { apiKey: "ff-key", fetcher });
+}
+
+beforeEach(() => {
+  sent = [];
+  globalFetch = vi.spyOn(globalThis, "fetch").mockImplementation(async () => Response.json({ data: { ok: true } }));
+});
+
+afterEach(() => {
+  globalFetch.mockRestore();
+});
+
+const accepted: [name: string, query: string][] = [
+  ["anonymous shorthand query", "{ user { name } }"],
+  ["named query", "query Q { transcripts { id } }"],
+  ["fragment defined before the query", "fragment F on User { name } query Q { user { ...F } }"],
+  ["fragment defined after the query", "query Q { user { ...F } } fragment F on User { name }"],
+  [
+    "fragments on both sides of the query",
+    "fragment A on User { name } query Q { user { ...A ...B } } fragment B on User { email }",
+  ],
+  ["two queries", "query A { user { name } } query B { transcripts { id } }"],
+  ["the word mutation in a comment", "# mutation\nquery Q { user { name } }"],
+  ["the word subscription in a comment", "query Q { user { name } } # subscription { x }"],
+  ["the word mutation in a double-quoted argument", 'query Q { transcripts(title: "mutation") { id } }'],
+  ["a mutation-looking string argument", 'query Q { transcripts(title: "mutation { deleteTranscript }") { id } }'],
+  ["fields named mutation and subscription", "query Q { mutation { id } subscription { id } }"],
+  ["a query named mutation", "query mutation { user { name } }"],
+  ["a query named subscription", "query subscription { user { name } }"],
+];
+
+describe("fireflies execute_graphql_query accepts read-only documents", () => {
+  it.each(accepted)("%s: sent once and unchanged", async (_name, query) => {
+    const result = await run({ query });
+
+    expect(globalFetch).not.toHaveBeenCalled();
+    expect(sent).toHaveLength(1);
+    expect(sent[0]!.url).toBe("https://api.fireflies.ai/graphql");
+    expect(sent[0]!.body.query).toBe(query);
+    expect(result).toMatchObject({ data: { ok: true } });
+  });
+
+  it("forwards operationName and variables", async () => {
+    await run({
+      query: "query A { user { name } } query B { transcripts { id } }",
+      operationName: "B",
+      variables: { limit: 3 },
+    });
+
+    expect(sent).toHaveLength(1);
+    expect(sent[0]!.body).toEqual({
+      query: "query A { user { name } } query B { transcripts { id } }",
+      operationName: "B",
+      variables: { limit: 3 },
+    });
+  });
+
+  it("sends neither operationName nor variables when none were given", async () => {
+    await run({ query: "{ user { name } }" });
+
+    expect(sent[0]!.body).toEqual({ query: "{ user { name } }" });
+  });
+});
+
+const rejected: [name: string, input: Record<string, unknown>][] = [
+  ["anonymous mutation", { query: 'mutation { deleteTranscript(id: "1") { id } }' }],
+  [
+    "named mutation selected by operationName",
+    { query: 'mutation Drop { deleteTranscript(id: "1") { id } }', operationName: "Drop" },
+  ],
+  ["subscription", { query: "subscription { x }" }],
+  ["query then mutation", { query: 'query Q { user { name } } mutation M { deleteTranscript(id: "1") { id } }' }],
+  ["mutation then query", { query: 'mutation M { deleteTranscript(id: "1") { id } } query Q { user { name } }' }],
+  [
+    "query then mutation with operationName naming the query",
+    { query: 'query Q { user { name } } mutation M { deleteTranscript(id: "1") { id } }', operationName: "Q" },
+  ],
+  [
+    "mutation then query with operationName naming the query",
+    { query: 'mutation M { deleteTranscript(id: "1") { id } } query Q { user { name } }', operationName: "Q" },
+  ],
+  ["query then subscription", { query: "query Q { user { name } } subscription S { x }" }],
+  ["subscription then query", { query: "subscription S { x } query Q { user { name } }" }],
+  [
+    "fragment, query and mutation",
+    { query: 'fragment F on User { name } query Q { user { ...F } } mutation { deleteTranscript(id: "1") { id } }' },
+  ],
+  ["syntax error: unbalanced brace", { query: "query Q { user { name }" }],
+  ["syntax error: not a document", { query: "this is not graphql" }],
+  ["unterminated ordinary string", { query: 'query Q { transcripts(title: "abc) { id } }' }],
+  ["fragment-only document", { query: "fragment F on User { name }" }],
+  ["comment-only input", { query: "# just a comment" }],
+  ["comment-only input over several lines", { query: "# one\n# two\n" }],
+  ["empty input", { query: "" }],
+  ["whitespace-only input", { query: "  \n\t  " }],
+];
+
+describe("fireflies execute_graphql_query rejects anything that is not all queries", () => {
+  it.each(rejected)("%s: 400 and no request", async (_name, input) => {
+    await expect(run(input)).rejects.toMatchObject({ status: 400 });
+
+    expect(sent).toHaveLength(0);
+    expect(globalFetch).not.toHaveBeenCalled();
+  });
+
+  it.each(rejected.filter(([, input]) => String(input.query).trim() !== ""))(
+    "%s: uses the read-only message",
+    async (_name, input) => {
+      await expect(run(input)).rejects.toMatchObject({ status: 400, message: rejectionMessage });
+    },
+  );
+});
+
+describe("fireflies execute_graphql_query label", () => {
+  it("is read in the action list and in the provider definition", () => {
+    const fromList = firefliesActions.find((action) => action.id === "fireflies.execute_graphql_query");
+    const fromProvider = provider.actions.find((action) => action.id === "fireflies.execute_graphql_query");
+
+    expect(fromList?.operationType).toBe("read");
+    expect(fromProvider?.operationType).toBe("read");
+  });
+
+  it("keeps delete_transcript destructive", () => {
+    const fromList = firefliesActions.find((action) => action.id === "fireflies.delete_transcript");
+    const fromProvider = provider.actions.find((action) => action.id === "fireflies.delete_transcript");
+
+    expect(fromList?.operationType).toBe("destructive");
+    expect(fromProvider?.operationType).toBe("destructive");
+  });
+});
