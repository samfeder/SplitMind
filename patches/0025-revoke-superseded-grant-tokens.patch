diff --git a/src/server/cloudflare/mcp-oauth-grant-flow.test.ts b/src/server/cloudflare/mcp-oauth-grant-flow.test.ts
index 38c8ae98..2988babc 100644
--- a/src/server/cloudflare/mcp-oauth-grant-flow.test.ts
+++ b/src/server/cloudflare/mcp-oauth-grant-flow.test.ts
@@ -5,6 +5,7 @@
 import type { AssetsBinding, KVNamespaceBinding } from "./cloudflare-bindings.ts";
 import type { CloudflareEnv } from "./cloudflare-env.ts";
 
+import { createHash } from "node:crypto";
 import { afterEach, describe, expect, it, vi } from "vitest";
 import worker from "../cloudflare.ts";
 import { SqliteD1Database } from "../storage/d1/test-database.ts";
@@ -514,3 +515,438 @@ describe("the consent page's single form carries every field the approval needs
     expect(new URL(response.headers.get("location") ?? "").searchParams.get("error")).toBe("access_denied");
   });
 });
+
+// ---------------------------------------------------------------------------------------------------------------
+// Patch 0025 (#131): a repeated approve must not leave a second live runtime token.
+//
+// The library's completeAuthorization deletes the administrator's earlier KV grants for the same client (and the same
+// redirect URI for a CIMD client), but not the D1 backing token each one carried. The expected values here are
+// independent: live tokens are read straight from the D1 table, and the grants from the OAuth KV's own keys.
+// ---------------------------------------------------------------------------------------------------------------
+
+const verifier = "v".repeat(64);
+const challenge = createHash("sha256").update(verifier).digest("base64url");
+
+interface FlowOptions {
+  decision?: "approve" | "deny";
+  token?: string | null;
+  fields?: Record<string, string>;
+  redirectUri?: string;
+}
+
+/** One consent POST. The same arguments give the same authorize URL and the same form, as a resubmit would. */
+function consent(testEnv: CloudflareEnv, clientId: string, options: FlowOptions = {}): Promise<Response> {
+  const query = new URLSearchParams({
+    response_type: "code",
+    client_id: clientId,
+    redirect_uri: options.redirectUri ?? claudeCallback,
+    scope: "mcp:access offline_access",
+    resource: `${origin}/mcp`,
+    state: "resubmit-state",
+    code_challenge: challenge,
+    code_challenge_method: "S256",
+  });
+  const form = new URLSearchParams({ decision: options.decision ?? "approve", access: "read", ...options.fields });
+  const token = options.token === undefined ? adminToken : options.token;
+  if (token !== null) form.set("admin_token", token);
+  return worker.fetch(
+    new Request(`${origin}/oauth/mcp/authorize?${query}`, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded", origin },
+      body: form,
+    }),
+    testEnv,
+    context(),
+  );
+}
+
+async function register(testEnv: CloudflareEnv, name = "Resubmit client"): Promise<string> {
+  const response = await worker.fetch(
+    new Request(`${origin}/oauth/mcp/register`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        client_name: name,
+        redirect_uris: [claudeCallback],
+        grant_types: ["authorization_code", "refresh_token"],
+        response_types: ["code"],
+        token_endpoint_auth_method: "none",
+      }),
+    }),
+    testEnv,
+    context(),
+  );
+  expect(response.status).toBe(201);
+  return (await response.json()).client_id;
+}
+
+function codeOf(response: Response): string {
+  expect(response.status).toBe(302);
+  const code = new URL(response.headers.get("location") ?? "").searchParams.get("code");
+  expect(code).toBeTruthy();
+  return code!;
+}
+
+async function exchange(testEnv: CloudflareEnv, clientId: string, code: string): Promise<Response> {
+  return worker.fetch(
+    new Request(`${origin}/oauth/mcp/token`, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams({
+        grant_type: "authorization_code",
+        code,
+        client_id: clientId,
+        redirect_uri: claudeCallback,
+        code_verifier: verifier,
+        resource: `${origin}/mcp`,
+      }),
+    }),
+    testEnv,
+    context(),
+  );
+}
+
+interface LiveRow {
+  id: string;
+  name: string;
+}
+
+/** The OAuth backing tokens that exist and are not revoked, read from the table itself. */
+async function liveOauthRows(testEnv: CloudflareEnv): Promise<LiveRow[]> {
+  const { results } = await testEnv.DB.prepare(
+    "select id, name from runtime_tokens where revoked_at is null and name like 'MCP OAuth%'",
+  ).all<LiveRow>();
+  return results;
+}
+
+async function liveIds(testEnv: CloudflareEnv): Promise<Set<string>> {
+  return new Set((await liveOauthRows(testEnv)).map((row) => row.id));
+}
+
+/** Backing token ids of the administrator's grants that are in the KV right now. */
+async function grantBackedIds(testEnv: CloudflareEnv): Promise<Set<string>> {
+  const kv = testEnv.OAUTH_KV as KVNamespaceBinding;
+  const ids = new Set<string>();
+  let cursor: string | undefined;
+  do {
+    const page = (await kv.list({ prefix: "grant:administrator:", cursor } as { prefix: string })) as {
+      keys: { name: string }[];
+      list_complete: boolean;
+      cursor?: string;
+    };
+    for (const key of page.keys) {
+      if (key.name.slice("grant:administrator:".length).includes(":")) continue;
+      const grant = await kv.get(key.name, { type: "json" });
+      if (grant?.metadata?.runtimeTokenId) ids.add(grant.metadata.runtimeTokenId);
+    }
+    cursor = page.list_complete ? undefined : page.cursor;
+  } while (cursor);
+  return ids;
+}
+
+function difference(a: Set<string>, b: Set<string>): string[] {
+  return [...a].filter((id) => !b.has(id));
+}
+
+/** Every structured log object with this event, from whichever console method the code uses. */
+function captureEvents(): { events: (name: string) => Record<string, unknown>[]; text: () => string } {
+  const calls: unknown[][] = [];
+  for (const method of ["log", "info", "warn", "error", "debug"] as const) {
+    vi.spyOn(console, method).mockImplementation((...args: unknown[]) => {
+      calls.push(args);
+    });
+  }
+  return {
+    events: (name) =>
+      calls.flatMap((args) =>
+        args.filter(
+          (arg): arg is Record<string, unknown> =>
+            typeof arg === "object" && arg !== null && (arg as { event?: unknown }).event === name,
+        ),
+      ),
+    text: () => JSON.stringify(calls, (_key, value) => (value instanceof Error ? value.message : value)),
+  };
+}
+
+describe("a repeated approve leaves no second live runtime token (#131)", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("A1: approving twice with the identical URL and form leaves one live token, and the second code exchanges", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    const logs = captureEvents();
+
+    const first = await consent(env, clientId);
+    codeOf(first);
+    const afterFirst = await liveIds(env);
+    const firstToken = difference(afterFirst, before);
+    expect(firstToken).toHaveLength(1);
+
+    const secondCode = codeOf(await consent(env, clientId));
+
+    const created = difference(await liveIds(env), before);
+    expect(created).toHaveLength(1);
+    expect(created).not.toContain(firstToken[0]);
+    // The first approve's token is gone from the live set, not merely hidden.
+    expect([...(await liveIds(env))]).not.toContain(firstToken[0]);
+    // Every live backing token is the one a surviving grant carries: nothing is orphaned.
+    expect(difference(new Set(difference(await liveIds(env), before)), await grantBackedIds(env))).toEqual([]);
+
+    const exchanged = await exchange(env, clientId, secondCode);
+    expect(exchanged.status).toBe(200);
+    expect((await exchanged.json()).access_token).toBeTruthy();
+
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked")).toEqual([
+      expect.objectContaining({ count: 1 }),
+    ]);
+    expect(logs.events("mcp_oauth_superseded_token_revoke_failed")).toEqual([]);
+  });
+
+  it("A1b: a third approve revokes only the second's token, and the count logged is 1 each time", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    const logs = captureEvents();
+
+    codeOf(await consent(env, clientId));
+    codeOf(await consent(env, clientId));
+    const afterSecond = await liveIds(env);
+    const secondToken = difference(afterSecond, before);
+    expect(secondToken).toHaveLength(1);
+    codeOf(await consent(env, clientId));
+
+    const created = difference(await liveIds(env), before);
+    expect(created).toHaveLength(1);
+    expect(created).not.toContain(secondToken[0]);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked").map((event) => event.count)).toEqual([1, 1]);
+  });
+
+  it("A1c: the first approve for a client revokes nothing and logs no revocation", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    const logs = captureEvents();
+
+    codeOf(await consent(env, clientId));
+
+    expect(difference(await liveIds(env), before)).toHaveLength(1);
+    // Nothing that was live before went away.
+    expect(difference(before, await liveIds(env))).toEqual([]);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked").every((event) => event.count === 0)).toBe(true);
+    expect(logs.events("mcp_oauth_superseded_token_revoke_failed")).toEqual([]);
+  });
+
+  it("A2: approving client A and then client B leaves both tokens live", async () => {
+    const before = await liveIds(env);
+    const clientA = await register(env, "Client A");
+    const clientB = await register(env, "Client B");
+
+    const codeA = codeOf(await consent(env, clientA));
+    const afterA = await liveIds(env);
+    const tokenA = difference(afterA, before);
+    expect(tokenA).toHaveLength(1);
+    const codeB = codeOf(await consent(env, clientB));
+
+    const live = await liveIds(env);
+    const created = difference(live, before);
+    expect(created).toHaveLength(2);
+    expect(created).toContain(tokenA[0]);
+    expect(difference(new Set(created), await grantBackedIds(env))).toEqual([]);
+    expect((await exchange(env, clientA, codeA)).status).toBe(200);
+    expect((await exchange(env, clientB, codeB)).status).toBe(200);
+  });
+
+  it("A2b: re-approving client A leaves client B's token alone", async () => {
+    const before = await liveIds(env);
+    const clientA = await register(env, "Client A2");
+    const clientB = await register(env, "Client B2");
+    codeOf(await consent(env, clientA));
+    codeOf(await consent(env, clientB));
+    const bothLive = difference(await liveIds(env), before);
+    expect(bothLive).toHaveLength(2);
+
+    codeOf(await consent(env, clientA));
+
+    const created = difference(await liveIds(env), before);
+    expect(created).toHaveLength(2);
+    // Of the two earlier tokens exactly one survives (B's); the other (A's first) is revoked.
+    expect(bothLive.filter((id) => created.includes(id))).toHaveLength(1);
+    expect(difference(new Set(difference(await liveIds(env), before)), await grantBackedIds(env))).toEqual([]);
+  });
+
+  it("A3: when revoking the superseded token throws, the second approve still redirects with a code and its token is valid", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    codeOf(await consent(env, clientId));
+    const supersededToken = difference(await liveIds(env), before);
+    expect(supersededToken).toHaveLength(1);
+    const supersededGrant = [...(await grantIdsByToken(env)).entries()].find(
+      ([, tokenId]) => tokenId === supersededToken[0],
+    )?.[0];
+    expect(supersededGrant).toBeTruthy();
+
+    const attempts: unknown[][] = [];
+    const faulty = failingDeletes(env, supersededToken[0]!, attempts);
+    const logs = captureEvents();
+
+    const second = await consent(faulty, clientId);
+
+    const code = codeOf(second);
+    // The revoke was attempted for exactly the superseded token, and failed.
+    expect(attempts).toEqual([[supersededToken[0]]]);
+    const created = difference(await liveIds(env), before);
+    expect(created).toHaveLength(2);
+    const newToken = created.find((id) => id !== supersededToken[0])!;
+    expect(newToken).toBeTruthy();
+    expect(await grantBackedIds(env)).toContain(newToken);
+    expect((await exchange(env, clientId, code)).status).toBe(200);
+
+    const failed = logs.events("mcp_oauth_superseded_token_revoke_failed");
+    expect(failed).toHaveLength(1);
+    expect(JSON.stringify(failed[0])).toContain(supersededGrant!);
+    // No token values: not the runtime token prefix, and not the administrator token.
+    expect(logs.text()).not.toMatch(/oct_[A-Za-z0-9_-]{10,}/);
+    expect(logs.text()).not.toContain(adminToken);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked").every((event) => event.count === 0)).toBe(true);
+  });
+
+  it("A4: a deny POST after an approve leaves the first token live", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    codeOf(await consent(env, clientId));
+    const first = difference(await liveIds(env), before);
+    expect(first).toHaveLength(1);
+
+    const denied = await consent(env, clientId, { decision: "deny" });
+
+    expect(denied.status).toBe(302);
+    expect(new URL(denied.headers.get("location") ?? "").searchParams.get("error")).toBe("access_denied");
+    expect(difference(await liveIds(env), before)).toEqual(first);
+    expect(await grantBackedIds(env)).toContain(first[0]);
+  });
+
+  it("A5: a POST without the administrator token after an approve leaves the first token live (401)", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    codeOf(await consent(env, clientId));
+    const first = difference(await liveIds(env), before);
+    expect(first).toHaveLength(1);
+
+    expect((await consent(env, clientId, { token: null })).status).toBe(401);
+    expect((await consent(env, clientId, { token: "wrong" })).status).toBe(401);
+
+    expect(difference(await liveIds(env), before)).toEqual(first);
+    expect(await grantBackedIds(env)).toContain(first[0]);
+  });
+
+  it("A5b: a refused scope (unknown account) after an approve leaves the first token live and revokes nothing", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    codeOf(await consent(env, clientId));
+    const first = difference(await liveIds(env), before);
+    const logs = captureEvents();
+
+    const refused = await consent(env, clientId, { fields: { accounts: "nonesuch" } });
+
+    expect(refused.status).toBe(400);
+    expect(difference(await liveIds(env), before)).toEqual(first);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked")).toEqual([]);
+  });
+
+  it("A6: a grant listing that spans several KV pages is followed to the end, and unrelated grants keep their tokens", async () => {
+    const pagedEnv: CloudflareEnv = { ...env, OAUTH_KV: new PagingKV(3), DB: new SqliteD1Database() };
+    const target = await register(pagedEnv, "Target client");
+    codeOf(await consent(pagedEnv, target));
+    const first = await liveIds(pagedEnv);
+    expect(first.size).toBe(1);
+    const others: string[] = [];
+    for (let index = 0; index < 8; index++) {
+      codeOf(await consent(pagedEnv, await register(pagedEnv, `Other client ${index}`)));
+    }
+    const beforeRepeat = await liveIds(pagedEnv);
+    expect(beforeRepeat.size).toBe(9);
+    others.push(...difference(beforeRepeat, first));
+
+    codeOf(await consent(pagedEnv, target));
+
+    const live = await liveIds(pagedEnv);
+    expect(live.size).toBe(9);
+    expect(difference(first, live)).toEqual([...first]);
+    for (const id of others) expect(live).toContain(id);
+    expect(difference(live, await grantBackedIds(pagedEnv))).toEqual([]);
+  });
+});
+
+/** The grants in the KV, as grantId -> backing token id. */
+async function grantIdsByToken(testEnv: CloudflareEnv): Promise<Map<string, string>> {
+  const kv = testEnv.OAUTH_KV as KVNamespaceBinding;
+  const map = new Map<string, string>();
+  const page = (await kv.list({ prefix: "grant:administrator:" })) as { keys: { name: string }[] };
+  for (const key of page.keys) {
+    const rest = key.name.slice("grant:administrator:".length);
+    if (rest.includes(":")) continue;
+    const grant = await kv.get(key.name, { type: "json" });
+    if (grant?.metadata?.runtimeTokenId) map.set(rest, grant.metadata.runtimeTokenId);
+  }
+  return map;
+}
+
+/**
+ * The environment with a D1 whose `delete from runtime_tokens where id = ?` fails for one id, which is how a
+ * revoke fails from outside. Each attempt's bound values are recorded. Every other statement is the real one.
+ */
+function failingDeletes(base: CloudflareEnv, failId: string, attempts: unknown[][]): CloudflareEnv {
+  const db = base.DB;
+  const wrapped = new Proxy(db, {
+    get(target, property) {
+      if (property !== "prepare") {
+        const value = Reflect.get(target, property) as unknown;
+        return typeof value === "function" ? value.bind(target) : value;
+      }
+      return (query: string) => {
+        const real = target.prepare(query);
+        if (!/^\s*delete\s+from\s+runtime_tokens\b/i.test(query)) return real;
+        const statement = (values: unknown[]) => ({
+          bind: (...next: unknown[]) => statement(next),
+          async run() {
+            attempts.push(values);
+            if (values.includes(failId)) throw new Error("simulated D1 failure while revoking");
+            return real.bind(...values).run();
+          },
+        });
+        return statement([]);
+      };
+    },
+  });
+  return { ...base, DB: wrapped as CloudflareEnv["DB"] };
+}
+
+/** A KV that answers lists a few keys at a time, newest-written first, with cursors, as the real one pages. */
+class PagingKV extends MemoryKV {
+  private readonly order: string[] = [];
+  private readonly pageSize: number;
+  constructor(pageSize: number) {
+    super();
+    this.pageSize = pageSize;
+  }
+  override async put(key: string, value: unknown): Promise<void> {
+    if (!this.order.includes(key)) this.order.unshift(key);
+    return super.put(key, value);
+  }
+  override async delete(key: string): Promise<void> {
+    const index = this.order.indexOf(key);
+    if (index >= 0) this.order.splice(index, 1);
+    return super.delete(key);
+  }
+  // oxlint-disable-next-line typescript/no-explicit-any -- the KV list signature carries a cursor and a limit.
+  override async list(options?: any): Promise<any> {
+    const prefix: string = options?.prefix ?? "";
+    const matching = this.order.filter((key) => key.startsWith(prefix));
+    const start = options?.cursor ? Number(options.cursor) : 0;
+    const keys = matching.slice(start, start + this.pageSize).map((name) => ({ name }));
+    const complete = start + this.pageSize >= matching.length;
+    return complete
+      ? { keys, list_complete: true }
+      : { keys, list_complete: false, cursor: String(start + this.pageSize) };
+  }
+}
