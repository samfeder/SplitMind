+type OAuthApi = ReturnType<typeof getOAuthApi>;
+type AdministratorGrant = { id: string; runtimeTokenId: unknown };
+
+/** Every administrator grant, following the cursor to the end. */
+async function listAdministratorGrants(oauth: OAuthApi): Promise<AdministratorGrant[]> {
+  const grants: AdministratorGrant[] = [];
+  let cursor: string | undefined;
+  do {
+    const page = await oauth.listUserGrants("administrator", cursor ? { cursor } : undefined);
+    for (const grant of page.items) grants.push({ id: grant.id, runtimeTokenId: grant.metadata?.runtimeTokenId });
+    cursor = page.cursor;
+  } while (cursor);
+  return grants;
+}
+
+/** Null when listing fails: the consent still completes, and nothing is revoked afterwards. */
+async function listAdministratorGrantsBestEffort(oauth: OAuthApi): Promise<AdministratorGrant[] | null> {
+  try {
+    return await listAdministratorGrants(oauth);
+  } catch {
+    console.warn({ event: "mcp_oauth_superseded_token_revoke_failed", stage: "list_before" });
+    return null;
+  }
+}
+
+/** Grants present before and absent after the library's own supersede step lose their backing token. Best effort. */
+async function revokeSupersededTokens(
+  oauth: OAuthApi,
+  tokens: ReturnType<typeof runtimeTokens>,
+  before: AdministratorGrant[] | null,
+): Promise<void> {
+  if (!before) return;
+  let after: AdministratorGrant[];
+  try {
+    after = await listAdministratorGrants(oauth);
+  } catch {
+    console.warn({ event: "mcp_oauth_superseded_token_revoke_failed", stage: "list_after" });
+    return;
+  }
+  const remaining = new Set(after.map((grant) => grant.id));
+  let count = 0;
+  for (const grant of before) {
+    if (remaining.has(grant.id) || typeof grant.runtimeTokenId !== "string") continue;
+    try {
+      await tokens.revokeToken(grant.runtimeTokenId);
+      count += 1;
+    } catch {
+      console.warn({ event: "mcp_oauth_superseded_token_revoke_failed", grantId: grant.id });
+    }
+  }
+  if (count > 0) console.info({ event: "mcp_oauth_superseded_tokens_revoked", count });
+}
+
