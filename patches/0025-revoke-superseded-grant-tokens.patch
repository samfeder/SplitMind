 }
 
-type OAuthApi = ReturnType<typeof getOAuthApi>;
-type AdministratorGrant = { id: string; runtimeTokenId: unknown };
+type AdministratorGrant = { key: string; runtimeTokenId: unknown };
+type GrantKey = { name: string; metadata?: unknown };
 
-/** Every administrator grant, following the cursor to the end. */
-async function listAdministratorGrants(oauth: OAuthApi): Promise<AdministratorGrant[]> {
-  const grants: AdministratorGrant[] = [];
+const administratorGrantPrefix = "grant:administrator:";
+
+function errorName(error: unknown): string {
+  return error instanceof Error ? error.name : "UnknownError";
+}
+
+/** Every administrator grant key and its key metadata, following the cursor to the end. Keys only: no values are read. */
+async function listAdministratorGrantKeys(kv: KVNamespace): Promise<GrantKey[]> {
+  const keys: GrantKey[] = [];
   let cursor: string | undefined;
   do {
-    const page = await oauth.listUserGrants("administrator", cursor ? { cursor } : undefined);
-    for (const grant of page.items) grants.push({ id: grant.id, runtimeTokenId: grant.metadata?.runtimeTokenId });
-    cursor = page.cursor;
+    const page = await kv.list({ prefix: administratorGrantPrefix, ...(cursor ? { cursor } : {}) });
+    for (const key of page.keys) keys.push({ name: key.name, metadata: key.metadata });
+    cursor = page.list_complete ? undefined : page.cursor;
   } while (cursor);
+  return keys;
+}
+
+/**
+ * The grants of one client, with their backing token ids. Only matching grants are read: a key whose metadata names
+ * another client is skipped, and a key without metadata (written by an older library) is read and compared.
+ */
+async function readClientGrants(kv: KVNamespace, keys: GrantKey[], clientId: string): Promise<AdministratorGrant[]> {
+  const grants: AdministratorGrant[] = [];
+  for (const key of keys) {
+    const keyClientId = (key.metadata as { clientId?: unknown } | null | undefined)?.clientId;
+    if (typeof keyClientId === "string" && keyClientId !== clientId) continue;
+    const record = await kv.get<{ clientId?: unknown; metadata?: { runtimeTokenId?: unknown } }>(key.name, {
+      type: "json",
+    });
+    if (!record || record.clientId !== clientId) continue;
+    grants.push({ key: key.name, runtimeTokenId: record.metadata?.runtimeTokenId });
+  }
   return grants;
