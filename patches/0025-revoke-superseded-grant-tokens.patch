+
+// ---------------------------------------------------------------------------------------------------------------
+// Patch 0025 revision (R1-R5): the superseded-token revoke must stay inside the Worker's KV subrequest budget and
+// must only ever touch the approving client's own grants.
+//
+// Key metadata shape, from workers-oauth-provider's grantKeyMetadata(): `{ clientId: string, resource?: string |
+// string[], redirectUri?: string }`, written by every grant put (completeAuthorization and refreshes) and returned
+// on the key by list(). A grant written without it (a pre-1.0 library, or metadata over 1 KiB) carries none.
+// ---------------------------------------------------------------------------------------------------------------
+
+const grantPrefix = "grant:administrator:";
+
+/**
+ * A KV that records what the approve does to it, from `arm()` on:
+ * - every get(), by key;
+ * - which "phase" each grant-prefix list() belongs to. "before" is any list until the new grant is written,
+ *   "after" is any later one, so it is the handler's own post-completeAuthorization listing. (The library's own
+ *   findGrants listing happens before its put, and its revokeGrant lists the token prefix, so neither is "after".)
+ * It can fail the first list of a phase, and hide keys from "after" lists, as a stale list would.
+ */
+class ProbeKV extends MemoryKV {
+  gets: string[] = [];
+  listPhases: ("before" | "after")[] = [];
+  failFirst: { before?: Error; after?: Error } = {};
+  hideAfter = new Set<string>();
+  private armed = false;
+  private grantWritten = false;
+
+  arm(): void {
+    this.gets = [];
+    this.listPhases = [];
+    this.grantWritten = false;
+    this.armed = true;
+  }
+  disarm(): void {
+    this.armed = false;
+  }
+  override async put(key: string, value: unknown, options?: { metadata?: unknown }): Promise<void> {
+    if (this.armed && key.startsWith(grantPrefix)) this.grantWritten = true;
+    return super.put(key, value, options);
+  }
+  // oxlint-disable-next-line typescript/no-explicit-any -- KV's overloads return text, JSON or bytes by option.
+  override async get(key: string, options?: unknown): Promise<any> {
+    if (this.armed) this.gets.push(key);
+    return super.get(key, options);
+  }
+  // oxlint-disable-next-line typescript/no-explicit-any -- the KV list signature carries a cursor and a limit.
+  override async list(options?: any): Promise<any> {
+    const isGrantList = this.armed && typeof options?.prefix === "string" && options.prefix.startsWith("grant:");
+    const phase = this.grantWritten ? "after" : "before";
+    if (isGrantList) {
+      this.listPhases.push(phase);
+      const fault = this.failFirst[phase];
+      if (fault) {
+        this.failFirst[phase] = undefined;
+        throw fault;
+      }
+    }
+    const result = await super.list(options);
+    if (isGrantList && phase === "after" && this.hideAfter.size > 0) {
+      return { ...result, keys: result.keys.filter((key: { name: string }) => !this.hideAfter.has(key.name)) };
+    }
+    return result;
+  }
+}
+
+function envWith(kv: MemoryKV): CloudflareEnv {
+  return { ...env, OAUTH_KV: kv, DB: new SqliteD1Database() };
+}
+
+/** Every administrator grant in the KV as key name -> clientId, read from the stored grant records themselves. */
+async function grantClients(kv: MemoryKV): Promise<Map<string, string>> {
+  const result = new Map<string, string>();
+  const page = await kv.list({ prefix: grantPrefix });
+  for (const key of page.keys) {
+    if (key.name.slice(grantPrefix.length).includes(":")) continue;
+    const grant = await kv.get(key.name, { type: "json" });
+    if (grant) result.set(key.name, grant.clientId);
+  }
+  return result;
+}
+
+async function onlyGrantKeyOf(kv: MemoryKV, clientId: string): Promise<string> {
+  const keys = [...(await grantClients(kv))].filter(([, owner]) => owner === clientId).map(([key]) => key);
+  expect(keys).toHaveLength(1);
+  return keys[0]!;
+}
+
+/** The backing token id a grant key carries. */
+async function tokenOfGrant(kv: MemoryKV, grantKey: string): Promise<string> {
+  const grant = await kv.get(grantKey, { type: "json" });
+  expect(typeof grant?.metadata?.runtimeTokenId).toBe("string");
+  return grant.metadata.runtimeTokenId;
+}
+
+function isLegacyWrite(clients: Set<string>): (key: string, text: string) => boolean {
+  return (key, text) => !(key.startsWith(grantPrefix) && clients.has(JSON.parse(text).clientId));
+}
+
+describe("the superseded-token revoke is cheap in KV reads and only touches the approving client's grants (R1-R5)", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("(a) a KV list that fails only after completeAuthorization still redirects with a code, logs stage list_after, and leaves the old token live", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const clientId = await register(e, "Budget (a)");
+    codeOf(await consent(e, clientId));
+    const old = [...(await liveIds(e))];
+    expect(old).toHaveLength(1);
+    const logs = captureEvents();
+
+    kv.failFirst.after = new Error("simulated KV list failure after completeAuthorization");
+    kv.arm();
+    const response = await consent(e, clientId);
+    kv.disarm();
+
+    const code = codeOf(response);
+    // The fault was really hit: the handler listed grants after the library had written the new one.
+    expect(kv.listPhases).toContain("after");
+    expect(kv.failFirst.after).toBeUndefined();
+    const failed = logs.events("mcp_oauth_superseded_token_revoke_failed");
+    expect(failed).toHaveLength(1);
+    expect(failed[0]).toEqual(expect.objectContaining({ stage: "list_after" }));
+    expect(await liveIds(e)).toContain(old[0]);
+    expect((await liveIds(e)).size).toBe(2);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked").every((event) => event.count === 0)).toBe(true);
+    expect((await exchange(e, clientId, code)).status).toBe(200);
+  });
+
+  it("(b) a KV list that fails before completeAuthorization still redirects with a code, logs stage list_before, and the new token is valid", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const clientId = await register(e, "Budget (b)");
+    codeOf(await consent(e, clientId));
+    const logs = captureEvents();
+
+    // Only the handler's own first listing fails; the library's later one must still succeed.
+    kv.failFirst.before = new Error("simulated KV list failure before completeAuthorization");
+    kv.arm();
+    const response = await consent(e, clientId);
+    kv.disarm();
+
+    const code = codeOf(response);
+    expect(kv.failFirst.before).toBeUndefined();
+    const failed = logs.events("mcp_oauth_superseded_token_revoke_failed");
+    expect(failed).toHaveLength(1);
+    expect(failed[0]).toEqual(expect.objectContaining({ stage: "list_before" }));
+    // The new grant exists and its backing token is live.
+    const backed = [...(await grantBackedIds(e))];
+    expect(backed).toHaveLength(1);
+    expect(await liveIds(e)).toContain(backed[0]);
+    const exchanged = await exchange(e, clientId, code);
+    expect(exchanged.status).toBe(200);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked").every((event) => event.count === 0)).toBe(true);
+  });
+
+  it("(c) with 60 other clients' grants and one earlier grant for this client, a re-approve reads none of the others and stays within 15 KV gets", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const target = await register(e, "Budget target");
+    codeOf(await consent(e, target));
+    for (let index = 0; index < 60; index++) {
+      codeOf(await consent(e, await register(e, `Budget other ${index}`)));
+    }
+    const liveBefore = await liveIds(e);
+    expect(liveBefore.size).toBe(61);
+    const clients = await grantClients(kv);
+    expect(clients.size).toBe(61);
+    const otherKeys = new Set([...clients].filter(([, owner]) => owner !== target).map(([key]) => key));
+    expect(otherKeys.size).toBe(60);
+    const targetKey = await onlyGrantKeyOf(kv, target);
+    const targetToken = await tokenOfGrant(kv, targetKey);
+    const otherTokens: string[] = [];
+    for (const key of otherKeys) otherTokens.push(await tokenOfGrant(kv, key));
+
+    kv.arm();
+    const response = await consent(e, target);
+    kv.disarm();
+
+    codeOf(response);
+    // No handler-side read of any other client's grant record.
+    expect(kv.gets.filter((key) => otherKeys.has(key))).toEqual([]);
+    // The whole approve, library included, stays far inside the 1000-operation limit.
+    expect(kv.gets.length).toBeLessThanOrEqual(15);
+    // And the behavior is still right: the old token of this client is gone, every other client's is live.
+    const liveAfter = await liveIds(e);
+    expect(liveAfter.has(targetToken)).toBe(false);
+    for (const id of otherTokens) expect(liveAfter.has(id)).toBe(true);
+    expect(liveAfter.size).toBe(61);
+  }, 120_000);
+
+  it("(d) another client's grant never loses its token, even when the after-listing hides it (a stale list)", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const target = await register(e, "Stale target");
+    const bystander = await register(e, "Stale bystander");
+    codeOf(await consent(e, target));
+    codeOf(await consent(e, bystander));
+    const bystanderKey = await onlyGrantKeyOf(kv, bystander);
+    const bystanderToken = await tokenOfGrant(kv, bystanderKey);
+    const targetToken = await tokenOfGrant(kv, await onlyGrantKeyOf(kv, target));
+    const logs = captureEvents();
+
+    kv.hideAfter.add(bystanderKey);
+    kv.arm();
+    const response = await consent(e, target);
+    kv.disarm();
+
+    codeOf(response);
+    expect(kv.listPhases).toContain("after");
+    const live = await liveIds(e);
+    expect(live.has(bystanderToken)).toBe(true);
+    expect(live.has(targetToken)).toBe(false);
+    expect(live.size).toBe(2);
+    // The bystander's grant itself is untouched in the KV.
+    expect((await grantClients(kv)).get(bystanderKey)).toBe(bystander);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked")).toEqual([expect.objectContaining({ count: 1 })]);
+  });
+
+  it("(d2) the same stale after-list cannot cost a bystander its token when the bystander's grant has no key metadata", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const target = await register(e, "Stale legacy target");
+    const bystander = await register(e, "Stale legacy bystander");
+    const legacy = new Set([bystander]);
+    kv.keepsKeyMetadata = isLegacyWrite(legacy);
+    codeOf(await consent(e, bystander));
+    kv.keepsKeyMetadata = () => true;
+    codeOf(await consent(e, target));
+    const bystanderKey = await onlyGrantKeyOf(kv, bystander);
+    const bystanderToken = await tokenOfGrant(kv, bystanderKey);
+    const targetToken = await tokenOfGrant(kv, await onlyGrantKeyOf(kv, target));
+    expect((await kv.list({ prefix: bystanderKey })).keys[0]).not.toHaveProperty("metadata");
+
+    kv.hideAfter.add(bystanderKey);
+    kv.arm();
+    codeOf(await consent(e, target));
+    kv.disarm();
+
+    const live = await liveIds(e);
+    expect(live.has(bystanderToken)).toBe(true);
+    expect(live.has(targetToken)).toBe(false);
+    expect(live.size).toBe(2);
+  });
+
+  it("(e) this client's earlier grant with no key metadata is still found and its token revoked, other clients' grants (with or without metadata) keep theirs", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const target = await register(e, "Legacy target");
+    const legacyOther = await register(e, "Legacy other");
+    const modernOther = await register(e, "Modern other");
+    kv.keepsKeyMetadata = isLegacyWrite(new Set([target, legacyOther]));
+    codeOf(await consent(e, target));
+    codeOf(await consent(e, legacyOther));
+    kv.keepsKeyMetadata = () => true;
+    codeOf(await consent(e, modernOther));
+
+    // Premise: the key listing really carries no metadata for the two legacy grants, and does for the modern one.
+    const listed = new Map((await kv.list({ prefix: grantPrefix })).keys.map((key) => [key.name, key]));
+    const targetKey = await onlyGrantKeyOf(kv, target);
+    expect(listed.get(targetKey)).not.toHaveProperty("metadata");
+    expect(listed.get(await onlyGrantKeyOf(kv, legacyOther))).not.toHaveProperty("metadata");
+    expect(listed.get(await onlyGrantKeyOf(kv, modernOther))).toHaveProperty("metadata", expect.objectContaining({ clientId: modernOther }));
+
+    const targetToken = await tokenOfGrant(kv, targetKey);
+    const legacyOtherToken = await tokenOfGrant(kv, await onlyGrantKeyOf(kv, legacyOther));
+    const modernOtherToken = await tokenOfGrant(kv, await onlyGrantKeyOf(kv, modernOther));
+    const logs = captureEvents();
+
+    const response = await consent(e, target);
+
+    const code = codeOf(response);
+    const live = await liveIds(e);
+    expect(live.has(targetToken)).toBe(false);
+    expect(live.has(legacyOtherToken)).toBe(true);
+    expect(live.has(modernOtherToken)).toBe(true);
+    expect(live.size).toBe(3);
+    expect(difference(live, await grantBackedIds(e))).toEqual([]);
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked")).toEqual([expect.objectContaining({ count: 1 })]);
+    expect(logs.events("mcp_oauth_superseded_token_revoke_failed")).toEqual([]);
+    expect((await exchange(e, target, code)).status).toBe(200);
+  });
+
+  // R3 and R4 are not in R5's list, but they are behavior this revision pins, so they are tested here too.
+
+  it("R3: a superseded token that was already gone is not counted as revoked", async () => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const clientId = await register(e, "Already gone");
+    codeOf(await consent(e, clientId));
+    const old = [...(await liveIds(e))];
+    expect(old).toHaveLength(1);
+    // Remove the backing row behind the grant's back, so revokeToken finds nothing to delete.
+    await e.DB.prepare("delete from runtime_tokens where id = ?").bind(old[0]).run();
+    const logs = captureEvents();
+
+    codeOf(await consent(e, clientId));
+
+    expect(logs.events("mcp_oauth_superseded_tokens_revoked").filter((event) => (event.count as number) > 0)).toEqual([]);
+    expect(logs.events("mcp_oauth_superseded_token_revoke_failed")).toEqual([]);
+    expect((await liveIds(e)).size).toBe(1);
+  });
+
+  it.each([
+    ["list_before", "before"],
+    ["list_after", "after"],
+  ] as const)("R4: a %s failure logs the error's name and never its message", async (stage, phase) => {
+    const kv = new ProbeKV();
+    const e = envWith(kv);
+    const clientId = await register(e, `Error name ${stage}`);
+    codeOf(await consent(e, clientId));
+    const logs = captureEvents();
+
+    kv.failFirst[phase] = new RangeError("kv-detail-that-must-not-be-logged-31337");
+    kv.arm();
+    codeOf(await consent(e, clientId));
+    kv.disarm();
+
+    const failed = logs.events("mcp_oauth_superseded_token_revoke_failed");
+    expect(failed).toEqual([expect.objectContaining({ stage, errorName: "RangeError" })]);
+    expect(logs.text()).not.toContain("kv-detail-that-must-not-be-logged-31337");
+  });
+
+  it("R4: a revoke failure logs the grant id and the error's name, never its message or a token value", async () => {
+    const clientId = await registerClient();
+    const before = await liveIds(env);
+    codeOf(await consent(env, clientId));
+    const superseded = difference(await liveIds(env), before);
+    expect(superseded).toHaveLength(1);
+    const attempts: unknown[][] = [];
+    const logs = captureEvents();
+
+    codeOf(await consent(failingDeletes(env, superseded[0]!, attempts), clientId));
+
+    const failed = logs.events("mcp_oauth_superseded_token_revoke_failed");
+    expect(failed).toEqual([expect.objectContaining({ grantId: expect.any(String), errorName: "Error" })]);
+    expect(logs.text()).not.toContain("simulated D1 failure while revoking");
+    expect(logs.text()).not.toMatch(/oct_[A-Za-z0-9_-]{10,}/);
+  });
+});
