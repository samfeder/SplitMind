+// Test doubles for the MCP OAuth registration counter (SplitMind #78, patch 0006).
+//
+// PUBLIC INTERFACE OF McpOAuthAnonymousWriteBudget THAT THESE TESTS PIN (the implementer must match it):
+//   - Exported from src/server/cloudflare.ts as `McpOAuthAnonymousWriteBudget`.
+//   - Plain class, no base class and no RPC: `new McpOAuthAnonymousWriteBudget(state, env, now?)`.
+//       state: DurableObjectState. Only `state.storage` (key/value API: get / put / delete / list / transaction) and
+//              `state.blockConcurrencyWhile` are used, never `storage.sql` or `deleteAll`.
+//       env:   the Worker env (the tests pass `{}`).
+//       now:   optional `() => number` clock in epoch milliseconds, default `Date.now`. The tests inject it.
+//   - `fetch(request: Request): Promise<Response>`. The Worker calls it through the namespace stub.
+//       POST, any path, JSON body `{ ip: string, maxPerDay: number, maxPerIpPerDay: number }`.
+//       200 with JSON `{ ok: true }` when a slot was taken, `{ ok: false }` when either limit is reached (nothing taken).
+//       A malformed body (bad JSON, missing or mistyped field) gets status 400 and takes nothing.
+//   - The Worker resolves the single instance with `namespace.get(namespace.idFromName("global"))`.
+//   - The limits travel in each call (the Worker reads the env vars and applies the defaults 100 and 20), so the
+//     counter stores only counts and the current UTC day.
+import { McpOAuthAnonymousWriteBudget } from "../cloudflare.ts";
+
+/** In-memory stand-in for the key/value API of a Durable Object's `ctx.storage`. Yields like a real storage call. */
+export class FakeDurableStorage {
+  readonly data: Map<string, unknown> = new Map<string, unknown>();
+  /** How many put or delete calls ran, so a test can tell whether an operation wrote. */
+  writes = 0;
+  private transactionTail: Promise<unknown> = Promise.resolve();
+
+  async get(keyOrKeys: string | string[]): Promise<unknown> {
+    await Promise.resolve();
+    if (Array.isArray(keyOrKeys)) {
+      return new Map(
+        keyOrKeys.filter((key) => this.data.has(key)).map((key) => [key, structuredClone(this.data.get(key))]),
+      );
+    }
+    return this.data.has(keyOrKeys) ? structuredClone(this.data.get(keyOrKeys)) : undefined;
+  }
+
+  async put(keyOrEntries: string | Record<string, unknown>, value?: unknown): Promise<void> {
+    await Promise.resolve();
+    this.writes++;
+    if (typeof keyOrEntries === "string") {
+      this.data.set(keyOrEntries, structuredClone(value));
+      return;
+    }
+    for (const [key, entry] of Object.entries(keyOrEntries)) this.data.set(key, structuredClone(entry));
+  }
+
+  async delete(keyOrKeys: string | string[]): Promise<boolean | number> {
+    await Promise.resolve();
+    this.writes++;
+    if (Array.isArray(keyOrKeys)) return keyOrKeys.filter((key) => this.data.delete(key)).length;
+    return this.data.delete(keyOrKeys);
+  }
+
+  async list(options?: { prefix?: string }): Promise<Map<string, unknown>> {
+    await Promise.resolve();
+    const prefix = options?.prefix ?? "";
+    return new Map(
+      [...this.data.entries()]
+        .filter(([key]) => key.startsWith(prefix))
+        .map(([key, value]) => [key, structuredClone(value)]),
+    );
+  }
+
+  /** Transactions run one at a time, which is the outcome of a real transaction's conflict retry. */
+  async transaction<T>(closure: (txn: FakeDurableStorage) => Promise<T>): Promise<T> {
+    const run = this.transactionTail.then(() => closure(this));
+    this.transactionTail = run.catch(() => undefined);
+    return run;
+  }
+
+  /** Everything stored, in a stable order: two storages with the same snapshot hold the same state. */
+  snapshot(): string {
+    return JSON.stringify([...this.data.entries()].sort(([a], [b]) => (a < b ? -1 : 1)));
+  }
+}
+
+/** A settable wall clock, passed to the counter as its `now`. */
+export class FakeClock {
+  time: number;
+  constructor(time: number) {
+    this.time = time;
+  }
+  readonly now: () => number = () => this.time;
+}
+
+export interface FakeDurableObjectState {
+  storage: FakeDurableStorage;
+  id: { toString: () => string };
+  blockConcurrencyWhile<T>(closure: () => Promise<T>): Promise<T>;
+  waitUntil(): void;
+}
+
+export function fakeDurableObjectState(storage: FakeDurableStorage): FakeDurableObjectState {
+  // No input gate is emulated: plain storage calls from concurrent fetches interleave at every await. A counter has to
+  // serialize its read-modify-write itself, with storage.transaction or blockConcurrencyWhile (both honoured here).
+  let blockTail: Promise<unknown> = Promise.resolve();
+  return {
+    storage,
+    id: { toString: () => "global" },
+    blockConcurrencyWhile<T>(closure: () => Promise<T>): Promise<T> {
+      const run = blockTail.then(closure);
+      blockTail = run.catch(() => undefined);
+      return run;
+    },
+    waitUntil() {},
+  };
+}
+
+export function createCounter(storage: FakeDurableStorage, clock: FakeClock): McpOAuthAnonymousWriteBudget {
+  // oxlint-disable-next-line typescript/no-explicit-any -- the fake covers only the storage surface the counter may use.
+  return new (McpOAuthAnonymousWriteBudget as any)(fakeDurableObjectState(storage), {}, clock.now);
+}
+
+export interface RecordedTake {
+  ip: unknown;
+  maxPerDay: unknown;
+  maxPerIpPerDay: unknown;
+}
+
+/**
+ * A Durable Object namespace whose "global" instance is a real McpOAuthAnonymousWriteBudget over fake storage, so
+ * Worker tests exercise the real counting logic. Calls to the one instance run one at a time, which is what the
+ * platform's input gate gives a counter that only awaits its own storage. A counter that splits one registration
+ * into two calls still interleaves with other requests between them.
+ */
+export interface CounterNamespace {
+  storage: FakeDurableStorage;
+  clock: FakeClock;
+  names: string[];
+  takes: RecordedTake[];
+  idFromName(name: string): { name: string };
+  get(id: { name: string }): { fetch(request: Request): Promise<Response> };
+}
+
+export function createCounterNamespace(
+  clock: FakeClock = new FakeClock(Date.UTC(2026, 10, 10, 12)),
+): CounterNamespace {
+  const storage = new FakeDurableStorage();
+  const instances = new Map<string, McpOAuthAnonymousWriteBudget>();
+  const names: string[] = [];
+  const takes: RecordedTake[] = [];
+  let tail: Promise<unknown> = Promise.resolve();
+  return {
+    storage,
+    clock,
+    /** Every name passed to idFromName. */
+    names,
+    /** The body of every call that reached the counter, in order. */
+    takes,
+    idFromName(name: string) {
+      names.push(name);
+      return { name };
+    },
+    get(id: { name: string }) {
+      if (!instances.has(id.name)) instances.set(id.name, createCounter(storage, clock));
+      const counter = instances.get(id.name)!;
+      return {
+        fetch(request: Request): Promise<Response> {
+          const copy = request.clone();
+          const run = tail.then(async () => {
+            takes.push((await copy.json().catch(() => ({}))) as RecordedTake);
+            return counter.fetch(request);
+          });
+          tail = run.catch(() => undefined);
+          return run;
+        },
+      };
+    },
+  };
+}
+
+/** A namespace whose single stub answers every fetch with `behavior`, for the fail-closed cases. */
+export interface StubNamespace {
+  calls: Request[];
+  idFromName(name: string): { name: string };
+  get(): { fetch(request: Request): Promise<Response> };
+}
+
+export function createStubNamespace(behavior: (request: Request) => Response | Promise<Response>): StubNamespace {
+  const calls: Request[] = [];
+  return {
+    calls,
+    idFromName: (name: string) => ({ name }),
+    get: () => ({
+      fetch(request: Request): Promise<Response> {
+        calls.push(request);
+        return Promise.resolve().then(() => behavior(request));
+      },
+    }),
+  };
+}
+
+export function takeRequest(body: unknown): Request {
+  return new Request("https://registrations.internal/take", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
