diff --git a/src/server/cloudflare/mcp-oauth-anonymous-write-budget.ts b/src/server/cloudflare/mcp-oauth-anonymous-write-budget.ts
new file mode 100644
index 000000000..b8fcaced3
--- /dev/null
+++ b/src/server/cloudflare/mcp-oauth-anonymous-write-budget.ts
@@ -0,0 +1,73 @@
+/**
+ * Durable Object that budgets the unauthenticated MCP OAuth requests that write to OAUTH_KV (client registrations and
+ * authorize requests), so they cannot use up the Workers Free plan's daily KV write allowance. One instance
+ * ("global") holds one global count and one count per client address for the current UTC day only. Each call checks
+ * both limits and takes a slot in one step.
+ *
+ * Plain class (no base class): the Workers runtime accepts it, and tests construct it with a fake storage. The
+ * read-modify-write runs inside blockConcurrencyWhile, so concurrent calls cannot both take the last slot even where
+ * no input gate is emulated.
+ */
+
+interface BudgetStorage {
+  get<T>(key: string): Promise<T | undefined>;
+  put(entries: Record<string, unknown>): Promise<void>;
+}
+
+interface BudgetState {
+  storage: BudgetStorage;
+  blockConcurrencyWhile<T>(closure: () => Promise<T>): Promise<T>;
+}
+
+interface DayCounts {
+  day: string;
+  total: number;
+  perIp: Record<string, number>;
+}
+
+const countsKey = "counts";
+
+export class McpOAuthAnonymousWriteBudget {
+  private readonly state: BudgetState;
+  private readonly now: () => number;
+
+  constructor(state: BudgetState, _env: unknown, now: () => number = Date.now) {
+    this.state = state;
+    this.now = now;
+  }
+
+  async fetch(request: Request): Promise<Response> {
+    const body = await readTakeRequest(request);
+    if (!body) return Response.json({ ok: false, error: "invalid_request" }, { status: 400 });
+    const ok = await this.state.blockConcurrencyWhile(() => this.take(body));
+    return Response.json({ ok });
+  }
+
+  private async take(body: { ip: string; maxPerDay: number; maxPerIpPerDay: number }): Promise<boolean> {
+    const day = new Date(this.now()).toISOString().slice(0, 10);
+    const stored = await this.state.storage.get<DayCounts>(countsKey);
+    // A different day means the old counts are dropped, so storage never grows with the days run.
+    const counts: DayCounts = stored?.day === day ? stored : { day, total: 0, perIp: {} };
+    const ipCount = Object.hasOwn(counts.perIp, body.ip) ? counts.perIp[body.ip]! : 0;
+    if (counts.total >= body.maxPerDay || ipCount >= body.maxPerIpPerDay) return false;
+    counts.total += 1;
+    counts.perIp[body.ip] = ipCount + 1;
+    await this.state.storage.put({ [countsKey]: counts });
+    return true;
+  }
+}
+
+async function readTakeRequest(
+  request: Request,
+): Promise<{ ip: string; maxPerDay: number; maxPerIpPerDay: number } | undefined> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return undefined;
+  }
+  if (typeof body !== "object" || body === null) return undefined;
+  const { ip, maxPerDay, maxPerIpPerDay } = body as Record<string, unknown>;
+  if (typeof ip !== "string" || typeof maxPerDay !== "number" || typeof maxPerIpPerDay !== "number") return undefined;
+  return { ip, maxPerDay, maxPerIpPerDay };
+}
diff --git a/src/server/cloudflare/mcp-oauth-registration-counter.test.ts b/src/server/cloudflare/mcp-oauth-registration-counter.test.ts
new file mode 100644
index 000000000..37b7e040e
--- /dev/null
+++ b/src/server/cloudflare/mcp-oauth-registration-counter.test.ts
@@ -0,0 +1,262 @@
+// Unit tests for McpOAuthAnonymousWriteBudget (SplitMind #78). The interface under test is pinned in the header of
+// ./test-registration-counter.ts: POST {ip, maxPerDay, maxPerIpPerDay} to fetch, get {ok} back.
+import { describe, expect, it, vi } from "vitest";
+import { createCounter, FakeClock, FakeDurableStorage, takeRequest } from "./test-registration-counter.ts";
+
+// A Durable Object base class from the Workers runtime, should the implementation extend one.
+vi.mock("cloudflare:workers", () => ({
+  WorkerEntrypoint: class {},
+  DurableObject: class {
+    readonly ctx: unknown;
+    readonly env: unknown;
+    constructor(ctx: unknown, env: unknown) {
+      this.ctx = ctx;
+      this.env = env;
+    }
+  },
+}));
+
+const noon = Date.UTC(2026, 10, 10, 12);
+const lastMs = Date.UTC(2026, 10, 10, 23, 59, 59, 999);
+const midnight = Date.UTC(2026, 10, 11, 0, 0, 0, 0);
+
+function setup(time = noon) {
+  const storage = new FakeDurableStorage();
+  const clock = new FakeClock(time);
+  const counter = createCounter(storage, clock);
+  const take = async (ip: string, maxPerDay: number, maxPerIpPerDay: number): Promise<boolean> => {
+    const response = await counter.fetch(takeRequest({ ip, maxPerDay, maxPerIpPerDay }));
+    expect(response.status).toBe(200);
+    const body = (await response.json()) as { ok: unknown };
+    expect(typeof body.ok).toBe("boolean");
+    return body.ok as boolean;
+  };
+  return { storage, clock, counter, take };
+}
+
+describe("McpOAuthAnonymousWriteBudget: limits", () => {
+  it("takes slots until the global limit is reached, then refuses", async () => {
+    const { take } = setup();
+    expect(await take("203.0.113.1", 3, 100)).toBe(true);
+    expect(await take("203.0.113.2", 3, 100)).toBe(true);
+    expect(await take("203.0.113.3", 3, 100)).toBe(true);
+    expect(await take("203.0.113.4", 3, 100)).toBe(false);
+    expect(await take("203.0.113.1", 3, 100)).toBe(false);
+  });
+
+  it("counts repeated calls from one address against its limit", async () => {
+    const { take } = setup();
+    for (let i = 0; i < 5; i++) expect(await take("203.0.113.9", 100, 5)).toBe(true);
+    expect(await take("203.0.113.9", 100, 5)).toBe(false);
+    expect(await take("203.0.113.9", 100, 5)).toBe(false);
+  });
+
+  it("keeps a separate count for each address, including IPv6 addresses in different /64s and the 'unknown' placeholder", async () => {
+    const { take } = setup();
+    for (const ip of ["203.0.113.1", "2001:db8:1::1", "2001:db8:2::1", "unknown"]) {
+      expect(await take(ip, 100, 1)).toBe(true);
+    }
+    for (const ip of ["203.0.113.1", "2001:db8:1::1", "2001:db8:2::1", "unknown"]) {
+      expect(await take(ip, 100, 1)).toBe(false);
+    }
+  });
+
+  it("never takes more than the global limit when many calls arrive at once on one storage", async () => {
+    const { counter } = setup();
+    // No serializing namespace and no input gate: the counter's own atomicity decides this.
+    const responses = await Promise.all(
+      Array.from({ length: 40 }, (_, i) =>
+        counter.fetch(takeRequest({ ip: `203.0.113.${(i % 8) + 1}`, maxPerDay: 7, maxPerIpPerDay: 100 })),
+      ),
+    );
+    const bodies = (await Promise.all(responses.map((response) => response.json()))) as { ok: boolean }[];
+    expect(bodies.filter((body) => body.ok)).toHaveLength(7);
+    expect(bodies.filter((body) => !body.ok)).toHaveLength(33);
+  });
+
+  it("never takes more than the address limit when many calls from one address arrive at once", async () => {
+    const { counter } = setup();
+    const responses = await Promise.all(
+      Array.from({ length: 30 }, (_, i) =>
+        counter.fetch(takeRequest({ ip: i % 2 ? "198.51.100.1" : "198.51.100.2", maxPerDay: 100, maxPerIpPerDay: 4 })),
+      ),
+    );
+    const bodies = (await Promise.all(responses.map((response) => response.json()))) as { ok: boolean }[];
+    // 15 calls per address, 4 slots each.
+    expect(bodies.filter((body) => body.ok)).toHaveLength(8);
+    expect(bodies.filter((body, i) => body.ok && i % 2 === 1)).toHaveLength(4);
+  });
+
+  it("writes nothing to storage for a refused call", async () => {
+    const { take, storage } = setup();
+    expect(await take("a", 1, 1)).toBe(true);
+    const writes = storage.writes;
+    const snapshot = storage.snapshot();
+    expect(await take("b", 1, 1)).toBe(false);
+    expect(await take("a", 5, 1)).toBe(false);
+    expect(storage.writes).toBe(writes);
+    expect(storage.snapshot()).toBe(snapshot);
+  });
+
+  it("allows exactly one slot at a limit of 1", async () => {
+    const { take } = setup();
+    expect(await take("a", 1, 1)).toBe(true);
+    expect(await take("b", 1, 1)).toBe(false);
+  });
+
+  it("takes nothing from the global count when the address limit refuses", async () => {
+    const { take } = setup();
+    expect(await take("a", 3, 1)).toBe(true);
+    // Refused by a's own limit, five times. None of these may use a global slot.
+    for (let i = 0; i < 5; i++) expect(await take("a", 3, 1)).toBe(false);
+    expect(await take("b", 3, 1)).toBe(true);
+    expect(await take("c", 3, 1)).toBe(true);
+    expect(await take("d", 3, 1)).toBe(false);
+  });
+
+  it("takes nothing from the address count when the global limit refuses", async () => {
+    const { take } = setup();
+    expect(await take("a", 2, 5)).toBe(true);
+    expect(await take("a", 2, 5)).toBe(true);
+    // The global limit of 2 is full. b is refused three times.
+    for (let i = 0; i < 3; i++) expect(await take("b", 2, 1)).toBe(false);
+    // Raise the global limit. If b's refusals had counted against b, its limit of 1 would refuse it now.
+    expect(await take("b", 10, 1)).toBe(true);
+  });
+
+  it("applies the limits given with each call to the counts it already holds", async () => {
+    const { take } = setup();
+    expect(await take("a", 2, 5)).toBe(true);
+    expect(await take("b", 2, 5)).toBe(true);
+    expect(await take("c", 2, 5)).toBe(false);
+    // Raised mid-day: the two used slots stay used, room opens up.
+    expect(await take("c", 3, 5)).toBe(true);
+    expect(await take("d", 3, 5)).toBe(false);
+    // Lowered below what is already used: refused.
+    expect(await take("e", 1, 5)).toBe(false);
+  });
+});
+
+describe("McpOAuthAnonymousWriteBudget: UTC day rollover", () => {
+  it("keeps the counts through the last millisecond of the UTC day", async () => {
+    const { take, clock } = setup(noon);
+    expect(await take("a", 1, 1)).toBe(true);
+    clock.time = lastMs;
+    expect(await take("b", 1, 1)).toBe(false);
+    expect(await take("a", 5, 1)).toBe(false);
+  });
+
+  it("resets the global and per-address counts at 00:00:00.000 UTC", async () => {
+    const { take, clock } = setup(lastMs);
+    expect(await take("a", 1, 1)).toBe(true);
+    expect(await take("a", 1, 1)).toBe(false);
+    clock.time = midnight;
+    expect(await take("a", 1, 1)).toBe(true);
+    expect(await take("b", 1, 1)).toBe(false);
+  });
+
+  it("counts a new day up from zero and refuses at the limit again", async () => {
+    const { take, clock } = setup();
+    for (const ip of ["a", "b", "c"]) expect(await take(ip, 3, 3)).toBe(true);
+    expect(await take("d", 3, 3)).toBe(false);
+    clock.time = midnight + 3_600_000;
+    for (const ip of ["a", "a", "a"]) expect(await take(ip, 3, 3)).toBe(true);
+    expect(await take("a", 3, 3)).toBe(false);
+    clock.time = midnight + 7_200_000;
+    // Still the same new day: no second reset.
+    expect(await take("b", 3, 3)).toBe(false);
+  });
+
+  it("resets after a gap of several days", async () => {
+    const { take, clock } = setup();
+    expect(await take("a", 1, 1)).toBe(true);
+    clock.time = Date.UTC(2026, 10, 15, 8); // date-guard: ok -- injected clock, not wall time
+    expect(await take("a", 1, 1)).toBe(true);
+  });
+
+  it("resets for the same day of the month in the next month, and across a year end", async () => {
