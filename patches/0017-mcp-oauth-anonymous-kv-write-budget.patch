+// A gate that runs without the current request's env must fail closed (SplitMind #78, R5).
+//
+// createMcpOAuthHandler keeps no handle on its options, and the only code that can reach the registration callback
+// without going through the handler's fetch wrapper is the OAuth library. So the library's default export is
+// replaced here by a recorder. It keeps the options it was built with, and its fetch() calls the registration callback
+// from inside the wrapper, which is where the library calls it. That gives two honest paths to the same callback:
+// through the wrapper (the env is known) and called directly from the recorded options (no wrapper, no env).
+import type { CloudflareEnv } from "./cloudflare-env.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createCounterNamespace } from "./test-registration-counter.ts";
+
+vi.mock("cloudflare:workers", () => ({
+  WorkerEntrypoint: class {},
+  DurableObject: class {
+    readonly ctx: unknown;
+    readonly env: unknown;
+    constructor(ctx: unknown, env: unknown) {
+      this.ctx = ctx;
+      this.env = env;
+    }
+  },
+}));
+
+interface RecordedOptions {
+  clientRegistrationCallback(input: { clientMetadata: Record<string, unknown>; request: Request }): Promise<unknown>;
+}
+
+const recorded = vi.hoisted(() => ({ options: undefined as unknown }));
+
+vi.mock("@cloudflare/workers-oauth-provider", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("@cloudflare/workers-oauth-provider")>();
+  class RecordingProvider {
+    constructor(options: RecordedOptions) {
+      recorded.options = options;
+    }
+    async fetch(request: Request): Promise<Response> {
+      const result = await (recorded.options as RecordedOptions).clientRegistrationCallback({
+        clientMetadata: { redirect_uris: ["https://claude.ai/api/mcp/auth_callback"] },
+        request,
+      });
+      return Response.json({ result: result ?? null });
+    }
+  }
+  return { ...actual, default: RecordingProvider };
+});
+
+const { createMcpOAuthHandler } = await import("./mcp-oauth.ts");
+
+const origin = "https://connect.example.com";
+const registerRequest = () =>
+  new Request(`${origin}/oauth/mcp/register`, { method: "POST", headers: { "cf-connecting-ip": "203.0.113.4" } });
+const context = { waitUntil() {}, passThroughOnException() {} };
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+function newHandler() {
+  return createMcpOAuthHandler(origin, async () => new Response("runtime"));
+}
+
+describe("registration gate without a per-request env", () => {
+  it("rejects, and logs an error, when the callback runs outside the handler's wrapper", async () => {
+    newHandler();
+    const errors = vi.spyOn(console, "error").mockImplementation(() => undefined);
+    const result = (await (recorded.options as RecordedOptions).clientRegistrationCallback({
+      clientMetadata: { redirect_uris: ["https://claude.ai/api/mcp/auth_callback"] },
+      request: registerRequest(),
+    })) as { description?: string } | undefined;
+    expect(result).toBeDefined();
+    expect(result?.description).toBeTruthy();
+    expect(errors).toHaveBeenCalled();
+  });
+
+  it("accepts when the wrapper supplies an env that has no budget binding", async () => {
+    const handler = newHandler();
+    const env = { OOMOL_CONNECT_ORIGIN: origin } as CloudflareEnv;
+    const response = await handler.fetch(registerRequest(), env, context);
+    expect(await response.json()).toEqual({ result: null });
+  });
+
+  it("uses the budget the wrapper's env binds", async () => {
+    const handler = newHandler();
+    const namespace = createCounterNamespace();
+    const env = {
+      OOMOL_CONNECT_ORIGIN: origin,
+      MCP_OAUTH_ANONYMOUS_WRITES: namespace,
+      OOMOL_CONNECT_MCP_OAUTH_MAX_ANONYMOUS_WRITES_PER_DAY: "1",
+    } as unknown as CloudflareEnv;
+    expect(await (await handler.fetch(registerRequest(), env, context)).json()).toEqual({ result: null });
+    const second = await (await handler.fetch(registerRequest(), env, context)).json();
+    expect(second).toEqual({ result: { description: expect.stringContaining("daily limit") } });
+  });
+});
