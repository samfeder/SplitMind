diff --git a/src/server/storage/d1/test-database.test.ts b/src/server/storage/d1/test-database.test.ts
new file mode 100644
index 00000000..42a9b465
--- /dev/null
+++ b/src/server/storage/d1/test-database.test.ts
@@ -0,0 +1,152 @@
+// Harness self-test (#127 item 4): the test D1 is loud about change counts it cannot know.
+//
+// A statement wrapper that forwards only `readRows` (no `readOutcome`) cannot say how many rows a batched write
+// changed. Reading `meta.changes` from its batch entry must throw, not quietly answer 0: the watcher decides "did
+// anything change" from that number, and a silent 0 makes such a test pass for the wrong reason. The rows of the
+// entry stay readable, and a wrapper that forwards `readOutcome` reports the real count.
+
+import { afterEach, describe, expect, it } from "vitest";
+import type { D1DatabaseBinding, D1PreparedStatementBinding } from "../../cloudflare/cloudflare-bindings.ts";
+import { ActionPolicyService } from "../../../core/action-policy.ts";
+import { FakeGmailRunner, FakeMailbox, HOUR, T0, createLogCapture, insertCursor, insertItem, itemRow, selectAll } from "../../email-watch/test-support.ts";
+import { EmailWatcher } from "../../email-watch/watcher.ts";
+import { SqliteD1Database } from "./test-database.ts";
+
+type Inner = D1PreparedStatementBinding & {
+  readRows(): Record<string, unknown>[];
+  readOutcome(): { rows: Record<string, unknown>[]; changes: number };
+};
+
+/** Forwards bind/first/all/run and `readRows`; forwards `readOutcome` only when asked to. */
+class Forwarding implements D1PreparedStatementBinding {
+  private readonly inner: Inner;
+  private readonly withOutcome: boolean;
+  readOutcome?: () => { rows: Record<string, unknown>[]; changes: number };
+
+  constructor(inner: D1PreparedStatementBinding, withOutcome: boolean) {
+    this.inner = inner as Inner;
+    this.withOutcome = withOutcome;
+    if (withOutcome) this.readOutcome = () => this.inner.readOutcome();
+  }
+
+  bind(...values: unknown[]): D1PreparedStatementBinding {
+    return new Forwarding(this.inner.bind(...values), this.withOutcome);
+  }
+  first<T = Record<string, unknown>>(): Promise<T | null> {
+    return this.inner.first<T>();
+  }
+  all<T = Record<string, unknown>>(): Promise<{ results: T[] }> {
+    return this.inner.all<T>();
+  }
+  run(): Promise<{ success: boolean; meta: { changes?: number } }> {
+    return this.inner.run();
+  }
+  readRows(): Record<string, unknown>[] {
+    return this.inner.readRows();
+  }
+}
+
+let databases: SqliteD1Database[] = [];
+afterEach(() => {
+  for (const database of databases) database.close();
+  databases = [];
+});
+
+function open(): SqliteD1Database {
+  const database = new SqliteD1Database();
+  databases.push(database);
+  return database;
+}
+
+async function twoCursors(database: SqliteD1Database): Promise<void> {
+  for (const name of ["a", "b"]) await insertCursor(database, { connection_name: name, history_id: "1", last_run_at: new Date(T0).toISOString() });
+}
+
+const names = async (database: SqliteD1Database): Promise<string[]> =>
+  (await selectAll<{ connection_name: string }>(database, "select connection_name from email_watch_cursors order by connection_name")).map((row) => row.connection_name);
+
+describe("a batch through statements that lack readOutcome", () => {
+  it("still runs the statements and returns the rows of a read", async () => {
+    const database = open();
+    await twoCursors(database);
+    const results = await database.batch([
+      new Forwarding(database.prepare("select connection_name from email_watch_cursors order by connection_name"), false),
+      new Forwarding(database.prepare("delete from email_watch_cursors where connection_name = ?"), false).bind("a"),
+    ]);
+    expect(results[0]!.results).toEqual([{ connection_name: "a" }, { connection_name: "b" }]);
+    expect(await names(database)).toEqual(["b"]);
+  });
+
+  it.each([
+    ["a read", "select connection_name from email_watch_cursors", [] as string[]],
+    ["a delete that removes a row", "delete from email_watch_cursors where connection_name = ?", ["a"]],
+    ["a delete that removes nothing", "delete from email_watch_cursors where connection_name = ?", ["nobody"]],
+  ])("asking %s for its change count throws instead of answering 0", async (_label, sql, values) => {
+    const database = open();
+    await twoCursors(database);
+    const results = await database.batch([new Forwarding(database.prepare(sql), false).bind(...values)]);
+    expect(results).toHaveLength(1);
+    expect(() => results[0]!.meta?.changes).toThrow(Error);
+  });
+
+  it("asking one entry throws while a neighbour entry from a statement with readOutcome still answers", async () => {
+    const database = open();
+    await twoCursors(database);
+    const results = await database.batch([
+      new Forwarding(database.prepare("delete from email_watch_cursors where connection_name = ?"), false).bind("a"),
+      new Forwarding(database.prepare("delete from email_watch_cursors where connection_name = ?"), true).bind("b"),
+    ]);
+    expect(() => results[0]!.meta?.changes).toThrow(Error);
+    expect(results[1]!.meta?.changes).toBe(1);
+  });
+});
+
+describe("a batch through statements that forward readOutcome", () => {
+  it("reports the real count per entry: 0 for a read, 1 for a delete of one row, 2 for two rows, 0 for none", async () => {
+    const database = open();
+    await twoCursors(database);
+    const results = await database.batch([
+      new Forwarding(database.prepare("select connection_name from email_watch_cursors"), true).bind(),
+      new Forwarding(database.prepare("delete from email_watch_cursors where connection_name = ?"), true).bind("nobody"),
+      new Forwarding(database.prepare("delete from email_watch_cursors where connection_name = ?"), true).bind("a"),
+      new Forwarding(database.prepare("delete from email_watch_cursors"), true).bind(),
+    ]);
+    expect(results.map((result) => result.meta?.changes)).toEqual([0, 0, 1, 1]);
+    expect(await names(database)).toEqual([]);
+  });
+
+  it("two rows changed by one statement are counted as 2", async () => {
+    const database = open();
+    await twoCursors(database);
+    const results = await database.batch([new Forwarding(database.prepare("delete from email_watch_cursors"), true).bind()]);
+    expect(results[0]!.meta?.changes).toBe(2);
+  });
+});
+
+describe("the watcher over a database whose statements lack readOutcome", () => {
+  it("fails loudly for that connection instead of reading the purge batch as 'nothing changed'", async () => {
+    const sqlite = open();
+    const OTHER = "e".repeat(64);
+    const mailbox = new FakeMailbox({ prefix: "m0" });
+    const runner = new FakeGmailRunner({ work: mailbox });
+    const log = createLogCapture();
+    await insertCursor(sqlite, { connection_name: "work", history_id: "1000", last_run_at: new Date(T0 - HOUR).toISOString(), connection_id: OTHER });
+    await insertItem(sqlite, itemRow({ id: "old", connection_name: "work", subject: "Deployment failed for old-app", dedup_key: "k-old" }));
+    const wrapped: D1DatabaseBinding = {
+      prepare: (query) => new Forwarding(sqlite.prepare(query), false),
+      batch: (statements) => sqlite.batch(statements),
+    };
+    const watcher = new EmailWatcher({
+      database: wrapped,
+      runner,
+      policy: new ActionPolicyService().createSnapshot(),
+      connections: ["work"],
+      logger: log.logger,
+      now: () => T0,
+    });
+    // The runner resolves "work" to a different account than the cursor holds, so resolution runs the purge batch.
+    await watcher.run();
+    expect(log.entries.filter((entry) => entry.level === "error").map((entry) => entry.message)).toEqual(["email watch failed for a connection"]);
+    expect(log.entries.filter((entry) => entry.level === "warn")).toEqual([]);
+  });
+});
