+// ---------------------------------------------------------------------------------------------------------------
+// Patch 0023, #127 item 6: the failing-notice claim matches `connection_id is ?`, so a cursor whose fingerprint is
+// null (a row from before 0015) can still claim. With `= ?` a null never matches, the claim never succeeds and the
+// notice is never made. The resolution keeps failing, so the null is never adopted.
+// ---------------------------------------------------------------------------------------------------------------
+describe("a cursor with no recorded fingerprint still gets its failing notice once (patch 0023, #127 item 6)", () => {
+  const MIN = 60_000;
+  const failingItems = (r: Rig) => itemsOf(r, "rule_id = 'watch-failing'");
+
+  /** A cursor from before 0015: no connection_id, no created_at. The last good read was at T0. Resolution fails from then on. */
+  async function legacyCursor(): Promise<Rig> {
+    const r = rig();
+    await insertCursor(r.db, {
+      connection_name: "work",
+      history_id: "1000",
+      last_run_at: iso(T0),
+      last_success_at: iso(T0),
+      failing_notice_at: null,
+      connection_id: null,
+      created_at: null,
+    });
+    r.runner.resolved.work = new Error("store unavailable");
+    return r;
+  }
+
+  it("no notice before 24 hours have passed since the last good read (control)", async () => {
+    const r = await legacyCursor();
+    r.clock.now = T0 + DAY - MIN;
+    await r.run();
+    expect(await failingItems(r)).toEqual([]);
+    expect((await cursorOf(r))!.failing_notice_at).toBeNull();
+  });
+
+  it("after 24 hours exactly one notice is made, and the cursor records when", async () => {
+    const r = await legacyCursor();
+    r.clock.now = T0 + DAY + HOUR;
+    await r.run();
+    expect((await failingItems(r)).map((row) => row.subject)).toEqual(["Email watch could not read this account since 2026-11-11 12:00 UTC"]);
+    expect(await cursorOf(r)).toMatchObject({ failing_notice_at: iso(T0 + DAY + HOUR), connection_id: null, history_id: "1000" });
+  });
+
+  it("later failing runs of the same streak make no second notice", async () => {
+    const r = await legacyCursor();
+    for (const at of [T0 + DAY + HOUR, T0 + DAY + 2 * HOUR, T0 + 2 * DAY, T0 + 3 * DAY]) {
+      r.clock.now = at;
+      await r.run();
+    }
+    expect(await failingItems(r)).toHaveLength(1);
+    expect((await cursorOf(r))!.failing_notice_at).toBe(iso(T0 + DAY + HOUR));
+  });
+
+  it("two overlapping invocations at the same moment leave exactly one notice", async () => {
+    const r = await legacyCursor();
+    r.clock.now = T0 + DAY + HOUR;
+    await Promise.all([r.watcher.run(), secondWatcher(r).run()]);
+    expect(await failingItems(r)).toHaveLength(1);
+  });
+});
