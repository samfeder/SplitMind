+  // A wrapper statement that only forwards readRows cannot know the count, so reading `changes` from its entry
+  // throws instead of quietly answering 0.
   async batch(
     statements: D1PreparedStatementBinding[],
-  ): Promise<{ results: Record<string, unknown>[] | null; meta: { changes: number } }[]> {
+  ): Promise<{ results: Record<string, unknown>[] | null; meta: { readonly changes: number } }[]> {
     this.database.exec("begin immediate");
     try {
       const results = statements.map((statement) => {
-        // A wrapper statement that only forwards readRows (see the sweeping test database) reports no changes.
         const inner = statement as Partial<SqliteD1PreparedStatement> & { readRows(): Record<string, unknown>[] };
-        const { rows, changes } = inner.readOutcome?.() ?? { rows: inner.readRows(), changes: 0 };
-        return { results: rows.length ? rows : null, meta: { changes } };
+        const outcome = inner.readOutcome?.();
+        const rows = outcome?.rows ?? inner.readRows();
+        const meta = {
+          get changes(): number {
+            if (!outcome) {
+              throw new Error("test D1: this statement wrapper has no readOutcome, so batch cannot report meta.changes");
+            }
+            return outcome.changes;
+          },
+        };
+        return { results: rows.length ? rows : null, meta };
       });
       this.database.exec("commit");
       return results;
