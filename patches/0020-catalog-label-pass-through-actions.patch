+describe("catalog labels for pass-through actions (patch 0020, #134)", () => {
+  it.each(passThrough)("%s exists and is labelled %s", async (actionId, operationType) => {
+    const label = await labelOf(actionId);
+    expect(label, `${actionId} must exist in the catalog with an operationType`).toBeDefined();
+    expect(label).toBe(operationType);
+  });
+
+  it.each(staysRead)("%s stays labelled read (control)", async (actionId) => {
+    const label = await labelOf(actionId);
+    expect(label, `${actionId} must exist in the catalog with an operationType`).toBeDefined();
+    expect(label).toBe("read");
+  });
+
+  // A relabelled action must not still advertise itself as read-only: that is what misled the grant.
+  it.each(passThrough)("%s no longer describes itself as read-only", async (actionId) => {
+    const action = await actionOf(actionId);
+    expect(action, `${actionId} must exist`).toBeDefined();
+    expect(action!.description).not.toMatch(/read[\s-]*only/i);
+  });
+
+  // The read-only rule itself, fed the label the definition carries: a read-only connection refuses every
+  // relabelled action and still allows the controls.
+  it.each(passThrough)("%s is refused on a read-only connection and the writable one is not", async (actionId) => {
+    const service = actionId.slice(0, actionId.indexOf("."));
+    const readOnly = parseReadOnlyConnections(`${service}:ro`, () => {});
+    const label = await labelOf(actionId);
+
+    expect(readOnly.refuseAction({ service, connectionName: "ro" }, label)).toMatchObject({
+      allowed: false,
+      code: "action_blocked",
+    });
+    expect(readOnly.refuseAction({ service, connectionName: "rw" }, label)).toBeUndefined();
+  });
+
+  it.each(staysRead)("%s is still allowed on a read-only connection (control)", async (actionId) => {
+    const service = actionId.slice(0, actionId.indexOf("."));
+    const readOnly = parseReadOnlyConnections(`${service}:ro`, () => {});
+
+    expect(readOnly.refuseAction({ service, connectionName: "ro" }, await labelOf(actionId))).toBeUndefined();
+  });
+});
