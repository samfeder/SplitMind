+/** metadataHeaders only means something with format "metadata"; Gmail ignores it otherwise, so refuse it here. */
+function readMetadataHeaders(value: unknown, format: string): string[] {
+  if (value === undefined) return [];
+  if (format !== "metadata") {
+    throw providerInputError("metadataHeaders is only valid with format metadata");
+  }
+  if (!Array.isArray(value) || value.some((name) => typeof name !== "string" || !name.trim())) {
+    throw providerInputError("metadataHeaders must be an array of header names");
+  }
+  return value as string[];
+}
