+    expect(expired!.fake).toMatchObject({ ok: false, error: { code: (expired!.real as any).error.code, details: { status: 404 } } });
+  });
+
+  it("fetch_message_by_message_id with format metadata (all headers), so the normalized shape is checked today", async () => {
+    const [fetched] = await both(
