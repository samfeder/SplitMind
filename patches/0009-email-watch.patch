+    expect(results[1]!.real).toMatchObject({ ok: true, output: { nextPageToken: null } });
+    expect(results[2]!.real).toMatchObject({ ok: true, output: { history: [], historyId: "1003", nextPageToken: null } });
+    for (const { real, fake } of results) expect(fake).toEqual(real);
+  });
+
+  it("list_history on an expired history id: the real error carries details.status 404", async () => {
+    const [expired] = await both(
