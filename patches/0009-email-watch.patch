@@ -0,0 +1,304 @@
+// (Lives here, not in src/providers/mail_watch/, so the provider-directory scan in generate:registry never meets a
+// directory that has a test but no definition.)
+// Decision 10: the built-in mail_watch provider (authTypes ["no_auth"]) reads and acknowledges the watcher's list.
+//
+// Interface pinned:
+//   src/providers/mail_watch/definition.ts   export const provider: ProviderDefinition
+//   src/providers/mail_watch/executors.ts
+//     export const executors: ProviderExecutors        the unbound default, used where the watch is not wired:
+//                                                      behaves as "feature off" (decision 10, last bullet)
+//     export function createMailWatchExecutors(deps: {
+//       database: D1DatabaseBinding;                   // email_watch_items lives here
+//       enabled: boolean;                              // the connection list is non-empty
+//       profileEmail(connectionName: string): Promise<string | undefined>;   // stored connection profile
+//       now?: () => number;
+//     }): ProviderExecutors
+//   Both are bound at app creation: `new ProviderLoader({ ...executorModules, mail_watch: async () => ({ executors }) })`.
+import type { ExecutionContext, ExecutionResult } from "../../core/types.ts";
+
+import { afterEach, describe, expect, it } from "vitest";
+import { ActionPolicyService } from "../../core/action-policy.ts";
+import { assertProviderId } from "../../core/provider-id.ts";
+import { validateActionInput } from "../../core/validation.ts";
+import { resolveMcpGrantScope } from "../cloudflare/mcp-grant-scope.ts";
+import type { CloudflareEnv } from "../cloudflare/cloudflare-env.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import { DAY, HOUR, T0, insertItem, itemRow, selectAll } from "./test-support.ts";
+import { provider } from "../../providers/mail_watch/definition.ts";
+import { createMailWatchExecutors, executors as unboundExecutors } from "../../providers/mail_watch/executors.ts";
+
+const context: ExecutionContext = { getCredential: async () => undefined };
+const iso = (ms: number) => new Date(ms).toISOString();
+
+let database: SqliteD1Database | undefined;
+afterEach(() => {
+  database?.close();
+  database = undefined;
+});
+
+function setup(options: { enabled?: boolean; emails?: Record<string, string> } = {}) {
+  database = new SqliteD1Database();
+  const db = database;
+  const emails = options.emails ?? { work: "owner@example.org", ops: "ops-owner@example.net" };
+  const executors = createMailWatchExecutors({
+    database: db,
+    enabled: options.enabled ?? true,
+    profileEmail: async (name) => emails[name],
+    now: () => T0,
+  });
+  return {
+    db,
+    list: (input: Record<string, unknown> = {}) => executors["mail_watch.list_pending_mail"]!(input, context),
+    acknowledge: (input: Record<string, unknown>) => executors["mail_watch.acknowledge_mail"]!(input, context),
+  };
+}
+
+function output<T>(result: ExecutionResult): T {
+  expect(result).toMatchObject({ ok: true });
+  return result.output as T;
+}
+
+interface Item {
+  id: string;
+  connectionName: string;
+  category: string;
+  ruleId: string;
+  senderDomain: string;
+  subject: string;
+  receivedAt: string;
+  occurrences: number;
+  link: string;
+}
+
