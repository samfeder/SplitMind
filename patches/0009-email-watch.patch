+import { describe, expect, it, vi } from "vitest";
+import { ActionPolicyService } from "../../core/action-policy.ts";
+import { provider as gmail } from "../../providers/gmail/definition.ts";
+import { createWatchGmailClient } from "./gmail-access.ts";
+import type { RunActionInput } from "../actions/action-runner.ts";
+
+// Interface pinned (gmail-access.ts), the allowlist of decision 3:
+//   createWatchGmailClient(runner: { run(input: RunActionInput): Promise<ActionRunResult | undefined> },
+//                          policy: ActionPolicySnapshot)
+//     -> { call(connectionName: string, actionId: string, input: unknown): Promise<ActionRunResult | undefined> }
+//   `call` REJECTS (throws) before touching the runner unless the call is one of
+//     gmail.get_profile | gmail.list_history | gmail.fetch_message_by_message_id with input.format === "metadata".
+//   Otherwise it calls runner.run exactly once with { actionId, input, connectionName, policy,
+//     caller: "cron", audit: "outcome" } and returns what the runner returns.
+
+const policy = new ActionPolicyService().createSnapshot();
+const HEADERS = ["From", "Subject", "Authentication-Results", "X-GitHub-Reason", "List-Id"];
+
+function setup() {
+  const run = vi.fn(async (_input: RunActionInput) => ({
+    executionId: "e1",
+    auditPersisted: true,
+    result: { ok: true as const, output: {} },
+  }));
+  const client = createWatchGmailClient({ run }, policy);
+  return { run, client };
+}
+
+describe("the watcher's Gmail allowlist", () => {
+  it("refuses every Gmail action in the catalog except the three reads, without calling the runner", async () => {
+    const { run, client } = setup();
+    const allowed = new Set(["gmail.get_profile", "gmail.list_history", "gmail.fetch_message_by_message_id"]);
+    const ids = gmail.actions.map((action) => action.id);
+    expect(ids.length).toBeGreaterThan(40);
+    for (const actionId of ids.filter((id) => !allowed.has(id))) {
+      await expect(client.call("work", actionId, { messageId: "m1", format: "metadata" }), actionId).rejects.toThrow();
+    }
+    expect(run).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    "gmail.send_email",
+    "gmail.reply_email",
+    "gmail.trash_message",
+    "gmail.move_to_trash",
+    "gmail.add_label_to_email",
+    "gmail.batch_modify_messages",
+    "gmail.modify_thread_labels",
+    "gmail.delete_label",
+    "gmail.create_filter",
+    "gmail.get_message",
+    "gmail.fetch_emails",
+    "gmail.list_threads",
+    "gmail.fetch_message_by_thread_id",
+    "gmail.download_attachment",
+    "gmail.stop_watch",
+    "slack.post_message",
+    "notion.search",
+    "mail_watch.acknowledge_mail",
+    "mail_watch.list_pending_mail",
+    "get_profile",
+    "gmail.",
+    "gmail",
+    "",
+    " gmail.get_profile",
+    "gmail.get_profile ",
+    "GMAIL.GET_PROFILE",
+    "gmail.get_profile.extra",
+    "gmail.list_history2",
+    "gmail.*",
+  ])("refuses the action id %j before the runner runs", async (actionId) => {
+    const { run, client } = setup();
+    await expect(client.call("work", actionId, { messageId: "m1", format: "metadata" })).rejects.toThrow();
+    expect(run).not.toHaveBeenCalled();
+  });
+
+  it.each([undefined, "full", "minimal", "raw", "METADATA", "metadata ", "", null, 1, ["metadata"], { format: "metadata" }])(
+    "refuses gmail.fetch_message_by_message_id with format %j",
+    async (format) => {
+      const { run, client } = setup();
+      const input = format === undefined ? { messageId: "m1" } : { messageId: "m1", format };
+      await expect(client.call("work", "gmail.fetch_message_by_message_id", input)).rejects.toThrow();
+      expect(run).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([undefined, null, "metadata", 42])("refuses the fetch when the input is %j", async (input) => {
+    const { run, client } = setup();
+    await expect(client.call("work", "gmail.fetch_message_by_message_id", input)).rejects.toThrow();
+    expect(run).not.toHaveBeenCalled();
+  });
+
+  it("runs gmail.get_profile through the runner as the cron caller with outcome-only audit", async () => {
+    const { run, client } = setup();
+    const result = await client.call("work", "gmail.get_profile", {});
+    expect(run).toHaveBeenCalledTimes(1);
+    expect(run.mock.calls[0]![0]).toMatchObject({
+      actionId: "gmail.get_profile",
+      input: {},
+      connectionName: "work",
+      caller: "cron",
+      audit: "outcome",
+      policy,
+    });
+    expect(result).toMatchObject({ executionId: "e1", result: { ok: true } });
+  });
+
+  it("runs gmail.list_history through the runner with its input unchanged", async () => {
+    const { run, client } = setup();
+    const input = { startHistoryId: "1001", labelId: "INBOX", historyTypes: ["messageAdded"], maxResults: 20 };
+    await client.call("ops", "gmail.list_history", input);
+    expect(run).toHaveBeenCalledTimes(1);
+    expect(run.mock.calls[0]![0]).toMatchObject({
+      actionId: "gmail.list_history",
+      input,
+      connectionName: "ops",
+      caller: "cron",
+      audit: "outcome",
+    });
+  });
+
+  it("runs gmail.fetch_message_by_message_id only with format metadata", async () => {
+    const { run, client } = setup();
+    const input = { messageId: "m1", format: "metadata", metadataHeaders: HEADERS };
+    await client.call("work", "gmail.fetch_message_by_message_id", input);
+    expect(run).toHaveBeenCalledTimes(1);
+    expect(run.mock.calls[0]![0]).toMatchObject({
+      actionId: "gmail.fetch_message_by_message_id",
+      input,
+      connectionName: "work",
+      caller: "cron",
+      audit: "outcome",
+    });
+  });
+
+  it("returns the runner's refusal as a result, so a policy block can skip a connection", async () => {
+    const refusal = { executionId: "e2", auditPersisted: true, result: { ok: false as const, error: { code: "action_blocked", message: "blocked" } } };
+    const client = createWatchGmailClient({ run: async () => refusal }, policy);
+    await expect(client.call("work", "gmail.list_history", { startHistoryId: "1" })).resolves.toBe(refusal);
+  });
+});
