+// Guards the fixtures: the FakeGmailRunner the watcher tests use must answer exactly as the real ActionRunner,
+// Gmail executors and action schemas do for the three reads the watcher makes. If the real shapes change, the
+// watcher tests would otherwise keep passing against a fake that no longer matches.
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createCatalogStore } from "../../catalog-store.ts";
