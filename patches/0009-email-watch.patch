+import { afterEach, describe, expect, it } from "vitest";
+import { defaultMigrationSource } from "../storage/migration-source.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import { insertCursor, insertItem, itemRow, selectAll, T0 } from "./test-support.ts";
+
+// Decision 9: migrations/0019_email_watch.sql (D1 and SQLite) creates the two tables. Postgres has its own
+// migrations/postgresql/ directory (its 0010_runtime.sql folds in D1's 0001 to 0010; every D1 migration from 0011
+// on is mirrored there under the same name), so a deployment on Postgres gets the same tables.
+
+let database: SqliteD1Database | undefined;
+afterEach(() => {
+  database?.close();
+  database = undefined;
+});
+
+function open(): SqliteD1Database {
+  database = new SqliteD1Database();
+  return database;
+}
+
+interface Column {
+  name: string;
+  type: string;
+  notnull: number;
+  dflt_value: string | null;
+  pk: number;
+}
+
+async function columns(db: SqliteD1Database, table: string): Promise<Column[]> {
+  return selectAll<Column>(db, `pragma table_info(${table})`);
+}
+
+describe("0019_email_watch migration (sqlite and D1)", () => {
+  it("is the migration after 0018_connection_retirement", () => {
+    const names = defaultMigrationSource.readMigrations("sqlite").map((migration) => migration.name);
+    expect(names).toContain("0019_email_watch.sql");
+    expect(names.indexOf("0019_email_watch.sql")).toBe(names.indexOf("0018_connection_retirement.sql") + 1);
+  });
+
+  it("creates email_watch_cursors with exactly the specified columns", async () => {
+    const found = await columns(open(), "email_watch_cursors");
+    expect(found.map((column) => column.name).sort()).toEqual(
+      ["catch_up", "connection_name", "history_id", "last_run_at", "page_token"].sort(),
+    );
+    const byName = Object.fromEntries(found.map((column) => [column.name, column]));
+    expect(byName.connection_name!.pk).toBe(1);
+    expect(byName.page_token!.notnull).toBe(0);
+  });
+
+  it("creates email_watch_items with exactly the specified columns and nothing that could hold mail content", async () => {
+    const found = await columns(open(), "email_watch_items");
+    expect(found.map((column) => column.name).sort()).toEqual(
+      [
+        "acknowledged_at",
+        "category",
+        "connection_name",
+        "created_at",
+        "dedup_key",
+        "gmail_message_id",
+        "gmail_thread_id",
+        "id",
+        "occurrences",
+        "received_at",
+        "rule_id",
+        "sender_domain",
+        "status",
+        "subject",
+      ].sort(),
+    );
+    const byName = Object.fromEntries(found.map((column) => [column.name, column]));
+    expect(byName.id!.pk).toBe(1);
+    expect(byName.acknowledged_at!.notnull).toBe(0);
+    expect(String(byName.occurrences!.dflt_value)).toBe("1");
+  });
+
+  it("rejects a second item for the same connection and Gmail message, and allows the same id on another connection", async () => {
+    const db = open();
+    await insertItem(db, itemRow({ id: "a", gmail_message_id: "g1" }));
+    await expect(insertItem(db, itemRow({ id: "b", gmail_message_id: "g1" }))).rejects.toThrow(/unique/i);
+    await insertItem(db, itemRow({ id: "c", gmail_message_id: "g1", connection_name: "ops" }));
+    expect(await selectAll(db, "select id from email_watch_items order by id")).toEqual([{ id: "a" }, { id: "c" }]);
+  });
+
+  it("rejects a status other than pending or acknowledged", async () => {
+    const db = open();
+    await expect(insertItem(db, itemRow({ id: "x", status: "archived" as "pending" }))).rejects.toThrow();
+    await insertItem(db, itemRow({ id: "p", status: "pending" }));
+    await insertItem(db, itemRow({ id: "q", status: "acknowledged", acknowledged_at: new Date(T0).toISOString() }));
+  });
+
+  it("defaults occurrences to 1", async () => {
+    const db = open();
+    await db
+      .prepare(
+        "insert into email_watch_items (id, connection_name, gmail_message_id, gmail_thread_id, sender_domain, subject, category, rule_id, received_at, created_at, status, dedup_key) values ('d', 'work', 'g', 't', 'vercel.com', 's', 'deploy_failed', 'r', 'x', 'y', 'pending', 'k')",
+      )
+      .run();
+    expect(await selectAll(db, "select occurrences from email_watch_items where id = 'd'")).toEqual([{ occurrences: 1 }]);
+  });
+
+  it("keys cursors by connection name", async () => {
+    const db = open();
+    await insertCursor(db, { connection_name: "work", history_id: "1", last_run_at: new Date(T0).toISOString() });
+    await expect(
+      insertCursor(db, { connection_name: "work", history_id: "2", last_run_at: new Date(T0).toISOString() }),
+    ).rejects.toThrow();
+  });
+});
+
+describe("Postgres parity", () => {
+  it("has the same 0019 file name as the D1 migration", () => {
+    const names = defaultMigrationSource.readMigrations("postgresql").map((migration) => migration.name);
+    expect(names).toContain("0019_email_watch.sql");
+  });
+
+  it("creates both tables with the same columns", () => {
+    const sql = defaultMigrationSource
+      .readMigrations("postgresql")
+      .find((migration) => migration.name === "0019_email_watch.sql")?.sql;
+    expect(sql).toBeDefined();
+    for (const table of ["email_watch_cursors", "email_watch_items"]) expect(sql).toContain(table);
+    for (const column of [
+      "connection_name",
+      "history_id",
+      "page_token",
+      "last_run_at",
+      "catch_up",
+      "gmail_message_id",
+      "gmail_thread_id",
+      "sender_domain",
+      "subject",
+      "category",
+      "rule_id",
+      "received_at",
+      "created_at",
+      "status",
+      "acknowledged_at",
+      "dedup_key",
+      "occurrences",
+    ]) {
+      expect(sql, column).toContain(column);
+    }
+  });
+
+  it("mirrors every D1 migration from 0011 on into the postgresql directory", () => {
+    const postgres = new Set(defaultMigrationSource.readMigrations("postgresql").map((migration) => migration.name));
+    const missing = defaultMigrationSource
+      .readMigrations("sqlite")
+      .map((migration) => migration.name)
+      .filter((name) => name >= "0011" && !postgres.has(name));
+    expect(missing).toEqual([]);
+  });
+});
