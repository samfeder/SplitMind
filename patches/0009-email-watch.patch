+++ b/src/server/actions/action-runner-audit.test.ts
@@ -0,0 +1,166 @@
+// Decision 4: `RunActionInput.audit: "outcome"` records the run row with no inputSummary or outputSummary, and the
+// "cron" caller exists. Every other caller's rows are unchanged. Stores are the real D1 run log over SQLite.
+import type { ActionDefinition, ActionExecutor, ProviderDefinition } from "../../core/types.ts";
+import type { IProviderLoader } from "../../providers/provider-loader.ts";
+
+import { afterEach, describe, expect, it } from "vitest";
+import { createCatalogStore } from "../../catalog-store.ts";
+import { ConnectionService } from "../../connection-service.ts";
+import { ActionPolicyService } from "../../core/action-policy.ts";
+import { D1RuntimeDatabase } from "../storage/d1/runtime-store.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import { ActionRunner } from "./action-runner.ts";
+import type { RunActionInput } from "./action-runner.ts";
+
+const echo: ActionDefinition = {
+  id: "example.echo",
+  service: "example",
+  name: "echo",
+  description: "Echo input.",
+  operationType: "read",
+  requiredScopes: [],
+  providerPermissions: [],
+  inputSchema: { type: "object" },
+  outputSchema: { type: "object" },
+};
+const provider: ProviderDefinition = {
+  service: "example",
+  displayName: "Example",
+  categories: ["Developer Tools"],
+  authTypes: ["no_auth"],
+  auth: [{ type: "no_auth" }],
+  actions: [echo],
+};
+
+const SECRET_INPUT = "private-subject-line-for-the-input";
+const SECRET_OUTPUT = "private-snippet-text-in-the-output";
+const open = new ActionPolicyService().createSnapshot();
+
+const databases: SqliteD1Database[] = [];
+afterEach(() => {
+  for (const database of databases.splice(0)) database.close();
+});
+
+function setup(executor: ActionExecutor = async () => ({ ok: true, output: { snippet: SECRET_OUTPUT } })) {
+  const binding = new SqliteD1Database();
+  databases.push(binding);
+  const database = new D1RuntimeDatabase(binding);
+  const catalog = createCatalogStore([provider], { executableActionIds: [echo.id] });
+  const loader: IProviderLoader = {
+    async loadActionExecutor() {
+      return executor;
+    },
+    async loadProxyExecutor() {
+      return undefined;
+    },
+    async loadCredentialValidators() {
+      return undefined;
+    },
+  };
+  const runner = new ActionRunner({
+    catalog,
+    providerLoader: loader,
+    connections: new ConnectionService({ catalog, providerLoader: loader, store: database.connectionStore }),
+    runs: database.runLogStore,
+  });
+  return { runner, database };
+}
+
+function input(overrides: Partial<RunActionInput> & { audit?: "outcome" } = {}): RunActionInput {
+  return {
+    actionId: "example.echo",
+    input: { subject: SECRET_INPUT, token: "tok-1" },
+    caller: "cron" as RunActionInput["caller"],
+    policy: open,
+    ...overrides,
+  } as RunActionInput;
+}
+
+describe("ActionRunner audit: outcome", () => {
+  it("records the run with no inputSummary and no outputSummary, and keeps the outcome fields", async () => {
+    const { runner, database } = setup();
+    const run = await runner.run(input({ audit: "outcome" }));
+    expect(run).toMatchObject({ auditPersisted: true, result: { ok: true } });
+
+    const row = await database.runLogStore.get(run!.executionId);
+    expect(row).toBeDefined();
+    expect(row).toMatchObject({
+      id: run!.executionId,
+      service: "example",
+      actionId: "example.echo",
+      caller: "cron",
+      ok: true,
+      policy: { allowed: true },
+    });
+    expect(typeof row!.durationMs).toBe("number");
+    expect(typeof row!.startedAt).toBe("string");
+    expect(typeof row!.completedAt).toBe("string");
+    expect(row!.inputSummary).toBeUndefined();
+    expect(row!.outputSummary).toBeUndefined();
+    const text = JSON.stringify(row);
+    expect(text).not.toContain(SECRET_INPUT);
+    expect(text).not.toContain(SECRET_OUTPUT);
+  });
+
+  it("still returns the full output to the caller", async () => {
+    const { runner } = setup();
+    const run = await runner.run(input({ audit: "outcome" }));
+    expect(run!.result).toEqual({ ok: true, output: { snippet: SECRET_OUTPUT } });
+  });
+
+  it("keeps the error code of a failed run and stores no summaries", async () => {
+    const { runner, database } = setup(async () => ({
+      ok: false,
+      error: { code: "provider_error", message: `upstream said ${SECRET_OUTPUT}` },
+    }));
+    const run = await runner.run(input({ audit: "outcome" }));
+    const row = await database.runLogStore.get(run!.executionId);
+    expect(row).toMatchObject({ ok: false, errorCode: "provider_error" });
+    expect(row!.inputSummary).toBeUndefined();
+    expect(row!.outputSummary).toBeUndefined();
+    expect(JSON.stringify(row)).not.toContain(SECRET_INPUT);
+  });
+
+  it("records a policy refusal with its decision and no summaries", async () => {
+    const { runner, database } = setup();
+    const blocked = new ActionPolicyService({ blockedActions: ["example.echo"] }).createSnapshot();
+    const run = await runner.run(input({ audit: "outcome", policy: blocked }));
+    expect(run!.result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    const row = await database.runLogStore.get(run!.executionId);
+    expect(row).toMatchObject({ ok: false, policy: { allowed: false, code: "action_blocked" }, errorCode: "action_blocked" });
+    expect(row!.inputSummary).toBeUndefined();
+    expect(JSON.stringify(row)).not.toContain(SECRET_INPUT);
+  });
+});
+
+describe("ActionRunner audit: default behaviour is unchanged", () => {
+  it.each(["http", "mcp", "web", "cron"])("keeps input and output summaries for the %s caller when audit is not set", async (caller) => {
+    const { runner, database } = setup();
+    const run = await runner.run(input({ caller: caller as RunActionInput["caller"] }));
+    const row = await database.runLogStore.get(run!.executionId);
+    expect(row).toMatchObject({
+      caller,
+      inputSummary: { subject: SECRET_INPUT, token: "[redacted]" },
+      outputSummary: { snippet: SECRET_OUTPUT },
+    });
+  });
+
+  it("does not let one run's audit option leak into the next", async () => {
+    const { runner, database } = setup();
+    const quiet = await runner.run(input({ audit: "outcome" }));
+    const loud = await runner.run(input());
+    expect((await database.runLogStore.get(quiet!.executionId))!.inputSummary).toBeUndefined();
+    expect((await database.runLogStore.get(loud!.executionId))!.inputSummary).toMatchObject({ subject: SECRET_INPUT });
+  });
+});
+
+describe("the cron caller in the run log store", () => {
+  it("stores and filters runs by caller cron", async () => {
+    const { runner, database } = setup();
+    const cron = await runner.run(input({ audit: "outcome" }));
+    await runner.run(input({ caller: "http" }));
+    const page = await database.runLogStore.list({ caller: "cron" });
+    expect(page.items.map((item) => item.id)).toEqual([cron!.executionId]);
+    expect(page.items[0]!.caller).toBe("cron");
+  });
+});
