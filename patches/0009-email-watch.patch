+import { describe, expect, it } from "vitest";
+import { createLogCapture } from "./test-support.ts";
+import { isWatchDue, parseEmailWatchConfig } from "./config.ts";
+
+// Interface pinned for decision 1 and 2 (see the comment block in watcher.test.ts for the whole module map):
+//   parseEmailWatchConfig(env, logger?) -> { connections: string[]; intervalMinutes: number }
+//   isWatchDue(scheduledTimeMs, intervalMinutes) -> boolean
+
+const CONNECTIONS = "OOMOL_CONNECT_EMAIL_WATCH_CONNECTIONS";
+const INTERVAL = "OOMOL_CONNECT_EMAIL_WATCH_INTERVAL_MINUTES";
+
+describe("parseEmailWatchConfig", () => {
+  it.each([undefined, "", "   ", "\n\t "])("is off for an unset or blank connection list (%j)", (value) => {
+    const config = parseEmailWatchConfig({ [CONNECTIONS]: value });
+    expect(config.connections).toEqual([]);
+  });
+
+  it("reads comma- and whitespace-separated gmail:<name> entries in order", () => {
+    const config = parseEmailWatchConfig({ [CONNECTIONS]: "gmail:work, gmail:ops\ngmail:home,\tgmail:side" });
+    expect(config.connections).toEqual(["work", "ops", "home", "side"]);
+  });
+
+  it("lists a repeated connection once", () => {
+    const config = parseEmailWatchConfig({ [CONNECTIONS]: "gmail:work gmail:work,gmail:ops" });
+    expect(config.connections).toEqual(["work", "ops"]);
+  });
+
+  it.each(["slack:team", "outlook:work", "gmail", "work", "gmail:", ":work", "gmail:work:extra", ":"])(
+    "ignores the entry %j and warns once",
+    (entry) => {
+      const log = createLogCapture();
+      const config = parseEmailWatchConfig({ [CONNECTIONS]: `gmail:good ${entry}` }, log.logger);
+      expect(config.connections).toEqual(["good"]);
+      expect(log.entries.filter((e) => e.level === "warn")).toHaveLength(1);
+    },
+  );
+
+  it("warns once for any number of bad entries, and names no entry text, subject or address", () => {
+    const log = createLogCapture();
+    const config = parseEmailWatchConfig(
+      { [CONNECTIONS]: "slack:team gmail: nocolon owner@example.org gmail:ops :alias" },
+      log.logger,
+    );
+    expect(config.connections).toEqual(["ops"]);
+    const warnings = log.entries.filter((e) => e.level === "warn");
+    expect(warnings).toHaveLength(1);
+    expect(log.text()).not.toContain("owner@example.org");
+    expect(log.text()).not.toContain("nocolon");
+  });
+
+  it("does not warn when every entry is valid or the list is empty", () => {
+    const log = createLogCapture();
+    parseEmailWatchConfig({ [CONNECTIONS]: "gmail:work" }, log.logger);
+    parseEmailWatchConfig({}, log.logger);
+    expect(log.entries).toEqual([]);
+  });
+
+  it("defaults the interval to 10 minutes", () => {
+    expect(parseEmailWatchConfig({ [CONNECTIONS]: "gmail:work" }).intervalMinutes).toBe(10);
+  });
+
+  it.each(["1", "5", "10", "30", "60"])("accepts the interval %s", (value) => {
+    expect(parseEmailWatchConfig({ [CONNECTIONS]: "gmail:work", [INTERVAL]: value }).intervalMinutes).toBe(Number(value));
+  });
+
+  it.each(["0", "61", "-5", "1.5", "abc", "", " ", "1e1", "10m", "NaN", "Infinity", "100"])(
+    "falls back to 10 for the invalid interval %j",
+    (value) => {
+      expect(parseEmailWatchConfig({ [CONNECTIONS]: "gmail:work", [INTERVAL]: value }).intervalMinutes).toBe(10);
+    },
+  );
+});
+
+describe("isWatchDue", () => {
+  const minute = 60_000;
+
+  it("is due exactly at minutes divisible by the interval, whatever the seconds", () => {
+    // The base is a UTC midnight, so it sits on a whole epoch minute; the oracle counts whole minutes by loop index.
+    const base = Date.UTC(2026, 10, 11, 0, 0, 0);
+    const baseMinutes = base / minute;
+    expect(Number.isInteger(baseMinutes)).toBe(true);
+    for (const interval of [1, 2, 5, 7, 10, 60]) {
+      for (let offset = 0; offset < 130; offset += 1) {
+        for (const seconds of [0, 1, 30_000, 59_999]) {
+          const expected = (baseMinutes + offset) % interval === 0;
+          expect(isWatchDue(base + offset * minute + seconds, interval), `interval ${interval}, +${offset} min, +${seconds} ms`).toBe(
+            expected,
+          );
+        }
+      }
+    }
+  });
+
+  it("uses minutes since the epoch, not minutes past the hour (interval 7 is due at epoch minute 7)", () => {
+    expect(isWatchDue(7 * minute, 7)).toBe(true);
+    expect(isWatchDue(7 * minute - 1, 7)).toBe(false);
+    expect(isWatchDue(14 * minute + 59_999, 7)).toBe(true);
+    expect(isWatchDue(15 * minute, 7)).toBe(false);
+  });
+
+  it("is due every minute at interval 1", () => {
+    expect(isWatchDue(Date.UTC(2026, 10, 11, 12, 34, 56), 1)).toBe(true);
+  });
+});
diff --git a/src/server/email-watch/config.ts b/src/server/email-watch/config.ts
new file mode 100644
index 00000000..a3e73323
--- /dev/null
+++ b/src/server/email-watch/config.ts
@@ -0,0 +1,49 @@
+import type { RuntimeLogger } from "../../core/types.ts";
+
+export const DEFAULT_INTERVAL_MINUTES = 10;
+
+export interface EmailWatchConfig {
+  /** Gmail connection names to watch, in the order given, each once. Empty means the feature is off. */
+  connections: string[];
+  intervalMinutes: number;
+}
+
+interface EmailWatchEnv {
+  OOMOL_CONNECT_EMAIL_WATCH_CONNECTIONS?: string;
+  OOMOL_CONNECT_EMAIL_WATCH_INTERVAL_MINUTES?: string;
+}
+
+/**
+ * Read the two email-watch settings. `OOMOL_CONNECT_EMAIL_WATCH_CONNECTIONS` is a comma- and/or
+ * whitespace-separated list of `gmail:<connectionName>` entries; any other entry is dropped, with one warning that
+ * does not repeat the entry. The interval is a whole number of minutes from 1 to 60, otherwise 10.
+ */
+export function parseEmailWatchConfig(env: EmailWatchEnv, logger?: RuntimeLogger): EmailWatchConfig {
+  const connections: string[] = [];
+  let ignored = 0;
+  for (const entry of (env.OOMOL_CONNECT_EMAIL_WATCH_CONNECTIONS ?? "").split(/[\s,]+/).filter(Boolean)) {
+    const parts = entry.split(":");
+    const name = parts.length === 2 && parts[0] === "gmail" ? parts[1]! : "";
+    if (!name) {
+      ignored += 1;
+    } else if (!connections.includes(name)) {
+      connections.push(name);
+    }
+  }
+  if (ignored > 0) {
+    logger?.warn({ ignoredEntries: ignored }, "email watch ignored entries that are not gmail:<connectionName>");
+  }
+  return { connections, intervalMinutes: parseInterval(env.OOMOL_CONNECT_EMAIL_WATCH_INTERVAL_MINUTES) };
+}
+
+function parseInterval(value: string | undefined): number {
+  const text = value?.trim() ?? "";
+  if (!/^\d{1,3}$/.test(text)) return DEFAULT_INTERVAL_MINUTES;
+  const minutes = Number(text);
+  return minutes >= 1 && minutes <= 60 ? minutes : DEFAULT_INTERVAL_MINUTES;
+}
+
+/** True at whole epoch minutes divisible by the interval, whatever the seconds. */
+export function isWatchDue(scheduledTimeMs: number, intervalMinutes: number): boolean {
+  return Math.floor(scheduledTimeMs / 60_000) % intervalMinutes === 0;
+}
