+import type { CatalogStore } from "../../catalog-store.ts";
+import type { RuntimeLogger } from "../../core/types.ts";
+import type { IProviderLoader } from "../../providers/provider-loader.ts";
+import type { D1RuntimeDatabase } from "../storage/d1/runtime-store.ts";
+
+import { ConnectionService } from "../../connection-service.ts";
+import { OAuthClientConfigService } from "../../oauth/oauth-client-config-service.ts";
+import { OAuthCredentialRefreshService } from "../../oauth/oauth-credential-refresh-service.ts";
+import { ActionRunner } from "../actions/action-runner.ts";
+
+export interface WatchRunnerOptions {
+  catalog: CatalogStore;
+  /** Needs only the executors of the providers the watch calls (gmail). */
+  providerLoader: IProviderLoader;
+  runtimeDatabase: D1RuntimeDatabase;
+  publicOrigin: string;
+  logger: RuntimeLogger;
+}
+
+/**
+ * The smallest ActionRunner the email watch can use on a cron tick: the D1 stores, a connection service that can
+ * refresh an OAuth token, and the runner itself. It leaves out the HTTP and MCP servers, the docs, SaaS and
+ * marketplace services, so a cold isolate does not pay for building them.
+ */
+export function createWatchActionRunner(options: WatchRunnerOptions): ActionRunner {
+  const oauthClientConfigs = new OAuthClientConfigService({
+    catalog: options.catalog,
+    origin: options.publicOrigin,
+    store: options.runtimeDatabase.oauthClientConfigStore,
+  });
+  const connections = new ConnectionService({
+    catalog: options.catalog,
+    oauthCredentials: new OAuthCredentialRefreshService(oauthClientConfigs, options.providerLoader),
+    providerLoader: options.providerLoader,
+    store: options.runtimeDatabase.connectionStore,
+    logger: options.logger,
+  });
+  return new ActionRunner({
+    catalog: options.catalog,
+    providerLoader: options.providerLoader,
+    connections,
+    runs: options.runtimeDatabase.runLogStore,
+    logger: options.logger,
+  });
+}
