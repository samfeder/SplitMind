+// Shared test fixtures for the email watch (directive #126). Synthetic data only: every address is on
+// example.com / example.org or on a rule domain (vercel.com, github.com, ...) that the rules table names.
+// Not imported by product code.
+import type { ActionRunResult, RunActionInput } from "../actions/action-runner.ts";
+import type { D1DatabaseBinding } from "../cloudflare/cloudflare-bindings.ts";
+
+export const T0: number = Date.UTC(2026, 10, 11, 12, 0, 0);
+export const HOUR = 3_600_000;
+export const DAY: number = 24 * HOUR;
+export const OWNER_EMAIL = "owner@example.org";
+
+export interface Header {
+  name: string;
+  value: string;
+}
+
+export interface FixtureMessage {
+  /** The whole From header value, for example `Vercel <no-reply@vercel.com>`. */
+  from: string;
+  subject: string;
+  to?: string;
+  snippet?: string;
+  labelIds?: string[];
+  /** Epoch milliseconds, default one minute before T0. */
+  internalDate?: number;
+  /**
+   * Authentication-Results as Gmail's own MX would stamp it. Default: dmarc=pass for the From domain.
+   * `false` leaves the header out. A string is used verbatim as the header value.
+   */
+  auth?: false | string;
+  githubReason?: string;
+  /** Full replacement for the header list, in order. Overrides everything above except From and Subject. */
+  headers?: Header[];
+}
+
+export function domainOf(fromHeader: string): string {
+  const match = fromHeader.match(/@([^>\s]+)>?\s*$/);
+  return (match?.[1] ?? "").toLowerCase();
+}
+
+/** An Authentication-Results value in the folded form Gmail returns. */
+export function authResults(
+  domain: string,
+  options: { dmarc?: string; authserv?: string; headerFrom?: string } = {},
+): string {
+  const { dmarc = "pass", authserv = "mx.google.com", headerFrom = domain } = options;
+  return [
+    `${authserv};`,
+    `       dkim=pass header.i=@${domain} header.s=sel1;`,
+    `       spf=pass (google.com: domain of bounce@${domain} designates 192.0.2.1 as permitted sender) smtp.mailfrom=bounce@${domain};`,
+    `       dmarc=${dmarc} (p=REJECT sp=REJECT dis=NONE) header.from=${headerFrom}`,
+  ].join("\r\n");
+}
+
+/** The raw header list of a delivered message, in the order Gmail would return it. */
+export function buildHeaders(message: FixtureMessage): Header[] {
+  if (message.headers) return message.headers;
+  const headers: Header[] = [{ name: "Received", value: "by 2002:a05:6a00:1 with SMTP id x1; Wed, 11 Nov 2026 11:59:00 -0800" }];
+  if (message.auth !== false) {
+    headers.push({
+      name: "Authentication-Results",
+      value: message.auth ?? authResults(domainOf(message.from)),
+    });
+  }
+  headers.push({ name: "From", value: message.from });
+  headers.push({ name: "To", value: message.to ?? `Owner <${OWNER_EMAIL}>` });
+  headers.push({ name: "Subject", value: message.subject });
+  headers.push({ name: "Date", value: "Wed, 11 Nov 2026 11:59:00 -0800" });
+  if (message.githubReason) headers.push({ name: "X-GitHub-Reason", value: message.githubReason });
+  headers.push({ name: "Message-ID", value: "<fixture-1@example.com>" });
+  return headers;
+}
+
+interface StoredMessage {
+  id: string;
+  threadId: string;
+  labelIds: string[];
+  snippet: string;
+  internalDate: number;
+  historyId: number;
+  headers: Header[];
+}
+
+export type MailboxRequestKind = "profile" | "history" | "message";
+
+export interface MailboxRequest {
+  kind: MailboxRequestKind;
+  id?: string;
+  params: URLSearchParams;
+}
+
+/**
+ * One Gmail mailbox behind a fake Gmail REST API. History ids are integers that grow by one per delivery,
+ * so `startHistoryId` comparisons work as they do against the real API.
+ */
+export class FakeMailbox {
+  readonly email: string;
+  readonly requests: MailboxRequest[] = [];
+  private readonly prefix: string;
+  private seq: number;
+  private oldestValid = 0;
+  private readonly messages = new Map<string, StoredMessage>();
+  private readonly entries: StoredMessage[] = [];
+  private readonly failures = new Map<string, number>();
+  /** When true, every history record is listed twice, as overlapping pages and retries can produce. */
+  duplicateHistoryRecords = false;
+
+  constructor(options: { prefix?: string; email?: string; startHistoryId?: number } = {}) {
+    this.prefix = options.prefix ?? "m";
+    this.email = options.email ?? OWNER_EMAIL;
+    this.seq = options.startHistoryId ?? 1000;
+  }
+
+  get historyId(): string {
+    return String(this.seq);
+  }
+
+  /** Delivers a message and returns its Gmail id. */
+  deliver(message: FixtureMessage): string {
+    this.seq += 1;
+    const id = `${this.prefix}-${String(this.messages.size + 1).padStart(4, "0")}`;
+    const stored: StoredMessage = {
+      id,
+      threadId: `t-${id}`,
+      labelIds: message.labelIds ?? ["INBOX", "UNREAD"],
+      snippet: message.snippet ?? `Snippet body for ${id}, private text`,
+      internalDate: message.internalDate ?? T0 - 60_000,
+      historyId: this.seq,
+      headers: buildHeaders(message),
+    };
+    this.messages.set(id, stored);
+    this.entries.push(stored);
+    return id;
+  }
+
+  /** Makes every start id older than the present answer 404, as Gmail does for a history id it no longer keeps. */
+  expireHistory(): void {
+    this.oldestValid = this.seq;
+  }
+
+  /** Makes the next requests of one kind answer with this HTTP status. Keys: profile, history, message, message:<id>. */
+  failWith(key: string, status: number): void {
+    this.failures.set(key, status);
+  }
+
+  clearFailures(): void {
+    this.failures.clear();
+  }
+
+  threadIdOf(id: string): string {
+    return this.messages.get(id)!.threadId;
+  }
+
+  messageRequests(): MailboxRequest[] {
+    return this.requests.filter((request) => request.kind === "message");
+  }
+
+  /** Answers a Gmail REST request path (after /users/me) and query. */
+  rest(pathname: string, params: URLSearchParams): Response {
+    if (pathname === "/profile") return this.answer("profile", undefined, params);
+    if (pathname === "/history") return this.answer("history", undefined, params);
+    const message = pathname.match(/^\/messages\/([^/]+)$/);
+    if (message) return this.answer("message", decodeURIComponent(message[1]!), params);
+    return Response.json({ error: { code: 404, message: "not found", errors: [] } }, { status: 404 });
+  }
+
+  private answer(kind: MailboxRequestKind, id: string | undefined, params: URLSearchParams): Response {
+    this.requests.push({ kind, id, params });
+    const status = this.failures.get(kind === "message" ? `message:${id}` : kind) ?? this.failures.get(kind);
+    if (status) {
+      return Response.json({ error: { code: status, message: "fixture failure", errors: [] } }, { status });
+    }
+    if (kind === "profile") {
+      return Response.json({
+        emailAddress: this.email,
+        messagesTotal: this.messages.size,
+        threadsTotal: this.messages.size,
+        historyId: this.historyId,
+      });
+    }
+    if (kind === "history") return this.history(params);
+    return this.message(id!, params);
+  }
+
+  private history(params: URLSearchParams): Response {
+    const start = Number(params.get("startHistoryId"));
+    if (!Number.isFinite(start) || start < this.oldestValid) {
+      return Response.json({ error: { code: 404, message: "Requested entity was not found.", errors: [] } }, { status: 404 });
+    }
+    const pageSize = Number(params.get("maxResults") ?? 100);
+    const offset = params.get("pageToken") ? Number(params.get("pageToken")!.slice(1)) : 0;
+    const pending = this.entries.filter((entry) => entry.historyId > start);
+    const page = pending.slice(offset, offset + pageSize);
+    const body: Record<string, unknown> = { historyId: this.historyId };
+    if (page.length > 0) {
+      body.history = (this.duplicateHistoryRecords ? page.flatMap((entry) => [entry, entry]) : page).map((entry) => ({
+        id: String(entry.historyId),
+        messages: [{ id: entry.id, threadId: entry.threadId }],
+        messagesAdded: [{ message: { id: entry.id, threadId: entry.threadId, labelIds: entry.labelIds } }],
+      }));
+    }
+    if (offset + pageSize < pending.length) body.nextPageToken = `p${offset + pageSize}`;
+    return Response.json(body);
+  }
+
+  private message(id: string, params: URLSearchParams): Response {
+    const stored = this.messages.get(id);
+    if (!stored) {
+      return Response.json({ error: { code: 404, message: "Requested entity was not found.", errors: [] } }, { status: 404 });
+    }
+    const format = params.get("format") ?? "full";
+    const wanted = params.getAll("metadataHeaders").map((name) => name.toLowerCase());
+    const headers =
+      format === "metadata" && wanted.length > 0
+        ? stored.headers.filter((header) => wanted.includes(header.name.toLowerCase()))
+        : stored.headers;
+    return Response.json({
+      id: stored.id,
+      threadId: stored.threadId,
+      labelIds: stored.labelIds,
+      snippet: stored.snippet,
+      historyId: String(stored.historyId),
+      internalDate: String(stored.internalDate),
+      sizeEstimate: 1234,
+      payload: { partId: "", mimeType: "text/html", headers },
+    });
+  }
+}
+
+/** A `fetch` that routes Gmail REST calls to a mailbox chosen by the bearer token `token-<connection>`. */
+export function fakeGmailFetch(mailboxes: Record<string, FakeMailbox>): typeof fetch {
+  return (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url);
+    const headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined));
+    const token = headers.get("authorization")?.replace(/^Bearer /i, "") ?? "";
+    const mailbox = mailboxes[token.replace(/^token-/, "")];
+    if (url.hostname !== "gmail.googleapis.com" || !url.pathname.startsWith("/gmail/v1/users/me") || !mailbox) {
+      return Response.json({ error: { code: 401, message: "unexpected request", errors: [] } }, { status: 401 });
+    }
+    return mailbox.rest(url.pathname.slice("/gmail/v1/users/me".length), url.searchParams);
+  }) as typeof fetch;
+}
+
+/** Normalizes a Gmail message resource the way `fetch_message_by_message_id` returns it. */
+function normalize(resource: Record<string, any>): Record<string, unknown> {
+  const headers: Header[] = resource.payload?.headers ?? [];
+  const read = (name: string) => headers.find((header) => header.name.toLowerCase() === name.toLowerCase())?.value ?? "";
+  return {
+    messageId: resource.id,
+    threadId: resource.threadId,
+    labelIds: resource.labelIds ?? [],
+    subject: read("Subject"),
+    sender: read("From"),
+    to: read("To"),
+    messageTimestamp: new Date(Number(resource.internalDate)).toISOString(),
+    historyId: resource.historyId,
+    internalDate: resource.internalDate,
+    sizeEstimate: resource.sizeEstimate,
+    snippet: resource.snippet,
+    preview: { subject: read("Subject"), body: resource.snippet ?? "" },
+    payload: resource.payload ?? null,
+    messageText: "",
+    attachmentList: [],
+  };
+}
+
+export interface RunnerCall {
+  actionId: string;
+  input: Record<string, unknown>;
+  connectionName: string | undefined;
+  caller: string;
+  audit: unknown;
+}
+
+/**
+ * An ActionRunner stand-in over fake mailboxes: it returns what the real runner returns for the three Gmail
+ * reads (`{ok, output}` or `{ok: false, error: {code, details: {status}}}`), without a catalog or store.
+ */
+export class FakeGmailRunner {
+  readonly calls: RunnerCall[] = [];
+  /** Return an error code to refuse the call the way deployment policy or a connection grant does. */
+  refuse?: (call: RunnerCall) => string | undefined;
+  /** Awaited before the call is answered. */
+  beforeRun?: (call: RunnerCall) => Promise<void>;
+  /** Awaited after the answer is computed and before it is returned, so a test can hold an invocation holding stale data. */
+  afterRun?: (call: RunnerCall) => Promise<void>;
+  private readonly mailboxes: Record<string, FakeMailbox>;
+
+  constructor(mailboxes: Record<string, FakeMailbox>) {
+    this.mailboxes = mailboxes;
+  }
+
+  callsTo(actionId: string, connectionName?: string): RunnerCall[] {
+    return this.calls.filter(
+      (call) => call.actionId === actionId && (connectionName === undefined || call.connectionName === connectionName),
+    );
+  }
+
+  async run(input: RunActionInput): Promise<ActionRunResult | undefined> {
+    const call = this.record(input);
+    await this.beforeRun?.(call);
+    const result = await this.answer(input, call);
+    await this.afterRun?.(call);
+    return result;
+  }
+
+  private record(input: RunActionInput): RunnerCall {
+    const call: RunnerCall = {
+      actionId: input.actionId,
+      input: structuredClone(input.input as Record<string, unknown>),
+      connectionName: input.connectionName,
+      caller: input.caller,
+      audit: (input as { audit?: unknown }).audit,
+    };
+    this.calls.push(call);
+    return call;
+  }
+
+  private async answer(input: RunActionInput, call: RunnerCall): Promise<ActionRunResult> {
+    const refusal = this.refuse?.(call);
+    if (refusal) return this.result({ ok: false, error: { code: refusal, message: "refused" } });
+    const mailbox = this.mailboxes[input.connectionName ?? ""];
+    if (!mailbox) return this.result({ ok: false, error: { code: "connection_not_found", message: "no connection" } });
+
+    const params = new URLSearchParams();
+    let path: string;
+    const body = call.input;
+    if (input.actionId === "gmail.get_profile") {
+      path = "/profile";
+    } else if (input.actionId === "gmail.list_history") {
+      path = "/history";
+      params.set("startHistoryId", String(body.startHistoryId));
+      if (body.pageToken != null) params.set("pageToken", String(body.pageToken));
+      if (body.maxResults != null) params.set("maxResults", String(body.maxResults));
+      if (body.labelId != null) params.set("labelId", String(body.labelId));
+      for (const type of (body.historyTypes as string[] | undefined) ?? []) params.append("historyTypes", type);
+    } else if (input.actionId === "gmail.fetch_message_by_message_id") {
+      path = `/messages/${encodeURIComponent(String(body.messageId))}`;
+      params.set("format", String(body.format ?? "full"));
+      for (const name of (body.metadataHeaders as string[] | undefined) ?? []) params.append("metadataHeaders", name);
+    } else {
+      throw new Error(`FakeGmailRunner was asked to run ${input.actionId}`);
+    }
+
+    const response = mailbox.rest(path, params);
+    const json = (await response.json()) as Record<string, any>;
+    if (!response.ok) {
+      const status = response.status;
+      const code = status === 429 ? "rate_limited" : status === 401 || status === 403 ? "authorization_failed" : status < 500 ? "invalid_input" : "provider_error";
+      return this.result({ ok: false, error: { code, message: `gmail request failed with ${status}`, details: { status } } });
+    }
+    if (input.actionId === "gmail.list_history") {
+      return this.result({
+        ok: true,
+        output: { history: json.history ?? [], historyId: json.historyId, nextPageToken: json.nextPageToken ?? null },
+      });
+    }
+    if (input.actionId === "gmail.fetch_message_by_message_id") return this.result({ ok: true, output: normalize(json) });
+    return this.result({ ok: true, output: json });
+  }
+
+  private result(result: ActionRunResult["result"]): ActionRunResult {
+    return { executionId: crypto.randomUUID(), auditPersisted: true, result };
+  }
+}
+
+export interface LogEntry {
+  level: "info" | "warn" | "error";
+  fields: unknown;
+  message: string;
+}
+
+export function createLogCapture(): {
+  entries: LogEntry[];
+  logger: { info(f: Record<string, unknown>, m: string): void; warn(f: Record<string, unknown>, m: string): void; error(f: Record<string, unknown>, m: string): void };
+  text(): string;
+} {
+  const entries: LogEntry[] = [];
+  const write = (level: LogEntry["level"]) => (fields: Record<string, unknown>, message: string) => {
+    entries.push({ level, fields, message });
+  };
+  return {
+    entries,
+    logger: { info: write("info"), warn: write("warn"), error: write("error") },
+    text: () => JSON.stringify(entries, (_key, value) => (value instanceof Error ? { message: value.message, stack: value.stack } : value)),
+  };
+}
+
+/** One row of `email_watch_items` with every column set, for seeding. */
+export interface ItemRow {
+  id: string;
+  connection_name: string;
+  gmail_message_id: string;
+  gmail_thread_id: string;
+  sender_domain: string;
+  subject: string;
+  category: string;
+  rule_id: string;
+  received_at: string;
+  created_at: string;
+  status: "pending" | "acknowledged";
+  acknowledged_at: string | null;
+  dedup_key: string;
+  occurrences: number;
+}
+
+export function itemRow(overrides: Partial<ItemRow> & Pick<ItemRow, "id">): ItemRow {
+  return {
+    connection_name: "work",
+    gmail_message_id: `gm-${overrides.id}`,
+    gmail_thread_id: `gt-${overrides.id}`,
+    sender_domain: "vercel.com",
+    subject: `Seed subject ${overrides.id}`,
+    category: "deploy_failed",
+    rule_id: "seed-rule",
+    received_at: new Date(T0 - HOUR).toISOString(),
+    created_at: new Date(T0 - HOUR).toISOString(),
+    status: "pending",
+    acknowledged_at: null,
+    dedup_key: `seed-key-${overrides.id}`,
+    occurrences: 1,
+    ...overrides,
+  };
+}
+
+type SqlDatabase = D1DatabaseBinding;
+
+export async function insertItem(database: SqlDatabase, row: ItemRow): Promise<void> {
+  const columns = Object.keys(row);
+  await database
+    .prepare(`insert into email_watch_items (${columns.join(", ")}) values (${columns.map(() => "?").join(", ")})`)
+    .bind(...Object.values(row))
+    .run();
+}
+
+export async function insertCursor(
+  database: SqlDatabase,
+  row: { connection_name: string; history_id: string; page_token?: string | null; last_run_at: string; catch_up?: number },
+): Promise<void> {
+  await database
+    .prepare(
+      "insert into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up) values (?, ?, ?, ?, ?)",
+    )
+    .bind(row.connection_name, row.history_id, row.page_token ?? null, row.last_run_at, row.catch_up ?? 0)
+    .run();
+}
+
+export async function selectAll<T = Record<string, unknown>>(database: SqlDatabase, query: string): Promise<T[]> {
+  return (await database.prepare(query).all<T>()).results;
+}
