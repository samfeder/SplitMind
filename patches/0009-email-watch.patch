+++ b/src/server/email-watch/rules.ts
@@ -0,0 +1,157 @@
+export type EmailWatchCategory = "deploy_failed" | "github" | "account_security" | "billing_quota";
+
+export interface MailHeader {
+  name: string;
+  value: string;
+}
+
+export interface EmailWatchRule {
+  id: string;
+  category: EmailWatchCategory;
+  /** The sender's domain must equal one of these or be a subdomain of one. */
+  domains: readonly string[];
+  /** Matched against the sender-visible subject. */
+  subject?: RegExp;
+  /** The named header must be present with one of these values (case-insensitive). */
+  header?: { name: string; values: readonly string[] };
+}
+
+export interface EmailWatchMatch {
+  category: EmailWatchCategory;
+  ruleId: string;
+  senderDomain: string;
+  /** Control characters stripped, at most 200 characters: what is stored. */
+  subject: string;
+}
+
+const failure = /\b(fail(ed|ure)?|error(ed)?|did not deploy|could not deploy)\b/i;
+const ciFailure = /\b(fail(ed|ure)?|cancell?ed)\b/i;
+
+/**
+ * Which machine mail needs action. Rows are tried in order and the first match wins; a row matches when the
+ * sender domain, the subject (if it has one) and the header condition (if it has one) all hold.
+ */
+export const emailWatchRules: readonly EmailWatchRule[] = [
+  { id: "deploy-failed", category: "deploy_failed", domains: ["vercel.com", "netlify.com", "cloudflare.com"], subject: failure },
+  {
+    id: "github-reason",
+    category: "github",
+    domains: ["github.com"],
+    header: { name: "X-GitHub-Reason", values: ["review_requested", "security_alert"] },
+  },
+  {
+    id: "github-ci-failed",
+    category: "github",
+    domains: ["github.com"],
+    header: { name: "X-GitHub-Reason", values: ["ci_activity"] },
+    subject: ciFailure,
+  },
+  { id: "github-security-subject", category: "github", domains: ["github.com"], subject: /dependabot|security (alert|advisory)/i },
+  {
+    id: "account-security",
+    category: "account_security",
+    domains: [
+      "google.com",
+      "accounts.google.com",
+      "github.com",
+      "vercel.com",
+      "netlify.com",
+      "cloudflare.com",
+      "anthropic.com",
+    ],
+    subject: /\b(new sign-?in|security alert|password|two-factor|2fa|verification code|suspicious)\b/i,
+  },
+  {
+    id: "billing-quota",
+    category: "billing_quota",
+    domains: ["vercel.com", "netlify.com", "cloudflare.com", "github.com", "google.com", "anthropic.com"],
+    subject: /\b(usage|limit|quota|exceed(ed|s)?|payment (failed|declined)|past due|suspend(ed)?)\b/i,
+  },
+];
+
+const MAX_SUBJECT_LENGTH = 200;
+const TRUSTED_AUTHSERV_ID = "mx.google.com";
+
+/**
+ * Classify one message from Gmail's raw `payload.headers`, in Gmail's order. Returns undefined when no rule may
+ * match, which includes every anti-spoofing refusal: a rule can only match when Gmail's own first
+ * Authentication-Results header says dmarc=pass for the From address's domain.
+ */
+export function classifyMessage(headers: readonly MailHeader[]): EmailWatchMatch | undefined {
+  const senderDomain = senderDomainOf(firstHeader(headers, "From"));
+  if (!senderDomain || !dmarcPassesFor(firstHeader(headers, "Authentication-Results"), senderDomain)) return undefined;
+
+  const fullSubject = stripControlCharacters(firstHeader(headers, "Subject") ?? "");
+  for (const rule of emailWatchRules) {
+    if (!rule.domains.some((domain) => senderDomain === domain || senderDomain.endsWith(`.${domain}`))) continue;
+    if (rule.subject && !rule.subject.test(fullSubject)) continue;
+    if (rule.header && !headerHasValue(headers, rule.header.name, rule.header.values)) continue;
+    return { category: rule.category, ruleId: rule.id, senderDomain, subject: truncate(fullSubject) };
+  }
+  return undefined;
+}
+
+function firstHeader(headers: readonly MailHeader[], name: string): string | undefined {
+  const wanted = name.toLowerCase();
+  return headers.find((header) => header.name.toLowerCase() === wanted)?.value;
+}
+
+function headerHasValue(headers: readonly MailHeader[], name: string, values: readonly string[]): boolean {
+  const value = firstHeader(headers, name)?.trim().toLowerCase();
+  return value !== undefined && values.includes(value);
+}
+
+/** The domain of the address in angle brackets, or of a bare address. Lists of addresses are not accepted. */
+function senderDomainOf(from: string | undefined): string | undefined {
+  if (!from) return undefined;
+  const brackets = from.match(/<[^<>]*>/g) ?? [];
+  if (brackets.length > 1) return undefined;
+  const address = brackets.length === 1 ? brackets[0]!.slice(1, -1) : from;
+  const at = address.lastIndexOf("@");
+  const domain = address
+    .slice(at + 1)
+    .trim()
+    .toLowerCase();
+  return at > 0 && /^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$/.test(domain) ? domain : undefined;
+}
+
+/**
+ * True when the header is Gmail's own (authserv-id mx.google.com) and every dmarc result in it is a pass whose
+ * header.from equals the From domain. Comments in parentheses are dropped first, so text inside one cannot count.
+ */
+function dmarcPassesFor(value: string | undefined, senderDomain: string): boolean {
+  if (!value) return false;
+  let text = value;
+  for (let previous = ""; previous !== text; ) {
+    previous = text;
+    text = text.replace(/\([^()]*\)/g, " ");
+  }
+  const [authservId, ...results] = text.split(";");
+  if (authservId!.trim().split(/\s+/)[0]?.toLowerCase() !== TRUSTED_AUTHSERV_ID) return false;
+
+  const dmarcResults = results
+    .map((result) => result.trim().split(/\s+/))
+    .filter((tokens) => /^dmarc=/i.test(tokens[0] ?? ""));
+  return (
+    dmarcResults.length > 0 &&
+    dmarcResults.every((tokens) => {
+      const headerFrom = tokens.find((token) => /^header\.from=/i.test(token));
+      return (
+        tokens[0]!.slice("dmarc=".length).toLowerCase() === "pass" &&
+        headerFrom?.slice("header.from=".length).toLowerCase() === senderDomain
+      );
+    })
+  );
+}
+
+function stripControlCharacters(text: string): string {
+  // oxlint-disable-next-line no-control-regex -- control characters are exactly what this removes
+  return text.replace(/[\u0000-\u001f\u007f-\u009f]/g, "");
+}
+
+function truncate(subject: string): string {
+  if (subject.length <= MAX_SUBJECT_LENGTH) return subject;
+  const cut = subject.slice(0, MAX_SUBJECT_LENGTH);
+  // Do not leave half of a surrogate pair at the end.
+  return /[\ud800-\udbff]$/.test(cut) ? cut.slice(0, -1) : cut;
+}
