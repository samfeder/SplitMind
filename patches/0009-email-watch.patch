diff --git a/src/server/cloudflare-email-watch.test.ts b/src/server/cloudflare-email-watch.test.ts
new file mode 100644
index 00000000..6107ce92
--- /dev/null
+++ b/src/server/cloudflare-email-watch.test.ts
@@ -0,0 +1,534 @@
+// The Worker's cron seam for the email watch (decisions 1, 2, 3, 4 and 11): `worker.scheduled(event, env, ctx)`
+// with a real D1-shaped SQLite database, the real ActionRunner and Gmail executors, and a fake Gmail REST API
+// behind `fetch`. Module interface: see the comment block at the top of email-watch/watcher.test.ts.
+import type { AssetsBinding, D1DatabaseBinding, D1PreparedStatementBinding, R2BucketBinding, R2ObjectBinding } from "./cloudflare/cloudflare-bindings.ts";
+import type { CloudflareEnv } from "./cloudflare/cloudflare-env.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { provider as gmail } from "../providers/gmail/definition.ts";
+import worker from "./cloudflare.ts";
+import { FakeMailbox, OWNER_EMAIL, T0, fakeGmailFetch } from "./email-watch/test-support.ts";
+import type { FixtureMessage } from "./email-watch/test-support.ts";
+import { createWorkerSecretCodec } from "./secrets/worker-secret-codec.ts";
+import { D1RuntimeDatabase } from "./storage/d1/runtime-store.ts";
+import { SqliteD1Database } from "./storage/d1/test-database.ts";
+
+const CONNECTIONS = "OOMOL_CONNECT_EMAIL_WATCH_CONNECTIONS";
+const INTERVAL = "OOMOL_CONNECT_EMAIL_WATCH_INTERVAL_MINUTES";
+const minute = 60_000;
+// An epoch minute divisible by 60, so every interval from 1 to 60 that divides 60 is due at it.
+const M0 = Math.ceil(T0 / minute / 60) * 60;
+const at = (epochMinute: number) => epochMinute * minute + 30_000;
+
+const catalog: Record<string, unknown> = {
+  "/catalog/index.json": { version: 1, providerCount: 1, chunks: ["apps-0000.json"] },
+  "/catalog/apps-0000.json": [JSON.parse(JSON.stringify(gmail))],
+};
+
+const assets: AssetsBinding = {
+  async fetch(request) {
+    const pathname = new URL(request.url).pathname;
+    return pathname in catalog ? Response.json(catalog[pathname]) : new Response("not found", { status: 404 });
+  },
+};
+
+class RecordingD1 implements D1DatabaseBinding {
+  readonly queries: string[] = [];
+  readonly inner = new SqliteD1Database();
+  failWhen?: (query: string) => boolean;
+
+  batch(statements: D1PreparedStatementBinding[]) {
+    return this.inner.batch(statements);
+  }
+
+  prepare(query: string): D1PreparedStatementBinding {
+    this.queries.push(query);
+    if (this.failWhen?.(query)) throw new Error("fixture D1 failure");
+    return this.inner.prepare(query);
+  }
+
+  watchQueries(): string[] {
+    return this.queries.filter((query) => /email_watch/i.test(query));
+  }
+}
+
+class UnusedBucket implements R2BucketBinding {
+  async put(): Promise<unknown> {
+    throw new Error("Unexpected R2 put");
+  }
+  async get(): Promise<R2ObjectBinding | null> {
+    throw new Error("Unexpected R2 get");
+  }
+  async delete(): Promise<void> {
+    throw new Error("Unexpected R2 delete");
+  }
+}
+
+let counter = 0;
+const openDatabases: RecordingD1[] = [];
+
+interface Setup {
+  db: RecordingD1;
+  env: CloudflareEnv;
+  mailboxes: Record<string, FakeMailbox>;
+  fetcher: ReturnType<typeof vi.fn>;
+  /** Run one cron invocation at the given epoch minute and wait for everything it handed to waitUntil. */
+  tick(epochMinute: number): Promise<PromiseSettledResult<unknown>[]>;
+  watchRows<T = Record<string, any>>(table: "email_watch_items" | "email_watch_cursors"): Promise<T[]>;
+}
+
+async function setup(options: {
+  names?: string[];
+  vars?: Partial<CloudflareEnv>;
+  withAssets?: boolean;
+  fetchImpl?: typeof fetch;
+}): Promise<Setup> {
+  const n = ++counter;
+  const names = options.names ?? ["work"];
+  const db = new RecordingD1();
+  openDatabases.push(db);
+  // Each setup gets its own origin and key: the Worker caches built apps by those, not by database.
+  const key = `email-watch-key-${n}`;
+  const runtime = new D1RuntimeDatabase(db, { secretCodec: await createWorkerSecretCodec(key) });
+  const mailboxes: Record<string, FakeMailbox> = {};
+  for (const [index, name] of names.entries()) {
+    mailboxes[name] = new FakeMailbox({ prefix: `w${index}` });
+    await runtime.connectionStore.set("gmail", name, {
+      authType: "oauth2",
+      accessToken: `token-${name}`,
+      tokenType: "Bearer",
+      metadata: {},
+      profile: { accountId: mailboxes[name]!.email, displayName: mailboxes[name]!.email, grantedScopes: [] },
+    });
+  }
+  db.queries.length = 0;
+  const fetcher = vi.fn(options.fetchImpl ?? fakeGmailFetch(mailboxes));
+  vi.stubGlobal("fetch", fetcher);
+  const env: CloudflareEnv = {
+    DB: db,
+    TRANSIT_FILES: new UnusedBucket(),
+    ...(options.withAssets === false ? {} : { ASSETS: assets }),
+    OOMOL_CONNECT_ENCRYPTION_KEY: key,
+    OOMOL_CONNECT_ORIGIN: `https://watch-${n}.example.com`,
+    ...options.vars,
+  };
+  return {
+    db,
+    env,
+    mailboxes,
+    fetcher,
+    async tick(epochMinute) {
+      const pending: Promise<unknown>[] = [];
+      await worker.scheduled(
+        { scheduledTime: at(epochMinute), cron: "* * * * *" },
+        env,
+        { waitUntil: (promise) => void pending.push(promise), passThroughOnException() {} },
+      );
+      expect(pending).toHaveLength(1);
+      return Promise.allSettled(pending);
+    },
+    async watchRows(table) {
+      return (await db.inner.prepare(`select * from ${table}`).all()).results as any[];
+    },
+  };
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+  for (const db of openDatabases.splice(0)) db.inner.close();
+});
+
+function vercelFailure(subject: string): FixtureMessage {
+  return { from: "Vercel <no-reply@vercel.com>", subject, snippet: "Snippet that must never be stored or logged" };
+}
+
+describe("off by default", () => {
+  it.each([undefined, "", "   ", "\n"])("does no watch D1 query and no Gmail call when the connection list is %j", async (value) => {
+    const s = await setup({ vars: { [CONNECTIONS]: value }, withAssets: false });
+    const results = await s.tick(M0);
+    expect(results).toEqual([{ status: "fulfilled", value: undefined }]);
+    expect(s.db.watchQueries()).toEqual([]);
+    expect(s.fetcher).not.toHaveBeenCalled();
+    expect(Object.values(s.mailboxes).flatMap((mailbox) => mailbox.requests)).toEqual([]);
+  });
+
+  it("makes no Gmail call when every entry is malformed or not Gmail", async () => {
+    const s = await setup({ vars: { [CONNECTIONS]: "slack:team outlook:work gmail: nocolon :alias" } });
+    await s.tick(M0);
+    expect(s.fetcher).not.toHaveBeenCalled();
+  });
+});
+
+describe("which connections run", () => {
+  it("watches the valid gmail:<name> entries, ignores the rest, and warns once without naming a subject or address", async () => {
+    const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+    vi.spyOn(console, "info").mockImplementation(() => {});
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const s = await setup({
+      names: ["work", "ops"],
+      vars: { [CONNECTIONS]: `gmail:work, slack:team gmail: nocolon\n:alias gmail:ops ${OWNER_EMAIL}` },
+    });
+    await s.tick(M0);
+
+    const names = (await s.watchRows<{ connection_name: string }>("email_watch_cursors")).map((row) => row.connection_name).sort();
+    expect(names).toEqual(["ops", "work"]);
+    expect(s.mailboxes.work!.requests.map((request) => request.kind)).toEqual(["profile"]);
+    expect(s.mailboxes.ops!.requests.map((request) => request.kind)).toEqual(["profile"]);
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(JSON.stringify(warn.mock.calls)).not.toContain(OWNER_EMAIL);
+  });
+});
+
+describe("when the watch runs", () => {
+  async function ran(s: Setup, epochMinute: number): Promise<boolean> {
+    await s.tick(epochMinute);
+    return (await s.watchRows("email_watch_cursors")).length > 0;
+  }
+
+  it.each([
+    // [interval variable, minutes after M0, runs?]
+    [undefined, 0, true],
+    [undefined, 1, false],
+    [undefined, 5, false],
+    [undefined, 9, false],
+    [undefined, 10, true],
+    [undefined, 20, true],
+    ["10", 7, false],
+    ["5", 5, true],
+    ["5", 3, false],
+    ["1", 3, true],
+    ["60", 30, false],
+    ["60", 60, true],
+    ["0", 5, false],
+    ["0", 10, true],
+    ["61", 5, false],
+    ["abc", 5, false],
+    ["abc", 10, true],
+    ["1.5", 5, false],
+    ["-3", 3, false],
+  ])("interval %j, %i minutes into the hour: runs %j", async (interval, offset, expected) => {
+    const s = await setup({ vars: { [CONNECTIONS]: "gmail:work", ...(interval === undefined ? {} : { [INTERVAL]: interval }) } });
+    expect(await ran(s, M0 + offset)).toBe(expected);
+    if (!expected) expect(s.fetcher).not.toHaveBeenCalled();
+  });
+
+  it("runs off-interval when a cursor has the catch-up flag set", async () => {
+    const s = await setup({ vars: { [CONNECTIONS]: "gmail:work" } });
+    await s.db.inner
+      .prepare("insert into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up) values ('work', '1000', 'p20', ?, 1)")
+      .bind(new Date(T0 - 60_000).toISOString())
+      .run();
+    s.mailboxes.work!.deliver(vercelFailure("Deployment failed for catch-up"));
+    expect(await ran(s, M0 + 3)).toBe(true);
+    expect(s.mailboxes.work!.requests.length).toBeGreaterThan(0);
+  });
+
+  it("does not run off-interval when the catch-up flag is 0", async () => {
+    const s = await setup({ vars: { [CONNECTIONS]: "gmail:work" } });
+    await s.db.inner
+      .prepare("insert into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up) values ('work', '1000', null, ?, 0)")
+      .bind(new Date(T0 - 60_000).toISOString())
+      .run();
+    await s.tick(M0 + 3);
+    expect(s.fetcher).not.toHaveBeenCalled();
+  });
+});
+
+describe("end to end through the real ActionRunner and Gmail executors", () => {
+  async function seeded(extra: Partial<CloudflareEnv> = {}, names = ["work"]) {
+    const s = await setup({ names, vars: { [CONNECTIONS]: names.map((name) => `gmail:${name}`).join(","), ...extra } });
+    await s.tick(M0);
+    return s;
+  }
+
+  it("stores a matching alert, skips personal mail and spoofed mail, and asks Gmail only for metadata headers", async () => {
+    const s = await seeded();
+    expect((await s.watchRows("email_watch_items"))).toEqual([]);
+    const mailbox = s.mailboxes.work!;
+    mailbox.deliver(vercelFailure("Deployment failed for my-app"));
+    mailbox.deliver({ from: "Pat <pat@example.com>", subject: "Deployment failed? Dinner at 7", snippet: "Private chat" });
+    mailbox.deliver({ ...vercelFailure("Deployment failed (spoofed)"), auth: false });
+    await s.tick(M0 + 10);
+
+    const rows = await s.watchRows("email_watch_items");
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      connection_name: "work",
+      sender_domain: "vercel.com",
+      subject: "Deployment failed for my-app",
+      category: "deploy_failed",
+      status: "pending",
+      occurrences: 1,
+    });
+    const cursors = await s.watchRows("email_watch_cursors");
+    expect(cursors).toMatchObject([{ connection_name: "work", history_id: "1003", page_token: null, catch_up: 0 }]);
+
+    const fetches = mailbox.messageRequests();
+    expect(fetches).toHaveLength(3);
+    for (const request of fetches) {
+      expect(request.params.get("format")).toBe("metadata");
+      expect(request.params.getAll("metadataHeaders").sort()).toEqual(
+        ["Authentication-Results", "From", "List-Id", "Subject", "X-GitHub-Reason"].sort(),
+      );
+    }
+    const history = mailbox.requests.find((request) => request.kind === "history")!;
+    expect(history.params.get("labelId")).toBe("INBOX");
+    expect(history.params.getAll("historyTypes")).toEqual(["messageAdded"]);
+    expect(history.params.get("maxResults")).toBe("20");
+    expect(history.params.get("startHistoryId")).toBe("1000");
+  });
+
+  it("leaves run rows with the cron caller and no input or output summary, and no mail content in them", async () => {
+    const s = await seeded();
+    const mailbox = s.mailboxes.work!;
+    mailbox.deliver(vercelFailure("Deployment failed for my-app"));
+    mailbox.deliver({ from: "Pat <pat@example.com>", subject: "Dinner at 7", snippet: "Private chat" });
+    await s.tick(M0 + 10);
+
+    const runs = (await s.db.inner.prepare("select * from runs").all<{ caller: string; action_id: string; value: string }>()).results;
+    // get_profile (first run), then list_history and two fetches.
+    expect(runs.map((run) => run.action_id).sort()).toEqual(
+      [
+        "gmail.fetch_message_by_message_id",
+        "gmail.fetch_message_by_message_id",
+        "gmail.get_profile",
+        "gmail.list_history",
+      ].sort(),
+    );
+    for (const run of runs) {
+      expect(run.caller).toBe("cron");
