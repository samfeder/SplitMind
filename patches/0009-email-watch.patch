@@ -0,0 +1,939 @@
+// Email watch (directive #126, patch 0009): behaviour of one watch invocation.
+//
+// MODULE INTERFACE PINNED BY THESE TESTS (the implementer builds to this; small on purpose):
+//
+//   src/server/email-watch/config.ts
+//     parseEmailWatchConfig(env: { OOMOL_CONNECT_EMAIL_WATCH_CONNECTIONS?: string;
+//                                  OOMOL_CONNECT_EMAIL_WATCH_INTERVAL_MINUTES?: string },
+//                           logger?: RuntimeLogger) -> { connections: string[]; intervalMinutes: number }
+//     isWatchDue(scheduledTimeMs: number, intervalMinutes: number): boolean
+//   src/server/email-watch/rules.ts
+//     emailWatchRules: readonly { id: string; category: string }[]
+//     classifyMessage(headers: readonly { name: string; value: string }[])
+//       -> { category, ruleId, senderDomain, subject } | undefined      (subject already sanitized for storage)
+//   src/server/email-watch/gmail-access.ts
+//     createWatchGmailClient(runner: { run(RunActionInput) }, policy: ActionPolicySnapshot)
+//       -> { call(connectionName, actionId, input): Promise<ActionRunResult | undefined> }   (the allowlist)
+//   src/server/email-watch/watcher.ts
+//     new EmailWatcher({ database: D1DatabaseBinding,            // the store: tables from migration 0019
+//                        runner: { run(RunActionInput): Promise<ActionRunResult | undefined> },
+//                        policy: ActionPolicySnapshot,
+//                        connections: readonly string[],         // gmail connection names, already parsed
+//                        logger: RuntimeLogger,                  // { info, warn, error }(fields, message)
+//                        now?: () => number })                   // epoch ms, default Date.now
+//     .run(): Promise<void>            one invocation: up to 30 Gmail action runs, oldest last_run_at first,
+//                                      then the once-a-day retention sweep when it is due. Never throws for a
+//                                      Gmail or policy failure of one connection.
+//     .needsCatchUp(): Promise<boolean>   true while any cursor has catch_up = 1
+//   src/server/actions/action-runner.ts
+//     RunActionInput.audit?: "outcome"  (run row has no inputSummary / outputSummary); RunLogCaller gains "cron"
+//   src/providers/gmail  fetch_message_by_message_id gains metadataHeaders (see its own test)
+//   src/providers/mail_watch/{definition,executors}.ts   (see mail-watch-provider.test.ts)
+//   src/server/cloudflare.ts  scheduled() glue (see cloudflare-email-watch.test.ts)
+//
+// Conventions the tests rely on: every timestamp column holds an ISO-8601 UTC string (new Date(ms).toISOString()),
+// including received_at (from Gmail's internalDate) and last_run_at; catch_up is 0 or 1; the first-run, expired
+// cursor and budget rules are decision 5; dedup_key is the lowercase hex sha256 of
+// `${category}|${sender_domain}|${subject lowercased, whitespace collapsed and trimmed}` (decision 9).
+
+import { createHash } from "node:crypto";
+import { afterEach, describe, expect, it } from "vitest";
+import { ActionPolicyService } from "../../core/action-policy.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import {
+  DAY,
+  FakeGmailRunner,
+  FakeMailbox,
+  HOUR,
+  OWNER_EMAIL,
+  T0,
+  authResults,
+  createLogCapture,
+  insertCursor,
+  insertItem,
+  itemRow,
+  selectAll,
+} from "./test-support.ts";
+import type { FixtureMessage } from "./test-support.ts";
+import { EmailWatcher } from "./watcher.ts";
+
+const policy = new ActionPolicyService().createSnapshot();
+const HEADER_NAMES = ["Authentication-Results", "From", "List-Id", "Subject", "X-GitHub-Reason"];
+
+let databases: SqliteD1Database[] = [];
+afterEach(() => {
+  for (const database of databases) database.close();
+  databases = [];
+});
+
+interface Rig {
+  db: SqliteD1Database;
+  runner: FakeGmailRunner;
+  mailboxes: Record<string, FakeMailbox>;
+  log: ReturnType<typeof createLogCapture>;
+  clock: { now: number };
+  watcher: EmailWatcher;
+  connections: string[];
+  run(): Promise<void>;
+  /** Number of runner calls made by one invocation. */
+  runCounting(): Promise<number>;
+}
+
+function rig(names: string[] = ["work"], options: { mailboxes?: Record<string, FakeMailbox> } = {}): Rig {
+  const db = new SqliteD1Database();
+  databases.push(db);
+  const mailboxes =
+    options.mailboxes ?? Object.fromEntries(names.map((name, index) => [name, new FakeMailbox({ prefix: `m${index}` })]));
+  const runner = new FakeGmailRunner(mailboxes);
+  const log = createLogCapture();
+  const clock = { now: T0 };
+  const watcher = new EmailWatcher({
+    database: db,
+    runner,
+    policy,
+    connections: names,
+    logger: log.logger,
+    now: () => clock.now,
+  });
+  const result: Rig = {
+    db,
+    runner,
+    mailboxes,
+    log,
+    clock,
+    watcher,
+    connections: names,
+    run: () => watcher.run(),
+    async runCounting() {
+      const before = runner.calls.length;
+      await watcher.run();
+      clock.now += 60_000;
+      return runner.calls.length - before;
+    },
+  };
+  return result;
+}
+
+/** Another watcher over the same database and runner, as a second overlapping Worker invocation would be. */
+function secondWatcher(base: Rig): EmailWatcher {
+  return new EmailWatcher({
+    database: base.db,
+    runner: base.runner,
+    policy,
+    connections: base.connections,
+    logger: base.log.logger,
+    now: () => base.clock.now,
+  });
+}
+
+/** The first run stores the profile historyId and nothing else. */
+async function seed(r: Rig): Promise<void> {
+  await r.run();
+}
+
+const cursorOf = async (r: Rig, name = "work") =>
+  (await selectAll<Record<string, any>>(r.db, `select * from email_watch_cursors where connection_name = '${name}'`))[0];
+const itemsOf = (r: Rig, where = "1 = 1") =>
+  selectAll<Record<string, any>>(r.db, `select * from email_watch_items where ${where} order by created_at, id`);
+
+function failed(subject: string, extra: Partial<FixtureMessage> = {}): FixtureMessage {
+  return { from: "Vercel <no-reply@vercel.com>", subject, ...extra };
+}
+
+function hash(category: string, domain: string, subject: string): string {
+  return createHash("sha256")
+    .update(`${category}|${domain}|${subject.toLowerCase().replace(/\s+/g, " ").trim()}`)
+    .digest("hex");
+}
+
+const iso = (ms: number) => new Date(ms).toISOString();
+
+describe("first run", () => {
+  it("stores the profile historyId, inserts nothing and makes only a get_profile call", async () => {
+    const r = rig();
+    r.mailboxes.work!.deliver(failed("Deployment failed for backlog-1"));
+    r.mailboxes.work!.deliver(failed("Deployment failed for backlog-2"));
+    await r.run();
+
