+  await database.connectionStore.set("gmail", "work", {
+    authType: "oauth2",
+    accessToken: "token-work",
+    tokenType: "Bearer",
+    metadata: {},
+    profile: { accountId: mailbox.email, displayName: mailbox.email, grantedScopes: [] },
