+import { describe, expect, it } from "vitest";
+import { classifyMessage, emailWatchRules } from "./rules.ts";
+import { authResults, buildHeaders, domainOf } from "./test-support.ts";
+import type { FixtureMessage, Header } from "./test-support.ts";
+
+// Interface pinned (rules.ts):
+//   emailWatchRules: readonly { id: string; category: string }[]          the checked-in table, in match order
+//   classifyMessage(headers: readonly {name; value}[])
+//     -> { category, ruleId, senderDomain, subject } | undefined
+//   `headers` is Gmail's raw payload.headers, in Gmail's order. `subject` is what is stored: control
+//   characters stripped, at most 200 characters. Returns undefined when no rule may match, which includes every
+//   anti-spoofing refusal (decision 8).
+
+function classify(message: FixtureMessage) {
+  return classifyMessage(buildHeaders(message));
+}
+
+function from(address: string, display = "Sender"): string {
+  return `${display} <${address}>`;
+}
+
+describe("rule table", () => {
+  it("names the four matching categories, each with at least one rule with a unique id", () => {
+    const ids = emailWatchRules.map((rule) => rule.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    expect(new Set(emailWatchRules.map((rule) => rule.category))).toEqual(
+      new Set(["deploy_failed", "github", "account_security", "billing_quota"]),
+    );
+    expect(ids.every((id) => typeof id === "string" && id.length > 0)).toBe(true);
+  });
+
+  it("lists rules in match order: deploy_failed, github, account_security, billing_quota", () => {
+    const firstIndex = (category: string) => emailWatchRules.findIndex((rule) => rule.category === category);
+    expect(firstIndex("deploy_failed")).toBeLessThan(firstIndex("github"));
+    expect(firstIndex("github")).toBeLessThan(firstIndex("account_security"));
+    expect(firstIndex("account_security")).toBeLessThan(firstIndex("billing_quota"));
+  });
+});
+
+describe("matching by sender domain and subject", () => {
+  it.each([
+    ["vercel.com", "Failed production deployment on my-app", "deploy_failed"],
+    ["vercel.com", "Deployment failed for my-app", "deploy_failed"],
+    ["netlify.com", "Deploy failure: site build error", "deploy_failed"],
+    ["cloudflare.com", "Your Worker build errored", "deploy_failed"],
+    ["vercel.com", "my-app did not deploy", "deploy_failed"],
+    ["netlify.com", "We could not deploy your site", "deploy_failed"],
+    ["github.com", "[acme/app] Dependabot alert: lodash", "github"],
+    ["github.com", "Security advisory for acme/app", "github"],
+    ["github.com", "A new security alert on acme/app", "github"],
+    ["accounts.google.com", "Security alert", "account_security"],
+    ["google.com", "New sign-in to your account", "account_security"],
+    ["github.com", "Your password was changed", "account_security"],
+    ["anthropic.com", "Your verification code", "account_security"],
+    ["cloudflare.com", "Suspicious activity on your account", "account_security"],
+    ["vercel.com", "Two-factor method removed", "account_security"],
+    ["netlify.com", "Your 2FA recovery codes", "account_security"],
+    ["vercel.com", "You have exceeded your usage limit", "billing_quota"],
