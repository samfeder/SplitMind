+-- Email watch (patch 0009). Only what the watch is allowed to keep: no address, recipient, snippet, body, label or
+-- header value ever lands here. Timestamps are ISO-8601 UTC strings.
+create table email_watch_cursors (
+  connection_name text primary key,
+  history_id text not null,
+  page_token text,
+  last_run_at text not null,
+  catch_up integer not null default 0
+);
+
+create table email_watch_items (
+  id text primary key,
+  connection_name text not null,
+  gmail_message_id text not null,
+  gmail_thread_id text,
+  sender_domain text not null,
+  subject text not null,
+  category text not null,
+  rule_id text not null,
+  received_at text not null,
+  created_at text not null,
+  status text not null check (status in ('pending', 'acknowledged')),
+  acknowledged_at text,
+  dedup_key text not null,
+  occurrences integer not null default 1,
+  unique (connection_name, gmail_message_id)
+);
+
+create index email_watch_items_status_received on email_watch_items (status, received_at desc);
+create index email_watch_items_dedup on email_watch_items (dedup_key, created_at);
