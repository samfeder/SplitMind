@@ -0,0 +1,42 @@
+import type { ActionRunResult, RunActionInput } from "../actions/action-runner.ts";
+import type { ActionPolicySnapshot } from "../../core/action-policy.ts";
+
+export interface WatchActionRunner {
+  run(input: RunActionInput): Promise<ActionRunResult | undefined>;
+}
+
+export interface WatchGmailClient {
+  call(connectionName: string, actionId: string, input: unknown): Promise<ActionRunResult | undefined>;
+}
+
+const GET_PROFILE = "gmail.get_profile";
+const LIST_HISTORY = "gmail.list_history";
+const FETCH_MESSAGE = "gmail.fetch_message_by_message_id";
+
+export const WATCH_ACTION_IDS: { getProfile: string; listHistory: string; fetchMessage: string } = {
+  getProfile: GET_PROFILE,
+  listHistory: LIST_HISTORY,
+  fetchMessage: FETCH_MESSAGE,
+};
+
+/**
+ * The only way the watcher reaches Gmail. It allows exactly three reads (profile, history, and a message fetched
+ * with format "metadata") and refuses everything else before the runner is called. Allowed calls still go
+ * through ActionRunner, so deployment policy and connection grants apply, and they record an outcome-only run row.
+ */
+export function createWatchGmailClient(runner: WatchActionRunner, policy: ActionPolicySnapshot): WatchGmailClient {
+  return {
+    async call(connectionName, actionId, input) {
+      assertAllowed(actionId, input);
+      return runner.run({ actionId, input, connectionName, caller: "cron", audit: "outcome", policy });
+    },
+  };
+}
+
+function assertAllowed(actionId: string, input: unknown): void {
+  if (actionId === GET_PROFILE || actionId === LIST_HISTORY) return;
+  if (actionId === FETCH_MESSAGE && typeof input === "object" && input !== null && (input as { format?: unknown }).format === "metadata") {
+    return;
+  }
+  throw new Error("The email watch may only read Gmail profile, history and message metadata.");
+}
