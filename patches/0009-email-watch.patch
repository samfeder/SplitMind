+import type { ActionPolicySnapshot } from "../../core/action-policy.ts";
+import type { RuntimeLogger } from "../../core/types.ts";
+import type { D1DatabaseBinding } from "../cloudflare/cloudflare-bindings.ts";
+import type { MailHeader } from "./rules.ts";
+import type { WatchActionRunner, WatchGmailClient } from "./gmail-access.ts";
+
+import { createWatchGmailClient, WATCH_ACTION_IDS } from "./gmail-access.ts";
+import { classifyMessage } from "./rules.ts";
+
+/** Gmail action runs per invocation. The Free plan allows 50 subrequests and a token refresh counts as one. */
+const MAX_ACTION_RUNS = 30;
+const PAGE_SIZE = 20;
+const DAY_MS = 86_400_000;
+const PENDING_RETENTION_MS = 14 * DAY_MS;
+const ACKNOWLEDGED_RETENTION_MS = 7 * DAY_MS;
+const DEDUP_WINDOW_MS = DAY_MS;
+const SKIPPED_LABELS = new Set(["DRAFT", "SENT", "SPAM", "TRASH"]);
+const METADATA_HEADERS = ["From", "Subject", "Authentication-Results", "X-GitHub-Reason", "List-Id"];
+
+export interface EmailWatcherOptions {
+  /** Holds the tables of migration 0019. */
+  database: D1DatabaseBinding;
+  runner: WatchActionRunner;
+  policy: ActionPolicySnapshot;
+  /** Gmail connection names, already parsed. */
+  connections: readonly string[];
+  logger: RuntimeLogger;
+  /** Epoch milliseconds. */
+  now?: () => number;
+}
+
+interface Cursor {
+  connectionName: string;
+  historyId: string;
+  pageToken: string | null;
+  lastRunAt: string;
+  catchUp: boolean;
+}
+
+interface CursorRow {
+  connection_name: string;
+  history_id: string;
+  page_token: string | null;
+  last_run_at: string;
+  catch_up: number;
+}
+
+/** What one Gmail action run came back as. Nothing in it is logged. */
+type GmailReply =
+  | { kind: "ok"; output: Record<string, unknown> }
+  | { kind: "failed"; code: string; status?: number }
+  | { kind: "no_budget" };
+
+/**
+ * Where a connection stands while its history is being read. `processPage` is the one transition function: it
+ * takes the `list_page` state and returns the next state, and `settle` writes the cursor for the final one.
+ */
+type PollStep =
+  | { state: "list_page"; pageToken: string | null }
+  /** Every page is read: move the cursor to Gmail's current historyId. */
+  | { state: "finish"; historyId: string }
+  /** The budget ran out: keep the position (the page that was not finished) and come back next minute. */
+  | { state: "pause"; pageToken: string | null }
+  /** Gmail no longer has the history the cursor points at. */
+  | { state: "reset_expired" }
+  /** A refusal or a Gmail failure: leave the cursor alone. */
+  | { state: "abort"; code: string };
+
+interface Budget {
+  remaining: number;
+}
+
+interface PageCounts {
+  fetched: number;
+  stored: number;
+  merged: number;
+}
+
+interface HistoryMessage {
+  id: string;
+  labelIds: string[];
+}
+
+/**
+ * Checks the named Gmail connections for new inbox mail and keeps the machine mail that needs action. Gmail is
+ * reached only through `createWatchGmailClient`; the only data kept is in email_watch_items and
+ * email_watch_cursors; nothing about a message other than a rule id, a category and counts is logged.
+ */
+export class EmailWatcher {
+  private readonly database: D1DatabaseBinding;
+  private readonly gmail: WatchGmailClient;
+  private readonly connections: readonly string[];
+  private readonly logger: RuntimeLogger;
+  private readonly now: () => number;
+
+  constructor(options: EmailWatcherOptions) {
+    this.database = options.database;
+    this.gmail = createWatchGmailClient(options.runner, options.policy);
+    this.connections = options.connections;
+    this.logger = options.logger;
+    this.now = options.now ?? Date.now;
+  }
+
+  /** One invocation: up to 30 Gmail action runs, oldest last run first, then the daily retention sweep if due. */
+  async run(): Promise<void> {
+    const cursors = await loadCursors(this.database);
+    const sweepDue = this.isSweepDue(cursors);
+    const budget: Budget = { remaining: MAX_ACTION_RUNS };
+    const waiting: string[] = [];
+
+    for (const name of this.orderConnections(cursors)) {
+      if (budget.remaining <= 0) {
+        if (cursors.has(name)) waiting.push(name);
+        continue;
+      }
+      try {
+        await this.pollConnection(name, cursors.get(name), budget);
+      } catch (error) {
+        this.logger.error({ connectionName: name, errorName: errorName(error) }, "email watch failed for a connection");
+      }
+    }
+    // Connections the budget did not reach are served first on the next run, off the interval.
+    for (const name of waiting) {
+      await this.database
+        .prepare("update email_watch_cursors set catch_up = 1 where connection_name = ?")
+        .bind(name)
+        .run();
+    }
+    if (sweepDue) await this.sweepRetention();
+  }
+
+  needsCatchUp(): Promise<boolean> {
+    return hasCatchUp(this.database, this.connections);
+  }
+
+  private orderConnections(cursors: Map<string, Cursor>): string[] {
+    // No cursor sorts first (empty string), then the oldest last run; ties keep the configured order.
+    return this.connections
+      .map((name, index) => ({ name, index, lastRunAt: cursors.get(name)?.lastRunAt ?? "" }))
+      .sort((a, b) => (a.lastRunAt < b.lastRunAt ? -1 : a.lastRunAt > b.lastRunAt ? 1 : a.index - b.index))
+      .map((entry) => entry.name);
+  }
+
+  private async pollConnection(name: string, cursor: Cursor | undefined, budget: Budget): Promise<void> {
+    if (!cursor) {
+      await this.startConnection(name, budget);
+      return;
+    }
+    const counts: PageCounts = { fetched: 0, stored: 0, merged: 0 };
+    let step: PollStep = { state: "list_page", pageToken: cursor.pageToken };
+    while (step.state === "list_page") {
+      step = await this.processPage(name, cursor, step.pageToken, budget, counts);
+    }
+    await this.settle(name, cursor, step, budget);
+    if (counts.fetched > 0) {
+      this.logger.info({ connectionName: name, ...counts, unmatched: counts.fetched - counts.stored - counts.merged }, "email watch checked a connection");
+    }
+  }
+
+  /** First run for a connection: remember where the mailbox is now and read nothing (no backfill). */
+  private async startConnection(name: string, budget: Budget): Promise<void> {
+    const reply = await this.callGmail(budget, name, WATCH_ACTION_IDS.getProfile, {});
+    const historyId = reply.kind === "ok" ? readString(reply.output.historyId) : undefined;
+    if (!historyId) {
+      this.logSkip(name, reply.kind === "failed" ? reply.code : "no_history_id");
+      return;
+    }
+    await this.database
+      .prepare(
+        "insert or ignore into email_watch_cursors (connection_name, history_id, page_token, last_run_at, catch_up) values (?, ?, null, ?, 0)",
+      )
+      .bind(name, historyId, this.nowIso())
+      .run();
+  }
+
+  /** Read one page of history and the messages on it. */
+  private async processPage(
+    name: string,
+    cursor: Cursor,
+    pageToken: string | null,
+    budget: Budget,
+    counts: PageCounts,
+  ): Promise<PollStep> {
+    const input: Record<string, unknown> = {
+      startHistoryId: cursor.historyId,
+      labelId: "INBOX",
+      historyTypes: ["messageAdded"],
+      maxResults: PAGE_SIZE,
+    };
+    if (pageToken) input.pageToken = pageToken;
+    const list = await this.callGmail(budget, name, WATCH_ACTION_IDS.listHistory, input);
+    if (list.kind === "no_budget") return { state: "pause", pageToken };
+    if (list.kind === "failed") {
+      return list.status === 404 ? { state: "reset_expired" } : { state: "abort", code: list.code };
+    }
+
+    for (const message of addedMessages(list.output.history)) {
+      if (await this.isStored(name, message.id)) continue;
+      const fetched = await this.callGmail(budget, name, WATCH_ACTION_IDS.fetchMessage, {
+        messageId: message.id,
+        format: "metadata",
+        metadataHeaders: METADATA_HEADERS,
+      });
+      if (fetched.kind === "no_budget") return { state: "pause", pageToken };
+      if (fetched.kind === "failed") {
+        // A message that is gone, or that Gmail will never serve, is skipped; anything else stops this connection.
+        if (isPermanentMessageFailure(fetched.status)) continue;
+        return { state: "abort", code: fetched.code };
+      }
+      counts.fetched += 1;
+      const outcome = await this.keepIfNeedsAction(name, fetched.output);
+      if (outcome === "stored") counts.stored += 1;
+      if (outcome === "merged") counts.merged += 1;
+    }
+
+    const next = readString(list.output.nextPageToken);
+    if (next) return { state: "list_page", pageToken: next };
+    return { state: "finish", historyId: readString(list.output.historyId) ?? cursor.historyId };
+  }
+
+  private async settle(name: string, cursor: Cursor, step: PollStep, budget: Budget): Promise<void> {
+    switch (step.state) {
+      case "finish":
+        await this.moveCursor(cursor, { historyId: step.historyId, pageToken: null, catchUp: false });
+        return;
+      case "pause":
+        await this.moveCursor(cursor, { historyId: cursor.historyId, pageToken: step.pageToken, catchUp: true });
+        return;
+      case "abort":
+        this.logSkip(name, step.code);
+        await this.touch(name);
+        return;
+      case "reset_expired":
+        await this.resetExpired(name, cursor, budget);
+        return;
+      case "list_page":
+        throw new Error("unreachable: list_page is not a final state");
+    }
+  }
+
+  /** Gmail dropped the history: restart from the mailbox's current historyId and leave one visible gap item. */
+  private async resetExpired(name: string, cursor: Cursor, budget: Budget): Promise<void> {
+    const profile = await this.callGmail(budget, name, WATCH_ACTION_IDS.getProfile, {});
+    const historyId = profile.kind === "ok" ? readString(profile.output.historyId) : undefined;
+    if (!historyId) {
+      this.logSkip(name, profile.kind === "failed" ? profile.code : "no_history_id");
+      await this.touch(name, profile.kind === "no_budget");
+      return;
+    }
+    // Only the invocation that moves the cursor leaves the gap item.
+    const moved = await this.moveCursor(cursor, { historyId, pageToken: null, catchUp: false });
+    if (moved) await this.insertGapItem(name, cursor.lastRunAt);
+    this.logger.warn({ connectionName: name }, "email watch cursor expired and was reset");
+  }
+
+  private async callGmail(budget: Budget, name: string, actionId: string, input: unknown): Promise<GmailReply> {
+    if (budget.remaining <= 0) return { kind: "no_budget" };
+    budget.remaining -= 1;
+    let run;
+    try {
+      run = await this.gmail.call(name, actionId, input);
+    } catch (error) {
+      return { kind: "failed", code: `call_${errorName(error)}` };
+    }
+    if (!run) return { kind: "failed", code: "unknown_action" };
+    if (run.result.ok) {
+      const output = run.result.output;
+      return typeof output === "object" && output !== null
+        ? { kind: "ok", output: output as Record<string, unknown> }
+        : { kind: "failed", code: "invalid_output" };
+    }
+    const status = (run.result.error?.details as { status?: unknown } | undefined)?.status;
+    return {
+      kind: "failed",
+      code: run.result.error?.code ?? "unknown_error",
+      ...(typeof status === "number" ? { status } : {}),
+    };
+  }
+
+  /** Classify a fetched message and keep it if a rule matches. Everything else about the message is dropped here. */
+  private async keepIfNeedsAction(name: string, output: Record<string, unknown>): Promise<"stored" | "merged" | "none"> {
+    const headers = readHeaders(output);
+    const match = headers && classifyMessage(headers);
+    const messageId = readString(output.messageId);
+    if (!match || !messageId) return "none";
+
+    const now = this.now();
+    const key = await dedupKey(match.category, match.senderDomain, match.subject);
+    const cutoff = new Date(now - DEDUP_WINDOW_MS).toISOString();
+    const createdAt = new Date(now).toISOString();
+    // One statement: add the row unless another pending item with the same key is already there. Two invocations
+    // cannot both pass the check, and the unique (connection, message) constraint keeps one message to one row.
+    const inserted = await this.database
+      .prepare(
+        `insert or ignore into email_watch_items
+           (id, connection_name, gmail_message_id, gmail_thread_id, sender_domain, subject, category, rule_id,
+            received_at, created_at, status, acknowledged_at, dedup_key, occurrences)
+         select ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', null, ?, 1
+         where not exists (
+           select 1 from email_watch_items
+           where dedup_key = ? and status = 'pending' and created_at >= ?
+             and not (connection_name = ? and gmail_message_id = ?))`,
+      )
+      .bind(
+        crypto.randomUUID(),
+        name,
+        messageId,
+        readString(output.threadId) ?? null,
+        match.senderDomain,
+        match.subject,
+        match.category,
+        match.ruleId,
+        receivedAtOf(output, createdAt),
+        createdAt,
+        key,
+        key,
+        cutoff,
+        name,
+        messageId,
+      )
+      .run();
+    if ((inserted.meta.changes ?? 0) > 0) return "stored";
+    if (await this.isStored(name, messageId)) return "none";
+
+    // A pending item with the same key was created in the last 24 hours: count this one on it. A page that is
+    // read twice (budget ran out part-way) can count a merged message twice; the count is a hint, not a ledger.
+    const merged = await this.database
+      .prepare(
+        `update email_watch_items set occurrences = occurrences + 1
+         where id = (select id from email_watch_items
+                     where dedup_key = ? and status = 'pending' and created_at >= ?
+                     order by created_at, id limit 1)`,
+      )
+      .bind(key, cutoff)
+      .run();
+    return (merged.meta.changes ?? 0) > 0 ? "merged" : "none";
+  }
+
+  private async insertGapItem(name: string, lastCheckedAt: string): Promise<void> {
+    const subject = `Mail between ${formatMinute(lastCheckedAt)} and now was not checked`;
+    const at = this.nowIso();
+    await this.database
+      .prepare(
+        `insert into email_watch_items
+           (id, connection_name, gmail_message_id, gmail_thread_id, sender_domain, subject, category, rule_id,
+            received_at, created_at, status, acknowledged_at, dedup_key, occurrences)
+         values (?, ?, ?, null, '', ?, 'watch_gap', 'watch-gap', ?, ?, 'pending', null, ?, 1)`,
+      )
+      .bind(
+        crypto.randomUUID(),
+        name,
+        `gap-${crypto.randomUUID()}`,
+        subject,
+        at,
+        at,
+        await dedupKey("watch_gap", name, subject),
+      )
+      .run();
+  }
+
+  private async isStored(name: string, messageId: string): Promise<boolean> {
+    const row = await this.database
+      .prepare("select 1 as found from email_watch_items where connection_name = ? and gmail_message_id = ? limit 1")
+      .bind(name, messageId)
+      .first();
+    return row !== null;
+  }
+
+  /** Compare-and-set on the cursor as this invocation read it, so a slower overlapping invocation changes nothing. */
+  private async moveCursor(
+    old: Cursor,
+    next: { historyId: string; pageToken: string | null; catchUp: boolean },
+  ): Promise<boolean> {
+    const result = await this.database
+      .prepare(
+        `update email_watch_cursors set history_id = ?, page_token = ?, last_run_at = ?, catch_up = ?
+         where connection_name = ? and history_id = ? and page_token is ?`,
+      )
+      .bind(next.historyId, next.pageToken, this.nowIso(), next.catchUp ? 1 : 0, old.connectionName, old.historyId, old.pageToken)
+      .run();
+    return (result.meta.changes ?? 0) > 0;
+  }
+
+  /** Record that the connection was tried, so one that keeps failing does not stay first in line. */
+  private async touch(name: string, catchUp = false): Promise<void> {
+    await this.database
+      .prepare(
+        `update email_watch_cursors set last_run_at = ?${catchUp ? ", catch_up = 1" : ""} where connection_name = ?`,
+      )
+      .bind(this.nowIso(), name)
+      .run();
+  }
+
+  private logSkip(name: string, errorCode: string): void {
+    this.logger.warn({ connectionName: name, errorCode }, "email watch skipped a connection");
+  }
+
+  /** The first watch run after 00:00 UTC: the last run on record was on an earlier UTC day. */
+  private isSweepDue(cursors: Map<string, Cursor>): boolean {
+    let latest = "";
+    for (const cursor of cursors.values()) if (cursor.lastRunAt > latest) latest = cursor.lastRunAt;
+    return latest === "" || latest.slice(0, 10) !== this.nowIso().slice(0, 10);
+  }
+
+  private async sweepRetention(): Promise<void> {
+    const now = this.now();
+    try {
+      await this.database
+        .prepare("delete from email_watch_items where status = 'pending' and created_at < ?")
+        .bind(new Date(now - PENDING_RETENTION_MS).toISOString())
+        .run();
+      await this.database
+        .prepare("delete from email_watch_items where status = 'acknowledged' and acknowledged_at < ?")
+        .bind(new Date(now - ACKNOWLEDGED_RETENTION_MS).toISOString())
+        .run();
+    } catch (error) {
+      this.logger.error({ errorName: errorName(error) }, "email watch retention sweep failed");
+    }
+  }
+
+  private nowIso(): string {
+    return new Date(this.now()).toISOString();
+  }
+}
+
+/** True while a watched connection has a cursor flagged for an off-interval catch-up run. */
+export async function hasCatchUp(database: D1DatabaseBinding, connections: readonly string[]): Promise<boolean> {
+  const { results } = await database
+    .prepare("select connection_name from email_watch_cursors where catch_up = 1")
+    .all<{ connection_name: string }>();
+  return results.some((row) => connections.includes(row.connection_name));
+}
+
+async function loadCursors(database: D1DatabaseBinding): Promise<Map<string, Cursor>> {
+  const { results } = await database
+    .prepare("select connection_name, history_id, page_token, last_run_at, catch_up from email_watch_cursors")
+    .all<CursorRow>();
+  return new Map(
+    results.map((row) => [
+      row.connection_name,
+      {
+        connectionName: row.connection_name,
+        historyId: row.history_id,
+        pageToken: row.page_token,
+        lastRunAt: row.last_run_at,
+        catchUp: row.catch_up === 1,
+      },
+    ]),
+  );
+}
+
+/** Messages added to the inbox on a history page, once each, without drafts, sent mail, spam or trash. */
+function addedMessages(history: unknown): HistoryMessage[] {
+  const seen = new Set<string>();
+  const messages: HistoryMessage[] = [];
+  for (const record of Array.isArray(history) ? history : []) {
+    const added = (record as { messagesAdded?: unknown } | null)?.messagesAdded;
+    for (const entry of Array.isArray(added) ? added : []) {
+      const message = (entry as { message?: { id?: unknown; labelIds?: unknown } } | null)?.message;
+      const id = readString(message?.id);
+      if (!id || seen.has(id)) continue;
+      seen.add(id);
+      const labelIds = Array.isArray(message?.labelIds) ? message.labelIds.filter((l): l is string => typeof l === "string") : [];
+      if (labelIds.some((label) => SKIPPED_LABELS.has(label))) continue;
+      messages.push({ id, labelIds });
+    }
+  }
+  return messages;
+}
+
+function readHeaders(output: Record<string, unknown>): MailHeader[] | undefined {
+  const headers = (output.payload as { headers?: unknown } | null | undefined)?.headers;
+  if (!Array.isArray(headers)) return undefined;
+  return headers.filter(
+    (header): header is MailHeader => typeof header?.name === "string" && typeof header?.value === "string",
+  );
+}
+
+function receivedAtOf(output: Record<string, unknown>, fallback: string): string {
+  const millis = Number(output.internalDate);
+  return Number.isFinite(millis) && millis > 0 ? new Date(millis).toISOString() : fallback;
+}
+
+function readString(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+/** A 4xx other than an authorisation or rate-limit answer means this one message cannot be read. */
+function isPermanentMessageFailure(status: number | undefined): boolean {
+  return status !== undefined && status >= 400 && status < 500 && ![401, 403, 429].includes(status);
+}
+
+function errorName(error: unknown): string {
+  return error instanceof Error ? error.name : "UnknownError";
+}
+
+function formatMinute(iso: string): string {
+  return `${iso.slice(0, 10)} ${iso.slice(11, 16)} UTC`;
+}
+
+/** sha256 of `category|domain|subject` with the subject lowercased and its whitespace collapsed, as lowercase hex. */
+async function dedupKey(category: string, domain: string, subject: string): Promise<string> {
+  const text = `${category}|${domain}|${subject.toLowerCase().replace(/\s+/g, " ").trim()}`;
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
+  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
+}
