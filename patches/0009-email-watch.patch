+import type { ProviderDefinition } from "../../core/types.ts";
+
+import { mailWatchActions } from "./actions.ts";
+
+const service = "mail_watch";
+
+/**
+ * Built-in provider over the email watch's own table: it lists the machine mail that needs action and lets a
+ * caller acknowledge it. It holds no credentials and never calls a mail provider.
+ */
+export const provider: ProviderDefinition = {
+  service,
+  displayName: "Mail watch",
+  categories: ["Productivity"],
+  authTypes: ["no_auth"],
+  auth: [{ type: "no_auth" }],
+  actions: mailWatchActions,
+};
diff --git a/src/providers/mail_watch/executors.ts b/src/providers/mail_watch/executors.ts
new file mode 100644
index 00000000..e3073c61
--- /dev/null
+++ b/src/providers/mail_watch/executors.ts
@@ -0,0 +1,114 @@
+import type { D1DatabaseBinding } from "../../server/cloudflare/cloudflare-bindings.ts";
+import type { ProviderExecutors } from "../../core/types.ts";
+
+const itemColumns =
+  "id, connection_name, gmail_message_id, category, rule_id, sender_domain, subject, received_at, occurrences";
+const defaultLimit = 50;
+const maxLimit = 100;
+
+export interface MailWatchDependencies {
+  /** Holds email_watch_items. */
+  database: D1DatabaseBinding;
+  /** True when the deployment names at least one connection to watch. */
+  enabled: boolean;
+  /** The Gmail address stored on a connection's profile, used only to build links at read time. */
+  profileEmail(connectionName: string): Promise<string | undefined>;
+  now?: () => number;
+}
+
+interface ItemRow {
+  id: string;
+  connection_name: string;
+  gmail_message_id: string;
+  category: string;
+  rule_id: string;
+  sender_domain: string;
+  subject: string;
+  received_at: string;
+  occurrences: number;
+}
+
+export function createMailWatchExecutors(deps: MailWatchDependencies): ProviderExecutors {
+  const now = deps.now ?? Date.now;
+  return {
+    "mail_watch.list_pending_mail": async (input) => {
+      if (!deps.enabled) return { ok: true, output: { enabled: false, items: [] } };
+      const filters = (input ?? {}) as { category?: string; connectionName?: string; limit?: number };
+      const clauses = ["status = 'pending'"];
+      const values: unknown[] = [];
+      if (filters.category) {
+        clauses.push("category = ?");
+        values.push(filters.category);
+      }
+      if (filters.connectionName) {
+        clauses.push("connection_name = ?");
+        values.push(filters.connectionName);
+      }
+      const limit = Math.min(filters.limit ?? defaultLimit, maxLimit);
+      const { results } = await deps.database
+        .prepare(
+          `select ${itemColumns} from email_watch_items where ${clauses.join(" and ")} order by received_at desc, id desc limit ?`,
+        )
+        .bind(...values, limit)
+        .all<ItemRow>();
+
+      const emails = new Map<string, string | undefined>();
+      for (const row of results) {
+        if (!emails.has(row.connection_name)) emails.set(row.connection_name, await deps.profileEmail(row.connection_name));
+      }
+      return {
+        ok: true,
+        output: {
+          enabled: true,
+          items: results.map((row) => ({
+            id: row.id,
+            connectionName: row.connection_name,
+            category: row.category,
+            ruleId: row.rule_id,
+            senderDomain: row.sender_domain,
+            subject: row.subject,
+            receivedAt: row.received_at,
+            occurrences: row.occurrences,
+            link: gmailLink(emails.get(row.connection_name), row.gmail_message_id),
+          })),
+        },
+      };
+    },
+    "mail_watch.acknowledge_mail": async (input) => {
+      if (!deps.enabled) return { ok: true, output: { acknowledged: 0 } };
+      const ids = [...new Set(((input ?? {}) as { ids?: string[] }).ids ?? [])];
+      if (ids.length === 0) return { ok: true, output: { acknowledged: 0 } };
+      // D1 allows 100 bound values per statement, so a full list of 100 ids goes in two.
+      const acknowledgedAt = new Date(now()).toISOString();
+      let acknowledged = 0;
+      for (let start = 0; start < ids.length; start += 50) {
+        const chunk = ids.slice(start, start + 50);
+        const result = await deps.database
+          .prepare(
+            `update email_watch_items set status = 'acknowledged', acknowledged_at = ? where status = 'pending' and id in (${chunk.map(() => "?").join(", ")})`,
+          )
+          .bind(acknowledgedAt, ...chunk)
+          .run();
+        acknowledged += result.meta.changes ?? 0;
+      }
+      return { ok: true, output: { acknowledged } };
+    },
+  };
+}
+
+function gmailLink(email: string | undefined, messageId: string): string {
+  return email
+    ? `https://mail.google.com/mail/?authuser=${encodeURIComponent(email)}#all/${messageId}`
+    : `https://mail.google.com/mail/u/0/#all/${messageId}`;
+}
+
+/** The module's default executors are unbound: no store, so the feature reads as off. */
+export const executors: ProviderExecutors = createMailWatchExecutors({
+  database: { prepare: unbound, batch: unbound },
+  enabled: false,
+  profileEmail: async () => undefined,
+});
+
+function unbound(): never {
+  throw new Error("The mail watch store is not bound.");
+}
diff --git a/src/server/actions/action-runner-audit.test.ts b/src/server/actions/action-runner-audit.test.ts
