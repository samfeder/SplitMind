@@ -0,0 +1,126 @@
+// Decision 6: fetch_message_by_message_id takes an optional metadataHeaders string[], valid only with
+// format "metadata", sent to Gmail as repeated metadataHeaders query parameters.
+import type { ExecutionContext } from "../../core/types.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { validateActionInput } from "../../core/validation.ts";
+import { provider } from "./definition.ts";
+import { executors } from "./executors.ts";
+
+afterEach(() => vi.unstubAllGlobals());
+
+const context: ExecutionContext = {
+  getCredential: async () => ({
+    authType: "oauth2",
+    accessToken: "test-token",
+    tokenType: "Bearer",
+    metadata: {},
+    profile: { accountId: "me", displayName: "Test", grantedScopes: [] },
+  }),
+};
+
+const message = {
+  id: "msg-1",
+  threadId: "thr-1",
+  labelIds: ["INBOX"],
+  internalDate: "1700000000000",
+  payload: {
+    headers: [
+      { name: "Authentication-Results", value: "mx.google.com; dmarc=pass header.from=vercel.com" },
+      { name: "From", value: "Vercel <no-reply@vercel.com>" },
+      { name: "Subject", value: "Deployment failed" },
+    ],
+  },
+};
+
+function stubGmail() {
+  const fetcher = vi.fn(async (_url: RequestInfo | URL, _init?: RequestInit) => Response.json(message));
+  vi.stubGlobal("fetch", fetcher);
+  return fetcher;
+}
+
+function requestedUrl(fetcher: ReturnType<typeof stubGmail>): URL {
+  return new URL(String(fetcher.mock.calls[0]![0]));
+}
+
+const run = (input: Record<string, unknown>) => executors["gmail.fetch_message_by_message_id"]!(input, context);
+
+describe("gmail.fetch_message_by_message_id metadataHeaders", () => {
+  it("sends one repeated metadataHeaders parameter per name with format=metadata", async () => {
+    const fetcher = stubGmail();
+    const names = ["From", "Subject", "Authentication-Results", "X-GitHub-Reason", "List-Id"];
+    const result = await run({ messageId: "msg-1", format: "metadata", metadataHeaders: names });
+    expect(result).toMatchObject({ ok: true });
+
+    const url = requestedUrl(fetcher);
+    expect(url.pathname).toBe("/gmail/v1/users/me/messages/msg-1");
+    expect(url.searchParams.get("format")).toBe("metadata");
+    expect(url.searchParams.getAll("metadataHeaders")).toEqual(names);
+    // Repeated, not joined with commas.
+    expect(url.search.match(/metadataHeaders=/g)).toHaveLength(5);
+    expect(url.search).not.toContain("%2C");
+    expect(url.search).not.toContain(",");
+  });
+
+  it("encodes a header name safely", async () => {
+    const fetcher = stubGmail();
+    await run({ messageId: "msg-1", format: "metadata", metadataHeaders: ["X-Odd Name&x=1"] });
+    const url = requestedUrl(fetcher);
+    expect(url.searchParams.getAll("metadataHeaders")).toEqual(["X-Odd Name&x=1"]);
+    expect(url.searchParams.has("x")).toBe(false);
+  });
+
+  it("still returns the raw payload headers in Gmail's order", async () => {
+    stubGmail();
+    const result = await run({ messageId: "msg-1", format: "metadata", metadataHeaders: ["From"] });
+    expect(result).toMatchObject({
+      ok: true,
+      output: { payload: { headers: message.payload.headers } },
+    });
+  });
+
+  it("adds no metadataHeaders parameter when none is given", async () => {
+    const fetcher = stubGmail();
+    await run({ messageId: "msg-1", format: "metadata" });
+    const url = requestedUrl(fetcher);
+    expect(url.searchParams.get("format")).toBe("metadata");
+    expect(url.searchParams.has("metadataHeaders")).toBe(false);
+  });
+
+  it("adds no metadataHeaders parameter for the default full format", async () => {
+    const fetcher = stubGmail();
+    await run({ messageId: "msg-1" });
+    const url = requestedUrl(fetcher);
+    expect(url.searchParams.get("format")).toBe("full");
+    expect(url.searchParams.has("metadataHeaders")).toBe(false);
+  });
+
+  it.each([undefined, "full", "minimal", "raw"])(
+    "rejects metadataHeaders with format %j as invalid input, without calling Gmail",
+    async (format) => {
+      const fetcher = stubGmail();
+      const input: Record<string, unknown> = { messageId: "msg-1", metadataHeaders: ["From"] };
+      if (format !== undefined) input.format = format;
+      const result = await run(input);
+      expect(result).toMatchObject({ ok: false, error: { code: "invalid_input" } });
+      expect(fetcher).not.toHaveBeenCalled();
+    },
+  );
+});
+
+describe("gmail.fetch_message_by_message_id input schema", () => {
+  const action = provider.actions.find((candidate) => candidate.id === "gmail.fetch_message_by_message_id")!;
+
+  it("accepts metadataHeaders as an array of strings", () => {
+    expect(validateActionInput(action, { messageId: "m", format: "metadata", metadataHeaders: ["From", "Subject"] }).valid).toBe(true);
+    expect(validateActionInput(action, { messageId: "m", format: "metadata" }).valid).toBe(true);
+    expect(validateActionInput(action, { messageId: "m" }).valid).toBe(true);
+  });
+
+  it.each([{ value: "From" }, { value: 1 }, { value: null }, { value: [["From"]] }, { value: [1] }, { value: { name: "From" } }])(
+    "rejects metadataHeaders $value that is not an array of strings",
+    ({ value }) => {
+      expect(validateActionInput(action, { messageId: "m", format: "metadata", metadataHeaders: value }).valid).toBe(false);
+    },
+  );
+});
