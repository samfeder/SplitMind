+// #162: env rule list entries that can never match are logged once at startup, through the same console.warn as the
+// read-only-connections warnings and with the same once-per-isolate-per-config caching. Everything goes through
+// `worker.fetch` in one isolate.
+import type { AssetsBinding } from "./cloudflare/cloudflare-bindings.ts";
+import type { CloudflareEnv } from "./cloudflare/cloudflare-env.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { provider as gmail } from "../providers/gmail/definition.ts";
+import worker from "./cloudflare.ts";
+import { createWorkerSecretCodec } from "./secrets/worker-secret-codec.ts";
+import { D1RuntimeDatabase } from "./storage/d1/runtime-store.ts";
+import { SqliteD1Database } from "./storage/d1/test-database.ts";
+
+const ADMIN = "admin-token";
+
+function catalogAssets(): AssetsBinding {
+  const files: Record<string, unknown> = {
+    "/catalog/index.json": { version: 1, providerCount: 1, chunks: ["apps-0000.json"] },
+    "/catalog/apps-0000.json": [JSON.parse(JSON.stringify(gmail))],
+  };
+  return {
+    async fetch(request) {
+      const pathname = new URL(request.url).pathname;
+      return pathname in files ? Response.json(files[pathname]) : new Response("not found", { status: 404 });
+    },
+  };
+}
+
+let counter = 0;
+const openDatabases: SqliteD1Database[] = [];
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  for (const db of openDatabases.splice(0)) db.close();
+});
+
+type Rules = Partial<
+  Record<
+    | "OOMOL_CONNECT_ALLOWED_ACTIONS"
+    | "OOMOL_CONNECT_BLOCKED_ACTIONS"
+    | "OOMOL_CONNECT_ALLOWED_PROXIES"
+    | "OOMOL_CONNECT_BLOCKED_PROXIES"
+    | "OOMOL_CONNECT_ALLOWED_TRIGGERS"
+    | "OOMOL_CONNECT_BLOCKED_TRIGGERS",
+    string
+  >
+>;
+
+async function boot(rules: Rules, options: { noConfiguredOrigin?: boolean } = {}) {
+  const n = ++counter;
+  const db = new SqliteD1Database();
+  openDatabases.push(db);
+  const key = `policy-warn-key-${n}`;
+  // Creating the store applies the schema, as the sibling startup-warning tests do.
+  new D1RuntimeDatabase(db, { secretCodec: await createWorkerSecretCodec(key) });
+  const origin = `https://policy-warn-${n}.example.com`;
+  const env: CloudflareEnv = {
+    DB: db,
+    TRANSIT_FILES: {
+      async put() {},
+      async get() {
+        return null;
+      },
+      async delete() {},
+    },
+    ASSETS: catalogAssets(),
+    OOMOL_CONNECT_ENCRYPTION_KEY: key,
+    OOMOL_CONNECT_ADMIN_TOKEN: ADMIN,
+    ...(options.noConfiguredOrigin ? {} : { OOMOL_CONNECT_ORIGIN: origin }),
+    ...rules,
+  };
+  const ctx = { waitUntil() {}, passThroughOnException() {} };
+  const request = (requestOrigin = origin) =>
+    worker.fetch(
+      new Request(`${requestOrigin}/api/connections`, { headers: { authorization: `Bearer ${ADMIN}` } }),
+      env,
+      ctx,
+    );
+  return { env, request };
+}
+
+function spyOnConsole() {
+  vi.spyOn(console, "info").mockImplementation(() => {});
+  vi.spyOn(console, "error").mockImplementation(() => {});
+  return vi.spyOn(console, "warn").mockImplementation(() => {});
+}
+
+const mentioning = (warn: { mock: { calls: unknown[][] } }, text: string) =>
+  warn.mock.calls.filter((call) => JSON.stringify(call).includes(text));
+
+describe("env rule list warnings at startup (#162)", () => {
+  it("V1: warns once through console.warn for a bad action-list entry, however many requests and origins build from it", async () => {
+    const warn = spyOnConsole();
+    const bad = `@Reads${counter + 1}`;
+    const site = await boot({ OOMOL_CONNECT_ALLOWED_ACTIONS: `${bad}, gmail.*` }, { noConfiguredOrigin: true });
+
+    expect((await site.request("https://first.example.com")).status).toBe(200);
+    expect((await site.request("https://second.example.com")).status).toBe(200);
+    expect((await site.request("https://first.example.com")).status).toBe(200);
+
+    const hits = mentioning(warn, bad);
+    expect(hits).toHaveLength(1);
+    expect(JSON.stringify(hits[0])).toContain("matches nothing");
+  });
+
+  it("V1: warns for a bad entry in the blocked action list too", async () => {
+    const warn = spyOnConsole();
+    const bad = `@read.*${counter + 1}`;
+    const site = await boot({ OOMOL_CONNECT_BLOCKED_ACTIONS: bad });
+    expect((await site.request()).status).toBe(200);
+    expect(mentioning(warn, bad)).toHaveLength(1);
+  });
+
+  it("V1: warns that @read in a trigger or proxy list applies to actions only, once per list, and never for the same entry in an action list", async () => {
+    const warn = spyOnConsole();
+    const marker = `marker${counter + 1}`;
+    const site = await boot({
+      OOMOL_CONNECT_ALLOWED_ACTIONS: `@read, gmail.${marker}`,
+      OOMOL_CONNECT_ALLOWED_TRIGGERS: `@read, gmail.on_${marker}`,
+      OOMOL_CONNECT_BLOCKED_PROXIES: "@read",
+    });
+    await site.request();
+    await site.request();
+
+    const hits = mentioning(warn, "applies to actions only");
+    expect(hits).toHaveLength(2);
+    for (const hit of hits) expect(JSON.stringify(hit)).toContain("matches nothing");
+  });
+
+  it("V1: logs nothing about rule lists when they are all valid", async () => {
+    const warn = spyOnConsole();
+    const site = await boot({
+      OOMOL_CONNECT_ALLOWED_ACTIONS: `@read, gmail.valid${counter + 1}`,
+      OOMOL_CONNECT_BLOCKED_ACTIONS: "gmail.send_message",
+      OOMOL_CONNECT_ALLOWED_TRIGGERS: "gmail.*",
+    });
+    await site.request();
+    expect(mentioning(warn, "matches nothing")).toEqual([]);
+  });
+
+  it("V1: a changed setting is a new config, so its bad entries warn again", async () => {
+    const warn = spyOnConsole();
+    const first = `@First${counter + 1}`;
+    const site = await boot({ OOMOL_CONNECT_ALLOWED_ACTIONS: first });
+    await site.request();
+    expect(mentioning(warn, first)).toHaveLength(1);
+
+    const second = `@Second${counter}`;
+    site.env.OOMOL_CONNECT_ALLOWED_ACTIONS = `${first}, ${second}`;
+    await site.request();
+    expect(mentioning(warn, second)).toHaveLength(1);
+    expect(mentioning(warn, first)).toHaveLength(2);
+  });
+
+  it("V1: the warning does not change behaviour: the app still starts and answers", async () => {
+    spyOnConsole();
+    const site = await boot({ OOMOL_CONNECT_ALLOWED_ACTIONS: `@Nope${counter + 1}` });
+    expect((await site.request()).status).toBe(200);
+  });
+});
