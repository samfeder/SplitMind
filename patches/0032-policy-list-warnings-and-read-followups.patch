+// #156: the orphan sweep is best-effort maintenance. Building its RuntimeTokenService must not be able to fail the
+// whole scheduled handler, whatever else the cron does in the same run. The service is replaced by one whose
+// constructor throws; everything else is the real Worker over a real (sqlite-backed) D1 store.
+import type { CloudflareEnv } from "./cloudflare-env.ts";
+
+import { describe, expect, it, vi } from "vitest";
+import worker from "../cloudflare.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+
+vi.mock("cloudflare:workers", () => ({
+  WorkerEntrypoint: class {},
+}));
+
+vi.mock("../storage/runtime-token-service.ts", async (importActual) => {
+  const actual = await importActual<typeof import("../storage/runtime-token-service.ts")>();
+  return {
+    ...actual,
+    RuntimeTokenService: class {
+      constructor() {
+        throw new Error("RuntimeTokenService constructor failed");
+      }
+    },
+  };
+});
+
+const minute = 60_000;
+const hour = 60 * minute;
+
+describe("worker.scheduled when the orphan sweep cannot even be set up", () => {
+  it("S11 (#156): at UTC minute 17 with OAUTH_KV bound, the handler resolves instead of rejecting", async () => {
+    const kv = {
+      async put() {},
+      async get() {
+        return null;
+      },
+      async delete() {},
+      async list() {
+        return { keys: [], list_complete: true };
+      },
+    };
+    const env = {
+      DB: new SqliteD1Database(),
+      TRANSIT_FILES: kv,
+      OAUTH_KV: kv,
+      OOMOL_CONNECT_ENCRYPTION_KEY: "orphan-sweep-constructor-key",
+    } as unknown as CloudflareEnv;
+    // The latest instant at or before now at UTC minute 17.
+    let scheduledTime = Math.floor(Date.now() / hour) * hour + 17 * minute + 12_000;
+    if (scheduledTime > Date.now()) scheduledTime -= hour;
+    expect(new Date(scheduledTime).getUTCMinutes()).toBe(17);
+
+    const pending: Promise<unknown>[] = [];
+    await worker.scheduled({ scheduledTime, cron: "* * * * *" }, env, {
+      waitUntil(promise) {
+        pending.push(promise);
+      },
+      passThroughOnException() {},
+    });
+
+    expect(pending).toHaveLength(1);
+    await expect(Promise.all(pending)).resolves.toBeDefined();
+  });
+});
