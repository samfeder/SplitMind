+ * The retention sweep runs on every due minute whether or not any connection is configured, so removing a
+ * connection from the list purges what was stored for it. It never throws.
+ */
+async function runEmailWatchSweep(event: ScheduledEventLike, env: CloudflareEnv): Promise<void> {
+  const settings = parseEmailWatchConfig(env);
+  const now = event.scheduledTime ?? Date.now();
+  if (!isWatchDue(now, settings.intervalMinutes)) return;
+  await sweepEmailWatchRetention(env.DB, settings.connections, workerLogger, now);
+}
