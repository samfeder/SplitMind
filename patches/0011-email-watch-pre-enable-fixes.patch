+describe("mail_watch runs are outcome-only whatever the caller and audit value", () => {
+  const callers: RunLogCaller[] = ["mcp", "http", "web", "cron"];
+  const audits: ("outcome" | undefined)[] = [undefined, "outcome"];
+
+  describe.each(callers)("caller %s", (caller) => {
+    it.each(audits)("list_pending_mail with audit %s", async (audit) => {
+      const s = await setup();
+      const { log, ok } = await s.run("mail_watch.list_pending_mail", { category: "deploy_failed", limit: 5 }, { caller, audit });
+      expect(ok).toBe(true);
+      expectOutcomeOnly(log, { actionId: "mail_watch.list_pending_mail", caller, ok: true });
+    });
