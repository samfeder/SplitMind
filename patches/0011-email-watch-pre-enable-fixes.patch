+
+    it("a malformed entry next to a valid one counts as not watched: gmail:a stays, bare b and slack:b go", async () => {
+      quiet();
+      const s = await atMinute(M0, { names: ["a", "b"], vars: { [CONNECTIONS]: "gmail:a, slack:b b gmail:" } });
