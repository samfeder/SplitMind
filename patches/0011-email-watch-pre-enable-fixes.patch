+// ---------------------------------------------------------------------------------------------------------------
+// Patch 0011, #106: the retention sweep is a standalone step of every scheduled invocation whose UTC minute is a
+// multiple of the watch interval, with or without any connection configured. Driven only through worker.scheduled
+// and read back from the D1 rows. `Date` is faked (and nothing else) so the cutoffs are exact whether the sweep
+// reads the clock or the event's scheduledTime: both are `at(minute)`.
+// ---------------------------------------------------------------------------------------------------------------
+describe("retention sweep (patch 0011, #106)", () => {
+  const iso = (ms: number) => new Date(ms).toISOString();
+  const quiet = () => {
+    vi.spyOn(console, "info").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    return vi.spyOn(console, "error").mockImplementation(() => {});
+  };
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  /** A setup whose clock stands at `epochMinute` for the whole test. */
+  async function atMinute(epochMinute: number, options: Parameters<typeof setup>[0]) {
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(at(epochMinute));
+    return setup(options);
+  }
+
+  const itemIds = async (s: Setup) =>
+    (await s.watchRows<{ id: string }>("email_watch_items")).map((row) => row.id).sort();
+  const cursorNames = async (s: Setup) =>
+    (await s.watchRows<{ connection_name: string }>("email_watch_cursors")).map((row) => row.connection_name).sort();
+
+  /** Fresh items and one cursor for each of the connections a and b. */
+  async function seedFresh(s: Setup, now: number) {
+    for (const name of ["a", "b"]) {
+      await insertCursor(s.db, { connection_name: name, history_id: "1000", last_run_at: iso(now - HOUR) });
+      await insertItem(s.db, itemRow({ id: `${name}-pending`, connection_name: name, created_at: iso(now - HOUR), received_at: iso(now - HOUR) }));
+      await insertItem(
+        s.db,
+        itemRow({ id: `${name}-acked`, connection_name: name, status: "acknowledged", acknowledged_at: iso(now - HOUR), created_at: iso(now - 2 * HOUR) }),
+      );
+      await insertItem(
+        s.db,
+        itemRow({ id: `${name}-gap`, connection_name: name, category: "watch_gap", sender_domain: "", rule_id: "watch-gap", created_at: iso(now - HOUR), received_at: iso(now - HOUR) }),
+      );
+    }
+  }
+
+  describe("what is purged: connections that are not in the configured list", () => {
+    it("with only gmail:a configured, a due invocation removes every item and the cursor of b and keeps a's fresh ones", async () => {
+      const s = await atMinute(M0, { names: ["a", "b"], vars: { [CONNECTIONS]: "gmail:a" } });
+      await seedFresh(s, at(M0));
+      await s.tick(M0);
+      expect(await itemIds(s)).toEqual(["a-acked", "a-gap", "a-pending"]);
+      expect(await cursorNames(s)).toEqual(["a"]);
+    });
+
+    it("with both configured nothing is purged", async () => {
+      const s = await atMinute(M0, { names: ["a", "b"], vars: { [CONNECTIONS]: "gmail:a gmail:b" } });
+      await seedFresh(s, at(M0));
+      await s.tick(M0);
+      expect(await itemIds(s)).toEqual(["a-acked", "a-gap", "a-pending", "b-acked", "b-gap", "b-pending"]);
+      expect(await cursorNames(s)).toEqual(["a", "b"]);
+    });
+
+    it.each([undefined, "", "   ", "\n"])(
+      "with the connection list %j a due invocation removes everything, makes no Gmail request and creates no run row",
+      async (value) => {
+        const s = await atMinute(M0, { names: ["a", "b"], vars: { [CONNECTIONS]: value }, withAssets: false });
+        await seedFresh(s, at(M0));
+        await s.tick(M0);
+        expect(await itemIds(s)).toEqual([]);
+        expect(await cursorNames(s)).toEqual([]);
+        expect(s.fetcher).not.toHaveBeenCalled();
+        expect(Object.values(s.mailboxes).flatMap((mailbox) => mailbox.requests)).toEqual([]);
+        expect(await s.db.inner.prepare("select count(*) as n from runs").all()).toMatchObject({ results: [{ n: 0 }] });
+      },
+    );
+
+    it.each([
+      ["slack:a"],
+      ["a"],
+      ["gmail:"],
+      [":a"],
+      ["gmail:a:extra"],
+      ["slack:a nocolon gmail: :a"],
+    ])("a list with only malformed or non-Gmail entries (%j) watches nothing, so everything is purged", async (value) => {
+      quiet();
+      const s = await atMinute(M0, { names: ["a", "b"], vars: { [CONNECTIONS]: value } });
