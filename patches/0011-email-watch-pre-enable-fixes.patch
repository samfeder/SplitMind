+/**
+ * Retention sweep, independent of the watch: D1 only, no Gmail, no KV. Deletes expired items, then everything for
+ * connections that are not in the watched list (an empty list purges all). Tables that do not exist yet make it a
+ * silent no-op; any other failure is logged once by error name and rethrown to nobody.
+ */
+export async function sweepEmailWatchRetention(
+  database: D1DatabaseBinding,
+  watched: readonly string[],
+  logger: RuntimeLogger,
+  now: number = Date.now(),
+): Promise<void> {
+  try {
+    await database
+      .prepare("delete from email_watch_items where status = 'pending' and created_at < ?")
+      .bind(new Date(now - PENDING_RETENTION_MS).toISOString())
+      .run();
+    await database
+      .prepare("delete from email_watch_items where status = 'acknowledged' and acknowledged_at < ?")
+      .bind(new Date(now - ACKNOWLEDGED_RETENTION_MS).toISOString())
+      .run();
+    for (const table of ["email_watch_items", "email_watch_cursors"]) {
+      const marks = watched.map(() => "?").join(", ");
+      const where = watched.length > 0 ? ` where connection_name not in (${marks})` : "";
+      await database.prepare(`delete from ${table}${where}`).bind(...watched).run();
     }
+  } catch (error) {
+    if (isMissingTable(error)) return;
+    logger.error({ errorName: errorName(error) }, "email watch retention sweep failed");
