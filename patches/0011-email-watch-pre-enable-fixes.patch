+  describe("what is purged: expired rows of a watched connection", () => {
+    it("deletes pending items older than 14 days and acknowledged items acknowledged over 7 days ago, keeping the rest", async () => {
+      const s = await atMinute(M0, { names: ["a"], vars: { [CONNECTIONS]: "gmail:a" } });
