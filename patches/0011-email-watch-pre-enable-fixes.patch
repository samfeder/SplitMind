+// Patch 0011, #104: every run of a mail_watch action is recorded with outcome-only audit, whatever the caller and
+// whatever `audit` value it passed. Exercised through the real ActionRunner, so the rule is enforced in one place
+// (keyed on the provider id) and not at each call site. The Worker-level MCP and HTTP routes are in
+// cloudflare-email-watch.test.ts ("mail_watch runs in run logs").
+import type { ProviderExecutors } from "../../core/types.ts";
+import type { RunLog, RunLogCaller } from "../storage/runtime-store.ts";
+
+import { afterEach, describe, expect, it } from "vitest";
+import { createCatalogStore } from "../../catalog-store.ts";
+import { ConnectionService } from "../../connection-service.ts";
+import { ActionPolicyService } from "../../core/action-policy.ts";
+import { provider as gmail } from "../../providers/gmail/definition.ts";
+import { provider as mailWatch } from "../../providers/mail_watch/definition.ts";
+import { createMailWatchExecutors } from "../../providers/mail_watch/executors.ts";
+import { ProviderLoader } from "../../providers/provider-loader.ts";
+import { ActionRunner } from "../actions/action-runner.ts";
+import { D1RuntimeDatabase } from "../storage/d1/runtime-store.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import { HOUR, T0, insertItem, itemRow } from "./test-support.ts";
+
+const SUBJECT = "Deployment failed for ledger-9QX";
+const LEAK = `Could not read "${SUBJECT}" at https://mail.google.com/mail/u/owner@example.org/#inbox/18c0ffee from owner@example.org`;
+const SECRETS = [SUBJECT, "ledger-9QX", "mail.google.com", "owner@example.org", "18c0ffee", "no-reply@vercel.com"];
+const iso = (ms: number) => new Date(ms).toISOString();
+
+const databases: SqliteD1Database[] = [];
+afterEach(() => {
+  for (const database of databases.splice(0)) database.close();
+});
+
+async function setup(mailWatchExecutors?: ProviderExecutors) {
+  const binding = new SqliteD1Database();
+  databases.push(binding);
+  const database = new D1RuntimeDatabase(binding);
+  await database.connectionStore.set("gmail", "work", {
+    authType: "oauth2",
+    accessToken: "token-work",
+    tokenType: "Bearer",
+    metadata: {},
+    profile: { accountId: "owner@example.org", displayName: "owner@example.org", grantedScopes: [] },
+  });
+  for (const id of ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8"]) {
+    await insertItem(
+      binding,
+      itemRow({
+        id,
+        connection_name: "work",
+        subject: SUBJECT,
+        received_at: iso(T0 - HOUR),
+        created_at: iso(T0 - HOUR),
+        dedup_key: `key-${id}`,
+      }),
+    );
+  }
+  const catalog = createCatalogStore([JSON.parse(JSON.stringify(gmail)), JSON.parse(JSON.stringify(mailWatch))], {
+    executableActionIds: [...mailWatch.actions.map((action) => action.id), "gmail.get_profile"],
+  });
+  const providerLoader = new ProviderLoader({
+    mail_watch: async () => ({
+      executors:
+        mailWatchExecutors ??
+        createMailWatchExecutors({
+          database: binding,
+          enabled: true,
+          profileEmail: async () => "owner@example.org",
+          now: () => T0,
+        }),
+    }),
+    gmail: async () => ({
+      executors: {
+        "gmail.get_profile": async () => ({
+          ok: true,
+          output: { emailAddress: "owner@example.org", messagesTotal: 7, historyId: "1234" },
+        }),
+      },
+    }),
+  });
+  const runner = new ActionRunner({
+    catalog,
+    providerLoader,
+    connections: new ConnectionService({ catalog, providerLoader, store: database.connectionStore }),
+    runs: database.runLogStore,
+  });
+  const policy = new ActionPolicyService().createSnapshot();
+  return {
+    binding,
+    async run(
+      actionId: string,
+      input: Record<string, unknown>,
+      options: { caller?: RunLogCaller; audit?: "outcome"; connectionName?: string } = {},
+    ): Promise<{ log: RunLog; ok: boolean; output: unknown }> {
+      const result = await runner.run({
+        actionId,
+        input,
+        caller: options.caller ?? "mcp",
+        policy,
+        ...(options.audit ? { audit: options.audit } : {}),
+        ...(options.connectionName ? { connectionName: options.connectionName } : {}),
+      });
+      expect(result).toBeDefined();
+      const log = await runner.getRun(result!.executionId);
+      expect(log).toBeDefined();
+      return { log: log!, ok: result!.result.ok, output: result!.result.output };
+    },
+  };
+}
+
+function expectOutcomeOnly(log: RunLog, expected: { actionId: string; caller: RunLogCaller; ok: boolean }): void {
+  expect(log).toMatchObject({ service: "mail_watch", actionId: expected.actionId, caller: expected.caller, ok: expected.ok });
+  expect(typeof log.durationMs).toBe("number");
+  expect(typeof log.startedAt).toBe("string");
+  expect(typeof log.completedAt).toBe("string");
+  expect(log.inputSummary).toBeUndefined();
+  expect(log.outputSummary).toBeUndefined();
+  expect("inputSummary" in JSON.parse(JSON.stringify(log))).toBe(false);
+  expect("outputSummary" in JSON.parse(JSON.stringify(log))).toBe(false);
+  const dump = JSON.stringify(log);
+  for (const secret of SECRETS) expect(dump, secret).not.toContain(secret);
+}
