+    it.each(audits)("acknowledge_mail with audit %s", async (audit) => {
+      const s = await setup();
+      const { log, ok } = await s.run("mail_watch.acknowledge_mail", { ids: ["i1", "i2"] }, { caller, audit });
+      expect(ok).toBe(true);
+      expectOutcomeOnly(log, { actionId: "mail_watch.acknowledge_mail", caller, ok: true });
+    });
+  });
+
+  it("the caller still gets the subjects in the run's output: only the stored row loses them", async () => {
+    const s = await setup();
+    const { output } = await s.run("mail_watch.list_pending_mail", {});
+    expect(JSON.stringify(output)).toContain(SUBJECT);
+    const ack = await s.run("mail_watch.acknowledge_mail", { ids: ["i3"] });
+    expect(ack.output).toEqual({ acknowledged: 1 });
+  });
+
+  it("a read action of another provider keeps its input and output summaries (control)", async () => {
+    const s = await setup();
+    const { log, ok } = await s.run("gmail.get_profile", {}, { connectionName: "work" });
+    expect(ok).toBe(true);
+    expect(log).toMatchObject({ service: "gmail", actionId: "gmail.get_profile", ok: true });
+    expect(log.inputSummary).toEqual({});
+    expect(log.outputSummary).toMatchObject({ messagesTotal: 7, historyId: "1234" });
+  });
+
+  it("audit: outcome on another provider's action still drops both summaries (existing behaviour)", async () => {
+    const s = await setup();
+    const { log } = await s.run("gmail.get_profile", {}, { connectionName: "work", audit: "outcome" });
+    expect(log.inputSummary).toBeUndefined();
+    expect(log.outputSummary).toBeUndefined();
+  });
+});
