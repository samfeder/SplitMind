+    // [interval variable, minutes after M0, due?]. M0 is a multiple of 60, so every divisor of 60 is due at it.
+    const cases: [string | undefined, number, boolean][] = [
+      [undefined, 0, true],
+      [undefined, 1, false],
+      [undefined, 5, false],
+      [undefined, 9, false],
