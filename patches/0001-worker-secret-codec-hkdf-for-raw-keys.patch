From 4816d8ed067ed140fe0ac2dcc226b2c22df27b4a Mon Sep 17 00:00:00 2001
From: SplitMind <noreply@example.invalid>
Date: Fri, 23 Oct 2026 19:06:13 +0000
Subject: [PATCH] perf(cloudflare): derive the Worker secret key with HKDF when
 it is 32 random bytes

The Worker secret codec stretches OOMOL_CONNECT_ENCRYPTION_KEY with PBKDF2-SHA256
(100,000 iterations) on every cold isolate. Measured in local workerd that is about
15 ms of CPU, more than the Workers Free plan's 10 ms per request on its own.

A key generated as documented (`openssl rand -base64 32`) is already 256 random
bits, so stretching adds nothing. When the key is standard base64 of exactly 32
bytes, derive the AES-256-GCM key with HKDF-SHA256 and write `enc:worker:v2:`
records. The PBKDF2 key is derived lazily, only when a v1 record is read, so
deployments with existing v1 data keep working. Passphrase keys stay on v1 and
refuse v2 records.

Tests use fixtures sealed independently with node:crypto (pbkdf2Sync, hkdfSync,
aes-256-gcm), not with this codec.
---
 .../secrets/worker-secret-codec.test.ts       |  34 ++++++
 src/server/secrets/worker-secret-codec.ts     | 111 +++++++++++++-----
 2 files changed, 118 insertions(+), 27 deletions(-)

diff --git a/src/server/secrets/worker-secret-codec.test.ts b/src/server/secrets/worker-secret-codec.test.ts
index 5ba851dc..4a0e4dcd 100644
--- a/src/server/secrets/worker-secret-codec.test.ts
+++ b/src/server/secrets/worker-secret-codec.test.ts
@@ -1,6 +1,13 @@
 import { describe, expect, it } from "vitest";
 import { createWorkerSecretCodec } from "./worker-secret-codec.ts";
 
+// Fixtures were sealed independently with node:crypto (pbkdf2Sync / hkdfSync + aes-256-gcm), not with this codec.
+// The raw key is the bytes 0x00..0x1f in base64: a test value, never a deployment key.
+const rawKey = Buffer.from(Array.from({ length: 32 }, (_, index) => index)).toString("base64");
+const v1UnderRawKey = "enc:worker:v1:AAECAwQFBgcICQoL.URusuMnufVf4YtsYZUQhh29RXJbD7sYBWlYGZYI";
+const v1UnderPassphrase = "enc:worker:v1:AAECAwQFBgcICQoL.OWZxsUe7I7AlUKYHVZi7lFe28Lt1DrO_e_38aws5DHpE";
+const v2UnderRawKey = "enc:worker:v2:AAECAwQFBgcICQoL.FdFPMRTyq3Hhpmy3dH6F7b_jFEqeZ1MuERHhx6U7";
+
 describe("worker secret codecs", () => {
   it("round-trips encrypted payloads with a worker-specific prefix", async () => {
     const codec = await createWorkerSecretCodec("test-key");
@@ -17,4 +24,31 @@ describe("worker secret codecs", () => {
     await expect(codec.encode("value")).resolves.toBe("value");
     await expect(codec.decode("value")).resolves.toBe("value");
   });
+
+  it("writes v2 records when the key is 32 random bytes in base64", async () => {
+    const codec = await createWorkerSecretCodec(rawKey);
+    const stored = await codec.encode("secret");
+
+    expect(stored).toMatch(/^enc:worker:v2:/);
+    await expect(codec.decode(stored)).resolves.toBe("secret");
+  });
+
+  it("reads a v2 record sealed with HKDF-SHA256 of the raw key", async () => {
+    const codec = await createWorkerSecretCodec(rawKey);
+
+    await expect(codec.decode(v2UnderRawKey)).resolves.toBe("raw-key-secret");
+  });
+
+  it("still reads v1 records written before the raw key path existed", async () => {
+    const codec = await createWorkerSecretCodec(rawKey);
+
+    await expect(codec.decode(v1UnderRawKey)).resolves.toBe("legacy-secret");
+  });
+
+  it("keeps passphrase keys on v1", async () => {
+    const codec = await createWorkerSecretCodec("fixture-passphrase");
+
+    await expect(codec.decode(v1UnderPassphrase)).resolves.toBe("passphrase-secret");
+    await expect(codec.decode(v2UnderRawKey)).rejects.toThrow("configured key is a passphrase");
+  });
 });
diff --git a/src/server/secrets/worker-secret-codec.ts b/src/server/secrets/worker-secret-codec.ts
index 08c1e5e1..0b79aa53 100644
--- a/src/server/secrets/worker-secret-codec.ts
+++ b/src/server/secrets/worker-secret-codec.ts
@@ -2,20 +2,34 @@ import type { ISecretCodec } from "./secret-codec-core.ts";
 
 import { PlainTextSecretCodec } from "./secret-codec-core.ts";
 
-const encryptedPrefix = "enc:worker:v1:";
+const legacyPrefix = "enc:worker:v1:";
+const rawKeyPrefix = "enc:worker:v2:";
 const keySalt = "oomol-connect-worker-secret-store-v1";
+const rawKeyInfo = "oomol-connect-worker-secret-store-v2";
+const rawKeyBytes = 32;
 
 export async function createWorkerSecretCodec(encryptionKey: string | undefined): Promise<ISecretCodec> {
   return encryptionKey ? await WorkerAesGcmSecretCodec.create(encryptionKey) : new PlainTextSecretCodec();
 }
 
+/**
+ * AES-256-GCM secret codec for Workers.
+ *
+ * v1 stretches the passphrase with PBKDF2 (100,000 iterations), which costs tens of milliseconds of CPU on every cold
+ * isolate. A key generated as documented (`openssl rand -base64 32`) is already 256 random bits, so stretching adds
+ * nothing; such keys derive a v2 key with HKDF instead and write v2 records. The PBKDF2 key is derived only when a v1
+ * record is read, so deployments with existing v1 data keep working and new deployments never pay for it.
+ */
 export class WorkerAesGcmSecretCodec implements ISecretCodec {
   readonly encrypted = true;
 
-  private readonly key: CryptoKey;
+  private readonly passphrase: string;
+  private readonly rawKey: CryptoKey | undefined;
+  private legacyKey: Promise<CryptoKey> | undefined;
 
-  private constructor(key: CryptoKey) {
-    this.key = key;
+  private constructor(passphrase: string, rawKey: CryptoKey | undefined) {
+    this.passphrase = passphrase;
+    this.rawKey = rawKey;
   }
 
   static async create(passphrase: string): Promise<WorkerAesGcmSecretCodec> {
@@ -23,49 +37,92 @@ export class WorkerAesGcmSecretCodec implements ISecretCodec {
       throw new Error("Encryption key must not be empty.");
     }
 
-    const material = await crypto.subtle.importKey("raw", utf8(passphrase), "PBKDF2", false, ["deriveKey"]);
-    const key = await crypto.subtle.deriveKey(
-      {
-        name: "PBKDF2",
-        salt: utf8(keySalt),
-        iterations: 100_000,
-        hash: "SHA-256",
-      },
-      material,
-      { name: "AES-GCM", length: 256 },
-      false,
-      ["encrypt", "decrypt"],
-    );
-    return new WorkerAesGcmSecretCodec(key);
+    const rawBytes = decodeRawKey(passphrase);
+    const codec = new WorkerAesGcmSecretCodec(passphrase, rawBytes ? await deriveRawKey(rawBytes) : undefined);
+    if (!codec.rawKey) {
+      // Passphrase keys keep v1 for writes, so derive eagerly as before.
+      await codec.getLegacyKey();
+    }
+    return codec;
   }
 
   async encode(plaintext: string): Promise<string> {
+    const [prefix, key] = this.rawKey ? [rawKeyPrefix, this.rawKey] : [legacyPrefix, await this.getLegacyKey()];
     const iv = crypto.getRandomValues(new Uint8Array(12));
-    const encrypted = await crypto.subtle.encrypt(
-      { name: "AES-GCM", iv: toArrayBuffer(iv) },
-      this.key,
-      utf8(plaintext),
-    );
-    return `${encryptedPrefix}${base64Url(iv)}.${base64Url(encrypted)}`;
+    const encrypted = await crypto.subtle.encrypt({ name: "AES-GCM", iv: toArrayBuffer(iv) }, key, utf8(plaintext));
+    return `${prefix}${base64Url(iv)}.${base64Url(encrypted)}`;
   }
 
   async decode(stored: string): Promise<string> {
-    if (!stored.startsWith(encryptedPrefix)) {
+    let key: CryptoKey;
+    let payload: string;
+    if (stored.startsWith(rawKeyPrefix)) {
+      if (!this.rawKey) {
+        throw new Error("Encrypted Worker secret uses a raw 32-byte key, but the configured key is a passphrase.");
+      }
+      key = this.rawKey;
+      payload = stored.slice(rawKeyPrefix.length);
+    } else if (stored.startsWith(legacyPrefix)) {
+      key = await this.getLegacyKey();
+      payload = stored.slice(legacyPrefix.length);
+    } else {
       return stored;
     }
 
-    const [ivText, encryptedText] = stored.slice(encryptedPrefix.length).split(".");
+    const [ivText, encryptedText] = payload.split(".");
     if (!ivText || !encryptedText) {
       throw new Error("Encrypted Worker secret payload is malformed.");
     }
 
     const decrypted = await crypto.subtle.decrypt(
       { name: "AES-GCM", iv: fromBase64Url(ivText) },
-      this.key,
+      key,
       fromBase64Url(encryptedText),
     );
     return new TextDecoder().decode(decrypted);
   }
+
+  private getLegacyKey(): Promise<CryptoKey> {
+    this.legacyKey ??= deriveLegacyKey(this.passphrase);
+    return this.legacyKey;
+  }
+}
+
+/** Returns the key bytes when the passphrase is standard base64 of exactly 32 bytes, as `openssl rand -base64 32` prints. */
+function decodeRawKey(passphrase: string): ArrayBuffer | undefined {
+  const text = passphrase.trim();
+  if (!/^[A-Za-z0-9+/]{43}=$/.test(text)) {
+    return undefined;
+  }
+  const bytes = Buffer.from(text, "base64");
+  return bytes.byteLength === rawKeyBytes ? toArrayBuffer(bytes) : undefined;
+}
+
+async function deriveRawKey(rawBytes: ArrayBuffer): Promise<CryptoKey> {
+  const material = await crypto.subtle.importKey("raw", rawBytes, "HKDF", false, ["deriveKey"]);
+  return await crypto.subtle.deriveKey(
+    { name: "HKDF", hash: "SHA-256", salt: utf8(keySalt), info: utf8(rawKeyInfo) },
+    material,
+    { name: "AES-GCM", length: 256 },
+    false,
+    ["encrypt", "decrypt"],
+  );
+}
+
+async function deriveLegacyKey(passphrase: string): Promise<CryptoKey> {
+  const material = await crypto.subtle.importKey("raw", utf8(passphrase), "PBKDF2", false, ["deriveKey"]);
+  return await crypto.subtle.deriveKey(
+    {
+      name: "PBKDF2",
+      salt: utf8(keySalt),
+      iterations: 100_000,
+      hash: "SHA-256",
+    },
+    material,
+    { name: "AES-GCM", length: 256 },
+    false,
+    ["encrypt", "decrypt"],
+  );
 }
 
 function utf8(value: string): ArrayBuffer {
