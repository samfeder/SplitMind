+import type { RuntimeLogger } from "../../core/types.ts";
+import type { RuntimeTokenService } from "../storage/runtime-token-service.ts";
+import type { OAuthKVNamespaceBinding } from "./cloudflare-bindings.ts";
+
+const TOKEN_NAME_PREFIX = "MCP OAuth • ";
+const GRANT_KEY_PREFIX = "grant:";
+const DEFAULT_MIN_AGE_MS = 15 * 60_000;
+const DEFAULT_MAX_GRANTS = 200;
+const MAX_REVOKES_PER_RUN = 50;
+
+export interface OrphanSweepOptions {
+  kv: OAuthKVNamespaceBinding;
+  tokens: RuntimeTokenService;
+  /** Epoch milliseconds. */
+  now: number;
+  logger: RuntimeLogger;
+  minAgeMs?: number;
+  maxGrants?: number;
+}
+
+type SkipReason = "kv_error" | "grant_vanished" | "too_many_grants";
+
+type ReferencedIds =
+  | { ok: true; ids: Set<string> }
+  | { ok: false; reason: SkipReason; errorName?: string; grants?: number };
+
+/**
+ * Revokes `MCP OAuth •` runtime tokens that no grant in OAUTH_KV references. Best effort and fail closed: if the grant
+ * set cannot be read completely, nothing is revoked. Never throws. Logs error names only, never messages or secrets.
+ */
+export async function sweepOrphanedMcpOAuthTokens(options: OrphanSweepOptions): Promise<void> {
+  const { kv, tokens, now, logger } = options;
+  try {
+    const minAgeMs = options.minAgeMs ?? DEFAULT_MIN_AGE_MS;
+    const maxGrants = options.maxGrants ?? DEFAULT_MAX_GRANTS;
+
+    const referenced = await readReferencedTokenIds(kv, maxGrants);
+    if (!referenced.ok) {
+      const { ok: _ok, ...fields } = referenced;
+      logger.warn(fields, "mcp_oauth_orphan_sweep_skipped");
+      return;
+    }
+
+    const candidates = (await tokens.listTokens()).filter(
+      (token) => token.name.startsWith(TOKEN_NAME_PREFIX) && now - Date.parse(token.createdAt) > minAgeMs,
+    );
+    const orphans = candidates.filter((token) => !referenced.ids.has(token.id));
+
+    let revoked = 0;
+    for (const orphan of orphans.slice(0, MAX_REVOKES_PER_RUN)) {
+      try {
+        if (await tokens.revokeToken(orphan.id)) revoked += 1;
+      } catch (error) {
+        logger.warn({ tokenId: orphan.id, errorName: errorName(error) }, "mcp_oauth_orphan_sweep_revoke_failed");
+      }
+    }
+    logger.info({ candidates: candidates.length, referenced: referenced.ids.size, revoked }, "mcp_oauth_orphan_sweep");
+  } catch (error) {
+    logger.warn({ reason: "error", errorName: errorName(error) }, "mcp_oauth_orphan_sweep_skipped");
+  }
+}
+
+async function readReferencedTokenIds(kv: OAuthKVNamespaceBinding, maxGrants: number): Promise<ReferencedIds> {
+  const keys: string[] = [];
+  try {
+    let cursor: string | undefined;
+    do {
+      const page = await kv.list({ prefix: GRANT_KEY_PREFIX, cursor });
+      for (const key of page.keys) keys.push(key.name);
+      if (keys.length > maxGrants) return { ok: false, reason: "too_many_grants", grants: keys.length };
+      cursor = page.list_complete ? undefined : page.cursor;
+    } while (cursor);
+  } catch (error) {
+    return { ok: false, reason: "kv_error", errorName: errorName(error) };
+  }
+
+  const ids = new Set<string>();
+  for (const key of keys) {
+    let grant: { metadata?: { runtimeTokenId?: unknown } } | null;
+    try {
+      grant = await kv.get(key, { type: "json" });
+    } catch (error) {
+      return { ok: false, reason: "kv_error", errorName: errorName(error) };
+    }
+    if (grant === null) return { ok: false, reason: "grant_vanished" };
+    const id = grant.metadata?.runtimeTokenId;
+    if (typeof id === "string") ids.add(id);
+  }
+  return { ok: true, ids };
+}
+
+function errorName(error: unknown): string {
+  return error instanceof Error ? error.name : "UnknownError";
+}
