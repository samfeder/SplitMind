+// SplitMind patch 0029 (#146): the hourly sweep that revokes `MCP OAuth •` runtime tokens no grant references.
+//
+// Seams: the exported `sweepOrphanedMcpOAuthTokens({ kv, tokens, now, logger, minAgeMs?, maxGrants? })` over the
+// real RuntimeTokenService on a real (sqlite-backed) D1 store, plus an in-memory KV fake that records every call;
+// and `worker.scheduled` for the wiring. Assumptions the implementation must meet:
+//   - `now` is epoch milliseconds, like `event.scheduledTime ?? Date.now()`.
+//   - `logger` is pino-shaped: `info|warn|error(fields, message)`, where `message` is the event name
+//     (`mcp_oauth_orphan_sweep`, `mcp_oauth_orphan_sweep_skipped`, ...). The tests ignore the level.
+//   - `RuntimeTokenService.revokeToken` DELETES the row (D1RuntimeTokenStore.revoke), and `listTokens()` returns
+//     live rows only with `id`, `name` and `createdAt`. Nothing new is needed on the store or service (point 9):
+//     "not revoked" holds for every listed token, and an already-revoked token is simply absent.
+//   - `candidates` counts the old, `MCP OAuth • ` named, live tokens; `referenced` counts distinct ids that grants
+//     reference. Every fixture keeps these unambiguous (each referenced token is also an old candidate).
+import type { KVListPage, OAuthKVNamespaceBinding } from "./cloudflare-bindings.ts";
+import type { CloudflareEnv } from "./cloudflare-env.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import worker from "../cloudflare.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+import { D1RuntimeDatabase } from "../storage/d1/runtime-store.ts";
+import { hashRuntimeToken, RuntimeTokenService } from "../storage/runtime-token-service.ts";
+import { sweepOrphanedMcpOAuthTokens } from "./mcp-oauth-orphan-sweep.ts";
+
+vi.mock("cloudflare:workers", () => ({
+  WorkerEntrypoint: class {},
+  DurableObject: class {
+    readonly ctx: unknown;
+    readonly env: unknown;
+    constructor(ctx: unknown, env: unknown) {
+      this.ctx = ctx;
+      this.env = env;
+    }
+  },
+}));
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+const minute = 60_000;
+const hour = 60 * minute;
+const PREFIX = "MCP OAuth • ";
+
+// ---- fakes -----------------------------------------------------------------------------------------------------
+
+/** In-memory KV that records every call, pages listings, and can be told to fail. */
+class RecordingKV implements OAuthKVNamespaceBinding {
+  readonly store = new Map<string, string>();
+  readonly listCalls: { prefix?: string; cursor?: string }[] = [];
+  readonly getCalls: string[] = [];
+  readonly writes: string[] = [];
+  pageSize = 1000;
+  failGet: (key: string) => Error | undefined = () => undefined;
+  failList: (cursor: string | undefined) => Error | undefined = () => undefined;
+  /** Keys that are listed but whose get() returns null, as after an expiry race. */
+  vanishOnGet = new Set<string>();
+
+  async put(key: string, value: unknown): Promise<void> {
+    this.writes.push(`put ${key}`);
+    this.store.set(key, typeof value === "string" ? value : "<binary>");
+  }
+  // oxlint-disable-next-line typescript/no-explicit-any -- KV's overloads return text, JSON or bytes by option.
+  async get(key: string, options?: unknown): Promise<any> {
+    this.getCalls.push(key);
+    const failure = this.failGet(key);
+    if (failure) throw failure;
+    if (this.vanishOnGet.has(key)) return null;
+    const value = this.store.get(key);
+    if (value === undefined) return null;
+    const type = typeof options === "string" ? options : (options as { type?: string } | undefined)?.type;
+    return type === "json" ? JSON.parse(value) : value;
+  }
+  async delete(key: string): Promise<void> {
+    this.writes.push(`delete ${key}`);
+    this.store.delete(key);
+  }
+  async list(options?: { prefix?: string; cursor?: string }): Promise<KVListPage> {
+    this.listCalls.push({ prefix: options?.prefix, cursor: options?.cursor });
+    const failure = this.failList(options?.cursor);
+    if (failure) throw failure;
+    const names = [...this.store.keys()].filter((key) => key.startsWith(options?.prefix ?? "")).sort();
+    const start = options?.cursor ? Number(options.cursor) : 0;
+    const page = names.slice(start, start + this.pageSize);
+    const next = start + this.pageSize;
+    return next < names.length
+      ? { keys: page.map((name) => ({ name })), list_complete: false, cursor: String(next) }
+      : { keys: page.map((name) => ({ name })), list_complete: true };
+  }
+}
+
+interface LogEntry {
+  level: string;
+  fields: Record<string, unknown>;
+  message: string;
+}
+
+function recordingLogger() {
+  const entries: LogEntry[] = [];
+  const at = (level: string) => (fields: Record<string, unknown>, message: string) => {
+    entries.push({ level, fields: fields ?? {}, message });
+  };
+  const logger = { info: at("info"), warn: at("warn"), error: at("error"), debug: at("debug") };
+  return {
+    logger: logger as unknown as Parameters<typeof sweepOrphanedMcpOAuthTokens>[0]["logger"],
+    entries,
+    named: (message: string) => entries.filter((entry) => entry.message === message),
+    /** Everything logged, as one string, with Error objects expanded so a leaked message cannot hide. */
+    dump: () =>
+      JSON.stringify(entries, (_key, value) =>
+        value instanceof Error ? { name: value.name, message: value.message, stack: value.stack } : value,
+      ),
+  };
+}
+
+/** A real token service whose revokeToken is observed and can be made to throw or answer false for chosen ids. */
+class ObservedTokens extends RuntimeTokenService {
+  readonly revokeCalls: string[] = [];
+  throwFor = new Map<string, Error>();
+  falseFor = new Set<string>();
+  override async revokeToken(id: string): Promise<boolean> {
+    this.revokeCalls.push(id);
+    const failure = this.throwFor.get(id);
+    if (failure) throw failure;
+    if (this.falseFor.has(id)) return false;
+    return super.revokeToken(id);
+  }
+}
+
+// ---- fixtures --------------------------------------------------------------------------------------------------
+
+function setup() {
+  const db = new SqliteD1Database();
+  const database = new D1RuntimeDatabase(db, {});
+  const tokens = new ObservedTokens(database.runtimeTokenStore);
+  const kv = new RecordingKV();
+  const log = recordingLogger();
+  return { db, database, tokens, kv, log, now: Date.now() };
+}
+type Setup = ReturnType<typeof setup>;
+
+let counter = 0;
+interface Seeded {
+  id: string;
+  secret: string;
+}
+
+/** Insert a live runtime token with an explicit name and age (createToken can neither backdate nor keep spaces). */
+async function seedToken(ctx: Setup, name: string, ageMs: number): Promise<Seeded> {
+  counter += 1;
+  const id = `tok-${counter}`;
+  const secret = `oct_secret-${counter}-${"x".repeat(32)}`;
+  await ctx.database.runtimeTokenStore.add({
+    id,
+    name,
+    tokenHash: hashRuntimeToken(secret),
+    allowedActions: [],
+    blockedActions: [],
+    allowedProxies: [],
+    allowedConnections: [],
+    allowedTriggers: [],
+    createdAt: new Date(ctx.now - ageMs).toISOString(),
+  });
+  return { id, secret };
+}
+
+const oldAge = 2 * hour;
+
+function orphan(ctx: Setup, client = "Claude", ageMs = oldAge): Promise<Seeded> {
+  return seedToken(ctx, `${PREFIX}${client}`, ageMs);
+}
+
+/** A grant record as the OAuth library stores it, carrying the backing token's id and (like props) its secret. */
+function putGrant(ctx: Setup, grantId: string, token: Seeded, body: Record<string, unknown> = {}): void {
+  ctx.kv.store.set(
+    `grant:administrator:${grantId}`,
+    JSON.stringify({
+      id: grantId,
+      userId: "administrator",
+      metadata: { runtimeTokenId: token.id },
+      props: { runtimeToken: token.secret, marker: "GRANT_BODY_MARKER" },
+      ...body,
+    }),
+  );
+}
+
+const liveIds = async (ctx: Setup) => (await ctx.tokens.listTokens()).map((token) => token.id).sort();
+const isLive = async (ctx: Setup, token: Seeded) => (await liveIds(ctx)).includes(token.id);
+
+function sweep(ctx: Setup, extra: { minAgeMs?: number; maxGrants?: number } = {}) {
+  return sweepOrphanedMcpOAuthTokens({
+    kv: ctx.kv,
+    tokens: ctx.tokens,
+    now: ctx.now,
+    logger: ctx.log.logger,
+    ...extra,
+  });
+}
+
+class NamedError extends Error {
+  constructor(name: string, message: string) {
+    super(message);
+    this.name = name;
+  }
+}
+
+// ---- S1 / S2 / S3: which tokens are touched --------------------------------------------------------------------
+
+describe("which runtime tokens the sweep revokes", () => {
+  it("S1: revokes an old orphan and keeps an old token a grant references, then reports the counts", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost client");
+    const kept = await orphan(ctx, "Kept client");
+    putGrant(ctx, "g1", kept);
+
+    await sweep(ctx);
+
+    expect(await isLive(ctx, lost)).toBe(false);
+    expect(await ctx.tokens.resolveToken(lost.secret)).toBeUndefined();
+    expect(await isLive(ctx, kept)).toBe(true);
+    expect(await ctx.tokens.resolveToken(kept.secret)).toMatchObject({ tokenId: kept.id });
+    expect(ctx.tokens.revokeCalls).toEqual([lost.id]);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")).toHaveLength(1);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")[0].fields).toMatchObject({
+      candidates: 2,
+      referenced: 1,
+      revoked: 1,
+    });
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")).toHaveLength(0);
+  });
+
+  it("S1: with no orphans and no grants it revokes nothing and still reports", async () => {
+    const ctx = setup();
+    await sweep(ctx);
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")[0].fields).toMatchObject({
+      candidates: 0,
+      referenced: 0,
+      revoked: 0,
+    });
+  });
+
+  it("S1: a grant whose runtimeTokenId is not a string, or is missing, protects nothing", async () => {
+    const ctx = setup();
+    const a = await orphan(ctx, "A");
+    const b = await orphan(ctx, "B");
+    const c = await orphan(ctx, "C");
+    ctx.kv.store.set("grant:administrator:n", JSON.stringify({ metadata: { runtimeTokenId: 42 } }));
+    ctx.kv.store.set("grant:administrator:m", JSON.stringify({ metadata: {} }));
+    ctx.kv.store.set("grant:administrator:z", JSON.stringify({ id: "z" }));
+    ctx.kv.store.set("grant:administrator:o", JSON.stringify({ metadata: { runtimeTokenId: { id: a.id } } }));
+
+    await sweep(ctx);
+
+    expect(await liveIds(ctx)).toEqual([]);
+    expect(ctx.tokens.revokeCalls.sort()).toEqual([a.id, b.id, c.id].sort());
+  });
+
+  it("S1: several grants may reference one token, and a grant for another client's token still protects it", async () => {
+    const ctx = setup();
+    const shared = await orphan(ctx, "Shared");
+    const other = await orphan(ctx, "Other");
+    const lost = await orphan(ctx, "Lost");
+    putGrant(ctx, "g1", shared);
+    putGrant(ctx, "g2", shared);
+    putGrant(ctx, "g3", other);
+
+    await sweep(ctx);
+
+    expect(await liveIds(ctx)).toEqual([shared.id, other.id].sort());
+    expect(await isLive(ctx, lost)).toBe(false);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")[0].fields).toMatchObject({
+      candidates: 3,
+      referenced: 2,
+      revoked: 1,
+    });
+  });
+
+  it("S1: reads grants only under the grant: prefix, as JSON, and writes nothing to KV", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx);
+    ctx.kv.store.set("token:administrator:g:t", JSON.stringify({ metadata: { runtimeTokenId: lost.id } }));
+    ctx.kv.store.set("client:abc", JSON.stringify({ metadata: { runtimeTokenId: lost.id } }));
+
+    await sweep(ctx);
+
+    expect(ctx.kv.listCalls.length).toBeGreaterThan(0);
+    expect(ctx.kv.listCalls.every((call) => call.prefix === "grant:")).toBe(true);
+    expect(ctx.kv.getCalls.every((key) => key.startsWith("grant:"))).toBe(true);
+    expect(ctx.kv.writes).toEqual([]);
+    // Only a grant protects a token: a stray non-grant key naming the id does not.
+    expect(await isLive(ctx, lost)).toBe(false);
+  });
+
+  it("S2: never touches a token that is not named exactly `MCP OAuth • <client>`, even with no grant and old", async () => {
+    const ctx = setup();
+    const handMade = await seedToken(ctx, "my laptop", oldAge);
+    const noBullet = await seedToken(ctx, "MCP OAuth", oldAge);
+    const noSpace = await seedToken(ctx, "MCP OAuth •Claude", oldAge);
+    const lower = await seedToken(ctx, "mcp oauth • Claude", oldAge);
+    const leading = await seedToken(ctx, ` ${PREFIX}Claude`, oldAge);
+    const middle = await seedToken(ctx, `Backup of ${PREFIX}Claude`, oldAge);
+    const dash = await seedToken(ctx, "MCP OAuth - Claude", oldAge);
+    const real = await orphan(ctx, "Claude");
+
+    await sweep(ctx);
+
+    for (const token of [handMade, noBullet, noSpace, lower, leading, middle, dash]) {
+      expect(await isLive(ctx, token), token.id).toBe(true);
+    }
+    expect(await isLive(ctx, real)).toBe(false);
+    expect(ctx.tokens.revokeCalls).toEqual([real.id]);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")[0].fields).toMatchObject({ candidates: 1, revoked: 1 });
+  });
+
+  it("S2: a token named with only the prefix and an empty client is still an MCP OAuth token", async () => {
+    const ctx = setup();
+    const bare = await seedToken(ctx, PREFIX, oldAge);
+    await sweep(ctx);
+    expect(await isLive(ctx, bare)).toBe(false);
+  });
+
+  it("S3: an orphan younger than the default 15 minutes stays live; an older one goes", async () => {
+    const ctx = setup();
+    const fresh = await orphan(ctx, "Fresh", 14 * minute);
+    const justBefore = await orphan(ctx, "JustBefore", 15 * minute - 1);
+    const stale = await orphan(ctx, "Stale", 16 * minute);
+
+    await sweep(ctx);
+
+    expect(await isLive(ctx, fresh)).toBe(true);
+    expect(await isLive(ctx, justBefore)).toBe(true);
+    expect(await isLive(ctx, stale)).toBe(false);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")[0].fields).toMatchObject({ candidates: 1, revoked: 1 });
+  });
+
+  it("S3: the age edge is strict, older than minAgeMs: exactly minAgeMs old stays, one ms more goes", async () => {
+    const ctx = setup();
+    const exact = await orphan(ctx, "Exact", 5 * minute);
+    const over = await orphan(ctx, "Over", 5 * minute + 1);
+
+    await sweep(ctx, { minAgeMs: 5 * minute });
+
+    expect(await isLive(ctx, exact)).toBe(true);
+    expect(await isLive(ctx, over)).toBe(false);
+  });
+
+  it("S3: a custom minAgeMs replaces the default in both directions", async () => {
+    const ctx = setup();
+    const tenMinutes = await orphan(ctx, "Ten", 10 * minute);
+    const twoHours = await orphan(ctx, "TwoH", 2 * hour);
+
+    await sweep(ctx, { minAgeMs: 3 * hour });
+    expect(await liveIds(ctx)).toEqual([tenMinutes.id, twoHours.id].sort());
+
+    await sweep(ctx, { minAgeMs: 5 * minute });
+    expect(await liveIds(ctx)).toEqual([]);
+  });
+
+  it("S3: a token with a createdAt in the future (clock skew) is not old", async () => {
+    const ctx = setup();
+    const future = await orphan(ctx, "Future", -10 * minute);
+    await sweep(ctx);
+    expect(await isLive(ctx, future)).toBe(true);
+  });
+
+  it("running the sweep twice is idempotent: the second run revokes nothing", async () => {
+    const ctx = setup();
+    await orphan(ctx, "A");
+    await orphan(ctx, "B");
+    await sweep(ctx);
+    ctx.tokens.revokeCalls.length = 0;
+    ctx.log.entries.length = 0;
+
+    await sweep(ctx);
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")[0].fields).toMatchObject({ candidates: 0, revoked: 0 });
+  });
+});
+
+// ---- S4 / S5 / S6 / S7: fail closed and listing ----------------------------------------------------------------
+
+describe("failing closed on the grant listing", () => {
+  it("S4: a KV get that throws revokes nothing and logs kv_error with only the error name", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    putGrant(ctx, "g1", kept);
+    putGrant(ctx, "g2", kept);
+    ctx.kv.failGet = (key) =>
+      key.endsWith(":g2") ? new NamedError("KVBoomError", `secret detail ${kept.secret}`) : undefined;
+
+    await expect(sweep(ctx)).resolves.toBeUndefined();
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(await liveIds(ctx)).toEqual([lost.id, kept.id].sort());
+    const skipped = ctx.log.named("mcp_oauth_orphan_sweep_skipped");
+    expect(skipped).toHaveLength(1);
+    expect(skipped[0].fields).toMatchObject({ reason: "kv_error", errorName: "KVBoomError" });
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")).toHaveLength(0);
+    expect(ctx.log.dump()).not.toContain("secret detail");
+  });
+
+  it("S4: a KV list that throws revokes nothing and logs kv_error", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    ctx.kv.failList = () => new NamedError("KVListError", "list exploded with a private message");
+
+    await expect(sweep(ctx)).resolves.toBeUndefined();
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(await isLive(ctx, lost)).toBe(true);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")[0].fields).toMatchObject({
+      reason: "kv_error",
+      errorName: "KVListError",
+    });
+    expect(ctx.log.dump()).not.toContain("private message");
+  });
+
+  it("S4: a list that fails on page 2 revokes nothing", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    for (let i = 0; i < 4; i += 1) putGrant(ctx, `g${i}`, kept);
+    ctx.kv.pageSize = 2;
+    ctx.kv.failList = (cursor) => (cursor ? new NamedError("Page2Error", "page two failed") : undefined);
+
+    await sweep(ctx);
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(await isLive(ctx, lost)).toBe(true);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")[0].fields).toMatchObject({ reason: "kv_error" });
+  });
+
+  it("S5: a listed grant whose get returns null revokes nothing and logs grant_vanished", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    putGrant(ctx, "g1", kept);
+    putGrant(ctx, "g2", kept);
+    ctx.kv.vanishOnGet.add("grant:administrator:g2");
+
+    await sweep(ctx);
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(await liveIds(ctx)).toEqual([lost.id, kept.id].sort());
+    const skipped = ctx.log.named("mcp_oauth_orphan_sweep_skipped");
+    expect(skipped).toHaveLength(1);
+    expect(skipped[0].fields).toMatchObject({ reason: "grant_vanished" });
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")).toHaveLength(0);
+  });
+
+  it("S6: more than maxGrants keys revokes nothing and logs too_many_grants with the key count", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    for (let i = 0; i < 6; i += 1) putGrant(ctx, `g${i}`, kept);
+
+    await sweep(ctx, { maxGrants: 5 });
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(await isLive(ctx, lost)).toBe(true);
+    const skipped = ctx.log.named("mcp_oauth_orphan_sweep_skipped");
+    expect(skipped).toHaveLength(1);
+    expect(skipped[0].fields).toMatchObject({ reason: "too_many_grants", grants: 6 });
+    expect(ctx.log.named("mcp_oauth_orphan_sweep")).toHaveLength(0);
+  });
+
+  it("S6: exactly maxGrants keys is fine and the sweep runs", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    for (let i = 0; i < 5; i += 1) putGrant(ctx, `g${i}`, kept);
+
+    await sweep(ctx, { maxGrants: 5 });
+
+    expect(await isLive(ctx, lost)).toBe(false);
+    expect(await isLive(ctx, kept)).toBe(true);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")).toHaveLength(0);
+  });
+
+  it("S6: maxGrants defaults to 200: 200 keys run, 201 skip", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    for (let i = 0; i < 200; i += 1) putGrant(ctx, `g${String(i).padStart(3, "0")}`, kept);
+
+    await sweep(ctx);
+    expect(await isLive(ctx, lost)).toBe(false);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")).toHaveLength(0);
+
+    const again = await orphan(ctx, "Again");
+    putGrant(ctx, "g200", kept);
+    ctx.log.entries.length = 0;
+    ctx.tokens.revokeCalls.length = 0;
+
+    await sweep(ctx);
+
+    expect(ctx.tokens.revokeCalls).toEqual([]);
+    expect(await isLive(ctx, again)).toBe(true);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")[0].fields).toMatchObject({
+      reason: "too_many_grants",
+      grants: 201,
+    });
+  });
+
+  it("S6: the maxGrants limit counts keys across pages", async () => {
+    const ctx = setup();
+    const lost = await orphan(ctx, "Lost");
+    const kept = await orphan(ctx, "Kept");
+    for (let i = 0; i < 7; i += 1) putGrant(ctx, `g${i}`, kept);
+    ctx.kv.pageSize = 3;
+
+    await sweep(ctx, { maxGrants: 6 });
+
+    expect(await isLive(ctx, lost)).toBe(true);
+    expect(ctx.log.named("mcp_oauth_orphan_sweep_skipped")[0].fields).toMatchObject({ reason: "too_many_grants" });
+  });
+
+  it("S7: follows the list cursor across pages, and a grant on page 2 protects its token", async () => {
