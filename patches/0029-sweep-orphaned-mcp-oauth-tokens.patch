+  /** The latest instant at or before now whose UTC minute is `minuteOfHour`, with 12 s of seconds. */
+  function slot(minuteOfHour: number): number {
+    const base = Math.floor(Date.now() / hour) * hour + minuteOfHour * minute + 12_000;
