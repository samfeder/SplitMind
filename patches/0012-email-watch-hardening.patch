 }
+
+/** What Cloudflare D1 allows: a statement may bind at most 100 parameters. */
+export const D1_MAX_BOUND_PARAMETERS = 100;
+
+export interface ExecutedStatement {
+  query: string;
+  /** Number of values bound when the statement was executed (run, all or first). */
+  bound: number;
+}
+
+/**
+ * A D1 database that behaves like the real one in the one way SQLite does not: binding more than `limit` values
+ * to one statement throws, as D1 does ("too many SQL variables"). Records every statement that gets executed.
+ */
+export class BindLimitedD1 implements D1DatabaseBinding {
+  readonly executed: ExecutedStatement[] = [];
+
+  private readonly inner: D1DatabaseBinding;
+  private readonly limit: number;
+  private readonly originals = new WeakMap<object, D1PreparedStatementBinding>();
+
+  constructor(inner: D1DatabaseBinding, limit: number = D1_MAX_BOUND_PARAMETERS) {
+    this.inner = inner;
+    this.limit = limit;
+  }
+
+  batch(statements: D1PreparedStatementBinding[]): Promise<{ results: Record<string, unknown>[] | null }[]> {
+    return this.inner.batch(statements.map((statement) => this.originals.get(statement) ?? statement));
+  }
+
+  prepare(query: string): D1PreparedStatementBinding {
+    return this.wrap(this.inner.prepare(query), query, 0);
+  }
+
+  private wrap(statement: D1PreparedStatementBinding, query: string, bound: number): D1PreparedStatementBinding {
+    const record = () => this.executed.push({ query, bound });
+    const wrapped = {
+      bind: (...values: unknown[]) => {
+        if (values.length > this.limit) throw new Error(`D1_ERROR: too many SQL variables (${values.length} bound, limit ${this.limit})`);
+        return this.wrap(statement.bind(...values), query, values.length);
+      },
+      first: (...args: []) => (record(), statement.first(...args)),
+      all: (...args: []) => (record(), statement.all(...args)),
+      run: () => (record(), statement.run()),
+    } as D1PreparedStatementBinding;
+    this.originals.set(wrapped, statement);
+    return wrapped;
+  }
+}
