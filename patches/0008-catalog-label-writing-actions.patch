+describe("read-only connections: a presigned URL is not a read (catalog label)", () => {
+  // aws_s3.generate_presigned_url can sign a DELETE or PUT, so the catalog must label it `destructive`.
+  // Presigning is local, so the observable fact is the refusal itself, not a provider call.
+  const presign = {
+    actionId: "aws_s3.generate_presigned_url",
+    input: { bucket: "my-bucket", objectKey: "k", method: "DELETE" },
+  };
+
+  it("is refused through MCP on a read-only aws_s3 connection", async () => {
+    const site = await boot({ readOnly: "aws_s3:a", connections: [], awsConnections: ["a", "b"] });
+    const result = await site.mcpExecute({ ...presign, connectionName: "a" });
+
+    expect(result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect(String((result.error as { message: string }).message)).toContain('"aws_s3:a"');
+  });
+
+  it("is refused through the HTTP execute API on a read-only aws_s3 connection", async () => {
+    const site = await boot({ readOnly: "aws_s3:a", connections: [], awsConnections: ["a", "b"] });
+    const token = await site.createRuntimeToken(["aws_s3.*"]);
+    const response = await site.httpExecute(token, presign.actionId, presign.input, { connectionName: "a" });
+
+    expect(response.status).toBe(400);
+    await expect(response.json()).resolves.toMatchObject({ success: false, errorCode: "action_blocked" });
+  });
+
+  it("still runs on an aws_s3 connection that is not read-only and returns a signed URL", async () => {
+    const site = await boot({ readOnly: "aws_s3:a", connections: [], awsConnections: ["a", "b"] });
+    const result = await site.mcpExecute({ ...presign, connectionName: "b" });
+
+    expect(result.ok).toBe(true);
+    expect((result.data as { url: string }).url).toContain("my-bucket");
+  });
+});
+
