@@ -0,0 +1,72 @@
+import type { ProviderDefinition } from "../core/types.ts";
+
+import { describe, expect, it } from "vitest";
+
+/**
+ * Read-only connections (and the read-only consent grants) trust each action's `operationType`. These actions
+ * were labelled `read` although they mutate, sign write or delete URLs, consume one-time state, or may leave
+ * files behind in the account, so a read-only connection would have let them through. Labels are read from the
+ * provider definitions, the same objects the catalog is generated from.
+ *
+ * Each expected value is a literal from the revision-2 review list, not derived from the code under test.
+ */
+
+const definitions: Record<string, () => Promise<{ provider: ProviderDefinition }>> = {
+  aws_s3: () => import("./aws_s3/definition.ts"),
+  aliyun_oss: () => import("./aliyun_oss/definition.ts"),
+  cloudflare_r2: () => import("./cloudflare_r2/definition.ts"),
+  tailscale: () => import("./tailscale/definition.ts"),
+  pinata: () => import("./pinata/definition.ts"),
+  keygen: () => import("./keygen/definition.ts"),
+  mailgun: () => import("./mailgun/definition.ts"),
+  vercel: () => import("./vercel/definition.ts"),
+  msg91: () => import("./msg91/definition.ts"),
+  myotp_app: () => import("./myotp_app/definition.ts"),
+  "fusion-api": () => import("./fusion-api/definition.ts"),
+  harpa_ai: () => import("./harpa_ai/definition.ts"),
+  fuxin: () => import("./fuxin/definition.ts"),
+};
+
+const expected: [actionId: string, operationType: "write" | "destructive"][] = [
+  // Presigned URLs that can be used for DELETE.
+  ["aws_s3.generate_presigned_url", "destructive"],
+  ["aliyun_oss.generate_presigned_url", "destructive"],
+  // Presigned URLs for PUT, and calls that change provider state.
+  ["cloudflare_r2.generate_presigned_url", "write"],
+  ["tailscale.rotate_webhook_secret", "write"],
+  ["pinata.pin_by_cid", "write"],
+  ["keygen.ping_machine", "write"],
+  ["keygen.ping_process", "write"],
+  ["mailgun.verify_domain", "write"],
+  ["vercel.verify_project_domain", "write"],
+  ["msg91.verify_otp", "write"],
+  ["myotp_app.verify_otp", "write"],
+  // Uncertain ones fail closed.
+  ["fusion-api.file_upload_generate_presigned_url", "write"],
+  ["fusion-api.file_upload_generate_presigned_urls", "write"],
+  ["harpa_ai.run_ai_prompt", "write"],
+  ["fuxin.create_pdf_from_document", "write"],
+  ["fuxin.create_pdf_from_html", "write"],
+  ["fuxin.merge_documents", "write"],
+  ["fuxin.remove_password_from_document", "write"],
+];
+
+async function labelOf(actionId: string): Promise<string | undefined> {
+  const service = actionId.slice(0, actionId.indexOf("."));
+  const load = definitions[service];
+  if (!load) throw new Error(`no definition loader for ${service}`);
+  const { provider } = await load();
+  return provider.actions.find((action) => action.id === actionId)?.operationType;
+}
+
+describe("catalog labels for actions that write", () => {
+  it("lists every service the review named", () => {
+    expect(new Set(expected.map(([id]) => id.slice(0, id.indexOf("."))))).toEqual(new Set(Object.keys(definitions)));
+  });
+
+  it.each(expected)("%s exists and is labelled %s", async (actionId, operationType) => {
+    const label = await labelOf(actionId);
+    expect(label, `${actionId} must exist in the catalog with an operationType`).toBeDefined();
+    expect(label).toBe(operationType);
+  });
+});
