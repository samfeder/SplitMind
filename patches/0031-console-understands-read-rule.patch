+describe("web policy @read rule", () => {
+  const readActionId = "x.read_a";
+
+  it("C1: accepts @read as an action rule and rejects every other @ rule", () => {
+    expect(policyRuleIssue("@read", "action")).toBeUndefined();
+    for (const rule of ["@read.*", "@read.x", "@reads", "@Read", "@", "@write", "@read ", " @read"]) {
+      expect(policyRuleIssue(rule, "action"), rule).toBe("invalid");
+    }
+  });
+
+  it("C1: rejects @read as a proxy rule", () => {
+    expect(policyRuleIssue("@read", "proxy")).toBe("invalid");
+  });
+
+  it("C1: the structured editor draft accepts @read for actions and flags it for proxies", () => {
+    const draft = createPolicyEditorDraft({ ...emptyRules, allowedActions: ["@read"], blockedActions: ["@read"] });
+    expect(validatePolicyEditorDraft(draft, true)).toEqual([]);
+
+    const proxyDraft = createPolicyEditorDraft({ ...emptyRules, allowedProxies: ["@read"] });
+    expect(validatePolicyEditorDraft(proxyDraft, true)).toEqual([
+      { field: "allowedProxies", code: "invalid", rule: "@read" },
+    ]);
+  });
+
+  it("C2: a token @read allowlist allows an action only when its operationType is read", () => {
+    const layers = tokenLayers({ allowedActions: ["@read"] });
+
+    const allowed = evaluatePolicy(readActionId, "action", layers, "read");
+    expect(allowed).toMatchObject({ allowed: true });
+    expect(allowed.trace).toEqual([
+      { source: "deployment", outcome: "unrestricted" },
+      { source: "runtime", outcome: "unrestricted" },
+      { source: "token", outcome: "allow_match", rule: "@read" },
+    ]);
+
+    for (const operationType of ["write", "destructive", undefined] as const) {
+      const denied = evaluatePolicy(readActionId, "action", layers, operationType);
+      expect(denied, String(operationType)).toMatchObject({ allowed: false, code: "action_not_allowed" });
+      expect(denied.trace[2], String(operationType)).toEqual({ source: "token", outcome: "allow_miss" });
+    }
+  });
+
+  it("C2: @read does not match by action id text and sits beside other rules in the same list", () => {
+    const layers = tokenLayers({ allowedActions: ["@read", "github.create_issue"] });
+
+    expect(evaluatePolicy("github.create_issue", "action", layers, "write")).toMatchObject({
+      allowed: true,
+      trace: expect.arrayContaining([{ source: "token", outcome: "allow_match", rule: "github.create_issue" }]),
+    });
+    expect(evaluatePolicy("@read", "action", tokenLayers({ allowedActions: ["@read"] }), "write")).toMatchObject({
+      allowed: false,
+    });
+  });
+
+  it("C2: @read in a token intersects with the other layers", () => {
+    const policy: RuntimePolicyState = {
+      deployment: { ...emptyRules, allowedActions: ["github.*"] },
+      runtime: emptyRules,
+    };
+    const layers = policyLayers(policy, tokenSummary({ allowedActions: ["@read"] }));
+
+    expect(evaluatePolicy("github.get_issue", "action", layers, "read")).toMatchObject({ allowed: true });
+    expect(evaluatePolicy("slack.read_channel", "action", layers, "read")).toMatchObject({
+      allowed: false,
+      code: "action_not_allowed",
+    });
+    expect(evaluatePolicy("github.create_issue", "action", layers, "write")).toMatchObject({
+      allowed: false,
+      code: "action_not_allowed",
+    });
+  });
+
+  it("C2: @read works in the deployment and Runtime layers too", () => {
+    const layers = policyLayers({
+      deployment: { ...emptyRules, allowedActions: ["@read"] },
+      runtime: { ...emptyRules, allowedActions: ["@read"] },
+    });
+
+    expect(evaluatePolicy(readActionId, "action", layers, "read")).toMatchObject({ allowed: true });
+    expect(evaluatePolicy(readActionId, "action", layers, "write")).toMatchObject({ allowed: false });
+  });
+
+  it("C3: @read in blockedActions blocks read actions only", () => {
+    const layers = tokenLayers({ blockedActions: ["@read"] });
+
+    const blocked = evaluatePolicy(readActionId, "action", layers, "read");
+    expect(blocked).toMatchObject({ allowed: false, code: "action_blocked" });
+    expect(blocked.trace[2]).toEqual({ source: "token", outcome: "block_match", rule: "@read" });
+
+    for (const operationType of ["write", "destructive", undefined] as const) {
+      expect(evaluatePolicy(readActionId, "action", layers, operationType), String(operationType)).toMatchObject({
+        allowed: true,
+      });
+    }
+  });
+
+  it("C3: a Runtime @read block overrides a token @read allow", () => {
+    const policy: RuntimePolicyState = {
+      deployment: emptyRules,
+      runtime: { ...emptyRules, blockedActions: ["@read"] },
+    };
+    const layers = policyLayers(policy, tokenSummary({ allowedActions: ["@read"] }));
+
+    expect(evaluatePolicy(readActionId, "action", layers, "read")).toMatchObject({
+      allowed: false,
+      code: "action_blocked",
+    });
+  });
+
+  it("C4: counts a token @read grant over the read actions of the catalog", () => {
+    const provider = providerWithOperations([
+      ["list_things", "read"],
+      ["get_thing", "read"],
+      ["create_thing", "write"],
+    ]);
+
+    expect(countAllowedActions([provider], tokenLayers({ allowedActions: ["@read"] }))).toEqual({
+      allowed: 2,
+      total: 3,
+    });
+    expect(countAllowedActions([provider], tokenLayers({ blockedActions: ["@read"] }))).toEqual({
+      allowed: 1,
+      total: 3,
+    });
+  });
+
+  it("C4: destructive actions and actions without an operationType are not read", () => {
+    const provider = providerWithOperations([
+      ["list_things", "read"],
+      ["delete_thing", "destructive"],
+      ["mystery", undefined],
+    ]);
+
+    expect(countAllowedActions([provider], tokenLayers({ allowedActions: ["@read"] }))).toEqual({
+      allowed: 1,
+      total: 3,
+    });
+  });
+
+  it("C5: @read never matches a proxy", () => {
+    const allow = tokenLayers({ allowedProxies: ["@read"] });
+    for (const operationType of [undefined, "read"] as const) {
+      expect(evaluatePolicy("github", "proxy", allow, operationType), String(operationType)).toMatchObject({
+        allowed: false,
+        code: "proxy_not_allowed",
+      });
+    }
+
+    const block = policyLayers(
+      { deployment: emptyRules, runtime: { ...emptyRules, blockedProxies: ["@read"] } },
+      tokenSummary({ allowedProxies: ["github"] }),
+    );
+    expect(evaluatePolicy("github", "proxy", block, "read")).toMatchObject({ allowed: true });
+  });
+
+  it("treats @read as a known action rule and not a known proxy rule", () => {
+    const providers = [githubProvider()];
+
+    expect(isKnownPolicyRule("@read", "action", providers)).toBe(true);
+    expect(isKnownPolicyRule("@read", "proxy", providers)).toBe(false);
+    expect(isKnownPolicyRule("@write", "action", providers)).toBe(false);
+  });
+});
+
+function tokenSummary(rules: Partial<Omit<PolicyRules, "blockedProxies">>): RuntimeTokenSummary {
+  return {
+    id: "token-1",
+    name: "Reader",
+    allowedActions: rules.allowedActions ?? [],
+    blockedActions: rules.blockedActions ?? [],
+    allowedProxies: rules.allowedProxies ?? [],
+    allowedConnections: [],
+    createdAt: "2026-07-20T00:00:00.000Z",
+  };
+}
+
+function tokenLayers(rules: Partial<Omit<PolicyRules, "blockedProxies">>) {
+  return policyLayers({ deployment: emptyRules, runtime: emptyRules }, tokenSummary(rules));
+}
+
+function providerWithOperations(
+  operations: Array<[name: string, operationType: "read" | "write" | "destructive" | undefined]>,
+): ProviderDefinition {
+  const base = githubProvider();
+  return {
+    ...base,
+    service: "x",
+    displayName: "X",
+    actions: operations.map(([name, operationType]) => ({
+      ...base.actions[0],
+      id: `x.${name}`,
+      service: "x",
+      name,
+      description: name,
+      ...(operationType ? { operationType } : {}),
+    })),
+  };
+}
+
 function githubProvider(): ProviderDefinition {
   return {
     service: "github",
