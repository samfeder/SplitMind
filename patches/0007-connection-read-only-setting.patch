index 00000000..cd08e532
--- /dev/null
+++ b/src/core/read-only-connections.ts
@@ -0,0 +1,76 @@
+import type { ActionPolicyDecision } from "./action-policy.ts";
+
+/**
+ * Per-connection read-only setting (`OOMOL_CONNECT_READ_ONLY_CONNECTIONS`).
+ *
+ * The value is a comma- and/or whitespace-separated list of `<providerId>:<connectionName>` entries. Matching is
+ * exact and case-sensitive. Every path that reaches a provider with a resolved connection (actions, proxy,
+ * Triggers) asks this one module, so the rule lives in one place.
+ */
+
+export interface ConnectionIdentity {
+  service: string;
+  connectionName: string;
+}
+
+export interface ReadOnlyConnections {
+  /** True when the connection is listed as read-only. */
+  isReadOnly(connection: ConnectionIdentity | undefined): boolean;
+  /**
+   * Refuse an action on a read-only connection unless its catalog `operationType` is `read`.
+   * A missing `operationType` is treated as a write (fail closed). Returns undefined when allowed.
+   */
+  refuseAction(
+    connection: ConnectionIdentity | undefined,
+    operationType: string | undefined,
+  ): ActionPolicyDecision | undefined;
+  /** Refuse any request on a read-only connection, whatever its kind (proxy requests, Trigger writes). */
+  refuseAll(connection: ConnectionIdentity | undefined): ActionPolicyDecision | undefined;
+}
+
+export const noReadOnlyConnections: ReadOnlyConnections = createReadOnlyConnections(new Set());
+
+/**
+ * Parse the setting. Malformed entries (not exactly one `:`, or an empty side) are ignored and reported through
+ * `warn` once each; they never throw.
+ */
+export function parseReadOnlyConnections(
+  value: string | undefined,
+  warn: (message: string) => void = (message) => console.warn(message),
+): ReadOnlyConnections {
+  const entries = new Set<string>();
+  for (const entry of (value ?? "").split(/[\s,]+/).filter(Boolean)) {
+    const parts = entry.split(":");
+    if (parts.length !== 2 || !parts[0] || !parts[1]) {
+      warn(
+        `Ignoring malformed OOMOL_CONNECT_READ_ONLY_CONNECTIONS entry "${entry}"; expected <providerId>:<connectionName>.`,
+      );
+      continue;
+    }
+    entries.add(entry);
+  }
+  return entries.size === 0 ? noReadOnlyConnections : createReadOnlyConnections(entries);
+}
+
+function createReadOnlyConnections(entries: ReadonlySet<string>): ReadOnlyConnections {
+  const isReadOnly = (connection: ConnectionIdentity | undefined): connection is ConnectionIdentity =>
+    connection !== undefined && entries.has(`${connection.service}:${connection.connectionName}`);
+  const refusal = (connection: ConnectionIdentity): ActionPolicyDecision => ({
+    allowed: false,
+    code: "action_blocked",
+    message: `Connection "${connection.service}:${connection.connectionName}" is read-only; write actions are refused.`,
+    checks: [
+      {
+        source: "deployment",
+        outcome: "block_match",
+        rule: "read-only-connection",
+      },
+    ],
+  });
+  return {
+    isReadOnly,
+    refuseAction: (connection, operationType) =>
+      isReadOnly(connection) && operationType !== "read" ? refusal(connection) : undefined,
+    refuseAll: (connection) => (isReadOnly(connection) ? refusal(connection) : undefined),
+  };
+}
