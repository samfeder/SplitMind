+import type { AssetsBinding, D1DatabaseBinding } from "./cloudflare/cloudflare-bindings.ts";
+import type { CloudflareEnv } from "./cloudflare/cloudflare-env.ts";
+
+import { Client, StreamableHTTPClientTransport } from "@modelcontextprotocol/client";
+import { createHmac } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import worker from "./cloudflare.ts";
+import { createWorkerSecretCodec } from "./secrets/worker-secret-codec.ts";
+import { D1RuntimeDatabase } from "./storage/d1/runtime-store.ts";
+import { SqliteD1Database } from "./storage/d1/test-database.ts";
+
+/**
+ * Per-connection read-only setting (OOMOL_CONNECT_READ_ONLY_CONNECTIONS), exercised through the Worker's
+ * public surface only: env var in, MCP tool results and HTTP responses out, with the provider's HTTP API
+ * stubbed at the network edge so "no provider HTTP call" is an observed fact, not an assumption.
+ *
+ * Fixture: the real Notion catalog entry (read, write and destructive actions) with two api_key
+ * connections, `notion:a` and `notion:b`, each holding a distinct secret so a provider call can be traced
+ * back to the connection that made it.
+ */
+
+type ReadOnlyEnv = CloudflareEnv & { OOMOL_CONNECT_READ_ONLY_CONNECTIONS?: string };
+
+const ADMIN = "admin-token";
+const NOTION_READ = { actionId: "notion.retrieve_page", input: { pageId: "page-1" } };
+const NOTION_WRITE = { actionId: "notion.append_block", input: { pageId: "page-1", text: "hello" } };
+const NOTION_DESTRUCTIVE = { actionId: "notion.delete_block", input: { blockId: "block-1" } };
+
+interface ProviderCall {
+  url: string;
+  method: string;
+  authorization: string | null;
+}
+
+let providerCalls: ProviderCall[] = [];
+/** Webhooks the stubbed GitHub API currently holds, so list, create and delete behave like the real thing. */
+let githubHooks: { id: number; config: { url: string } }[] = [];
+let bootCounter = 0;
+
+beforeEach(() => {
+  providerCalls = [];
+  githubHooks = [];
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      const request = new Request(input, init);
+      const url = new URL(request.url);
+      providerCalls.push({
+        url: request.url,
+        method: request.method,
+        authorization: request.headers.get("authorization"),
+      });
+      const token = (request.headers.get("authorization") ?? "").replace(/^(Bearer|token) /i, "");
+      if (url.hostname === "api.linear.app") {
+        return Response.json({
+          data: {
+            viewer: { id: `lin-${token}`, name: `Linear ${token}`, email: "user@example.com" },
+            teams: {
+              nodes: [{ id: "11111111-1111-4111-8111-111111111111", name: "Engineering", key: "ENG" }],
+              pageInfo: { hasNextPage: false },
+            },
+          },
+        });
+      }
+      if (url.hostname.endsWith("amazonaws.com")) return new Response(null, { status: 200 });
+      if (url.hostname.endsWith("feishu.cn")) {
+        return Response.json({ code: 0, tenant_access_token: "t-feishu", expire: 7200, data: {} });
+      }
+      if (url.hostname === "api.github.com") {
+        if (url.pathname === "/user") return Response.json({ id: 7, login: `gh-${token}`, name: `GH ${token}` });
+        if (url.pathname.endsWith("/hooks")) {
+          if (request.method === "POST") {
+            const created = { id: 101, config: { url: ((await request.clone().json()) as any).config.url as string } };
+            githubHooks.push(created);
+            return Response.json({ ...created, active: true, events: ["issues"] }, { status: 201 });
+          }
+          return Response.json(githubHooks);
+        }
+        const hookId = /\/hooks\/(\d+)$/.exec(url.pathname)?.[1];
+        if (hookId && request.method === "DELETE") {
+          githubHooks = githubHooks.filter((hook) => String(hook.id) !== hookId);
+          return new Response(null, { status: 204 });
+        }
+        return request.method === "DELETE" ? new Response(null, { status: 204 }) : Response.json({});
+      }
+      if (url.pathname === "/v1/users/me") {
+        return Response.json({ id: `bot-${token}`, name: `Bot ${token}`, bot: { workspace_name: `ws-${token}` } });
+      }
+      if (url.pathname.startsWith("/v1/databases/")) {
+        return Response.json({
+          object: "database",
+          id: "db",
+          data_sources: [{ id: "11111111-1111-4111-8111-111111111111" }],
+        });
+      }
+      return Response.json({ object: "page", id: "page-1", results: [], has_more: false, next_cursor: null });
+    }),
+  );
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+describe("read-only connections: MCP execute_action", () => {
+  it("refuses a write action on a read-only connection and makes no provider call", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    const result = await site.mcpExecute({ ...NOTION_WRITE, connectionName: "a" });
+
+    expect(result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect(String((result.error as { message: string }).message)).toContain('"notion:a"');
+    expect(String((result.error as { message: string }).message)).toContain("read-only");
+    expect(providerCalls).toEqual([]);
+  });
+
+  it("refuses a destructive action on a read-only connection and makes no provider call", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    const result = await site.mcpExecute({ ...NOTION_DESTRUCTIVE, connectionName: "a" });
+
+    expect(result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect(providerCalls).toEqual([]);
+  });
+
+  it("still runs a read action on the read-only connection, using that connection's credential", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    const result = await site.mcpExecute({ ...NOTION_READ, connectionName: "a" });
+
+    expect(result.ok).toBe(true);
+    expect(providerCalls).toHaveLength(1);
+    expect(providerCalls[0]).toMatchObject({ method: "GET", authorization: "Bearer secret-a" });
+    expect(providerCalls[0].url).toContain("/v1/pages/page-1");
+  });
+
+  it("still runs the same write action on another connection of the same provider", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    const result = await site.mcpExecute({ ...NOTION_WRITE, connectionName: "b" });
+
+    expect(result.ok).toBe(true);
+    expect(providerCalls).toHaveLength(1);
+    expect(providerCalls[0]).toMatchObject({ method: "PATCH", authorization: "Bearer secret-b" });
+  });
+
+  it("records the refusal in the run log as a deployment policy refusal", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    await site.mcpExecute({ ...NOTION_WRITE, connectionName: "a" });
+
+    const runs = (await (await site.admin("/api/runs")).json()) as { items: Record<string, unknown>[] };
+    expect(runs.items).toHaveLength(1);
+    expect(runs.items[0]).toMatchObject({
+      actionId: "notion.append_block",
+      caller: "mcp",
+      ok: false,
+      errorCode: "action_blocked",
+      policy: { allowed: false, checks: [expect.objectContaining({ source: "deployment" })] },
+    });
+  });
+
+  it("applies to an unnamed default connection listed as <provider>:default", async () => {
+    const site = await boot({ readOnly: "notion:default", connections: ["default", "b"] });
+
+    const write = await site.mcpExecute({ ...NOTION_WRITE });
+    expect(write).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect(String((write.error as { message: string }).message)).toContain('"notion:default"');
+    expect(providerCalls).toEqual([]);
+
+    expect((await site.mcpExecute({ ...NOTION_READ })).ok).toBe(true);
+    expect((await site.mcpExecute({ ...NOTION_WRITE, connectionName: "b" })).ok).toBe(true);
+  });
+});
+
+describe("read-only connections: HTTP execute API with a runtime token", () => {
+  it("refuses a write on the read-only connection even though the token allows the action", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    const token = await site.createRuntimeToken(["notion.*"]);
+    const response = await site.httpExecute(token, NOTION_WRITE.actionId, NOTION_WRITE.input, { connectionName: "a" });
+
+    expect(response.status).toBe(400);
+    const body = (await response.json()) as { success: boolean; errorCode: string; message: string };
+    expect(body).toMatchObject({ success: false, errorCode: "action_blocked" });
+    expect(body.message).toContain('"notion:a"');
+    expect(body.message).toContain("read-only");
+    expect(providerCalls).toEqual([]);
+  });
+
+  it("refuses a destructive action on the read-only connection", async () => {
+    const site = await boot({ readOnly: "notion:a" });
+    const token = await site.createRuntimeToken(["notion.*"]);
+    const response = await site.httpExecute(token, NOTION_DESTRUCTIVE.actionId, NOTION_DESTRUCTIVE.input, {
+      connectionName: "a",
+    });
+
+    expect(response.status).toBe(400);
+    await expect(response.json()).resolves.toMatchObject({ success: false, errorCode: "action_blocked" });
+    expect(providerCalls).toEqual([]);
