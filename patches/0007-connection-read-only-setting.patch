+      const raw = JSON.stringify({ action: "opened", issue: { number: 7 } });
+      const response = await trigger(
+        readOnly,
+        token,
+        "github",
+        "github.on_repo_event",
+        {
+          operation: "receive",
+          subscriptionId: id,
+          method: "POST",
+          headers: {
+            "content-type": "application/json",
+            "x-github-event": "issues",
+            "x-github-delivery": "delivery-7",
+            "x-hub-signature-256": `sha256=${createHmac("sha256", record.callbackSecret).update(raw).digest("hex")}`,
+          },
+          query: { connector_subscription: record.callbackNonce },
+          rawBody: Buffer.from(raw).toString("base64"),
+          admit: true,
+          current: true,
+        },
+        { connectionName: "work" },
+      );
+
+      expect(response.status, await response.clone().text()).toBe(200);
+      const data = ((await response.json()) as { data: { result: Record<string, unknown> } }).data;
+      expect(data.result).toMatchObject({ outcome: "event", dedupeKey: "delivery-7" });
+      expect(providerCalls).toEqual([]);
+    });
+
+    it("options still works on a read-only connection (it only reads)", async () => {
+      const site = await boot({ readOnly: "linear:work", connections: [], linearConnections: ["work"] });
+      const token = await site.createRuntimeToken([], { allowedTriggers: ["linear.on_issue_changed"] });
+      const response = await trigger(
+        site,
+        token,
+        "linear",
+        "linear.on_issue_changed",
+        { operation: "options", config: {}, field: "teamId" },
+        { connectionName: "work" },
+      );
+
+      expect(response.status, await response.clone().text()).toBe(200);
+      await expect(response.json()).resolves.toMatchObject({
+        data: [{ value: "11111111-1111-4111-8111-111111111111", label: "Engineering (ENG)" }],
+      });
+      expect(providerCalls.length).toBeGreaterThan(0);
+      expect(providerCalls.every((call) => call.method === "POST" && call.url.includes("api.linear.app"))).toBe(true);
+    });
+  });
+});
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Harness
+// ---------------------------------------------------------------------------------------------------------------------
+
+interface BootOptions {
+  /** Value of OOMOL_CONNECT_READ_ONLY_CONNECTIONS; undefined leaves the variable unset. */
+  readOnly: string | undefined;
+  /** Notion connection names to create (api_key, secret-<name>). "default" creates the unnamed connection. */
+  connections?: string[];
+  /** Feishu app bot connection names to create (custom_credential, appId cli_<name>). Used by the resource Trigger tests. */
+  feishuConnections?: string[];
+  /** Linear connection names to create (api_key, secret-<name>). Used by the `options` Trigger test. */
+  linearConnections?: string[];
+  /** AWS S3 connection names to create (custom_credential, accessKeyId AKIA<name>). */
+  awsConnections?: string[];
+  /** GitHub connection names to create (api_key, secret-<name>). Used by the Trigger tests. */
+  githubConnections?: string[];
+}
+
+interface Site {
+  fetch(path: string, init?: RequestInit): Promise<Response>;
+  admin(path: string, init?: RequestInit): Promise<Response>;
+  createRuntimeToken(
+    allowedActions: string[],
+    extra?: { allowedProxies?: string[]; allowedTriggers?: string[] },
+  ): Promise<string>;
+  connectionId(connectionName: string): Promise<string>;
+  httpExecute(
+    token: string,
+    actionId: string,
+    input: unknown,
+    options: { connectionName?: string; connectionId?: string; idempotencyKey?: string },
+  ): Promise<Response>;
+  mcpCall(tool: string, args: Record<string, unknown>): Promise<Record<string, unknown>>;
+  mcpExecute(args: { actionId: string; input: unknown; connectionName?: string }): Promise<Record<string, unknown>>;
+  /** The same Worker origin and database, booted again with a different setting (and optionally more env vars). */
+  withReadOnly(value: string | undefined, extraEnv?: Record<string, string>): Site;
+  /** The Worker's scheduled handler (trigger maintenance), awaited to completion. */
+  runScheduled(): Promise<void>;
+  /** A view of the Worker's database with the Worker's own secret codec, for reading stored subscriptions. */
+  runtimeDatabase(): D1RuntimeDatabase;
+}
+
+async function boot(options: BootOptions): Promise<Site> {
+  const origin = `https://read-only-${++bootCounter}.example.com`;
+  const database = new SqliteD1Database();
+  const assets = memoryAssets(notionCatalog());
+  const site = createSite(origin, database, assets, options.readOnly, {});
+
+  for (const name of options.connections ?? ["a", "b"]) {
+    const response = await site.admin("/api/connections/notion", {
+      method: "PUT",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        authType: "api_key",
+        ...(name === "default" ? {} : { connectionName: name }),
+        values: { apiKey: `secret-${name}` },
+      }),
+    });
+    expect(response.status, `connect notion:${name}: ${await response.clone().text()}`).toBe(200);
+  }
+  for (const name of options.githubConnections ?? []) {
+    const response = await site.admin("/api/connections/github", {
+      method: "PUT",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ authType: "api_key", connectionName: name, values: { apiKey: `secret-${name}` } }),
+    });
+    expect(response.status, `connect github:${name}: ${await response.clone().text()}`).toBe(200);
+  }
+  for (const name of options.feishuConnections ?? []) {
+    const response = await site.admin("/api/connections/feishu_app_bot", {
+      method: "PUT",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        authType: "custom_credential",
+        connectionName: name,
+        values: { appId: `cli_${name}`, appSecret: `secret-${name}` },
+      }),
+    });
+    expect(response.status, `connect feishu_app_bot:${name}: ${await response.clone().text()}`).toBe(200);
+  }
+  for (const name of options.linearConnections ?? []) {
+    const response = await site.admin("/api/connections/linear", {
+      method: "PUT",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ authType: "api_key", connectionName: name, values: { apiKey: `secret-${name}` } }),
+    });
+    expect(response.status, `connect linear:${name}: ${await response.clone().text()}`).toBe(200);
+  }
+  for (const name of options.awsConnections ?? []) {
+    const response = await site.admin("/api/connections/aws_s3", {
+      method: "PUT",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        authType: "custom_credential",
+        connectionName: name,
+        values: {
+          accessKeyId: `AKIA${name}`,
+          secretAccessKey: `secret-${name}`,
+          region: "us-east-1",
+          bucket: "my-bucket",
+        },
+      }),
+    });
+    expect(response.status, `connect aws_s3:${name}: ${await response.clone().text()}`).toBe(200);
+  }
+  providerCalls = [];
+  return site;
+}
+
+function createSite(
+  origin: string,
+  database: D1DatabaseBinding,
+  assets: AssetsBinding,
+  readOnly: string | undefined,
+  extraEnv: Record<string, string>,
+): Site {
+  const env: ReadOnlyEnv = {
+    DB: database,
+    TRANSIT_FILES: new UnusedR2Bucket(),
+    ASSETS: assets,
+    OOMOL_CONNECT_ADMIN_TOKEN: ADMIN,
+    OOMOL_CONNECT_ENCRYPTION_KEY: "read-only-test-key",
+    ...(readOnly === undefined ? {} : { OOMOL_CONNECT_READ_ONLY_CONNECTIONS: readOnly }),
+    ...extraEnv,
+  };
+  const ctx = { waitUntil() {}, passThroughOnException() {} };
+  const send = (path: string, init?: RequestInit): Promise<Response> =>
+    worker.fetch(new Request(`${origin}${path}`, init), env, ctx);
+  const withAuth = (token: string, init?: RequestInit): RequestInit => ({
+    ...init,
+    headers: { ...(init?.headers as Record<string, string> | undefined), authorization: `Bearer ${token}` },
+  });
+
+  const mcpCall = async (tool: string, args: Record<string, unknown>, token = runtimeTokenFor(site)) => {
+    const bearer = await token;
+    const transport = new StreamableHTTPClientTransport(new URL(`${origin}/mcp`), {
+      fetch: async (input, init) => worker.fetch(new Request(input, init), env, ctx),
+      requestInit: { headers: { authorization: `Bearer ${bearer}` } },
+    });
+    const client = new Client({ name: "read-only-test", version: "0.0.0" });
+    try {
+      await client.connect(transport);
+      const result = await client.callTool({ name: tool, arguments: args });
+      return result.structuredContent as Record<string, unknown>;
+    } finally {
+      await client.close();
+    }
+  };
+
+  const site: Site = {
+    fetch: send,
+    admin: (path, init) => send(path, withAuth(ADMIN, init)),
+    async createRuntimeToken(allowedActions, extra = {}) {
+      const response = await send(
+        "/api/runtime-tokens",
+        withAuth(ADMIN, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({
+            name: "test",
+            allowedActions,
+            blockedActions: [],
+            allowedProxies: extra.allowedProxies ?? [],
+            ...(extra.allowedTriggers ? { allowedTriggers: extra.allowedTriggers } : {}),
+          }),
+        }),
+      );
+      expect(response.status).toBe(200);
+      return ((await response.json()) as { token: string }).token;
+    },
+    async connectionId(connectionName) {
+      const response = await site.admin("/api/connections");
+      const all = (await response.json()) as { id: string; service: string; connectionName: string }[];
+      const found = all.find((item) => item.service === "notion" && item.connectionName === connectionName);
+      expect(found, `connection notion:${connectionName}`).toBeDefined();
+      return found!.id;
+    },
+    httpExecute(token, actionId, input, { connectionName, connectionId, idempotencyKey }) {
+      const headers: Record<string, string> = { "content-type": "application/json" };
+      if (connectionId) headers["x-oo-connector-app-id"] = connectionId;
+      if (idempotencyKey) headers["idempotency-key"] = idempotencyKey;
+      return send(
+        `/v1/actions/${actionId}`,
+        withAuth(token, {
+          method: "POST",
+          headers,
+          body: JSON.stringify({ input, ...(connectionName ? { connectionName } : {}) }),
+        }),
+      );
+    },
+    mcpCall: (tool, args) => mcpCall(tool, args),
+    mcpExecute: (args) => mcpCall("execute_action", args),
+    withReadOnly: (value, extra = {}) => createSite(origin, database, assets, value, extra),
+    async runScheduled() {
+      const pending: Promise<unknown>[] = [];
+      await worker.scheduled({}, env, {
+        waitUntil: (promise) => void pending.push(promise),
+        passThroughOnException() {},
+      });
+      await Promise.all(pending);
+    },
+    runtimeDatabase: () => new D1RuntimeDatabase(database, { secretCodec: testSecretCodec }),
+  };
+  return site;
+}
+
+const testSecretCodec = await createWorkerSecretCodec("read-only-test-key");
+
+const runtimeTokens = new WeakMap<Site, Promise<string>>();
+function runtimeTokenFor(site: Site): Promise<string> {
+  let token = runtimeTokens.get(site);
+  if (!token) {
+    token = site.createRuntimeToken(["notion.*", "aws_s3.*"]);
+    runtimeTokens.set(site, token);
+  }
+  return token;
+}
+
+function notionCatalog(): Record<string, unknown> {
+  const load = (name: string) =>
+    JSON.parse(readFileSync(new URL(`../../catalog/apps/${name}.json`, import.meta.url), "utf8")) as {
+      actions: Record<string, unknown>[];
+    };
+  const provider = load("notion");
+  const github = load("github");
+  const feishu = load("feishu_app_bot");
+  const linear = load("linear");
+  const awsS3 = load("aws_s3");
+  return {
+    "/catalog/index.json": { version: 1, providerCount: 5, chunks: ["apps-0000.json"] },
+    "/catalog/apps-0000.json": [provider, github, feishu, linear, awsS3],
+  };
+}
+
+function memoryAssets(files: Record<string, unknown>): AssetsBinding {
+  return {
+    async fetch(request) {
+      const pathname = new URL(request.url).pathname;
+      return pathname in files ? Response.json(files[pathname]) : new Response("not found", { status: 404 });
+    },
+  };
+}
+
+class UnusedR2Bucket {
+  async put(): Promise<unknown> {
+    throw new Error("Unexpected R2 put");
+  }
+  async get(): Promise<null> {
+    throw new Error("Unexpected R2 get");
+  }
+  async delete(): Promise<void> {
+    throw new Error("Unexpected R2 delete");
+  }
+}
diff --git a/src/server/cloudflare-read-only-untyped-action.test.ts b/src/server/cloudflare-read-only-untyped-action.test.ts
new file mode 100644
index 00000000..56b43115
--- /dev/null
+++ b/src/server/cloudflare-read-only-untyped-action.test.ts
@@ -0,0 +1,208 @@
+import type { AssetsBinding } from "./cloudflare/cloudflare-bindings.ts";
+import type { CloudflareEnv } from "./cloudflare/cloudflare-env.ts";
+
+import { Client, StreamableHTTPClientTransport } from "@modelcontextprotocol/client";
+import { readFileSync } from "node:fs";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import worker from "./cloudflare.ts";
+import { SqliteD1Database } from "./storage/d1/test-database.ts";
+
+/**
+ * Fail-closed rule for read-only connections: an action whose catalog entry has no `operationType` is treated as a
+ * write. This lives in its own file because the Worker caches its catalog per module graph
+ * (`loadCatalogOnce` in cloudflare.ts), so a fixture catalog with a stripped action cannot share a file with tests
+ * that need the normal catalog. Companion to cloudflare-read-only-connections.test.ts.
+ *
+ * Fixture: the real Notion catalog entry with `operationType` removed from notion.retrieve_page only.
+ */
+
+type ReadOnlyEnv = CloudflareEnv & { OOMOL_CONNECT_READ_ONLY_CONNECTIONS?: string };
+
+const ADMIN = "admin-token";
+const UNTYPED = { actionId: "notion.retrieve_page", input: { pageId: "page-1" } };
+const TYPED_READ = { actionId: "notion.retrieve_block", input: { blockId: "block-1" } };
+
+let providerCalls: { url: string; method: string; authorization: string | null }[] = [];
+let bootCounter = 0;
+
+beforeEach(() => {
+  providerCalls = [];
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      const request = new Request(input, init);
+      providerCalls.push({
+        url: request.url,
+        method: request.method,
+        authorization: request.headers.get("authorization"),
+      });
+      const token = (request.headers.get("authorization") ?? "").replace("Bearer ", "");
+      if (new URL(request.url).pathname === "/v1/users/me") {
+        return Response.json({ id: `bot-${token}`, name: `Bot ${token}`, bot: { workspace_name: `ws-${token}` } });
+      }
+      return Response.json({ object: "page", id: "page-1", results: [] });
+    }),
+  );
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+describe("read-only connections: action with no operationType", () => {
+  it("is confirmed untyped in the fixture catalog", () => {
+    const provider = loadNotion();
+    expect(provider.actions.find((action) => action.id === UNTYPED.actionId)).not.toHaveProperty("operationType");
+    expect(provider.actions.find((action) => action.id === TYPED_READ.actionId)).toHaveProperty(
+      "operationType",
+      "read",
+    );
+  });
+
+  it("is refused through MCP on a read-only connection, with no provider call", async () => {
+    const site = await boot("notion:a");
+    const result = await site.mcpExecute({ ...UNTYPED, connectionName: "a" });
+
+    expect(result).toMatchObject({ ok: false, error: { code: "action_blocked" } });
+    expect(String((result.error as { message: string }).message)).toContain('"notion:a"');
+    expect(providerCalls).toEqual([]);
+  });
+
+  it("is refused through the HTTP execute API on a read-only connection, with no provider call", async () => {
+    const site = await boot("notion:a");
+    const response = await site.httpExecute(UNTYPED, "a");
+
+    expect(response.status).toBe(400);
+    await expect(response.json()).resolves.toMatchObject({ success: false, errorCode: "action_blocked" });
+    expect(providerCalls).toEqual([]);
+  });
+
+  it("still runs on a connection that is not read-only", async () => {
+    const site = await boot("notion:a");
+    const result = await site.mcpExecute({ ...UNTYPED, connectionName: "b" });
+
+    expect(result.ok).toBe(true);
+    expect(providerCalls).toHaveLength(1);
+    expect(providerCalls[0].authorization).toBe("Bearer secret-b");
+  });
+
+  it("runs on every connection when nothing is configured", async () => {
+    const site = await boot(undefined);
+    const result = await site.mcpExecute({ ...UNTYPED, connectionName: "a" });
+
+    expect(result.ok).toBe(true);
+  });
+
+  it("does not affect a typed read action on the same read-only connection", async () => {
+    const site = await boot("notion:a");
+    const result = await site.mcpExecute({ ...TYPED_READ, connectionName: "a" });
+
+    expect(result.ok).toBe(true);
+    expect(providerCalls).toHaveLength(1);
+    expect(providerCalls[0].authorization).toBe("Bearer secret-a");
+  });
+});
+
+interface Site {
+  mcpExecute(args: { actionId: string; input: unknown; connectionName?: string }): Promise<Record<string, unknown>>;
+  httpExecute(args: { actionId: string; input: unknown }, connectionName: string): Promise<Response>;
+}
+
+function loadNotion(): { actions: Record<string, unknown>[] } {
+  const provider = JSON.parse(readFileSync(new URL("../../catalog/apps/notion.json", import.meta.url), "utf8")) as {
+    actions: Record<string, unknown>[];
+  };
+  const action = provider.actions.find((candidate) => candidate.id === UNTYPED.actionId);
+  if (!action) throw new Error("fixture action missing");
+  delete action.operationType;
+  return provider;
+}
+
+async function boot(readOnly: string | undefined): Promise<Site> {
+  const origin = `https://read-only-untyped-${++bootCounter}.example.com`;
+  const files: Record<string, unknown> = {
+    "/catalog/index.json": { version: 1, providerCount: 1, chunks: ["apps-0000.json"] },
+    "/catalog/apps-0000.json": [loadNotion()],
+  };
+  const assets: AssetsBinding = {
+    async fetch(request) {
+      const pathname = new URL(request.url).pathname;
+      return pathname in files ? Response.json(files[pathname]) : new Response("not found", { status: 404 });
+    },
+  };
+  const env: ReadOnlyEnv = {
+    DB: new SqliteD1Database(),
+    TRANSIT_FILES: {
+      async put() {
+        throw new Error("Unexpected R2 put");
+      },
+      async get() {
+        throw new Error("Unexpected R2 get");
+      },
+      async delete() {
+        throw new Error("Unexpected R2 delete");
+      },
+    },
+    ASSETS: assets,
+    OOMOL_CONNECT_ADMIN_TOKEN: ADMIN,
+    OOMOL_CONNECT_ENCRYPTION_KEY: "read-only-untyped-key",
+    ...(readOnly === undefined ? {} : { OOMOL_CONNECT_READ_ONLY_CONNECTIONS: readOnly }),
+  };
+  const ctx = { waitUntil() {}, passThroughOnException() {} };
+  const send = (path: string, init?: RequestInit): Promise<Response> =>
+    worker.fetch(new Request(`${origin}${path}`, init), env, ctx);
+  const bearer = (token: string, init: RequestInit = {}): RequestInit => ({
+    ...init,
+    headers: { ...(init.headers as Record<string, string> | undefined), authorization: `Bearer ${token}` },
+  });
+
+  for (const name of ["a", "b"]) {
+    const response = await send(
+      "/api/connections/notion",
+      bearer(ADMIN, {
+        method: "PUT",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ authType: "api_key", connectionName: name, values: { apiKey: `secret-${name}` } }),
+      }),
+    );
+    expect(response.status, `connect notion:${name}`).toBe(200);
+  }
+  const tokenResponse = await send(
+    "/api/runtime-tokens",
+    bearer(ADMIN, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ name: "test", allowedActions: ["notion.*"], blockedActions: [], allowedProxies: [] }),
+    }),
+  );
+  const runtimeToken = ((await tokenResponse.json()) as { token: string }).token;
+  providerCalls = [];
+
+  return {
+    async mcpExecute(args) {
+      const transport = new StreamableHTTPClientTransport(new URL(`${origin}/mcp`), {
+        fetch: async (input, init) => worker.fetch(new Request(input, init), env, ctx),
+        requestInit: { headers: { authorization: `Bearer ${runtimeToken}` } },
+      });
+      const client = new Client({ name: "read-only-untyped-test", version: "0.0.0" });
+      try {
+        await client.connect(transport);
+        const result = await client.callTool({ name: "execute_action", arguments: args });
+        return result.structuredContent as Record<string, unknown>;
+      } finally {
+        await client.close();
+      }
+    },
+    httpExecute({ actionId, input }, connectionName) {
+      return send(
+        `/v1/actions/${actionId}`,
+        bearer(runtimeToken, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ input, connectionName }),
+        }),
+      );
+    },
+  };
+}
