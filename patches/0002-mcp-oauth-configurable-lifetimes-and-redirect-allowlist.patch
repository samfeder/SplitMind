+/**
+ * Read the MCP OAuth lifetimes and redirect allowlist. An unset value keeps the shipped default (1 hour access
+ * tokens, 30-day fixed grants, any registered redirect). A set but invalid lifetime returns undefined, so the
+ * Worker fails closed instead of silently running with a lifetime the operator did not choose.
+ */
+function readMcpOAuthSettings(env: CloudflareEnv): McpOAuthSettings | undefined {
+  const accessTokenTTL = readLifetime(env.OOMOL_CONNECT_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS, 3600);
+  const grantTTL = readLifetime(env.OOMOL_CONNECT_MCP_OAUTH_GRANT_TTL_SECONDS, 30 * 86400);
+  const grantIdleTTL = readLifetime(env.OOMOL_CONNECT_MCP_OAUTH_GRANT_IDLE_TTL_SECONDS, undefined);
+  if (accessTokenTTL === null || grantTTL === null || grantIdleTTL === null) return undefined;
+  if (accessTokenTTL === undefined || grantTTL === undefined) return undefined;
+  const allowedRedirectUris = (env.OOMOL_CONNECT_MCP_OAUTH_ALLOWED_REDIRECT_URIS ?? "")
+    .split(",")
+    .map((uri) => uri.trim())
+    .filter(Boolean);
+  return { accessTokenTTL, grantTTL, ...(grantIdleTTL === undefined ? {} : { grantIdleTTL }), allowedRedirectUris };
+}
+
+/** Returns the fallback when unset, the value when it is an integer of at least 60, and null otherwise. */
+function readLifetime<T extends number | undefined>(value: string | undefined, fallback: T): number | T | null {
+  const trimmed = value?.trim();
+  if (!trimmed) return fallback;
+  const parsed = Number(trimmed);
+  return Number.isInteger(parsed) && parsed >= 60 ? parsed : null;
+}
+
 async function fetchRuntime(request: Request, env: CloudflareEnv): Promise<Response> {
   setPrivateNetworkAccessAllowed(parsePrivateNetworkAccessFlag(env.OOMOL_CONNECT_ALLOW_PRIVATE_NETWORK));
   setEgressTrustedHosts(parseEgressTrustedHosts(env.OOMOL_CONNECT_EGRESS_TRUSTED_HOSTS));
