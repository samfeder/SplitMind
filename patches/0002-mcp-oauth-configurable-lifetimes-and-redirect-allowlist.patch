+import type { AssetsBinding, KVNamespaceBinding } from "./cloudflare-bindings.ts";
+import type { CloudflareEnv } from "./cloudflare-env.ts";
+
+import { createHash, randomBytes } from "node:crypto";
+import { describe, expect, it, vi } from "vitest";
+import worker from "../cloudflare.ts";
+import { SqliteD1Database } from "../storage/d1/test-database.ts";
+
+// The OAuth library imports the Workers runtime module only for its WorkerEntrypoint base class.
+vi.mock("cloudflare:workers", () => ({ WorkerEntrypoint: class {} }));
+
+const origin = "https://connect.example.com";
+const adminToken = "test-admin-token";
+const claudeCallback = "https://claude.ai/api/mcp/auth_callback";
+
+describe("MCP OAuth lifetimes and redirect allowlist", () => {
+  it("issues one-hour access tokens by default", async () => {
+    const tokens = await authorizeAndExchange(createEnv({}), claudeCallback);
+    expect(tokens.status).toBe(200);
+    expect(tokens.body.expires_in).toBe(3600);
+  });
+
+  it("issues access tokens with the configured lifetime", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS: "86400" });
+    const tokens = await authorizeAndExchange(env, claudeCallback);
+    expect(tokens.status).toBe(200);
+    expect(tokens.body.expires_in).toBe(86400);
+  });
+
+  it("keeps the configured access token lifetime after a refresh", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS: "43200" });
+    const tokens = await authorizeAndExchange(env, claudeCallback);
+    const refreshed = await post(env, "/oauth/mcp/token", {
+      grant_type: "refresh_token",
+      refresh_token: String(tokens.body.refresh_token),
+      client_id: tokens.clientId,
+    });
+    expect(refreshed.status).toBe(200);
+    expect((await refreshed.json()).expires_in).toBe(43200);
+  });
+
+  it("fails closed on a lifetime below 60 seconds", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS: "59" });
+    const response = await worker.fetch(
+      new Request(`${origin}/.well-known/oauth-authorization-server`),
+      env,
+      context(),
+    );
+    expect(response.status).toBe(503);
+  });
+
+  it("states the configured grant lifetime on the consent page", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_GRANT_TTL_SECONDS: "604800" });
+    const clientId = await register(env, [claudeCallback]);
+    const page = await worker.fetch(
+      new Request(authorizeUrl(clientId, claudeCallback, "x".repeat(43))),
+      env,
+      context(),
+    );
+    expect(await page.text()).toContain("Keep this connection active for up to 7 days without asking again.");
+  });
+
+  it("refuses to register a client whose redirect URI is not allowlisted", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ALLOWED_REDIRECT_URIS: claudeCallback });
+    const response = await registerResponse(env, ["https://attacker.example/callback"]);
+    expect(response.status).toBe(400);
+    expect((await response.json()).error).toBe("invalid_client_metadata");
+  });
+
+  it("completes authorization for an allowlisted redirect URI", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ALLOWED_REDIRECT_URIS: claudeCallback });
+    const tokens = await authorizeAndExchange(env, claudeCallback);
+    expect(tokens.status).toBe(200);
+  });
+
+  it("matches an allowlisted loopback redirect on any port", async () => {
+    const env = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ALLOWED_REDIRECT_URIS: "http://localhost/callback" });
+    const tokens = await authorizeAndExchange(env, "http://localhost:51234/callback");
+    expect(tokens.status).toBe(200);
+  });
+
+  it("refuses consent for a client registered before the allowlist excluded it", async () => {
+    const kv = new MemoryKV();
+    const db = new SqliteD1Database();
+    const open = createEnv({}, kv, db);
+    const clientId = await register(open, ["https://other.example/callback"]);
+    const restricted = createEnv({ OOMOL_CONNECT_MCP_OAUTH_ALLOWED_REDIRECT_URIS: claudeCallback }, kv, db);
+    const page = await worker.fetch(
+      new Request(authorizeUrl(clientId, "https://other.example/callback", "x".repeat(43))),
+      restricted,
+      context(),
+    );
+    expect(page.status).toBe(403);
+    expect(page.headers.get("location")).toBeNull();
+  });
+});
+
+async function authorizeAndExchange(
+  env: CloudflareEnv,
+  redirectUri: string,
+): Promise<{ status: number; body: Record<string, unknown>; clientId: string }> {
+  const clientId = await register(env, [redirectUri]);
+  const verifier = randomBytes(48).toString("base64url");
+  const challenge = createHash("sha256").update(verifier).digest("base64url");
+  const page = await worker.fetch(new Request(authorizeUrl(clientId, redirectUri, challenge)), env, context());
+  expect(page.status).toBe(200);
+  const handle = /name="handle" value="([^"]+)"/.exec(await page.text())?.[1];
+  const cookies = page.headers
+    .getSetCookie()
+    .map((cookie) => cookie.split(";")[0])
+    .join("; ");
+  const approval = await worker.fetch(
+    new Request(`${origin}/oauth/mcp/authorize`, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded", origin, cookie: cookies },
+      body: new URLSearchParams({ handle: handle ?? "", decision: "approve", admin_token: adminToken }),
+    }),
+    env,
+    context(),
+  );
+  expect(approval.status).toBe(302);
+  const code = new URL(approval.headers.get("location") ?? "").searchParams.get("code") ?? "";
+  const exchanged = await post(env, "/oauth/mcp/token", {
+    grant_type: "authorization_code",
+    code,
+    code_verifier: verifier,
+    redirect_uri: redirectUri,
+    client_id: clientId,
+    resource: `${origin}/mcp`,
+  });
+  return { status: exchanged.status, body: await exchanged.json(), clientId };
+}
+
+function authorizeUrl(clientId: string, redirectUri: string, challenge: string): string {
+  return `${origin}/oauth/mcp/authorize?${new URLSearchParams({
+    response_type: "code",
+    client_id: clientId,
+    redirect_uri: redirectUri,
+    scope: "mcp:access offline_access",
+    resource: `${origin}/mcp`,
+    state: "test-state",
+    code_challenge: challenge,
+    code_challenge_method: "S256",
+  })}`;
+}
+
+async function register(env: CloudflareEnv, redirectUris: string[]): Promise<string> {
+  const response = await registerResponse(env, redirectUris);
+  expect(response.status).toBe(201);
+  return (await response.json()).client_id;
+}
+
+function registerResponse(env: CloudflareEnv, redirectUris: string[]): Promise<Response> {
+  return worker.fetch(
+    new Request(`${origin}/oauth/mcp/register`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        client_name: "Test client",
+        redirect_uris: redirectUris,
+        grant_types: ["authorization_code", "refresh_token"],
+        response_types: ["code"],
+        token_endpoint_auth_method: "none",
+      }),
+    }),
+    env,
+    context(),
+  );
+}
+
+function post(env: CloudflareEnv, path: string, form: Record<string, string>): Promise<Response> {
+  return worker.fetch(
+    new Request(`${origin}${path}`, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams(form),
+    }),
+    env,
+    context(),
+  );
+}
+
+function createEnv(
+  vars: Partial<CloudflareEnv>,
+  kv: MemoryKV = new MemoryKV(),
+  db: SqliteD1Database = new SqliteD1Database(),
+): CloudflareEnv {
+  return {
+    DB: db,
+    TRANSIT_FILES: new MemoryKV(),
+    ASSETS: { fetch: async () => new Response("not found", { status: 404 }) } satisfies AssetsBinding,
+    OAUTH_KV: kv,
+    OOMOL_CONNECT_ORIGIN: origin,
+    OOMOL_CONNECT_ADMIN_TOKEN: adminToken,
+    OOMOL_CONNECT_ENCRYPTION_KEY: "test-encryption-key",
+    ...vars,
+  };
+}
+
+function context(): Parameters<typeof worker.fetch>[2] {
+  return { waitUntil() {}, passThroughOnException() {} };
+}
+
+/** The subset of Workers KV the OAuth library uses: text and JSON reads, TTL writes, deletes and prefix listing. */
+class MemoryKV implements KVNamespaceBinding {
+  private readonly store = new Map<string, string>();
+
+  async put(key: string, value: unknown): Promise<void> {
+    this.store.set(key, typeof value === "string" ? value : new TextDecoder().decode(value as ArrayBuffer));
+  }
+
+  // oxlint-disable-next-line typescript/no-explicit-any -- KV's overloads return text, JSON or bytes by option.
+  async get(key: string, options?: unknown): Promise<any> {
+    const value = this.store.get(key);
+    if (value === undefined) return null;
+    const type = typeof options === "string" ? options : (options as { type?: string } | undefined)?.type;
+    if (type === "json") return JSON.parse(value);
+    if (type === "arrayBuffer") return new TextEncoder().encode(value).buffer;
+    return value;
+  }
+
+  async delete(key: string): Promise<void> {
+    this.store.delete(key);
+  }
+
+  async list(options?: { prefix?: string }): Promise<{ keys: { name: string }[]; list_complete: true }> {
+    const prefix = options?.prefix ?? "";
+    return {
+      keys: [...this.store.keys()].filter((key) => key.startsWith(prefix)).map((name) => ({ name })),
+      list_complete: true,
+    };
+  }
+}
