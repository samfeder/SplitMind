diff --git a/src/server/email-watch/account-fingerprint.ts b/src/server/email-watch/account-fingerprint.ts
new file mode 100644
index 00000000..bbf93ea9
--- /dev/null
+++ b/src/server/email-watch/account-fingerprint.ts
@@ -0,0 +1,14 @@
+import type { ConnectionSummary } from "../../connection-service.ts";
+
+/**
+ * What the email watch records as `connection_id`: sha256 hex of the connection row id, a bar and the provider
+ * account id of its profile ("" when there is none). A connection saved over in place for another Google account
+ * keeps its row id but changes the account id, so it counts as a different account. Neither the id nor the address
+ * is stored or logged, only the hash. The watcher and the list/acknowledge check both get it from the action runner,
+ * which calls this one function.
+ */
+export async function accountFingerprint(summary: Pick<ConnectionSummary, "id" | "profile">): Promise<string> {
+  const text = `${summary.id}|${summary.profile?.accountId ?? ""}`;
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
+  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
+}
