+/**
+ * The caller's connection predicate, narrowed so a name whose cursor was written for a different connection id than
+ * the name resolves to now is not allowed (the id is an account fingerprint, so a connection saved over in place for
+ * another account counts too): its items belong to a previous account, and the next poll deletes them.
+ * A cursor without a connection id (written before patch 0015) is not checked. Without a resolver on the context
+ * nothing is checked. A name with no cursor at all is not allowed. A name that no longer resolves, or whose resolution fails, is hidden.
+ */
+function withAccountCheck(
+  database: D1DatabaseBinding,
+  context: ExecutionContext,
+  allowed: (connectionName: string) => Promise<boolean>,
+): (connectionName: string) => Promise<boolean> {
+  const resolve = context.resolveConnectionId;
+  let recorded: Map<string, string | null> | undefined;
+  const recordedIds = async (): Promise<Map<string, string | null>> => {
+    if (!recorded) {
+      const { results } = await database
+        .prepare("select connection_name, connection_id from email_watch_cursors")
+        .all<{ connection_name: string; connection_id: string | null }>();
+      recorded = new Map(results.map((row) => [row.connection_name, row.connection_id]));
+    }
+    return recorded;
+  };
+  return async (name) => {
+    if (!(await allowed(name))) return false;
+    // Without a resolver (a caller that is not the action runner) nothing is checked.
+    if (!resolve) return true;
+    const ids = await recordedIds();
+    // Fail closed: items of a name with no cursor (a purge that stopped half way) are not shown.
+    if (!ids.has(name)) return false;
+    const expected = ids.get(name);
+    if (expected === null) return true;
+    try {
+      return (await resolve(name)) === expected;
+    } catch {
+      return false;
+    }
+  };
+}
