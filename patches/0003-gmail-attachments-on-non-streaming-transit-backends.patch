@@ -0,0 +1,123 @@
+import type { ExecutionContext, ExecutionResult, ResolvedCredential, TransitFileUpload } from "../../core/types.ts";
+import type { KVNamespaceBinding } from "../../server/cloudflare/cloudflare-bindings.ts";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { executeAction } from "../../core/execution.ts";
+import { setDefaultGuardedFetchDnsLookup } from "../../core/guarded-fetch.ts";
+import { KVTransitFileService } from "../../server/files/kv-transit-files.ts";
+import { provider } from "./definition.ts";
+import { executors } from "./executors.ts";
+
+// Workers KV has no createFromStream, so download_attachment decodes the whole response in memory instead.
+
+const credential: ResolvedCredential = {
+  authType: "oauth2",
+  accessToken: "gmail-buffered-token",
+  tokenType: "Bearer",
+  profile: { accountId: "gmail:test", displayName: "Gmail test", grantedScopes: [] },
+  metadata: {},
+};
+const file = Buffer.from(Array.from({ length: 50_001 }, (_, index) => (index * 7) % 256));
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  setDefaultGuardedFetchDnsLookup(undefined);
+});
+
+class MemoryKV implements KVNamespaceBinding {
+  readonly values = new Map<string, ArrayBuffer | string>();
+
+  async put(key: string, value: string | ArrayBuffer | ArrayBufferView | ReadableStream): Promise<void> {
+    if (typeof value !== "string" && !(value instanceof ArrayBuffer)) throw new Error("unexpected KV value type");
+    this.values.set(key, value);
+  }
+
+  get(key: string, type: "text"): Promise<string | null>;
+  get(key: string, type: "arrayBuffer"): Promise<ArrayBuffer | null>;
+  async get(key: string, type: "text" | "arrayBuffer"): Promise<string | ArrayBuffer | null> {
+    const value = this.values.get(key);
+    if (value === undefined) return null;
+    if (type === "text") return typeof value === "string" ? value : new TextDecoder().decode(value);
+    return typeof value === "string" ? new TextEncoder().encode(value).buffer : value;
+  }
+
+  async delete(key: string): Promise<void> {
+    this.values.delete(key);
+  }
+}
+
+function setup(body: string, maxBytes = 1024 * 1024) {
+  const namespace = new MemoryKV();
+  const transitFiles = new KVTransitFileService({
+    namespace,
+    publicOrigin: "https://worker.example",
+    ttlSeconds: 60,
+    maxBytes,
+  });
+  const requests: string[] = [];
+  setDefaultGuardedFetchDnsLookup(null);
+  vi.stubGlobal("fetch", async (input: string | URL | Request) => {
+    requests.push(String(input));
+    return new Response(body, { headers: { "content-type": "application/json" } });
+  });
+  const context: ExecutionContext = { getCredential: async () => credential, transitFiles };
+  return { namespace, transitFiles, context, requests };
+}
+
+function download(context: ExecutionContext): Promise<ExecutionResult> {
+  return executeAction(
+    provider.actions.find((action) => action.name === "download_attachment")!,
+    executors["gmail.download_attachment"],
+    { messageId: "message", attachmentId: "attachment", fileName: "report.pdf", mimeType: "application/pdf" },
+    context,
+  );
+}
+
+describe("Gmail attachment download on a non-streaming transit backend", () => {
+  it.each([
+    ["unpadded", file.toString("base64url")],
+    ["padded", file.toString("base64url") + "="],
+  ])("stores the decoded file from %s base64url data", async (_label, data) => {
+    const fixture = setup(JSON.stringify({ data, size: file.length }));
+
+    const result = await download(fixture.context);
+
+    expect(result.ok).toBe(true);
+    if (!result.ok) throw new Error(result.error?.message);
+    const upload = result.output as TransitFileUpload;
+    expect(upload).toMatchObject({ sizeBytes: 50_001, name: "report.pdf", mimeType: "application/pdf" });
+    expect(upload.downloadUrl).toBe(`https://worker.example/api/files/${upload.fileId}`);
+    const stored = await fixture.transitFiles.read(upload.fileId);
+    expect(Buffer.from(await stored.file.arrayBuffer()).equals(file)).toBe(true);
+    expect(fixture.requests).toEqual([
+      "https://gmail.googleapis.com/gmail/v1/users/me/messages/message/attachments/attachment?fields=data,size",
+    ]);
+  });
+
+  it.each([
+    ["invalid base64", JSON.stringify({ data: "ab!cd", size: 3 })],
+    ["impossible length", JSON.stringify({ data: "abcde" })],
+    ["size mismatch", JSON.stringify({ data: file.toString("base64url"), size: 1 })],
+    ["missing data", JSON.stringify({ size: 3 })],
+    ["truncated JSON", `{"data":"${file.toString("base64url")}`],
+  ])("refuses %s with 502 and stores nothing", async (_label, body) => {
+    const fixture = setup(body);
+
+    expect(await download(fixture.context)).toMatchObject({ ok: false, error: { details: { status: 502 } } });
+    expect(fixture.namespace.values.size).toBe(0);
+  });
+
+  it("refuses an attachment over the transit limit with 413 and stores nothing", async () => {
+    const fixture = setup(JSON.stringify({ data: file.toString("base64url"), size: file.length }), 50_000);
+
+    expect(await download(fixture.context)).toMatchObject({ ok: false, error: { details: { status: 413 } } });
+    expect(fixture.namespace.values.size).toBe(0);
+  });
+
+  it("refuses a response far over the limit before parsing it", async () => {
+    const fixture = setup(JSON.stringify({ data: "A".repeat(200_000) }), 50_000);
+
+    expect(await download(fixture.context)).toMatchObject({ ok: false, error: { details: { status: 413 } } });
+    expect(fixture.namespace.values.size).toBe(0);
+  });
+});
