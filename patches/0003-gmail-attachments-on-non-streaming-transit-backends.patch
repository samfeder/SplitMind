+/**
+ * Decode a whole MessagePartBody response in memory, for transit backends that cannot store a stream (Workers KV,
+ * which buffers every value anyway). Native JSON and base64 decoding cost a small fraction of the streaming parser's
+ * CPU, which is what a Worker's CPU limit counts.
+ */
+export async function readGmailAttachmentBytes(
+  response: Response,
+  maxBytes: number,
+  signal?: AbortSignal,
+): Promise<Uint8Array<ArrayBuffer>> {
+  const tooLarge = () =>
+    new ProviderRequestError(413, `Gmail attachment exceeds transit file limit of ${maxBytes} bytes`);
+  const bytes = await readBoundedResponseBytes(response, {
+    maxBytes: Math.ceil(maxBytes / 3) * 4 + maxEnvelopeCharacters,
+    fieldName: "Gmail attachment",
+    createError: tooLarge,
+    signal,
+  });
+  let body: { data?: unknown; size?: unknown };
+  try {
+    body = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes)) as typeof body;
+  } catch {
+    throw providerResponseError("Invalid Gmail attachment JSON");
+  }
+  const data = body?.data;
+  if (typeof data !== "string")
+    throw providerResponseError("Gmail attachment is incomplete or its size does not match");
+  const unpadded = data.endsWith("==") ? data.slice(0, -2) : data.endsWith("=") ? data.slice(0, -1) : data;
+  // Buffer skips characters outside the alphabet instead of failing, so a short result means invalid data.
+  const decoded = Buffer.from(unpadded, "base64url");
+  if (unpadded.length % 4 === 1 || decoded.length !== Math.floor((unpadded.length * 3) / 4)) {
+    throw providerResponseError("Invalid Gmail attachment base64url data");
+  }
+  if (decoded.length > maxBytes) throw tooLarge();
+  if (body.size !== undefined && body.size !== decoded.length) {
+    throw providerResponseError("Gmail attachment is incomplete or its size does not match");
+  }
+  return new Uint8Array(decoded.buffer, decoded.byteOffset, decoded.length) as Uint8Array<ArrayBuffer>;
+}
