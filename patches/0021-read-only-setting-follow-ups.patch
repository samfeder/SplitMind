+// One parsed list per (raw setting, catalog), shared by app builds and the watch runner, so each startup warning is
+// logged once per isolate per config instead of once per build.
+let readOnlyParsed: { raw: string | undefined; catalog: CatalogStore; value: ReadOnlyConnections } | undefined;
+
+function readOnlyConnectionsFor(env: CloudflareEnv, catalog: CatalogStore): ReadOnlyConnections {
+  const raw = env.OOMOL_CONNECT_READ_ONLY_CONNECTIONS;
+  if (readOnlyParsed && readOnlyParsed.raw === raw && readOnlyParsed.catalog === catalog) return readOnlyParsed.value;
+  const value = parseReadOnlyConnections(raw, undefined, (id) =>
+    catalog.providers.some((provider) => provider.service === id),
+  );
+  readOnlyParsed = { raw, catalog, value };
+  return value;
+}
+
 function loadCatalogOnce(assets: AssetsBinding): Promise<CatalogStore> {
   // The catalog depends only on the assets binding, which is fixed for the isolate, so one slot
   // under a constant key covers every request.
