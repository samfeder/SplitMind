+// Patch 0030 (P8): "@read" is a label rule for action fields only.
+describe("policy input: the @read label rule", () => {
+  const none = { allowedActions: [], blockedActions: [], allowedProxies: [] };
+
+  it("P8: accepts @read in token allowedActions and blockedActions, alone or beside other rules", () => {
+    expect(readTokenPolicy({ ...none, allowedActions: ["@read"] }, true).allowedActions).toEqual(["@read"]);
+    expect(readTokenPolicy({ ...none, blockedActions: ["@read"] }, true).blockedActions).toEqual(["@read"]);
+    expect(
+      readTokenPolicy({ ...none, allowedActions: [" @read ", "github.create_issue", "@read"] }, true).allowedActions,
+    ).toEqual(["@read", "github.create_issue"]);
+  });
+
+  it("P8: accepts @read in Runtime allowedActions and blockedActions", () => {
+    expect(
+      readRuntimePolicyRules({ ...none, allowedActions: ["@read"], blockedActions: ["@read"], blockedProxies: [] }),
+    ).toMatchObject({ allowedActions: ["@read"], blockedActions: ["@read"] });
+  });
+
+  it.each(["@reads", "@Read", "@READ", "@", "@read.*", "@write", "@destructive", "@*", "read@", "@@read", "@read.x"])(
+    "P8: rejects %j as an action rule, so a typo cannot silently match nothing",
+    (rule) => {
+      expect(() => readTokenPolicy({ ...none, allowedActions: [rule] }, true)).toThrow("invalid action rule");
+      expect(() => readTokenPolicy({ ...none, blockedActions: [rule] }, true)).toThrow("invalid action rule");
+      expect(() => readRuntimePolicyRules({ ...none, allowedActions: [rule], blockedProxies: [] })).toThrow(
+        "invalid action rule",
+      );
+    },
+  );
+
+  it("P8: rejects @read for proxies, in tokens and in Runtime policy", () => {
+    expect(() => readTokenPolicy({ ...none, allowedProxies: ["@read"] }, true)).toThrow("invalid proxy rule");
+    expect(() => readRuntimePolicyRules({ ...none, allowedProxies: ["@read"], blockedProxies: [] })).toThrow(
+      "invalid proxy rule",
+    );
+    expect(() => readRuntimePolicyRules({ ...none, allowedProxies: [], blockedProxies: ["@read"] })).toThrow(
+      "invalid proxy rule",
+    );
+  });
+
+  it("P8: rejects @read for Triggers, which have no definition to read a label from", () => {
+    expect(() => readTokenPolicy({ ...none, allowedTriggers: ["@read"] }, true)).toThrow("@read");
+    expect(() => readRuntimePolicyRules({ ...none, allowedTriggers: ["@read"], blockedProxies: [] })).toThrow("@read");
+    expect(() => readRuntimePolicyRules({ ...none, blockedTriggers: ["@read"], blockedProxies: [] })).toThrow("@read");
+  });
+
+  it("P8: Trigger fields still accept their ordinary rules", () => {
+    expect(
+      readRuntimePolicyRules({
+        ...none,
+        allowedTriggers: ["*", "github.on_repo_event"],
+        blockedTriggers: ["gmail.*"],
+        blockedProxies: [],
+      }),
+    ).toMatchObject({ allowedTriggers: ["*", "github.on_repo_event"], blockedTriggers: ["gmail.*"] });
+  });
+});
