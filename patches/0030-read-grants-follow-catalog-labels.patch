+// Patch 0030 (P7): a read-only grant is stored as the @read label rule, and the policy follows the catalog's labels at
+// request time. The expected behaviour is read from the MCP endpoint itself, with the access token the code exchange
+// returns. The MCP server exposes a fixed set of tools (search_actions, get_action_guide, execute_action), so "the
+// write tool is absent" is observed as: search_actions reports the write action's policy as not allowed, and
+// execute_action refuses it with action_not_allowed.
+const mcpVerifier = "m".repeat(64);
+
+async function exchangeForAccessToken(clientId: string, code: string): Promise<string> {
+  const response = await worker.fetch(
+    new Request(`${origin}/oauth/mcp/token`, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams({
+        grant_type: "authorization_code",
+        code,
+        client_id: clientId,
+        redirect_uri: claudeCallback,
+        code_verifier: mcpVerifier,
+        resource: `${origin}/mcp`,
+      }),
+    }),
+    env,
+    context(),
+  );
+  expect(response.status).toBe(200);
+  return (await response.json()).access_token;
+}
+
+/** Approve a consent with the given access field and return the access token an MCP client would hold. */
+async function readOnlyOrFullAccessToken(access: "read" | "all"): Promise<string> {
+  const clientId = await registerClient();
+  const query = new URLSearchParams({
+    response_type: "code",
+    client_id: clientId,
+    redirect_uri: claudeCallback,
+    scope: "mcp:access offline_access",
+    resource: `${origin}/mcp`,
+    state: "mcp-state",
+    code_challenge: createHash("sha256").update(mcpVerifier).digest("base64url"),
+    code_challenge_method: "S256",
+  });
+  const response = await worker.fetch(
+    new Request(`${origin}/oauth/mcp/authorize?${query}`, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded", origin },
+      body: new URLSearchParams({ decision: "approve", access, admin_token: adminToken }),
+    }),
+    env,
+    context(),
+  );
+  expect(response.status).toBe(302);
+  const code = new URL(response.headers.get("location") ?? "").searchParams.get("code");
+  expect(code).toBeTruthy();
+  return exchangeForAccessToken(clientId, code!);
+}
+
+let rpcId = 0;
+/** One stateless JSON-RPC request to /mcp. Returns the parsed result, or the error object. */
+async function mcpRpc(
+  accessToken: string,
+  method: string,
+  params: unknown,
+  target: typeof worker = worker,
+): Promise<any> {
+  const response = await target.fetch(
+    new Request(`${origin}/mcp`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${accessToken}`,
+        "content-type": "application/json",
+        accept: "application/json, text/event-stream",
+      },
+      body: JSON.stringify({ jsonrpc: "2.0", id: ++rpcId, method, params }),
+    }),
+    env,
+    context(),
+  );
+  const text = await response.text();
+  expect([response.status, text.slice(0, 300)]).toEqual([200, expect.any(String)]);
+  const data =
+    text.startsWith("event:") || text.includes("\ndata:")
+      ? text
+          .split("\n")
+          .find((line) => line.startsWith("data:"))!
+          .slice(5)
+      : text;
+  const message = JSON.parse(data);
+  return message.error ?? message.result;
+}
+
+async function callTool(
+  accessToken: string,
+  name: string,
+  args: Record<string, unknown>,
+  target: typeof worker = worker,
+): Promise<any> {
+  const result = await mcpRpc(accessToken, "tools/call", { name, arguments: args }, target);
+  const content = result.content?.[0]?.text;
+  return content ? JSON.parse(content) : result;
+}
+
+describe("P7: a read-only grant follows the catalog's labels through the MCP endpoint", () => {
+  it("stores @read, lists the fixed tools, reports the write and destructive actions as refused and the read ones as allowed", async () => {
+    const accessToken = await readOnlyOrFullAccessToken("read");
+    const listed = await mcpRpc(accessToken, "tools/list", {});
+    expect((listed.tools as { name: string }[]).map((tool) => tool.name).sort()).toEqual([
+      "execute_action",
+      "get_action_guide",
+      "list_apps",
+      "list_connections",
+      "search_actions",
+    ]);
+
+    const found = await callTool(accessToken, "search_actions", { service: "17track", limit: 20 });
+    const rows = (found.data ?? found) as {
+      id: string;
+      operationType: string;
+      capability: { policy: { allowed: boolean; code?: string } };
+    }[];
+    const byId = new Map(rows.map((row) => [row.id, row]));
+    expect(byId.get("17track.read_thing")!.capability.policy.allowed).toBe(true);
+    expect(byId.get("17track.list_things")!.capability.policy.allowed).toBe(true);
+    expect(byId.get("17track.write_thing")!.capability.policy).toMatchObject({
+      allowed: false,
+      code: "action_not_allowed",
+    });
+    expect(byId.get("17track.delete_thing")!.capability.policy).toMatchObject({
+      allowed: false,
+      code: "action_not_allowed",
+    });
+  });
+
+  it("refuses execute_action for a write and a destructive action with action_not_allowed, and lets a read action past the policy", async () => {
