index ceda8324..72722e79 100644
--- a/src/core/action-policy.test.ts
+++ b/src/core/action-policy.test.ts
@@ -410,3 +410,188 @@ describe("Trigger policy", () => {
     expect(service.createSnapshot(rules, token).evaluateTrigger("gmail.on_message_received").allowed).toBe(true);
   });
 });
+
+// Patch 0030: "@read" is a label rule. It follows each action's operationType at request time, so a read-only grant
+// tracks the catalog instead of a frozen list of ids.
+describe("@read label rule", () => {
+  const emptyRules = { allowedActions: [], blockedActions: [], allowedProxies: [], blockedProxies: [] };
+  const withType = (id: string, operationType: unknown): ActionDefinition =>
+    ({ ...action, id, name: id.split(".")[1]!, operationType }) as ActionDefinition;
+  const tokenSnapshot = (allowedActions: string[], blockedActions: string[] = []) =>
+    new ActionPolicyService().createSnapshot(emptyRules, { allowedActions, blockedActions, allowedProxies: ["*"] });
+
+  it("P1: a token granting only @read allows read actions and refuses every other label", () => {
+    const snapshot = tokenSnapshot(["@read"]);
+    expect(snapshot.evaluate(withType("gmail.search_messages", "read"))).toEqual({
+      allowed: true,
+      checks: [{ source: "token", outcome: "allow_match", rule: "@read" }],
+    });
+    for (const operationType of ["write", "destructive", undefined, "READ", "Read", "read ", "", null, 1, ["read"]]) {
+      expect(snapshot.evaluate(withType("gmail.send_message", operationType)), String(operationType)).toEqual({
+        allowed: false,
+        code: "action_not_allowed",
+        message: "gmail.send_message is not included in the local action allowlist.",
+        checks: [{ source: "token", outcome: "allow_miss" }],
+      });
+    }
+  });
+
+  it("P1: an action with no operationType property at all is refused", () => {
+    const { operationType: _omitted, ...bare } = action;
+    expect(tokenSnapshot(["@read"]).evaluate(bare as ActionDefinition)).toMatchObject({
+      allowed: false,
+      code: "action_not_allowed",
+    });
+  });
+
+  it("P2: relabelling an action from read to write refuses it under the same stored rule, and the reverse allows it", () => {
+    const stored = ["@read"]; // what a read-only consent stored once, never rewritten
+    const asRead = withType("notion.update_page", "read");
+    const asWrite = withType("notion.update_page", "write");
+    expect(tokenSnapshot(stored).evaluate(asRead).allowed).toBe(true);
+    expect(tokenSnapshot(stored).evaluate(asWrite)).toMatchObject({ allowed: false, code: "action_not_allowed" });
+    // A read action added to the catalog later was never in any list, yet is allowed.
+    expect(tokenSnapshot(stored).evaluate(withType("notion.brand_new_lookup", "read")).allowed).toBe(true);
+    // And a write action relabelled read becomes reachable.
+    expect(tokenSnapshot(stored).evaluate(withType("notion.send_digest", "write")).allowed).toBe(false);
+    expect(tokenSnapshot(stored).evaluate(withType("notion.send_digest", "read")).allowed).toBe(true);
+  });
+
+  it("P2: @read composes with an exact id and a provider prefix in the same list", () => {
+    const snapshot = tokenSnapshot(["@read", "github.create_issue"]);
+    expect(snapshot.evaluate(withType("github.create_issue", "write")).allowed).toBe(true);
+    expect(snapshot.evaluate(withType("github.delete_repository", "destructive")).allowed).toBe(false);
+    expect(snapshot.evaluate(withType("github.get_user", "read")).allowed).toBe(true);
+    const prefixed = tokenSnapshot(["@read", "slack.*"]);
+    expect(prefixed.evaluate(withType("slack.post_message", "write")).allowed).toBe(true);
+    expect(prefixed.evaluate(withType("gmail.send_message", "write")).allowed).toBe(false);
+  });
+
+  it("P2: @read is one layer of the intersection, so a deployment allowlist still narrows it", () => {
+    const snapshot = new ActionPolicyService({ allowedActions: ["gmail.*"] }).createSnapshot(emptyRules, {
+      allowedActions: ["@read"],
+      blockedActions: [],
+      allowedProxies: ["*"],
+    });
+    expect(snapshot.evaluate(withType("gmail.search_messages", "read")).allowed).toBe(true);
+    expect(snapshot.evaluate(withType("notion.search", "read"))).toMatchObject({
+      allowed: false,
+      code: "action_not_allowed",
+      checks: [{ source: "deployment", outcome: "allow_miss" }],
+    });
+  });
+
+  it("P2: @read works in a deployment or Runtime allowlist, not only in a token", () => {
+    const deployment = new ActionPolicyService({ allowedActions: ["@read"] }).createSnapshot();
+    expect(deployment.evaluate(withType("gmail.search_messages", "read")).allowed).toBe(true);
+    expect(deployment.evaluate(withType("gmail.send_message", "write")).allowed).toBe(false);
+    const runtime = new ActionPolicyService().createSnapshot({ ...emptyRules, allowedActions: ["@read"] });
+    expect(runtime.evaluate(withType("gmail.search_messages", "read")).allowed).toBe(true);
+    expect(runtime.evaluate(withType("gmail.send_message", "write")).allowed).toBe(false);
+  });
+
+  it("P3: @read in blockedActions blocks read actions only", () => {
+    const snapshot = tokenSnapshot([], ["@read"]);
+    expect(snapshot.evaluate(withType("gmail.search_messages", "read"))).toEqual({
+      allowed: false,
+      code: "action_blocked",
+      message: "gmail.search_messages is blocked by the local action policy.",
+      checks: [{ source: "token", outcome: "block_match", rule: "@read" }],
+    });
+    expect(snapshot.evaluate(withType("gmail.send_message", "write")).allowed).toBe(true);
+    expect(snapshot.evaluate(withType("notion.delete_block", "destructive")).allowed).toBe(true);
+    expect(snapshot.evaluate(withType("gmail.mystery", undefined)).allowed).toBe(true);
+  });
+
+  it("P3: @read in a deployment blockedActions blocks read actions even when another layer allows them", () => {
+    const snapshot = new ActionPolicyService({ blockedActions: ["@read"] }).createSnapshot(emptyRules, {
+      allowedActions: ["*"],
+      blockedActions: [],
+      allowedProxies: ["*"],
+    });
+    expect(snapshot.evaluate(withType("gmail.search_messages", "read"))).toMatchObject({
+      allowed: false,
+      code: "action_blocked",
+      checks: [{ source: "deployment", outcome: "block_match", rule: "@read" }],
+    });
+    expect(snapshot.evaluate(withType("gmail.send_message", "write")).allowed).toBe(true);
+  });
+
+  it("P3: a block on @read wins over an allow of the same read action", () => {
+    const snapshot = tokenSnapshot(["@read"], ["@read"]);
+    expect(snapshot.evaluate(withType("gmail.search_messages", "read"))).toMatchObject({
+      allowed: false,
+      code: "action_blocked",
+    });
+  });
+
+  it("P4: @read in Trigger rules matches nothing, so no Trigger is granted by it", () => {
+    const service = new ActionPolicyService();
+    const token = { ...emptyRules, allowedProxies: ["*"], allowedTriggers: ["@read"] };
+    expect(service.createSnapshot(emptyRules, token).evaluateTrigger("github.on_repo_event")).toMatchObject({
+      allowed: false,
+      code: "trigger_not_allowed",
+    });
+    expect(
+      new ActionPolicyService({ allowedTriggers: ["@read"] })
+        .createSnapshot(emptyRules, { ...token, allowedTriggers: ["*"] })
+        .evaluateTrigger("github.on_repo_event"),
+    ).toMatchObject({ allowed: false, code: "trigger_not_allowed" });
+    expect(
+      service.createSnapshot({ ...emptyRules, allowedTriggers: ["@read"] }).evaluateTrigger("github.on_repo_event"),
+    ).toMatchObject({ allowed: false, code: "trigger_not_allowed" });
+  });
+
+  it("P4: @read in Trigger block rules blocks nothing", () => {
+    const service = new ActionPolicyService();
+    const token = { ...emptyRules, allowedProxies: ["*"], allowedTriggers: ["*"] };
+    expect(
+      service
+        .createSnapshot({ ...emptyRules, blockedTriggers: ["@read"] }, token)
+        .evaluateTrigger("github.on_repo_event").allowed,
+    ).toBe(true);
+  });
+
+  it("P4: @read in proxy rules matches no service, so it grants no proxy", () => {
+    const service = new ActionPolicyService();
+    const token = { ...emptyRules, allowedActions: ["@read"], allowedProxies: ["@read"] };
+    expect(service.createSnapshot(emptyRules, token).evaluateProxy("github")).toMatchObject({
+      allowed: false,
+      code: "proxy_not_allowed",
+    });
+  });
+
+  it("P5: the other patterns behave as before, whatever the label", () => {
+    for (const operationType of ["read", "write", "destructive"] as const) {
+      const target = { ...action, operationType };
+      expect(tokenSnapshot(["*"]).evaluate(target).allowed).toBe(true);
+      expect(tokenSnapshot(["github.*"]).evaluate(target).allowed).toBe(true);
+      expect(tokenSnapshot(["gmail.*"]).evaluate(target).allowed).toBe(false);
+      expect(tokenSnapshot(["github.create_issue"]).evaluate(target).allowed).toBe(true);
+      expect(tokenSnapshot(["github.create_issues"]).evaluate(target).allowed).toBe(false);
+      expect(tokenSnapshot([], ["github.*"]).evaluate(target).allowed).toBe(false);
+      expect(tokenSnapshot([], ["*"]).evaluate(target).allowed).toBe(false);
+    }
+  });
+
+  it("P5: an action id that spells a label is just an id, and the pattern is not a prefix or glob", () => {
+    expect(tokenSnapshot(["@reads"]).evaluate(withType("gmail.search_messages", "read")).allowed).toBe(false);
+    expect(tokenSnapshot(["@read.*"]).evaluate(withType("gmail.search_messages", "read")).allowed).toBe(false);
+    expect(tokenSnapshot(["@write"]).evaluate(withType("gmail.send_message", "write")).allowed).toBe(false);
+    expect(tokenSnapshot(["@READ"]).evaluate(withType("gmail.search_messages", "read")).allowed).toBe(false);
+  });
+
+  it("P5: an id-only path never treats @read as allow-all, and evaluating the same action twice agrees", () => {
+    const snapshot = tokenSnapshot(["@read"]);
+    const readAction = withType("gmail.search_messages", "read");
+    expect(snapshot.evaluate(readAction)).toEqual(snapshot.evaluate(readAction));
+    // Trigger ids carry no definition, so they go through the id-only path and must stay refused.
+    const triggers = new ActionPolicyService().createSnapshot(emptyRules, {
+      allowedActions: ["@read"],
+      blockedActions: [],
+      allowedProxies: ["*"],
+      allowedTriggers: ["@read"],
+    });
+    expect(triggers.evaluateTrigger("gmail.search_messages").allowed).toBe(false);
+  });
+});
